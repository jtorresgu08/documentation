+/**
+ * Installation and support work: work orders and their life cycle (scheduled, on the way, in progress, completed),
+ * photos and signature of the installation report, equipment reserved and installed, the device created when a
+ * tracker is installed and the signal test the technician runs before leaving.
+ */
+@Singleton
+public class InstallationService {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(InstallationService.class);
+
+    public static final String SCHEDULED = "scheduled";
+    public static final String EN_ROUTE = "enRoute";
+    public static final String IN_PROGRESS = "inProgress";
+    public static final String COMPLETED = "completed";
+    public static final String CANCELLED = "cancelled";
+    public static final List<String> STATUSES = List.of(SCHEDULED, EN_ROUTE, IN_PROGRESS, COMPLETED, CANCELLED);
+    public static final List<String> TYPES = List.of("installation", "maintenance", "removal", "inspection", "support");
+
+    public static final String STOCK = "stock";
+    public static final String TECHNICIAN = "technician";
+    public static final String RESERVED = "reserved";
+    public static final String INSTALLED = "installed";
+    public static final String FAULTY = "faulty";
+    public static final String RETIRED = "retired";
+    public static final List<String> STOCK_STATUSES = List.of(STOCK, TECHNICIAN, RESERVED, INSTALLED, FAULTY, RETIRED);
+
+    public static final List<String> CHECKLIST = List.of(
+            "power", "gpsFix", "gsmSignal", "ignition", "engineStop", "panicButton", "wiring", "clientTrained");
+
+    private static final int MAX_IMAGE = 5 * 1024 * 1024;
+    private static final long SIGNAL_MILLIS = 15 * 60_000L;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private final Config config;
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final HierarchyService hierarchyService;
+
+    @Inject
+    public InstallationService(
+            Config config, Storage storage, CacheManager cacheManager, HierarchyService hierarchyService) {
+        this.config = config;
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.hierarchyService = hierarchyService;
+    }
+
+    public static String newToken() {
+        byte[] bytes = new byte[18];
+        RANDOM.nextBytes(bytes);
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+    }
+
+    /** accounts whose installation data the user sees: its own and those below it, or {@code null} for all */
+    public Set<Long> owners(long userId, boolean admin) throws StorageException {
+        if (admin) {
+            return null;
+        }
+        Set<Long> owners = new HashSet<>(hierarchyService.getDescendants(userId));
+        owners.add(userId);
+        return owners;
+    }
+
+    public Technician technicianByToken(String token) throws StorageException {
+        if (token == null || token.length() < 16) {
+            return null;
+        }
+        Technician technician = storage.getObject(Technician.class, new Request(
+                new Columns.All(), new Condition.Equals("token", token)));
+        return technician != null && technician.getActive() ? technician : null;
+    }
+
+    public WorkOrder orderByToken(String token) throws StorageException {
+        if (token == null || token.length() < 16) {
+            return null;
+        }
+        return storage.getObject(WorkOrder.class, new Request(
+                new Columns.All(), new Condition.Equals("token", token)));
+    }
+
+    public WorkOrder order(long id) throws StorageException {
+        return storage.getObject(WorkOrder.class, new Request(new Columns.All(), new Condition.Equals("id", id)));
+    }
+
+    public Technician technician(long id) throws StorageException {
+        return id > 0 ? storage.getObject(Technician.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id))) : null;
+    }
+
+    public List<WorkOrderPhoto> photos(long orderId) throws StorageException {
+        return new ArrayList<>(storage.getObjects(WorkOrderPhoto.class, new Request(
+                new Columns.All(), new Condition.Equals("workOrderId", orderId), new Order("time"))));
+    }
+
+    public List<StockItem> orderItems(long orderId) throws StorageException {
+        return new ArrayList<>(storage.getObjects(StockItem.class, new Request(
+                new Columns.All(), new Condition.Equals("workOrderId", orderId))));
+    }
+
+    public Map<String, Object> view(WorkOrder order, boolean full) throws StorageException {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", order.getId());
+        result.put("type", order.getType());
+        result.put("status", order.getStatus());
+        result.put("clientId", order.getClientId());
+        result.put("clientName", order.getClientName());
+        result.put("contactName", order.getContactName());
+        result.put("contactPhone", order.getContactPhone());
+        result.put("address", order.getAddress());
+        result.put("latitude", order.getLatitude());
+        result.put("longitude", order.getLongitude());
+        result.put("scheduledAt", order.getScheduledAt());
+        result.put("duration", order.getDuration());
+        result.put("plate", order.getPlate());
+        result.put("vehicle", order.getVehicle());
+        result.put("notes", order.getNotes());
+        result.put("techNotes", order.getTechNotes());
+        result.put("uniqueId", order.getUniqueId());
+        result.put("iccid", order.getIccid());
+        result.put("deviceId", order.getDeviceId());
+        result.put("ticketId", order.getTicketId());
+        result.put("enRouteAt", order.getEnRouteAt());
+        result.put("startedAt", order.getStartedAt());
+        result.put("completedAt", order.getCompletedAt());
+        result.put("signatureName", order.getSignatureName());
+        result.put("checklist", order.getAttributes().getOrDefault("checklist", Map.of()));
+        result.put("odometer", order.getAttributes().get("odometer"));
+        result.put("technicianId", order.getTechnicianId());
+        Technician technician = technician(order.getTechnicianId());
+        result.put("technicianName", technician != null ? technician.getName() : null);
+        result.put("technicianPhone", technician != null ? technician.getPhone() : null);
+        List<Map<String, Object>> items = new ArrayList<>();
+        for (StockItem item : orderItems(order.getId())) {
+            Map<String, Object> view = new LinkedHashMap<>();
+            view.put("id", item.getId());
+            view.put("type", item.getType());
+            view.put("model", item.getModel());
+            view.put("serial", item.getSerial());
+            view.put("status", item.getStatus());
+            items.add(view);
+        }
+        result.put("items", items);
+        if (full) {
+            result.put("userId", order.getUserId());
+            result.put("token", order.getToken());
+            result.put("createdAt", order.getCreatedAt());
+            List<Map<String, Object>> photos = new ArrayList<>();
+            for (WorkOrderPhoto photo : photos(order.getId())) {
