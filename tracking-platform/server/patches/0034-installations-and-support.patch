+package org.traccar.api.resource;
+
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.installations.InstallationService;
+import org.traccar.model.Server;
+import org.traccar.model.StockItem;
+import org.traccar.model.Technician;
+import org.traccar.model.WorkOrder;
+import org.traccar.model.WorkOrderPhoto;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Panel of the installer, opened with his private link (no account needed): his agenda, the details of each
+ * visit, status, equipment and IMEI, checklist, photos, signal test and the client signature. Also the public
+ * installation report of a completed order.
+ */
+@Path("installer")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class InstallerResource extends BaseResource {
+
+    private static final long PAST_MILLIS = 3 * 86_400_000L;
+
+    @Inject
+    private InstallationService installationService;
+
+    private static WebApplicationException notFound() {
+        return new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+    }
+
+    private Technician technician(String token) throws StorageException {
+        Technician technician = installationService.technicianByToken(token);
+        if (technician == null) {
+            throw notFound();
+        }
+        return technician;
+    }
+
+    private WorkOrder order(String token, long id) throws StorageException {
+        Technician technician = technician(token);
+        WorkOrder order = installationService.order(id);
+        if (order == null || order.getTechnicianId() != technician.getId()) {
+            throw notFound();
+        }
+        return order;
+    }
+
+    private static Double number(Object value) {
+        return value instanceof Number number ? number.doubleValue() : null;
+    }
+
+    /** open orders of the technician and the ones he closed in the last days */
+    @GET
+    @PermitAll
+    @Path("{token}")
+    public Map<String, Object> agenda(@PathParam("token") String token) throws StorageException {
+        Technician technician = technician(token);
+        long since = System.currentTimeMillis() - PAST_MILLIS;
+        List<Map<String, Object>> orders = new ArrayList<>();
+        for (WorkOrder order : storage.getObjects(WorkOrder.class, new Request(
+                new Columns.All(), new Condition.Equals("technicianId", technician.getId()),
+                new Order("scheduledAt")))) {
+            boolean closed = InstallationService.COMPLETED.equals(order.getStatus())
+                    || InstallationService.CANCELLED.equals(order.getStatus());
+            Long closedAt = order.getCompletedAt() != null ? order.getCompletedAt().getTime()
+                    : order.getScheduledAt() != null ? order.getScheduledAt().getTime() : null;
+            if (!closed || closedAt != null && closedAt > since) {
+                Map<String, Object> view = installationService.view(order, false);
+                view.put("photoCount", installationService.photos(order.getId()).size());
+                orders.add(view);
+            }
+        }
+        List<Map<String, Object>> stock = new ArrayList<>();
+        for (StockItem item : storage.getObjects(StockItem.class, new Request(
+                new Columns.All(), new Condition.Equals("technicianId", technician.getId())))) {
+            if (InstallationService.TECHNICIAN.equals(item.getStatus())
+                    || InstallationService.RESERVED.equals(item.getStatus())) {
+                Map<String, Object> view = new LinkedHashMap<>();
+                view.put("id", item.getId());
+                view.put("type", item.getType());
+                view.put("model", item.getModel());
+                view.put("serial", item.getSerial());
+                view.put("status", item.getStatus());
+                stock.add(view);
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("name", technician.getName());
+        result.put("orders", orders);
+        result.put("stock", stock);
+        result.put("checklist", InstallationService.CHECKLIST);
+        return result;
+    }
+
+    private Map<String, Object> detail(WorkOrder order) throws StorageException {
+        Map<String, Object> view = installationService.view(order, true);
+        view.remove("userId");
+        return view;
+    }
+
+    @GET
+    @PermitAll
+    @Path("{token}/orders/{id}")
+    public Map<String, Object> get(@PathParam("token") String token, @PathParam("id") long id)
+            throws StorageException {
+        return detail(order(token, id));
+    }
+
+    @POST
+    @PermitAll
+    @Path("{token}/orders/{id}/status")
+    public Map<String, Object> status(
+            @PathParam("token") String token, @PathParam("id") long id, Map<String, Object> body) throws Exception {
+        WorkOrder order = order(token, id);
+        installationService.advance(order, String.valueOf(body.get("status")),
+                number(body.get("latitude")), number(body.get("longitude")));
+        return detail(order);
+    }
+
+    @PUT
+    @PermitAll
+    @Path("{token}/orders/{id}")
+    public Map<String, Object> fill(
+            @PathParam("token") String token, @PathParam("id") long id, Map<String, Object> body) throws Exception {
+        WorkOrder order = order(token, id);
+        installationService.fill(order, body);
+        return detail(order);
+    }
+
+    @POST
+    @PermitAll
+    @Path("{token}/orders/{id}/photos")
+    public Map<String, Object> addPhoto(
+            @PathParam("token") String token, @PathParam("id") long id, Map<String, Object> body) throws Exception {
+        WorkOrder order = order(token, id);
+        if (InstallationService.COMPLETED.equals(order.getStatus())
+                || InstallationService.CANCELLED.equals(order.getStatus())) {
+            throw new IllegalArgumentException("The order is closed");
+        }
+        Object category = body.get("category");
+        installationService.addPhoto(order, "photo", category != null ? String.valueOf(category) : null,
+                body.get("data"), number(body.get("latitude")), number(body.get("longitude")));
+        return detail(order);
+    }
+
+    @DELETE
+    @PermitAll
+    @Path("{token}/orders/{id}/photos/{photoId}")
+    public Map<String, Object> removePhoto(
+            @PathParam("token") String token, @PathParam("id") long id, @PathParam("photoId") long photoId)
+            throws Exception {
+        WorkOrder order = order(token, id);
+        WorkOrderPhoto photo = installationService.photo(order, photoId);
+        if (photo == null || !"photo".equals(photo.getKind())) {
+            throw notFound();
+        }
+        installationService.removePhoto(order, photo);
+        return detail(order);
+    }
+
+    @GET
+    @PermitAll
+    @Path("{token}/orders/{id}/photos/{photoId}")
+    @Produces({"image/jpeg", "image/png", "image/webp"})
+    public Response photo(
+            @PathParam("token") String token, @PathParam("id") long id, @PathParam("photoId") long photoId)
+            throws Exception {
+        WorkOrderPhoto photo = installationService.photo(order(token, id), photoId);
+        if (photo == null) {
+            throw notFound();
+        }
+        return Response.ok(installationService.read(photo), InstallationService.mime(photo)).build();
+    }
+
+    @GET
+    @PermitAll
+    @Path("{token}/orders/{id}/signal")
+    public Map<String, Object> signal(@PathParam("token") String token, @PathParam("id") long id)
+            throws StorageException {
+        return installationService.signal(order(token, id));
+    }
+
+    @POST
+    @PermitAll
+    @Path("{token}/orders/{id}/complete")
+    public Map<String, Object> complete(
+            @PathParam("token") String token, @PathParam("id") long id, Map<String, Object> body) throws Exception {
+        WorkOrder order = order(token, id);
+        installationService.fill(order, body);
+        installationService.complete(order, body);
+        return detail(order);
+    }
+
+    // ---------- installation report ----------
+
+    private WorkOrder completed(String token) throws StorageException {
+        WorkOrder order = installationService.orderByToken(token);
+        if (order == null || !InstallationService.COMPLETED.equals(order.getStatus())) {
+            throw notFound();
+        }
+        return order;
+    }
+
+    @GET
+    @PermitAll
+    @Path("acta/{token}")
+    public Map<String, Object> report(@PathParam("token") String token) throws StorageException {
+        Map<String, Object> view = detail(completed(token));
+        view.remove("token");
+        view.remove("technicianPhone");
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        view.put("company", server.getString("title"));
+        return view;
+    }
+
+    @GET
+    @PermitAll
+    @Path("acta/{token}/photos/{photoId}")
+    @Produces({"image/jpeg", "image/png", "image/webp"})
+    public Response reportPhoto(@PathParam("token") String token, @PathParam("photoId") long photoId)
+            throws Exception {
+        WorkOrderPhoto photo = installationService.photo(completed(token), photoId);
+        if (photo == null) {
+            throw notFound();
+        }
+        return Response.ok(installationService.read(photo), InstallationService.mime(photo)).build();
+    }
+
+}
diff --git a/src/main/java/org/traccar/api/resource/SupportResource.java b/src/main/java/org/traccar/api/resource/SupportResource.java
