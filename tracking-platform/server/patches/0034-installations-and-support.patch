+
+    // ---------- equipment ----------
+
+    /** reserves the given inventory items for the order and frees the ones no longer listed */
+    public void reserve(WorkOrder order, List<Long> itemIds, Set<Long> owners) throws StorageException {
+        Date now = new Date();
+        for (StockItem item : orderItems(order.getId())) {
+            if (!itemIds.contains(item.getId()) && RESERVED.equals(item.getStatus())) {
+                item.setStatus(item.getTechnicianId() > 0 ? TECHNICIAN : STOCK);
+                item.setWorkOrderId(0);
+                item.setUpdatedAt(now);
+                saveItem(item);
+            }
+        }
+        for (long id : itemIds) {
+            StockItem item = storage.getObject(StockItem.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", id)));
+            if (item == null || owners != null && !owners.contains(item.getUserId())) {
+                throw new IllegalArgumentException("Unknown equipment " + id);
+            }
+            if (item.getWorkOrderId() == order.getId()) {
+                continue;
+            }
+            if (!STOCK.equals(item.getStatus()) && !TECHNICIAN.equals(item.getStatus())) {
+                throw new IllegalArgumentException("Equipment " + item.getSerial() + " is not available");
+            }
+            item.setStatus(RESERVED);
+            item.setWorkOrderId(order.getId());
+            if (order.getTechnicianId() > 0) {
+                item.setTechnicianId(order.getTechnicianId());
+            }
+            item.setUpdatedAt(now);
+            saveItem(item);
+        }
+    }
+
+    private void saveItem(StockItem item) throws StorageException {
+        storage.updateObject(item, new Request(new Columns.Exclude("id", "userId"),
+                new Condition.Equals("id", item.getId())));
+    }
+
+    /** a cancelled order gives its reserved equipment back */
+    public void release(WorkOrder order) throws StorageException {
+        reserve(order, List.of(), null);
+    }
+
+    // ---------- life cycle ----------
+
+    private void save(WorkOrder order) throws StorageException {
+        storage.updateObject(order, new Request(new Columns.Exclude("id", "userId", "token", "createdAt"),
+                new Condition.Equals("id", order.getId())));
+    }
+
+    private static void checkOpen(WorkOrder order) {
+        if (COMPLETED.equals(order.getStatus()) || CANCELLED.equals(order.getStatus())) {
+            throw new IllegalArgumentException("The order is closed");
+        }
+    }
+
+    /** on the way or started by the technician, with where he was */
+    public void advance(WorkOrder order, String status, Double latitude, Double longitude) throws StorageException {
+        checkOpen(order);
+        Date now = new Date();
+        if (EN_ROUTE.equals(status)) {
+            order.setEnRouteAt(now);
+        } else if (IN_PROGRESS.equals(status)) {
+            order.setStartedAt(now);
+            if (latitude != null && longitude != null && order.getLatitude() == 0 && order.getLongitude() == 0) {
+                order.setLatitude(latitude);
+                order.setLongitude(longitude);
+            }
+        } else {
+            throw new IllegalArgumentException("Invalid status");
+        }
+        order.setStatus(status);
+        save(order);
+    }
+
+    private static String text(Object value) {
+        if (value == null) {
+            return null;
+        }
+        String result = String.valueOf(value).trim();
+        return result.isEmpty() ? null : result;
+    }
+
+    /** details the technician fills during the visit */
+    public void fill(WorkOrder order, Map<String, Object> body) throws Exception {
+        checkOpen(order);
+        String previousUniqueId = order.getUniqueId();
+        if (body.containsKey("techNotes")) {
+            order.setTechNotes(text(body.get("techNotes")));
+        }
+        if (body.containsKey("uniqueId")) {
+            String uniqueId = text(body.get("uniqueId"));
+            order.setUniqueId(uniqueId != null ? uniqueId.replaceAll("\\s", "") : null);
+        }
+        if (body.containsKey("iccid")) {
+            String iccid = text(body.get("iccid"));
+            order.setIccid(iccid != null ? iccid.replaceAll("[^0-9A-Za-z]", "") : null);
+        }
+        if (body.containsKey("plate") && text(body.get("plate")) != null) {
+            order.setPlate(text(body.get("plate")).toUpperCase());
+        }
+        if (body.containsKey("odometer")) {
+            order.set("odometer", text(body.get("odometer")));
+        }
+        if (body.get("checklist") instanceof Map<?, ?> checklist) {
+            Map<String, Object> clean = new LinkedHashMap<>();
+            for (String key : CHECKLIST) {
+                if (checklist.containsKey(key)) {
+                    clean.put(key, Boolean.TRUE.equals(checklist.get(key)));
+                }
+            }
+            order.getAttributes().put("checklist", clean);
+        }
+        if (!java.util.Objects.equals(previousUniqueId, order.getUniqueId())) {
+            prepareDevice(order);
+        }
+        save(order);
+    }
+
+    private static final String CREATED_DEVICE = "createdDeviceId";
+
+    /** whether the IMEI is free or already belongs to the account of the order (or one below it) */
+    private void checkDeviceOwner(WorkOrder order, Device device) throws StorageException {
+        if (device.getId() == order.getDeviceId()) {
+            return;
+        }
+        User owner = storage.getObject(User.class, new Request(
+                new Columns.All(), new Condition.Equals("id", order.getUserId())));
+        if (owner == null || owner.getAdministrator()) {
+            return;
+        }
+        List<Permission> links = storage.getPermissions(User.class, 0, Device.class, device.getId());
+        if (links.isEmpty()) {
+            return;
+        }
+        Set<Long> allowed = owners(order.getUserId(), false);
+        if (order.getClientId() > 0) {
+            allowed.add(order.getClientId());
+        }
+        if (links.stream().noneMatch(link -> allowed.contains(link.getOwnerId()))) {
+            throw new IllegalArgumentException("The IMEI " + device.getUniqueId() + " belongs to another account");
+        }
+    }
+
+    /** a cancelled or deleted order does not leave behind the unit its IMEI created */
+    public void discardDevice(WorkOrder order) throws Exception {
+        if (!COMPLETED.equals(order.getStatus())) {
+            removeCreatedDevice(order);
+        }
+    }
+
+    private void removeCreatedDevice(WorkOrder order) throws Exception {
+        long created = order.getLong(CREATED_DEVICE);
+        if (created > 0) {
+            storage.removeObject(Device.class, new Request(new Condition.Equals("id", created)));
+            cacheManager.invalidateObject(true, Device.class, created, ObjectOperation.DELETE);
+            order.getAttributes().remove(CREATED_DEVICE);
+            if (order.getDeviceId() == created) {
+                order.setDeviceId(0);
+            }
+            LOGGER.info("Device {} created by work order {} removed after an IMEI change", created, order.getId());
+        }
+    }
+
+    /**
+     * As soon as the technician enters the IMEI of a tracker being installed, the unit exists for the client, so the
+     * signal test shows real data during the visit. A unit created by a mistyped IMEI is removed when it is fixed.
+     */
+    private void prepareDevice(WorkOrder order) throws Exception {
+        if ("removal".equals(order.getType())) {
+            return;
+        }
+        String uniqueId = order.getUniqueId();
+        Device device = uniqueId != null ? deviceByUniqueId(uniqueId) : null;
+        if (device != null) {
+            checkDeviceOwner(order, device);
+        }
+        if (device == null || device.getId() != order.getLong(CREATED_DEVICE)) {
+            removeCreatedDevice(order);
+        }
+        if (uniqueId == null) {
+            return;
+        }
+        if (device == null) {
+            device = new Device();
+            device.setName(order.getPlate() != null ? order.getPlate()
+                    : order.getVehicle() != null ? order.getVehicle() : "Unidad " + uniqueId);
+            device.setUniqueId(uniqueId);
+            if (order.getPlate() != null) {
+                device.set("plate", order.getPlate());
+            }
+            device.setId(storage.addObject(device, new Request(new Columns.Exclude("id"))));
+            order.set(CREATED_DEVICE, device.getId());
+            LOGGER.info("Device {} created by work order {}", uniqueId, order.getId());
+        }
+        link(order.getUserId(), device.getId());
+        link(order.getClientId(), device.getId());
+        order.setDeviceId(device.getId());
+    }
+
+    private Path mediaRoot() {
+        return Paths.get(config.getString(Keys.MEDIA_PATH));
+    }
+
+    public WorkOrderPhoto addPhoto(
+            WorkOrder order, String kind, String category, Object value, Double latitude, Double longitude)
+            throws IOException, StorageException {
+        if (!(value instanceof String data) || !data.matches("(?s)^data:image/(jpeg|jpg|png|webp);base64,.+")) {
+            throw new IllegalArgumentException("The photo must be a JPEG, PNG or WebP image");
+        }
+        int comma = data.indexOf(',');
+        String extension = data.startsWith("data:image/png") ? "png"
+                : data.startsWith("data:image/webp") ? "webp" : "jpg";
+        byte[] bytes = Base64.getMimeDecoder().decode(data.substring(comma + 1));
+        if (bytes.length > MAX_IMAGE) {
+            throw new IllegalArgumentException("Image too large (max 5 MB)");
+        }
+        String name = String.format("installations/%d/%s-%s.%s", order.getId(), kind, newToken(), extension);
+        Path file = mediaRoot().resolve(name);
+        Files.createDirectories(file.getParent());
+        Files.write(file, bytes);
+        WorkOrderPhoto photo = new WorkOrderPhoto();
+        photo.setWorkOrderId(order.getId());
+        photo.setKind(kind);
+        photo.setCategory(category != null ? category : "other");
+        photo.setFile(name);
+        photo.setTime(new Date());
+        if (latitude != null && longitude != null) {
+            photo.setLatitude(latitude);
+            photo.setLongitude(longitude);
+        }
+        photo.setId(storage.addObject(photo, new Request(new Columns.Exclude("id"))));
+        return photo;
+    }
+
+    public WorkOrderPhoto photo(WorkOrder order, long photoId) throws StorageException {
+        WorkOrderPhoto photo = storage.getObject(WorkOrderPhoto.class, new Request(
+                new Columns.All(), new Condition.Equals("id", photoId)));
+        return photo != null && photo.getWorkOrderId() == order.getId() ? photo : null;
+    }
+
+    public byte[] read(WorkOrderPhoto photo) throws IOException {
+        Path root = mediaRoot().toAbsolutePath().normalize();
+        Path file = root.resolve(photo.getFile()).normalize();
+        if (!file.startsWith(root)) {
+            throw new IOException("Invalid path");
+        }
+        return Files.readAllBytes(file);
+    }
+
+    public static String mime(WorkOrderPhoto photo) {
+        return photo.getFile().endsWith(".png") ? "image/png"
+                : photo.getFile().endsWith(".webp") ? "image/webp" : "image/jpeg";
+    }
+
+    public void removePhoto(WorkOrder order, WorkOrderPhoto photo) throws StorageException {
+        checkOpen(order);
+        storage.removeObject(WorkOrderPhoto.class, new Request(new Condition.Equals("id", photo.getId())));
+        try {
+            Files.deleteIfExists(mediaRoot().resolve(photo.getFile()));
+        } catch (IOException e) {
+            LOGGER.warn("Photo file not deleted", e);
+        }
+    }
+
+    /** deletes the photo files of an order being deleted (the rows go with the order) */
+    public void removePhotos(WorkOrder order) throws StorageException {
+        for (WorkOrderPhoto photo : photos(order.getId())) {
+            try {
+                Files.deleteIfExists(mediaRoot().resolve(photo.getFile()));
+            } catch (IOException e) {
+                LOGGER.warn("Photo file not deleted", e);
+            }
+        }
+    }
+
+    private Device deviceByUniqueId(String uniqueId) throws StorageException {
+        return storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("uniqueId", uniqueId)));
+    }
+
+    private void link(long userId, long deviceId) throws Exception {
+        if (userId <= 0) {
+            return;
+        }
+        try {
+            storage.addPermission(new Permission(User.class, userId, Device.class, deviceId));
+            cacheManager.invalidatePermission(true, User.class, userId, Device.class, deviceId, true);
+        } catch (StorageException e) {
+            LOGGER.debug("Permission already present", e);
+        }
+    }
+
+    /**
+     * Closes the order: the client signature is stored, a tracker being installed becomes a device of the client
+     * (created when its IMEI is new), the equipment is marked installed (or back in stock for a removal), the SIM
+     * follows the device and a ticket that originated the visit is resolved.
+     */
+    public synchronized WorkOrder complete(WorkOrder order, Map<String, Object> body) throws Exception {
+        checkOpen(order);
+        String signatureName = text(body.get("signatureName"));
+        if (signatureName == null || body.get("signature") == null) {
+            throw new IllegalArgumentException("The client signature and name are required");
+        }
+        Double latitude = body.get("latitude") instanceof Number number ? number.doubleValue() : null;
+        Double longitude = body.get("longitude") instanceof Number number ? number.doubleValue() : null;
+        addPhoto(order, "signature", "signature", body.get("signature"), latitude, longitude);
+        Date now = new Date();
+        String uniqueId = order.getUniqueId();
+        boolean removal = "removal".equals(order.getType());
+        if (uniqueId != null && !removal) {
+            Device device = deviceByUniqueId(uniqueId);
+            if (device == null || device.getId() != order.getDeviceId()) {
+                prepareDevice(order);
+            }
+        }
+        for (StockItem item : orderItems(order.getId())) {
+            item.setStatus(removal ? STOCK : INSTALLED);
+            item.setDeviceId(removal ? 0 : order.getDeviceId());
+            item.setUpdatedAt(now);
+            saveItem(item);
+        }
+        if (uniqueId != null) {
+            StockItem tracker = storage.getObject(StockItem.class, new Request(
+                    new Columns.All(), new Condition.Equals("serial", uniqueId)));
+            if (tracker != null && tracker.getWorkOrderId() != order.getId()) {
+                tracker.setStatus(removal ? STOCK : INSTALLED);
+                tracker.setDeviceId(removal ? 0 : order.getDeviceId());
+                tracker.setWorkOrderId(order.getId());
+                tracker.setUpdatedAt(now);
+                saveItem(tracker);
+            }
+        }
+        if (order.getIccid() != null && order.getDeviceId() > 0 && !removal) {
+            Sim sim = storage.getObject(Sim.class, new Request(
+                    new Columns.All(), new Condition.Equals("iccid", order.getIccid())));
+            if (sim != null) {
+                sim.setDeviceId(order.getDeviceId());
+                sim.setStatus("active");
+                if (sim.getActivatedAt() == null) {
+                    sim.setActivatedAt(now);
+                }
+                storage.updateObject(sim, new Request(new Columns.Include("deviceId", "status", "activatedAt"),
+                        new Condition.Equals("id", sim.getId())));
+            }
+        }
+        order.setSignatureName(signatureName);
+        order.setStatus(COMPLETED);
+        order.setCompletedAt(now);
+        if (order.getStartedAt() == null) {
+            order.setStartedAt(now);
+        }
+        save(order);
+        if (order.getTicketId() > 0) {
+            Ticket ticket = storage.getObject(Ticket.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", order.getTicketId())));
+            if (ticket != null) {
+                ticket.setStatus("resolved");
+                ticket.setUpdatedAt(now);
+                storage.updateObject(ticket, new Request(new Columns.Include("status", "updatedAt"),
+                        new Condition.Equals("id", ticket.getId())));
+                TicketMessage message = new TicketMessage();
+                message.setTicketId(ticket.getId());
+                message.setAuthor("Sistema");
+                message.setText("Visita técnica completada (orden #" + order.getId() + ").");
+                message.setTime(now);
+                message.setId(storage.addObject(message, new Request(new Columns.Exclude("id"))));
+            }
+        }
+        return order;
+    }
+
+    /** whether the tracker of the order is reporting, so the technician can check it before leaving */
+    public Map<String, Object> signal(WorkOrder order) throws StorageException {
+        Map<String, Object> result = new LinkedHashMap<>();
+        Device device = order.getDeviceId() > 0 ? storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("id", order.getDeviceId())))
+                : order.getUniqueId() != null ? deviceByUniqueId(order.getUniqueId()) : null;
+        result.put("known", device != null);
+        if (device == null) {
+            result.put("reporting", false);
+            return result;
+        }
+        result.put("lastUpdate", device.getLastUpdate());
+        result.put("reporting", device.getLastUpdate() != null
+                && System.currentTimeMillis() - device.getLastUpdate().getTime() < SIGNAL_MILLIS);
+        Position position = cacheManager.getPosition(device.getId());
+        if (position == null && device.getPositionId() > 0) {
+            position = storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", device.getPositionId())));
+        }
+        if (position != null) {
+            Map<String, Object> view = new HashMap<>();
+            view.put("fixTime", position.getFixTime());
+            view.put("latitude", position.getLatitude());
+            view.put("longitude", position.getLongitude());
+            view.put("valid", position.getValid());
+            view.put("speed", UnitsConverter.kphFromKnots(position.getSpeed()));
+            view.put("ignition", position.getAttributes().get(Position.KEY_IGNITION));
+            view.put("satellites", position.getAttributes().get(Position.KEY_SATELLITES));
+            view.put("power", position.getAttributes().get(Position.KEY_POWER));
+            view.put("rssi", position.getAttributes().get(Position.KEY_RSSI));
+            result.put("position", view);
+        }
+        return result;
+    }
+
+}
