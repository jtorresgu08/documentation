+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.installations.InstallationService;
+import org.traccar.model.Device;
+import org.traccar.model.Technician;
+import org.traccar.model.Ticket;
+import org.traccar.model.TicketMessage;
+import org.traccar.model.User;
+import org.traccar.model.WorkOrder;
+import org.traccar.plans.PlanService;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Support tickets: any user opens and follows its tickets; the support team (administrators and managers with the
+ * installations module) answers, adds internal notes, changes status and priority and sends a technician.
+ */
+@Path("support")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SupportResource extends BaseResource {
+
+    public static final List<String> STATUSES = List.of("open", "inProgress", "waiting", "resolved", "closed");
+    public static final List<String> CATEGORIES = List.of(
+            "noSignal", "damage", "installation", "app", "billing", "other");
+    public static final List<String> PRIORITIES = List.of("low", "normal", "high", "urgent");
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private PlanService planService;
+
+    @Inject
+    private InstallationService installationService;
+
+    private boolean admin() throws StorageException {
+        return !permissionsService.notAdmin(getUserId());
+    }
+
+    /** administrators, and managers whose plan includes installations, handle the tickets of their accounts */
+    private boolean handler() throws StorageException {
+        if (admin()) {
+            return true;
+        }
+        User user = permissionsService.getUser(getUserId());
+        return user.getUserLimit() != 0 && planService.getModules(getUserId()).contains("installations");
+    }
+
+    private Set<Long> handled() throws StorageException {
+        if (admin()) {
+            return null;
+        }
+        Set<Long> result = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        result.add(getUserId());
+        return result;
+    }
+
+    private Ticket check(long id) throws StorageException {
+        Ticket ticket = storage.getObject(Ticket.class, new Request(new Columns.All(), new Condition.Equals("id", id)));
+        if (ticket == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        if (ticket.getUserId() != getUserId()) {
+            Set<Long> handled = handled();
+            if (!handler() || handled != null && !handled.contains(ticket.getUserId())) {
+                throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+            }
+        }
+        return ticket;
+    }
+
+    private void checkHandler(Ticket ticket) throws StorageException {
+        Set<Long> handled = handled();
+        if (!handler() || handled != null && !handled.contains(ticket.getUserId())) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+    }
+
+    private static String text(Object value) {
+        if (value == null) {
+            return null;
+        }
+        String result = String.valueOf(value).trim();
+        return result.isEmpty() ? null : result;
+    }
+
+    private Map<String, Object> view(Ticket ticket, Map<Long, User> users) throws StorageException {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", ticket.getId());
+        result.put("userId", ticket.getUserId());
+        User user = users.computeIfAbsent(ticket.getUserId(), id -> {
+            try {
+                return storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", id)));
+            } catch (StorageException e) {
+                return null;
+            }
+        });
+        result.put("userName", user != null ? user.getName() : null);
+        result.put("userPhone", user != null ? user.getPhone() : null);
+        result.put("subject", ticket.getSubject());
+        result.put("description", ticket.getDescription());
+        result.put("category", ticket.getCategory());
+        result.put("priority", ticket.getPriority());
+        result.put("status", ticket.getStatus());
+        result.put("deviceId", ticket.getDeviceId());
+        result.put("workOrderId", ticket.getWorkOrderId());
+        result.put("createdAt", ticket.getCreatedAt());
+        result.put("updatedAt", ticket.getUpdatedAt());
+        return result;
+    }
+
+    @GET
+    @Path("tickets")
+    public List<Map<String, Object>> tickets(@QueryParam("status") String status) throws StorageException {
+        boolean handler = handler();
+        Set<Long> handled = handler ? handled() : Set.of(getUserId());
+        Map<Long, User> users = new HashMap<>();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Ticket ticket : storage.getObjects(Ticket.class, new Request(new Columns.All()))) {
+            boolean visible = ticket.getUserId() == getUserId()
+                    || handled == null || handled.contains(ticket.getUserId());
+            if (visible && (status == null || status.isEmpty() || status.equals(ticket.getStatus()))) {
+                result.add(view(ticket, users));
+            }
+        }
+        result.sort(Comparator.comparing((Map<String, Object> item) -> (Date) item.get("updatedAt"),
+                Comparator.nullsLast(Comparator.naturalOrder())).reversed());
+        return result;
+    }
+
+    @POST
+    @Path("tickets")
+    public Map<String, Object> add(Map<String, Object> body) throws Exception {
+        String subject = text(body.get("subject"));
+        if (subject == null) {
+            throw new IllegalArgumentException("The ticket needs a subject");
+        }
+        Ticket ticket = new Ticket();
+        ticket.setUserId(getUserId());
+        ticket.setSubject(subject.length() > 250 ? subject.substring(0, 250) : subject);
+        String description = text(body.get("description"));
+        ticket.setDescription(description != null && description.length() > 3900
+                ? description.substring(0, 3900) : description);
+        String category = text(body.get("category"));
+        ticket.setCategory((category != null && CATEGORIES.contains(category)) ? category : "other");
+        String priority = text(body.get("priority"));
+        ticket.setPriority((priority != null && PRIORITIES.contains(priority)) ? priority : "normal");
+        long deviceId = body.get("deviceId") instanceof Number number ? number.longValue() : 0;
+        if (deviceId > 0 && FleetUtil.devices(storage, permissionsService, getUserId()).stream()
+                .noneMatch(device -> device.getId() == deviceId)) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+        ticket.setDeviceId(deviceId);
+        ticket.setStatus("open");
+        Date now = new Date();
+        ticket.setCreatedAt(now);
+        ticket.setUpdatedAt(now);
+        ticket.setId(storage.addObject(ticket, new Request(new Columns.Exclude("id"))));
+        return view(ticket, new HashMap<>());
+    }
+
+    @GET
+    @Path("tickets/{id}")
+    public Map<String, Object> get(@PathParam("id") long id) throws StorageException {
+        Ticket ticket = check(id);
+        boolean team = ticket.getUserId() != getUserId() || handler();
+        Map<String, Object> result = view(ticket, new HashMap<>());
+        List<Map<String, Object>> messages = new ArrayList<>();
+        for (TicketMessage message : storage.getObjects(TicketMessage.class, new Request(
+                new Columns.All(), new Condition.Equals("ticketId", id), new Order("time")))) {
+            if (message.getInternal() && !team) {
+                continue;
+            }
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("id", message.getId());
+            item.put("author", message.getAuthor());
+            item.put("mine", message.getUserId() == getUserId());
+            item.put("fromClient", message.getUserId() == ticket.getUserId());
+            item.put("text", message.getText());
+            item.put("time", message.getTime());
+            item.put("internal", message.getInternal());
+            messages.add(item);
+        }
+        result.put("messages", messages);
+        if (ticket.getDeviceId() > 0) {
+            Device device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ticket.getDeviceId())));
+            result.put("deviceName", device != null ? device.getName() : null);
+            result.put("deviceLastUpdate", device != null ? device.getLastUpdate() : null);
+        }
+        if (ticket.getWorkOrderId() > 0) {
+            WorkOrder order = installationService.order(ticket.getWorkOrderId());
+            if (order != null) {
+                result.put("workOrderStatus", order.getStatus());
+                result.put("workOrderScheduledAt", order.getScheduledAt());
+            }
+        }
+        result.put("canHandle", ticket.getUserId() != getUserId() ? true : handler() && admin());
+        return result;
+    }
+
+    private void touch(Ticket ticket, String status) throws StorageException {
+        if (status != null) {
+            ticket.setStatus(status);
+        }
+        ticket.setUpdatedAt(new Date());
+        storage.updateObject(ticket, new Request(new Columns.Include("status", "priority", "updatedAt", "workOrderId"),
+                new Condition.Equals("id", ticket.getId())));
+    }
+
+    @POST
+    @Path("tickets/{id}/messages")
+    public Map<String, Object> message(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        Ticket ticket = check(id);
+        String text = text(body.get("text"));
+        if (text == null) {
+            throw new IllegalArgumentException("Empty message");
+        }
+        boolean fromClient = ticket.getUserId() == getUserId();
+        boolean internal = !fromClient && Boolean.TRUE.equals(body.get("internal"));
+        User user = permissionsService.getUser(getUserId());
+        TicketMessage message = new TicketMessage();
+        message.setTicketId(id);
+        message.setUserId(getUserId());
+        message.setAuthor(user.getName());
+        message.setText(text.length() > 3900 ? text.substring(0, 3900) : text);
+        message.setTime(new Date());
+        message.setInternal(internal);
+        message.setId(storage.addObject(message, new Request(new Columns.Exclude("id"))));
+        String status = null;
+        if (fromClient && "waiting".equals(ticket.getStatus()) || "resolved".equals(ticket.getStatus())) {
+            status = "open";
+        } else if (!fromClient && !internal && "open".equals(ticket.getStatus())) {
+            status = "inProgress";
+        }
+        touch(ticket, status);
+        return get(id);
+    }
+
+    @PUT
+    @Path("tickets/{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        Ticket ticket = check(id);
+        String status = text(body.get("status"));
+        if (ticket.getUserId() == getUserId() && !handler()) {
+            if (!"closed".equals(status)) {
+                throw new WebApplicationException(Response.Status.FORBIDDEN);
+            }
+        } else {
+            checkHandler(ticket);
+            String priority = text(body.get("priority"));
+            if (priority != null && PRIORITIES.contains(priority)) {
+                ticket.setPriority(priority);
+            }
+        }
+        touch(ticket, (status != null && STATUSES.contains(status)) ? status : null);
+        return get(id);
+    }
+
+    /** only administrators delete tickets */
+    @jakarta.ws.rs.DELETE
+    @Path("tickets/{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        if (!admin()) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+        check(id);
+        storage.removeObject(Ticket.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    /** sends a technician: creates a support work order for the client of the ticket */
+    @POST
+    @Path("tickets/{id}/order")
+    public Map<String, Object> order(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        Ticket ticket = check(id);
+        checkHandler(ticket);
+        if (ticket.getWorkOrderId() > 0) {
+            throw new IllegalArgumentException("The ticket already has a work order");
+        }
+        User client = storage.getObject(User.class, new Request(
+                new Columns.All(), new Condition.Equals("id", ticket.getUserId())));
+        WorkOrder order = new WorkOrder();
+        order.setUserId(getUserId());
+        order.setClientId(ticket.getUserId());
+        order.setClientName(client != null ? client.getName() : "Cliente");
+        order.setContactName(client != null ? client.getName() : null);
+        order.setContactPhone(client != null ? client.getPhone() : null);
+        Object type = body.get("type");
+        order.setType(type != null && InstallationService.TYPES.contains(type) ? String.valueOf(type) : "support");
+        order.setStatus(InstallationService.SCHEDULED);
+        long technicianId = body.get("technicianId") instanceof Number number ? number.longValue() : 0;
+        if (technicianId > 0) {
+            Technician technician = installationService.technician(technicianId);
+            Set<Long> owners = installationService.owners(getUserId(), admin());
+            if (technician == null || owners != null && !owners.contains(technician.getUserId())) {
+                throw new IllegalArgumentException("Unknown technician");
+            }
+        }
+        order.setTechnicianId(technicianId);
+        Object scheduled = body.get("scheduledAt");
+        if (scheduled != null) {
+            order.setScheduledAt(Date.from(java.time.Instant.parse(String.valueOf(scheduled))));
+        }
+        order.setDuration(60);
+        order.setAddress(text(body.get("address")));
+        if (ticket.getDeviceId() > 0) {
+            Device device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ticket.getDeviceId())));
+            if (device != null) {
+                order.setDeviceId(device.getId());
+                order.setUniqueId(device.getUniqueId());
+                String plate = device.getString("plate");
+                order.setPlate(plate != null ? plate : device.getName());
+            }
+        }
+        order.setNotes("Ticket #" + ticket.getId() + ": " + ticket.getSubject()
+                + (ticket.getDescription() != null ? "\n" + ticket.getDescription() : ""));
+        if (order.getNotes().length() > 1990) {
+            order.setNotes(order.getNotes().substring(0, 1990));
+        }
+        order.setTicketId(ticket.getId());
+        order.setToken(InstallationService.newToken());
+        order.setCreatedAt(new Date());
+        order.setId(storage.addObject(order, new Request(new Columns.Exclude("id"))));
+        ticket.setWorkOrderId(order.getId());
+        touch(ticket, "inProgress");
+        return get(id);
+    }
+
+}
