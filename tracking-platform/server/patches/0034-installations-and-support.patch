+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.installations.InstallationService;
+import org.traccar.model.StockItem;
+import org.traccar.model.Technician;
+import org.traccar.model.User;
+import org.traccar.model.WorkOrder;
+import org.traccar.model.WorkOrderPhoto;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Installations and field service for the office: technicians, equipment inventory, work orders with their
+ * schedule, and the photos and report of each visit.
+ */
+@Path("installations")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class InstallationResource extends BaseResource {
+
+    @Inject
+    private InstallationService installationService;
+
+    private Set<Long> owners() throws StorageException {
+        return installationService.owners(getUserId(), !permissionsService.notAdmin(getUserId()));
+    }
+
+    private static boolean visible(Set<Long> owners, long userId) {
+        return owners == null || owners.contains(userId);
+    }
+
+    private static WebApplicationException notFound() {
+        return new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+    }
+
+    private static String text(Object value) {
+        if (value == null) {
+            return null;
+        }
+        String result = String.valueOf(value).trim();
+        return result.isEmpty() ? null : result;
+    }
+
+    private static long id(Object value) {
+        return value instanceof Number number ? number.longValue() : 0;
+    }
+
+    private static Date date(Object value) {
+        if (value == null || String.valueOf(value).isBlank()) {
+            return null;
+        }
+        try {
+            return Date.from(java.time.OffsetDateTime.parse(String.valueOf(value)).toInstant());
+        } catch (Exception e) {
+            try {
+                return Date.from(java.time.Instant.parse(String.valueOf(value)));
+            } catch (Exception other) {
+                throw new IllegalArgumentException("Invalid date " + value);
+            }
+        }
+    }
+
+    // ---------- technicians ----------
+
+    private Map<String, Object> view(Technician technician) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", technician.getId());
+        result.put("name", technician.getName());
+        result.put("phone", technician.getPhone());
+        result.put("email", technician.getEmail());
+        result.put("color", technician.getColor());
+        result.put("active", technician.getActive());
+        result.put("token", technician.getToken());
+        return result;
+    }
+
+    private List<Technician> technicians() throws StorageException {
+        Set<Long> owners = owners();
+        List<Technician> result = new ArrayList<>();
+        for (Technician technician : storage.getObjects(Technician.class, new Request(
+                new Columns.All(), new Order("name")))) {
+            if (visible(owners, technician.getUserId())) {
+                result.add(technician);
+            }
+        }
+        return result;
+    }
+
+    private Technician checkTechnician(long id) throws StorageException {
+        Technician technician = installationService.technician(id);
+        if (technician == null || !visible(owners(), technician.getUserId())) {
+            throw notFound();
+        }
+        return technician;
+    }
+
+    @GET
+    @Path("technicians")
+    public List<Map<String, Object>> technicianList() throws StorageException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Technician technician : technicians()) {
+            result.add(view(technician));
+        }
+        return result;
+    }
+
+    private static void read(Technician technician, Map<String, Object> body) {
+        String name = text(body.get("name"));
+        if (name == null) {
+            throw new IllegalArgumentException("The technician needs a name");
+        }
+        technician.setName(name);
+        technician.setPhone(text(body.get("phone")));
+        technician.setEmail(text(body.get("email")));
+        technician.setColor(text(body.get("color")));
+        technician.setActive(!Boolean.FALSE.equals(body.get("active")));
+    }
+
+    @POST
+    @Path("technicians")
+    public Map<String, Object> addTechnician(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Technician technician = new Technician();
+        read(technician, body);
+        technician.setUserId(getUserId());
+        technician.setToken(InstallationService.newToken());
+        technician.setId(storage.addObject(technician, new Request(new Columns.Exclude("id"))));
+        return view(technician);
+    }
+
+    @PUT
+    @Path("technicians/{id}")
+    public Map<String, Object> updateTechnician(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Technician technician = checkTechnician(id);
+        read(technician, body);
+        if (Boolean.TRUE.equals(body.get("newToken"))) {
+            technician.setToken(InstallationService.newToken());
+        }
+        storage.updateObject(technician, new Request(
+                new Columns.Exclude("id", "userId"), new Condition.Equals("id", id)));
+        return view(technician);
+    }
+
+    @DELETE
+    @Path("technicians/{id}")
+    public Response removeTechnician(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        checkTechnician(id);
+        storage.removeObject(Technician.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    // ---------- stock ----------
+
+    private Map<String, Object> view(StockItem item, Map<Long, String> technicianNames) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", item.getId());
+        result.put("type", item.getType());
+        result.put("model", item.getModel());
+        result.put("serial", item.getSerial());
+        result.put("status", item.getStatus());
+        result.put("technicianId", item.getTechnicianId());
+        result.put("technicianName", technicianNames.get(item.getTechnicianId()));
+        result.put("deviceId", item.getDeviceId());
+        result.put("workOrderId", item.getWorkOrderId());
+        result.put("notes", item.getNotes());
+        result.put("updatedAt", item.getUpdatedAt());
+        return result;
+    }
+
+    private Map<Long, String> technicianNames() throws StorageException {
+        Map<Long, String> result = new LinkedHashMap<>();
+        for (Technician technician : technicians()) {
+            result.put(technician.getId(), technician.getName());
+        }
+        return result;
+    }
+
+    @GET
+    @Path("stock")
+    public List<Map<String, Object>> stock() throws StorageException {
+        Set<Long> owners = owners();
+        Map<Long, String> names = technicianNames();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (StockItem item : storage.getObjects(StockItem.class, new Request(
+                new Columns.All(), new Order("serial")))) {
+            if (visible(owners, item.getUserId())) {
+                result.add(view(item, names));
+            }
+        }
+        return result;
+    }
+
+    private StockItem checkItem(long id) throws StorageException {
+        StockItem item = storage.getObject(StockItem.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (item == null || !visible(owners(), item.getUserId())) {
+            throw notFound();
+        }
+        return item;
+    }
+
+    private void read(StockItem item, Map<String, Object> body) throws StorageException {
+        String serial = text(body.get("serial"));
+        if (serial == null) {
+            throw new IllegalArgumentException("The equipment needs a serial number or IMEI");
+        }
+        serial = serial.replaceAll("\\s", "");
+        StockItem existing = storage.getObject(StockItem.class, new Request(
+                new Columns.All(), new Condition.Equals("serial", serial)));
+        if (existing != null && existing.getId() != item.getId()) {
+            throw new IllegalArgumentException("Serial already registered: " + serial);
+        }
+        item.setSerial(serial);
+        String type = text(body.get("type"));
+        item.setType(type != null ? type.toLowerCase(Locale.ROOT) : "gps");
+        item.setModel(text(body.get("model")));
+        item.setNotes(text(body.get("notes")));
+        long technicianId = id(body.get("technicianId"));
+        if (technicianId > 0) {
+            checkTechnician(technicianId);
+        }
+        item.setTechnicianId(technicianId);
+        String status = text(body.get("status"));
+        if (status == null || !InstallationService.STOCK_STATUSES.contains(status)) {
+            status = technicianId > 0 ? InstallationService.TECHNICIAN : InstallationService.STOCK;
+        }
+        if (InstallationService.STOCK.equals(status) && technicianId > 0) {
+            status = InstallationService.TECHNICIAN;
+        }
+        if (InstallationService.TECHNICIAN.equals(status) && technicianId == 0) {
+            status = InstallationService.STOCK;
+        }
+        item.setStatus(status);
+        item.setUpdatedAt(new Date());
+    }
+
+    @POST
+    @Path("stock")
+    public Map<String, Object> addItem(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        StockItem item = new StockItem();
+        read(item, body);
+        item.setUserId(getUserId());
+        item.setId(storage.addObject(item, new Request(new Columns.Exclude("id"))));
+        return view(item, technicianNames());
+    }
+
+    @PUT
+    @Path("stock/{id}")
+    public Map<String, Object> updateItem(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        StockItem item = checkItem(id);
+        boolean locked = InstallationService.RESERVED.equals(item.getStatus())
+                || InstallationService.INSTALLED.equals(item.getStatus());
+        String previousStatus = item.getStatus();
+        long previousOrder = item.getWorkOrderId();
+        read(item, body);
+        if (locked && !body.containsKey("status")) {
+            item.setStatus(previousStatus);
+        }
+        item.setWorkOrderId(InstallationService.RESERVED.equals(item.getStatus()) ? previousOrder : 0);
+        storage.updateObject(item, new Request(new Columns.Exclude("id", "userId"), new Condition.Equals("id", id)));
+        return view(item, technicianNames());
+    }
+
+    @DELETE
+    @Path("stock/{id}")
+    public Response removeItem(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        checkItem(id);
+        storage.removeObject(StockItem.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    /** CSV with header: type, model, serial (or imei), notes; existing serials are skipped */
+    @POST
+    @Path("stock/import")
+    public Map<String, Object> importStock(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        String csv = text(body.get("csv"));
+        if (csv == null) {
+            throw new IllegalArgumentException("Empty CSV");
+        }
+        String[] lines = csv.replace("\r", "").split("\n");
+        String separator = lines[0].contains(";") ? ";" : ",";
+        String[] header = lines[0].toLowerCase(Locale.ROOT).split(separator, -1);
+        int created = 0;
+        List<String> errors = new ArrayList<>();
+        for (int i = 1; i < lines.length; i++) {
+            if (lines[i].isBlank()) {
+                continue;
+            }
+            String[] values = lines[i].split(separator, -1);
+            Map<String, Object> row = new LinkedHashMap<>();
+            for (int j = 0; j < header.length && j < values.length; j++) {
+                String key = header[j].trim().replaceAll("[^a-z]", "");
+                String value = values[j].trim();
+                switch (key) {
+                    case "tipo", "type" -> row.put("type", value);
+                    case "modelo", "model" -> row.put("model", value);
+                    case "serie", "serial", "imei", "numero" -> row.put("serial", value);
+                    case "notas", "notes" -> row.put("notes", value);
+                    default -> {
+                    }
+                }
+            }
+            try {
+                StockItem item = new StockItem();
+                read(item, row);
+                item.setUserId(getUserId());
+                item.setId(storage.addObject(item, new Request(new Columns.Exclude("id"))));
+                created += 1;
+            } catch (RuntimeException e) {
+                errors.add("Line " + (i + 1) + ": " + e.getMessage());
+            }
+        }
+        return Map.of("created", created, "errors", errors);
+    }
+
+    // ---------- work orders ----------
+
+    private WorkOrder checkOrder(long id) throws StorageException {
+        WorkOrder order = installationService.order(id);
+        if (order == null || !visible(owners(), order.getUserId())) {
+            throw notFound();
+        }
+        return order;
+    }
+
+    @GET
+    @Path("orders")
+    public List<Map<String, Object>> orders(
+            @QueryParam("from") String from, @QueryParam("to") String to,
+            @QueryParam("status") String status, @QueryParam("technicianId") long technicianId)
+            throws StorageException {
+        Set<Long> owners = owners();
+        Date start = from != null ? date(from) : null;
+        Date end = to != null ? date(to) : null;
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (WorkOrder order : storage.getObjects(WorkOrder.class, new Request(
+                new Columns.All(), new Order("scheduledAt")))) {
+            if (!visible(owners, order.getUserId())
+                    || status != null && !status.isEmpty() && !status.equals(order.getStatus())
+                    || technicianId > 0 && order.getTechnicianId() != technicianId) {
+                continue;
+            }
+            Date scheduled = order.getScheduledAt();
+            if (start != null && (scheduled == null || scheduled.before(start))
+                    || end != null && (scheduled == null || scheduled.after(end))) {
+                continue;
+            }
+            result.add(installationService.view(order, false));
+        }
+        return result;
+    }
+
+    @GET
+    @Path("orders/{id}")
+    public Map<String, Object> order(@PathParam("id") long id) throws StorageException {
+        return installationService.view(checkOrder(id), true);
+    }
+
+    private List<Long> ids(Object value) {
+        List<Long> result = new ArrayList<>();
+        if (value instanceof List<?> list) {
+            list.forEach(item -> {
+                if (item instanceof Number number) {
+                    result.add(number.longValue());
+                }
+            });
+        }
+        return result;
+    }
+
+    private void read(WorkOrder order, Map<String, Object> body) throws StorageException {
+        String type = text(body.get("type"));
+        order.setType(type != null && InstallationService.TYPES.contains(type) ? type : "installation");
+        long clientId = id(body.get("clientId"));
+        if (clientId > 0) {
+            if (!visible(owners(), clientId)) {
+                throw new WebApplicationException(Response.Status.FORBIDDEN);
+            }
+            User client = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", clientId)));
+            if (client == null) {
+                throw new IllegalArgumentException("Unknown client");
+            }
+            if (text(body.get("clientName")) == null) {
+                body.put("clientName", client.getName());
+            }
+        }
+        order.setClientId(clientId);
+        String clientName = text(body.get("clientName"));
+        if (clientName == null) {
+            throw new IllegalArgumentException("The order needs a client");
+        }
+        order.setClientName(clientName);
+        order.setContactName(text(body.get("contactName")));
+        order.setContactPhone(text(body.get("contactPhone")));
+        order.setAddress(text(body.get("address")));
+        order.setLatitude(body.get("latitude") instanceof Number number ? number.doubleValue() : 0);
+        order.setLongitude(body.get("longitude") instanceof Number number ? number.doubleValue() : 0);
+        long technicianId = id(body.get("technicianId"));
+        if (technicianId > 0) {
+            checkTechnician(technicianId);
+        }
+        order.setTechnicianId(technicianId);
+        order.setScheduledAt(date(body.get("scheduledAt")));
+        int duration = (int) id(body.get("duration"));
+        order.setDuration(duration > 0 ? Math.min(duration, 24 * 60) : 60);
+        String plate = text(body.get("plate"));
+        order.setPlate(plate != null ? plate.toUpperCase(Locale.ROOT) : null);
+        order.setVehicle(text(body.get("vehicle")));
+        order.setNotes(text(body.get("notes")));
+        if (body.containsKey("uniqueId")) {
+            String uniqueId = text(body.get("uniqueId"));
+            order.setUniqueId(uniqueId != null ? uniqueId.replaceAll("\\s", "") : null);
+        }
+        order.setTicketId(id(body.get("ticketId")));
+    }
+
+    @POST
+    @Path("orders")
+    public Map<String, Object> addOrder(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        WorkOrder order = new WorkOrder();
+        read(order, body);
+        order.setUserId(getUserId());
+        order.setStatus(InstallationService.SCHEDULED);
+        order.setToken(InstallationService.newToken());
+        order.setCreatedAt(new Date());
+        order.setId(storage.addObject(order, new Request(new Columns.Exclude("id"))));
+        try {
+            installationService.reserve(order, ids(body.get("itemIds")), owners());
+        } catch (RuntimeException e) {
+            installationService.release(order);
+            storage.removeObject(WorkOrder.class, new Request(new Condition.Equals("id", order.getId())));
+            throw e;
+        }
+        return installationService.view(order, true);
+    }
+
+    @PUT
+    @Path("orders/{id}")
+    public Map<String, Object> updateOrder(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        WorkOrder order = checkOrder(id);
+        if (InstallationService.COMPLETED.equals(order.getStatus())) {
+            throw new IllegalArgumentException("A completed order cannot be changed");
+        }
+        read(order, body);
+        String status = text(body.get("status"));
+        if (InstallationService.CANCELLED.equals(status) || InstallationService.SCHEDULED.equals(status)) {
+            order.setStatus(status);
+        }
+        if (InstallationService.CANCELLED.equals(order.getStatus())) {
+            installationService.discardDevice(order);
+        }
+        storage.updateObject(order, new Request(new Columns.Exclude("id", "userId", "token", "createdAt"),
+                new Condition.Equals("id", id)));
+        if (InstallationService.CANCELLED.equals(order.getStatus())) {
+            installationService.release(order);
+        } else if (body.containsKey("itemIds")) {
+            installationService.reserve(order, ids(body.get("itemIds")), owners());
+        }
+        return installationService.view(order, true);
+    }
+
+    @DELETE
+    @Path("orders/{id}")
+    public Response removeOrder(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        WorkOrder order = checkOrder(id);
+        if (InstallationService.COMPLETED.equals(order.getStatus()) && permissionsService.notAdmin(getUserId())) {
+            throw new IllegalArgumentException("A completed order is part of the history");
+        }
+        if (!InstallationService.COMPLETED.equals(order.getStatus())) {
+            installationService.release(order);
+            installationService.discardDevice(order);
+        }
+        installationService.removePhotos(order);
+        storage.removeObject(WorkOrder.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    @GET
+    @Path("orders/{id}/photos/{photoId}")
+    @Produces({"image/jpeg", "image/png", "image/webp"})
+    public Response photo(@PathParam("id") long id, @PathParam("photoId") long photoId) throws Exception {
+        WorkOrder order = checkOrder(id);
+        WorkOrderPhoto photo = installationService.photo(order, photoId);
+        if (photo == null) {
+            throw notFound();
+        }
+        return Response.ok(installationService.read(photo), InstallationService.mime(photo)).build();
+    }
+
+    /** counts for the dashboard: orders by status today and this week, equipment by status */
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary() throws StorageException {
+        Set<Long> owners = owners();
+        Map<String, Integer> orders = new LinkedHashMap<>();
+        InstallationService.STATUSES.forEach(status -> orders.put(status, 0));
+        int today = 0;
+        java.time.LocalDate now = java.time.LocalDate.now();
+        for (WorkOrder order : storage.getObjects(WorkOrder.class, new Request(new Columns.All()))) {
+            if (!visible(owners, order.getUserId())) {
+                continue;
+            }
+            orders.merge(order.getStatus(), 1, Integer::sum);
+            if (order.getScheduledAt() != null && order.getScheduledAt().toInstant()
+                    .atZone(java.time.ZoneId.systemDefault()).toLocalDate().equals(now)) {
+                today += 1;
+            }
+        }
+        Map<String, Integer> stock = new LinkedHashMap<>();
+        InstallationService.STOCK_STATUSES.forEach(status -> stock.put(status, 0));
+        for (StockItem item : storage.getObjects(StockItem.class, new Request(new Columns.All()))) {
+            if (visible(owners, item.getUserId())) {
+                stock.merge(item.getStatus(), 1, Integer::sum);
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("orders", orders);
+        result.put("today", today);
+        result.put("stock", stock);
+        return result;
+    }
+
+}
