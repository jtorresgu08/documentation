+package org.traccar.api.resource;
+
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.model.ManagedUser;
+import org.traccar.model.Permission;
+import org.traccar.model.User;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+@Path("hierarchy")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class HierarchyResource extends BaseResource {
+
+    public static final String BRAND_PREFIX = "brand.";
+    public static final String BRAND_DOMAINS = "brandDomains";
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    /**
+     * Direct manager of every user visible to the caller, as {@code userId -> managerId}.
+     */
+    @GET
+    @Path("parents")
+    public Map<Long, Long> parents() throws StorageException {
+        Map<Long, Set<Long>> owners = new HashMap<>();
+        for (Permission permission : storage.getPermissions(User.class, ManagedUser.class)) {
+            owners.computeIfAbsent(permission.getPropertyId(), key -> new HashSet<>()).add(permission.getOwnerId());
+        }
+        Set<Long> visible = null;
+        if (permissionsService.notAdmin(getUserId())) {
+            visible = hierarchyService.getDescendants(getUserId());
+        }
+        Map<Long, Long> result = new LinkedHashMap<>();
+        for (var entry : owners.entrySet()) {
+            if (visible != null && !visible.contains(entry.getKey())) {
+                continue;
+            }
+            // every ancestor holds a materialized link, the closest one is the ancestor with most ancestors itself
+            long parent = 0;
+            int parentDepth = -1;
+            for (long owner : entry.getValue()) {
+                int depth = owners.getOrDefault(owner, Set.of()).size();
+                if (depth > parentDepth) {
+                    parent = owner;
+                    parentDepth = depth;
+                }
+            }
+            result.put(entry.getKey(), parent);
+        }
+        return result;
+    }
+
+    @POST
+    @Path("sync")
+    public Response synchronize() throws Exception {
+        permissionsService.checkAdmin(getUserId());
+        hierarchyService.synchronize();
+        return Response.noContent().build();
+    }
+
+    private Map<String, Object> brandAttributes(long userId) throws StorageException {
+        User user = storage.getObject(User.class, new Request(
+                new Columns.All(), new Condition.Equals("id", userId)));
+        Map<String, Object> result = new HashMap<>();
+        if (user != null) {
+            for (var entry : user.getAttributes().entrySet()) {
+                if (entry.getKey().startsWith(BRAND_PREFIX) && entry.getValue() != null
+                        && !entry.getValue().toString().isEmpty()) {
+                    result.put(entry.getKey().substring(BRAND_PREFIX.length()), entry.getValue());
+                }
+            }
+        }
+        return result;
+    }
+
+    private long findDomainOwner(String host) throws StorageException {
+        String domains = permissionsService.getServer().getString(BRAND_DOMAINS);
+        if (host != null && domains != null) {
+            for (String item : domains.split("[,;\\s]+")) {
+                String[] pair = item.split("=");
+                if (pair.length == 2 && pair[0].trim().equalsIgnoreCase(host.trim())) {
+                    try {
+                        return Long.parseLong(pair[1].trim());
+                    } catch (NumberFormatException ignored) {
+                        return 0;
+                    }
+                }
+            }
+        }
+        return 0;
+    }
+
+    /**
+     * White label settings: attributes prefixed with {@code brand.} on the user and its managers, the closest
+     * manager winning. Before login the brand is resolved from the domain using the {@code brandDomains} server
+     * attribute ({@code host=userId} pairs), which only the administrator can change.
+     */
+    @GET
+    @Path("brand")
+    @PermitAll
+    public Map<String, Object> brand(@QueryParam("host") String host) throws StorageException {
+        long userId = getUserId() > 0 ? getUserId() : findDomainOwner(host);
+        Map<String, Object> result = new LinkedHashMap<>();
+        if (userId > 0) {
+            List<Long> chain = new ArrayList<>(hierarchyService.getAncestorChain(userId));
+            chain.add(0, userId);
+            for (int i = chain.size() - 1; i >= 0; i--) {
+                result.putAll(brandAttributes(chain.get(i)));
+            }
+        }
+        return result;
+    }
+
+}
