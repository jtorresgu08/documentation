+    private static boolean withinLimit(int ownLimit, int requestedLimit) {
+        return ownLimit == -1 || (requestedLimit != -1 && requestedLimit <= ownLimit);
+    }
+
+    /**
+     * Managers can create sub-managers, as long as the limits they grant do not exceed their own.
+     */
+    private void checkLimitsUpdate(User user, User after) throws StorageException, SecurityException {
+        if (user != null && user.getAdministrator()) {
+            return;
+        }
+        if (user == null || !user.getManager() || user.getId() == after.getId()) {
+            throw new SecurityException("Administrator access required");
+        }
+        if (after.getId() > 0) {
+            checkUser(user.getId(), after.getId());
+        }
+        if (!withinLimit(user.getUserLimit(), after.getUserLimit())
+                || !withinLimit(user.getDeviceLimit(), after.getDeviceLimit())) {
+            throw new SecurityException("Limit exceeds manager limit");
+        }
+    }
