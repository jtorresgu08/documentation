+ * limitations under the License.
+ */
+package org.traccar.api.security;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.model.Attribute;
+import org.traccar.model.BaseModel;
+import org.traccar.model.Calendar;
+import org.traccar.model.Command;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+import org.traccar.model.Geofence;
+import org.traccar.model.Group;
+import org.traccar.model.Maintenance;
+import org.traccar.model.ManagedUser;
+import org.traccar.model.Notification;
+import org.traccar.model.Order;
+import org.traccar.model.Permission;
+import org.traccar.model.Report;
+import org.traccar.model.User;
+import org.traccar.session.ConnectionManager;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+
+import java.util.ArrayDeque;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Multi-level manager hierarchy.
+ * <p>
+ * Stock Traccar only gives a manager access to the users it manages directly and to the objects linked to
+ * itself. This service materializes the hierarchy: every permission a user gets is also granted to all of its
+ * ancestor managers, so a manager sees everything from itself downwards while the administrator sees everything.
+ * Because the permissions are real rows, queries, cache, live updates and notifications work unchanged.
+ */
+@Singleton
+public class HierarchyService {
+
+    public static final List<Class<? extends BaseModel>> CLASSES = List.of(
+            ManagedUser.class, Device.class, Group.class, Geofence.class, Notification.class, Driver.class,
+            Attribute.class, Calendar.class, Command.class, Maintenance.class, Order.class, Report.class);
+
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final ConnectionManager connectionManager;
+
+    @Inject
+    public HierarchyService(Storage storage, CacheManager cacheManager, ConnectionManager connectionManager) {
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.connectionManager = connectionManager;
+    }
+
+    private Set<Long> traverse(long userId, boolean up) throws StorageException {
+        Set<Long> result = new LinkedHashSet<>();
+        var queue = new ArrayDeque<Long>();
+        queue.add(userId);
+        while (!queue.isEmpty()) {
+            long current = queue.poll();
+            var permissions = up
+                    ? storage.getPermissions(User.class, 0, ManagedUser.class, current)
+                    : storage.getPermissions(User.class, current, ManagedUser.class, 0);
+            for (Permission permission : permissions) {
+                long next = up ? permission.getOwnerId() : permission.getPropertyId();
+                if (next != userId && result.add(next)) {
+                    queue.add(next);
+                }
+            }
+        }
+        return result;
+    }
+
+    public Set<Long> getAncestors(long userId) throws StorageException {
+        return traverse(userId, true);
+    }
+
+    public Set<Long> getDescendants(long userId) throws StorageException {
+        return traverse(userId, false);
+    }
+
+    /**
+     * Ancestors ordered from the closest manager to the top of the tree.
+     */
+    public List<Long> getAncestorChain(long userId) throws StorageException {
+        Map<Long, Integer> depth = new HashMap<>();
+        for (long ancestorId : getAncestors(userId)) {
+            depth.put(ancestorId, getAncestors(ancestorId).size());
+        }
+        return depth.keySet().stream()
+                .sorted(Comparator.comparing(depth::get).reversed())
+                .toList();
+    }
+
+    public void checkCycle(long ownerId, long managedUserId) throws StorageException {
+        if (ownerId == managedUserId || getAncestors(ownerId).contains(managedUserId)) {
+            throw new IllegalArgumentException("Cycle in user hierarchy");
+        }
+    }
+
+    private void link(long userId, Class<? extends BaseModel> clazz, long propertyId) throws Exception {
+        if (clazz.equals(ManagedUser.class) && userId == propertyId) {
+            return;
+        }
+        if (storage.getPermissions(User.class, userId, clazz, propertyId).isEmpty()) {
+            storage.addPermission(new Permission(User.class, userId, clazz, propertyId));
+            cacheManager.invalidatePermission(true, User.class, userId, clazz, propertyId, true);
+            connectionManager.invalidatePermission(true, User.class, userId, clazz, propertyId, true);
+        }
+    }
+
+    /**
+     * Call after a permission {@code ownerId -> propertyId} has been stored.
+     */
+    public void propagate(long ownerId, Class<? extends BaseModel> clazz, long propertyId) throws Exception {
+        if (!CLASSES.contains(clazz)) {
+            return;
+        }
+        Set<Long> ancestors = getAncestors(ownerId);
+        for (long ancestorId : ancestors) {
+            link(ancestorId, clazz, propertyId);
+        }
+        if (clazz.equals(ManagedUser.class)) {
+            // a whole subtree was attached: everyone above it inherits users and objects below it
+            Set<Long> owners = new LinkedHashSet<>(ancestors);
+            owners.add(ownerId);
+            Set<Long> subtree = new LinkedHashSet<>(getDescendants(propertyId));
+            subtree.add(propertyId);
+            for (long userId : subtree) {
+                for (long owner : owners) {
+                    link(owner, ManagedUser.class, userId);
+                }
+                for (var objectClass : CLASSES) {
+                    if (objectClass.equals(ManagedUser.class)) {
+                        continue;
+                    }
+                    for (Permission permission : storage.getPermissions(User.class, userId, objectClass, 0)) {
+                        for (long owner : owners) {
+                            link(owner, objectClass, permission.getPropertyId());
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /**
+     * Rebuilds inherited permissions for existing data, e.g. after importing users.
+     */
+    public void synchronize() throws Exception {
+        for (Permission permission : storage.getPermissions(User.class, ManagedUser.class)) {
+            propagate(permission.getOwnerId(), ManagedUser.class, permission.getPropertyId());
+        }
+    }
+
+}
