+package org.traccar.api.resource;
+
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.driving.DrivingScore;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+import org.traccar.model.Position;
+import org.traccar.model.Server;
+import org.traccar.model.UserRestrictions;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Driving score ranking per unit and per driver (when the units identify the driver) for a period.
+ */
+@Path("driving")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class DrivingResource extends BaseResource {
+
+    private static final long MAX_PERIOD = 31L * 24 * 3600 * 1000;
+    private static final double DEFAULT_SPEED_LIMIT = 90;
+
+    private static Map<String, Object> summary(DrivingScore.Result result, boolean details) {
+        Map<String, Object> item = new LinkedHashMap<>();
+        item.put("score", result.getScore());
+        item.put("rating", result.getRating());
+        item.put("distance", Math.round(result.getDistance() * 10) / 10.0);
+        item.put("drivingTime", result.getDrivingTime());
+        item.put("speedingTime", result.getSpeedingTime());
+        item.put("maxSpeed", Math.round(result.getMaxSpeed()));
+        item.put("counts", result.getCounts());
+        if (details) {
+            item.put("incidents", result.getIncidents());
+        }
+        return item;
+    }
+
+    private double speedLimit(Device device, Server server) {
+        if (device.hasAttribute(Position.KEY_SPEED_LIMIT)) {
+            return UnitsConverter.kphFromKnots(device.getDouble(Position.KEY_SPEED_LIMIT));
+        }
+        return server.hasAttribute("driving.speedLimit")
+                ? server.getDouble("driving.speedLimit") : DEFAULT_SPEED_LIMIT;
+    }
+
+    // units or drivers that did not drive in the period are left out instead of ranking as a perfect 100
+    private static boolean idle(DrivingScore.Result result) {
+        return result.getDrivingTime() == 0 && result.getIncidents().isEmpty();
+    }
+
+    @GET
+    @Path("score")
+    public Map<String, Object> score(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to,
+            @QueryParam("details") boolean details) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getDisableReports);
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+        Server server = permissionsService.getServer();
+        List<Map<String, Object>> devices = new ArrayList<>();
+        Map<String, DrivingScore.Result> drivers = new LinkedHashMap<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            List<Position> positions = PositionUtil.getPositions(storage, device.getId(), from, to);
+            double limit = speedLimit(device, server);
+            DrivingScore.Result result = DrivingScore.compute(positions, limit);
+            if (!idle(result)) {
+                Map<String, Object> item = summary(result, details);
+                item.put("deviceId", device.getId());
+                item.put("name", device.getName());
+                devices.add(item);
+            }
+
+            // per driver: split the positions where the identified driver changes
+            List<Position> segment = new ArrayList<>();
+            String current = null;
+            for (Position position : positions) {
+                String driver = position.getString(Position.KEY_DRIVER_UNIQUE_ID);
+                if (segment.isEmpty() || Objects.equals(driver, current)) {
+                    segment.add(position);
+                } else {
+                    if (current != null) {
+                        drivers.computeIfAbsent(current, key -> DrivingScore.compute(List.of(), 0))
+                                .merge(DrivingScore.compute(segment, limit));
+                    }
+                    segment = new ArrayList<>(List.of(position));
+                }
+                current = driver;
+            }
+            if (current != null && !segment.isEmpty()) {
+                drivers.computeIfAbsent(current, key -> DrivingScore.compute(List.of(), 0))
+                        .merge(DrivingScore.compute(segment, limit));
+            }
+        }
+        devices.sort((a, b) -> Double.compare((Double) b.get("score"), (Double) a.get("score")));
+
+        List<Map<String, Object>> driverItems = new ArrayList<>();
+        for (var entry : drivers.entrySet()) {
+            if (idle(entry.getValue())) {
+                continue;
+            }
+            Driver driver = storage.getObject(Driver.class, new Request(
+                    new Columns.All(), new Condition.Equals("uniqueId", entry.getKey())));
+            Map<String, Object> item = summary(entry.getValue(), false);
+            item.put("driverUniqueId", entry.getKey());
+            item.put("name", driver != null ? driver.getName() : entry.getKey());
+            driverItems.add(item);
+        }
+        driverItems.sort((a, b) -> Double.compare((Double) b.get("score"), (Double) a.get("score")));
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("devices", devices);
+        result.put("drivers", driverItems);
+        return result;
+    }
+
+}
