+package org.traccar.driving;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class DrivingScoreTest {
+
+    private final List<Position> positions = new ArrayList<>();
+    private long time = 1_700_000_000_000L;
+    private double total;
+    private double latitude = -12;
+
+    private void add(double speed, double course, String alarm) {
+        Position position = new Position();
+        time += 1000;
+        double meters = speed / 3.6;
+        total += meters;
+        position.setTime(new Date(time));
+        position.setSpeed(UnitsConverter.knotsFromKph(speed));
+        position.setCourse(course);
+        latitude += meters / 111320;
+        position.setLatitude(latitude);
+        position.setLongitude(-77);
+        position.set(Position.KEY_DISTANCE, meters);
+        position.set(Position.KEY_TOTAL_DISTANCE, total);
+        if (alarm != null) {
+            position.set(Position.KEY_ALARM, alarm);
+        }
+        positions.add(position);
+    }
+
+    @Test
+    public void testGpsDerivedEventsAndSpeeding() {
+        for (int i = 0; i < 20; i++) {
+            add(50, 0, null);
+        }
+        add(70, 0, null); // +20 km/h in 1 s = 5.6 m/s²
+        for (int i = 0; i < 20; i++) {
+            add(70, 0, null);
+        }
+        add(50, 0, null); // -20 km/h in 1 s
+        for (int i = 0; i < 40; i++) {
+            add(100, 0, null); // 40 s above 90 km/h
+        }
+        for (int i = 0; i < 20; i++) {
+            add(60, 0, null);
+        }
+        var result = DrivingScore.compute(positions, 90);
+        // 50 -> 100 comes 1 s after the braking, inside the 10 s refractory window
+        assertEquals(1, result.getCounts().get(DrivingScore.ACCELERATION));
+        assertEquals(2, result.getCounts().get(DrivingScore.BRAKING)); // 70 -> 50 and 100 -> 60
+        assertEquals(1, result.getCounts().get(DrivingScore.SPEEDING));
+        assertTrue(result.getSpeedingTime() >= 39000);
+        assertTrue(result.getScore() < 100);
+    }
+
+    @Test
+    public void testDeviceAlarmsTakePrecedence() {
+        for (int i = 0; i < 10; i++) {
+            add(50, 0, null);
+        }
+        add(20, 0, Position.ALARM_BRAKING);
+        add(20, 0, Position.ALARM_BRAKING); // same alarm still active, counted once
+        add(80, 0, null); // big jump, but the device reports harsh events itself
+        add(80, 0, "phoneCall,laneDeparture");
+        var result = DrivingScore.compute(positions, 0);
+        assertEquals(1, result.getCounts().get(DrivingScore.BRAKING));
+        assertEquals(0, result.getCounts().get(DrivingScore.ACCELERATION));
+        assertEquals(1, result.getCounts().get(DrivingScore.DMS));
+        assertEquals(1, result.getCounts().get(DrivingScore.ADAS));
+    }
+
+    @Test
+    public void testSpeedingAroundLimitIsOneEpisode() {
+        for (int k = 0; k < 6; k++) {
+            for (int i = 0; i < 15; i++) {
+                add(96, 0, null);
+            }
+            for (int i = 0; i < 10; i++) {
+                add(88, 0, null); // short dips under the limit continue the same episode
+            }
+        }
+        for (int i = 0; i < 40; i++) {
+            add(70, 0, null);
+        }
+        var result = DrivingScore.compute(positions, 90);
+        assertEquals(1, result.getCounts().get(DrivingScore.SPEEDING));
+    }
+
+    @Test
+    public void testGpsJumpIgnoredInDistance() {
+        for (int i = 0; i < 600; i++) {
+            add(60, 0, null);
+        }
+        latitude += 1; // 111 km jump in one second
+        add(60, 0, null);
+        var result = DrivingScore.compute(positions, 90);
+        assertEquals(10, result.getDistance(), 0.1);
+    }
+
+    @Test
+    public void testCleanDrive() {
+        for (int i = 0; i < 600; i++) {
+            add(60, 0, null);
+        }
+        var result = DrivingScore.compute(positions, 90);
+        assertEquals(100, result.getScore());
+        assertEquals("excellent", result.getRating());
+        assertEquals(10, result.getDistance(), 0.1);
+    }
+
+}
