+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.NotFoundException;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Expense;
+import org.traccar.model.Group;
+import org.traccar.model.Maintenance;
+import org.traccar.model.Permission;
+import org.traccar.model.Position;
+import org.traccar.model.UserRestrictions;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Unit expenses (fuel, tolls, workshop...) with the cost summary per unit and the upcoming maintenance services.
+ * Access follows the unit: whoever sees a unit sees its expenses; read-only users cannot change them.
+ */
+@Path("expenses")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class ExpenseResource extends BaseResource {
+
+    private static final long MAX_PERIOD = 400L * 24 * 3600 * 1000;
+
+    private Collection<Device> devices(List<Long> deviceIds, List<Long> groupIds) throws StorageException {
+        return DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds);
+    }
+
+    private static void checkPeriod(Date from, Date to) {
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+    }
+
+    private List<Expense> expenses(long deviceId, Date from, Date to) throws StorageException {
+        return storage.getObjects(Expense.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("deviceId", deviceId),
+                        new Condition.Between("expenseTime", from, to)),
+                new Order("expenseTime", true, 0)));
+    }
+
+    private Expense find(long id) throws StorageException {
+        Expense expense = storage.getObject(Expense.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (expense == null) {
+            throw new NotFoundException();
+        }
+        permissionsService.checkPermission(Device.class, getUserId(), expense.getDeviceId());
+        return expense;
+    }
+
+    private void validate(Expense expense) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        permissionsService.checkPermission(Device.class, getUserId(), expense.getDeviceId());
+        if (expense.getType() == null || expense.getType().isBlank() || expense.getExpenseTime() == null
+                || expense.getAmount() < 0) {
+            throw new BadRequestException("Invalid expense");
+        }
+    }
+
+    @GET
+    public List<Expense> get(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        checkPeriod(from, to);
+        List<Expense> result = new ArrayList<>();
+        for (Device device : devices(deviceIds, groupIds)) {
+            result.addAll(expenses(device.getId(), from, to));
+        }
+        result.sort((a, b) -> b.getExpenseTime().compareTo(a.getExpenseTime()));
+        return result;
+    }
+
+    @POST
+    public Expense add(Expense expense) throws StorageException {
+        validate(expense);
+        expense.setUserId(getUserId());
+        expense.setId(storage.addObject(expense, new Request(new Columns.Exclude("id"))));
+        return expense;
+    }
+
+    @PUT
+    @Path("{id}")
+    public Expense update(@PathParam("id") long id, Expense expense) throws StorageException {
+        Expense existing = find(id);
+        validate(expense);
+        expense.setId(existing.getId());
+        expense.setUserId(existing.getUserId());
+        storage.updateObject(expense, new Request(
+                new Columns.Exclude("id"), new Condition.Equals("id", id)));
+        return expense;
+    }
+
+    @DELETE
+    @Path("{id}")
+    public Response remove(@PathParam("id") long id) throws StorageException {
+        find(id);
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        storage.removeObject(Expense.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        checkPeriod(from, to);
+        SimpleDateFormat month = new SimpleDateFormat("yyyy-MM");
+        Map<String, Double> byType = new TreeMap<>();
+        Map<String, Map<String, Double>> byMonth = new TreeMap<>();
+        List<Map<String, Object>> units = new ArrayList<>();
+        double total = 0;
+        double distance = 0;
+        double fuelLitres = 0;
+        double fuelCost = 0;
+        for (Device device : devices(deviceIds, groupIds)) {
+            Map<String, Double> unitByType = new TreeMap<>();
+            double unitTotal = 0;
+            for (Expense expense : expenses(device.getId(), from, to)) {
+                unitByType.merge(expense.getType(), expense.getAmount(), Double::sum);
+                byType.merge(expense.getType(), expense.getAmount(), Double::sum);
+                byMonth.computeIfAbsent(month.format(expense.getExpenseTime()), key -> new TreeMap<>())
+                        .merge(expense.getType(), expense.getAmount(), Double::sum);
+                unitTotal += expense.getAmount();
+                if ("fuel".equals(expense.getType())) {
+                    fuelLitres += expense.getQuantity();
+                    fuelCost += expense.getAmount();
+                }
+            }
+            Position first = PositionUtil.getEdgePosition(storage, device.getId(), from, to, false);
+            Position last = PositionUtil.getEdgePosition(storage, device.getId(), from, to, true);
+            double unitDistance = first != null && last != null
+                    ? Math.max(0, last.getDouble(Position.KEY_TOTAL_DISTANCE)
+                            - first.getDouble(Position.KEY_TOTAL_DISTANCE)) / 1000 : 0;
+            total += unitTotal;
+            distance += unitDistance;
+            if (unitTotal > 0 || unitDistance > 0) {
+                Map<String, Object> unit = new LinkedHashMap<>();
+                unit.put("deviceId", device.getId());
+                unit.put("name", device.getName());
+                unit.put("total", unitTotal);
+                unit.put("distance", Math.round(unitDistance * 10) / 10.0);
+                unit.put("costPerKm", unitDistance > 0 ? unitTotal / unitDistance : null);
+                unit.put("byType", unitByType);
+                units.add(unit);
+            }
+        }
+        units.sort((a, b) -> Double.compare((Double) b.get("total"), (Double) a.get("total")));
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("total", total);
+        result.put("distance", Math.round(distance * 10) / 10.0);
+        result.put("costPerKm", distance > 0 ? total / distance : null);
+        result.put("fuelLitres", fuelLitres);
+        result.put("fuelPricePerLitre", fuelLitres > 0 ? fuelCost / fuelLitres : null);
+        result.put("byType", byType);
+        result.put("byMonth", byMonth);
+        result.put("units", units);
+        return result;
+    }
+
+    static double currentValue(Maintenance maintenance, Position position) {
+        String type = maintenance.getType();
+        if (type.endsWith("Time")) {
+            return switch (type) {
+                case "serverTime" -> position.getServerTime().getTime();
+                case "deviceTime" -> position.getDeviceTime().getTime();
+                default -> position.getFixTime().getTime();
+            };
+        }
+        return position.getDouble(type);
+    }
+
+    static double nextDue(double start, double period, double current) {
+        if (current < start || period <= 0) {
+            return start;
+        }
+        return start + period * (Math.floor((current - start) / period) + 1);
+    }
+
+    // maintenance linked to the unit or inherited from its group and parent groups
+    private Collection<Maintenance> maintenances(Device device) throws StorageException {
+        Map<Long, Maintenance> result = new LinkedHashMap<>();
+        for (Maintenance maintenance : storage.getObjects(Maintenance.class, new Request(
+                new Columns.All(), new Condition.Permission(Device.class, device.getId(), Maintenance.class)))) {
+            result.put(maintenance.getId(), maintenance);
+        }
+        Set<Long> visited = new HashSet<>();
+        long groupId = device.getGroupId();
+        while (groupId > 0 && visited.add(groupId)) {
+            for (Permission permission : storage.getPermissions(Group.class, groupId, Maintenance.class, 0)) {
+                if (!result.containsKey(permission.getPropertyId())) {
+                    Maintenance maintenance = storage.getObject(Maintenance.class, new Request(
+                            new Columns.All(), new Condition.Equals("id", permission.getPropertyId())));
+                    if (maintenance != null) {
+                        result.put(maintenance.getId(), maintenance);
+                    }
+                }
+            }
+            Group group = storage.getObject(Group.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", groupId)));
+            groupId = group != null ? group.getGroupId() : 0;
+        }
+        return result.values();
+    }
+
+    @GET
+    @Path("maintenance")
+    public List<Map<String, Object>> maintenance(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds)
+            throws StorageException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : devices(deviceIds, groupIds)) {
+            Position position = device.getPositionId() > 0 ? storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", device.getPositionId()))) : null;
+            if (position == null) {
+                continue;
+            }
+            for (Maintenance maintenance : maintenances(device)) {
+                double current = currentValue(maintenance, position);
+                double next = nextDue(maintenance.getStart(), maintenance.getPeriod(), current);
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("deviceId", device.getId());
+                item.put("deviceName", device.getName());
+                item.put("maintenanceId", maintenance.getId());
+                item.put("name", maintenance.getName());
+                item.put("type", maintenance.getType());
+                item.put("period", maintenance.getPeriod());
+                item.put("current", current);
+                item.put("next", next);
+                item.put("remaining", next - current);
+                result.add(item);
+            }
+        }
+        result.sort((a, b) -> Double.compare(
+                (Double) a.get("remaining") / Math.max(1, (Double) a.get("period")),
+                (Double) b.get("remaining") / Math.max(1, (Double) b.get("period"))));
+        return result;
+    }
+
+}
