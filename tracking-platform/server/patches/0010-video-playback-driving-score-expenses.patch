+import org.traccar.model.Device;
+import org.traccar.protocol.HuabaoProtocol;
+import org.traccar.protocol.VideoRecordings;
+import org.traccar.session.ConnectionManager;
+import org.traccar.session.DeviceSession;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+
+/**
+ * Recordings stored on a JT/T 1078 MDVR: asks the connected device for its resource list and waits for the answer.
+ * Playback itself is started with the videoPlayback / videoPlaybackControl commands.
+ */
+@Path("video")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class VideoResource extends BaseResource {
+
+    private static final long TIMEOUT = 20;
+
+    @Inject
+    private CommandsManager commandsManager;
+
+    @Inject
+    private ConnectionManager connectionManager;
+
+    @GET
+    @Path("recordings")
+    public Response recordings(
+            @QueryParam("deviceId") long deviceId, @QueryParam("channel") int channel,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws Exception {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        DeviceSession session = connectionManager.getDeviceSession(deviceId);
+        if (session == null || !session.supportsLiveCommands()) {
+            return Response.status(Response.Status.CONFLICT).entity(Map.of("error", "offline")).build();
+        }
+        CompletableFuture<List<VideoRecordings.Recording>> future = VideoRecordings.expect(deviceId);
+        Command command = new Command();
+        command.setDeviceId(deviceId);
+        command.setType(HuabaoProtocol.TYPE_VIDEO_RECORDINGS);
+        command.set(Command.KEY_INDEX, Math.max(0, channel));
+        command.set("from", from != null ? from.getTime() : 0);
+        command.set("to", to != null ? to.getTime() : 0);
+        command.set(Command.KEY_NO_QUEUE, true);
+        try {
+            commandsManager.sendCommand(command);
+            return Response.ok(future.get(TIMEOUT, TimeUnit.SECONDS)).build();
+        } catch (TimeoutException e) {
+            return Response.status(Response.Status.GATEWAY_TIMEOUT).entity(Map.of("error", "timeout")).build();
+        } finally {
+            VideoRecordings.cancel(deviceId, future);
+        }
+    }
+
+}
