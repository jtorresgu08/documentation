+package org.traccar.protocol;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Pending JT/T 1078 recording queries: the API waits on a future that the decoder completes when the MDVR answers
+ * with its resource list (0x1205).
+ */
+public final class VideoRecordings {
+
+    public record Recording(
+            int channel, long start, long end, long alarm, int mediaType, int streamType, int storageType, long size) {
+    }
+
+    private static final Map<Long, CompletableFuture<List<Recording>>> PENDING = new ConcurrentHashMap<>();
+
+    private VideoRecordings() {
+    }
+
+    public static CompletableFuture<List<Recording>> expect(long deviceId) {
+        CompletableFuture<List<Recording>> future = new CompletableFuture<>();
+        PENDING.put(deviceId, future);
+        return future;
+    }
+
+    public static void cancel(long deviceId, CompletableFuture<List<Recording>> future) {
+        PENDING.remove(deviceId, future);
+    }
+
+    static void complete(long deviceId, List<Recording> recordings) {
+        CompletableFuture<List<Recording>> future = PENDING.remove(deviceId);
+        if (future != null) {
+            future.complete(recordings);
+        }
+    }
+
+}
