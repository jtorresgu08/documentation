+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.driving;
+
+import org.traccar.helper.DistanceCalculator;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Driving behaviour score of a set of positions. Counts harsh braking, acceleration and cornering (device alarms, or
+ * derived from GPS speed and course changes when the device reports none), sustained speeding above the limit and
+ * camera ADAS / DMS alarms, then scores 0-100 from the penalties per 100 km.
+ */
+public final class DrivingScore {
+
+    public static final String BRAKING = "braking";
+    public static final String ACCELERATION = "acceleration";
+    public static final String CORNERING = "cornering";
+    public static final String SPEEDING = "speeding";
+    public static final String ADAS = "adas";
+    public static final String DMS = "dms";
+
+    static final Map<String, Double> WEIGHTS = Map.of(
+            BRAKING, 2.5, ACCELERATION, 2.0, CORNERING, 2.0, SPEEDING, 3.0, ADAS, 2.0, DMS, 4.0);
+
+    static final double HARSH_ACCELERATION = 3.0; // m/s²
+    static final double HARSH_BRAKING = -3.5; // m/s²
+    static final double HARSH_CORNERING = 3.0; // m/s² lateral
+    static final long MAX_SAMPLE_GAP = 5000;
+    static final long REFRACTORY = 10000;
+    static final long MIN_SPEEDING = 20000;
+    static final long SPEEDING_MERGE = 30000; // dips under the limit shorter than this continue the same episode
+    static final double MAX_SEGMENT_SPEED = 300; // km/h, longer jumps between fixes are GPS errors
+    static final double MIN_DISTANCE = 10; // km, avoids huge rates on very short trips
+
+    private static final Set<String> ADAS_ALARMS = Set.of(
+            "forwardCollision", "laneDeparture", "vehicleDistance", "pedestrianCollision", "frequentLaneChange",
+            "roadSignOverLimit", Position.ALARM_LANE_CHANGE);
+    private static final Set<String> DMS_ALARMS = Set.of(
+            Position.ALARM_FATIGUE_DRIVING, "phoneCall", "smoking", "distraction", "driverAbnormal");
+
+    private DrivingScore() {
+    }
+
+    public record Incident(String type, String detail, long time, double speed, double latitude, double longitude) {
+    }
+
+    public static final class Result {
+        private final Map<String, Integer> counts = new LinkedHashMap<>();
+        private final List<Incident> incidents = new ArrayList<>();
+        private double distance;
+        private long drivingTime;
+        private long speedingTime;
+        private double maxSpeed;
+
+        Result() {
+            for (String type : List.of(BRAKING, ACCELERATION, CORNERING, SPEEDING, ADAS, DMS)) {
+                counts.put(type, 0);
+            }
+        }
+
+        void add(Incident incident) {
+            counts.merge(incident.type(), 1, Integer::sum);
+            incidents.add(incident);
+        }
+
+        public Map<String, Integer> getCounts() {
+            return counts;
+        }
+
+        public List<Incident> getIncidents() {
+            return incidents;
+        }
+
+        public double getDistance() {
+            return distance;
+        }
+
+        public long getDrivingTime() {
+            return drivingTime;
+        }
+
+        public long getSpeedingTime() {
+            return speedingTime;
+        }
+
+        public double getMaxSpeed() {
+            return maxSpeed;
+        }
+
+        public void merge(Result other) {
+            other.counts.forEach((key, value) -> counts.merge(key, value, Integer::sum));
+            incidents.addAll(other.incidents);
+            distance += other.distance;
+            drivingTime += other.drivingTime;
+            speedingTime += other.speedingTime;
+            maxSpeed = Math.max(maxSpeed, other.maxSpeed);
+        }
+
+        public double getScore() {
+            double rate = 100 / Math.max(distance, MIN_DISTANCE);
+            double penalty = counts.entrySet().stream()
+                    .mapToDouble(entry -> WEIGHTS.get(entry.getKey()) * entry.getValue() * rate).sum();
+            return distance > 0 || penalty > 0 ? Math.max(0, Math.round((100 - penalty) * 10) / 10.0) : 100;
+        }
+
+        public String getRating() {
+            double score = getScore();
+            return score >= 90 ? "excellent" : score >= 75 ? "good" : score >= 60 ? "regular" : "risky";
+        }
+    }
+
+    private static Incident incident(String type, String detail, Position position) {
+        return new Incident(type, detail, position.getFixTime().getTime(),
+                Math.round(UnitsConverter.kphFromKnots(position.getSpeed())),
+                position.getLatitude(), position.getLongitude());
+    }
+
+    private static Set<String> alarms(Position position) {
+        String alarm = position.getString(Position.KEY_ALARM);
+        return alarm != null ? Set.of(alarm.split(",")) : Set.of();
+    }
+
+    /**
+     * @param speedLimit default limit in km/h; a position speedLimit attribute (knots) takes precedence
+     */
+    private static void closeSpeeding(
+            Result result, long start, long end, double max, double limit, Position position) {
+        if (end - start >= MIN_SPEEDING) {
+            result.speedingTime += end - start;
+            result.add(incident(SPEEDING, String.format("%.0f/%.0f km/h", max, limit), position));
+        }
+    }
+
+    public static Result compute(List<Position> positions, double speedLimit) {
+        Result result = new Result();
+        if (positions.isEmpty()) {
+            return result;
+        }
+        boolean deviceHarsh = positions.stream().anyMatch(position -> {
+            Set<String> alarms = alarms(position);
+            return alarms.contains(Position.ALARM_BRAKING) || alarms.contains(Position.ALARM_ACCELERATION)
+                    || alarms.contains(Position.ALARM_CORNERING);
+        });
+
+        Set<String> previousAlarms = Set.of();
+        long lastHarsh = 0;
+        long speedingStart = -1;
+        long speedingLast = -1;
+        double speedingLimit = speedLimit;
+        double speedingMax = 0;
+        Position speedingPosition = null;
+        Position previous = null;
+        double odometer = 0;
+
+        for (Position position : positions) {
+            long time = position.getFixTime().getTime();
+            double speed = UnitsConverter.kphFromKnots(position.getSpeed());
+            result.maxSpeed = Math.max(result.maxSpeed, speed);
+            if (previous != null) {
+                double meters = DistanceCalculator.distance(
+                        previous.getLatitude(), previous.getLongitude(),
+                        position.getLatitude(), position.getLongitude());
+                long elapsed = time - previous.getFixTime().getTime();
+                if (elapsed > 0 && meters / elapsed * 3600 <= MAX_SEGMENT_SPEED) {
+                    odometer += meters;
+                }
+            }
+
+            Set<String> alarms = alarms(position);
+            for (String alarm : alarms) {
+                if (previousAlarms.contains(alarm)) {
+                    continue;
+                }
+                if (Position.ALARM_BRAKING.equals(alarm)) {
+                    result.add(incident(BRAKING, alarm, position));
+                } else if (Position.ALARM_ACCELERATION.equals(alarm)) {
+                    result.add(incident(ACCELERATION, alarm, position));
+                } else if (Position.ALARM_CORNERING.equals(alarm)) {
+                    result.add(incident(CORNERING, alarm, position));
+                } else if (ADAS_ALARMS.contains(alarm)) {
+                    result.add(incident(ADAS, alarm, position));
+                } else if (DMS_ALARMS.contains(alarm)) {
+                    result.add(incident(DMS, alarm, position));
+                }
+            }
+            previousAlarms = alarms;
+
+            double limit = position.hasAttribute(Position.KEY_SPEED_LIMIT)
+                    ? UnitsConverter.kphFromKnots(position.getDouble(Position.KEY_SPEED_LIMIT)) : speedLimit;
+            if (limit > 0 && speed > limit) {
+                if (speedingStart < 0) {
+                    speedingStart = time;
+                    speedingPosition = position;
+                    speedingMax = speed;
+                }
+                speedingLast = time;
+                speedingLimit = limit;
+                speedingMax = Math.max(speedingMax, speed);
+            } else if (speedingStart >= 0 && time - speedingLast >= SPEEDING_MERGE) {
+                closeSpeeding(result, speedingStart, speedingLast, speedingMax, speedingLimit, speedingPosition);
+                speedingStart = -1;
+            }
+
+            if (previous != null) {
+                long gap = time - previous.getFixTime().getTime();
+                double previousSpeed = UnitsConverter.kphFromKnots(previous.getSpeed());
+                if (gap > 0 && gap <= 300_000 && (speed > 5 || previousSpeed > 5)) {
+                    result.drivingTime += gap;
+                }
+                if (!deviceHarsh && gap > 0 && gap <= MAX_SAMPLE_GAP && time - lastHarsh > REFRACTORY) {
+                    double seconds = gap / 1000.0;
+                    double acceleration = (speed - previousSpeed) / 3.6 / seconds;
+                    double turn = Math.abs(((position.getCourse() - previous.getCourse() + 540) % 360) - 180);
+                    double lateral = speed / 3.6 * Math.toRadians(turn) / seconds;
+                    String type = null;
+                    if (acceleration >= HARSH_ACCELERATION) {
+                        type = ACCELERATION;
+                    } else if (acceleration <= HARSH_BRAKING) {
+                        type = BRAKING;
+                    } else if (speed > 20 && lateral >= HARSH_CORNERING) {
+                        type = CORNERING;
+                    }
+                    if (type != null) {
+                        result.add(incident(type, "gps", position));
+                        lastHarsh = time;
+                    }
+                }
+            }
+            previous = position;
+        }
+        if (speedingStart >= 0) {
+            closeSpeeding(result, speedingStart, speedingLast, speedingMax, speedingLimit, speedingPosition);
+        }
+        result.distance = odometer / 1000;
+        result.incidents.sort((a, b) -> Long.compare(a.time(), b.time()));
+        return result;
+    }
+
+}
