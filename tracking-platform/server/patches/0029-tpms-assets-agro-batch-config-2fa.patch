+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import com.warrenstrange.googleauth.GoogleAuthenticator;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.api.security.TwoFactor;
+import org.traccar.api.security.TwoFactorRequestFilter;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.Server;
+import org.traccar.model.User;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Two-factor authentication of the own account: state, setup with an authenticator app (the key is saved only after
+ * a valid code), recovery codes, turning it off, and a manager requiring it for an account and everything below it.
+ */
+@Path("security")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SecurityResource extends BaseResource {
+
+    private static final int RECOVERY_COUNT = 8;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    private User me() throws Exception {
+        return storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", getUserId())));
+    }
+
+    private void save(User user) throws Exception {
+        storage.updateObject(user, new Request(new Columns.Include("totpKey", "attributes"),
+                new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+        TwoFactorRequestFilter.invalidate(user.getId());
+    }
+
+    private static int code(Map<String, Object> body) {
+        Object value = body != null ? body.get("code") : null;
+        try {
+            return Integer.parseInt(String.valueOf(value).replaceAll("\\s", ""));
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("Invalid code");
+        }
+    }
+
+    @GET
+    public Map<String, Object> status() throws Exception {
+        User user = me();
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("enabled", user.getTotpKey() != null && !user.getTotpKey().isEmpty());
+        result.put("required", !user.getAdministrator()
+                && TwoFactor.required(storage, hierarchyService.getAncestors(user.getId()), user));
+        result.put("requiredForOthers", user.getBoolean(TwoFactor.REQUIRED));
+        result.put("recoveryLeft", TwoFactor.recoveryLeft(user));
+        return result;
+    }
+
+    /**
+     * New secret key and the otpauth link for the QR code; nothing is saved yet.
+     */
+    @POST
+    @Path("totp/setup")
+    public Map<String, Object> setup() throws Exception {
+        User user = me();
+        Server server = permissionsService.getServer();
+        String issuer = server.getString("title") != null ? server.getString("title") : "Andes Tracking";
+        String key = new GoogleAuthenticator().createCredentials().getKey();
+        String label = URLEncoder.encode(issuer + ":" + user.getEmail(), StandardCharsets.UTF_8).replace("+", "%20");
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("key", key);
+        result.put("uri", "otpauth://totp/" + label + "?secret=" + key
+                + "&issuer=" + URLEncoder.encode(issuer, StandardCharsets.UTF_8).replace("+", "%20"));
+        return result;
+    }
+
+    /**
+     * Turns two-factor on with the key from setup and a code from the app; answers the recovery codes (shown once).
+     */
+    @POST
+    @Path("totp/enable")
+    public Map<String, Object> enable(Map<String, Object> body) throws Exception {
+        String key = String.valueOf(body.getOrDefault("key", ""));
+        if (key.length() < 16 || !new GoogleAuthenticator().authorize(key, code(body))) {
+            throw new SecurityException("The code does not match, check the time of the phone");
+        }
+        User user = me();
+        user.setTotpKey(key);
+        List<Integer> codes = TwoFactor.generateRecovery(user, RECOVERY_COUNT);
+        save(user);
+        Map<String, Object> result = new LinkedHashMap<>(status());
+        result.put("recoveryCodes", codes);
+        return result;
+    }
+
+    private void checkCode(User user, int code) throws Exception {
+        boolean valid = code >= TwoFactor.RECOVERY_MIN
+                ? TwoFactor.consumeRecovery(storage, user, code)
+                : user.getTotpKey() != null && new GoogleAuthenticator().authorize(user.getTotpKey(), code);
+        if (!valid) {
+            throw new SecurityException("Invalid code");
+        }
+    }
+
+    /**
+     * New recovery codes (the old ones stop working); needs a current code.
+     */
+    @POST
+    @Path("totp/recovery")
+    public Map<String, Object> recovery(Map<String, Object> body) throws Exception {
+        User user = me();
+        checkCode(user, code(body));
+        List<Integer> codes = TwoFactor.generateRecovery(user, RECOVERY_COUNT);
+        save(user);
+        Map<String, Object> result = new LinkedHashMap<>(status());
+        result.put("recoveryCodes", codes);
+        return result;
+    }
+
+    @POST
+    @Path("totp/disable")
+    public Map<String, Object> disable(Map<String, Object> body) throws Exception {
+        User user = me();
+        if (!user.getAdministrator()
+                && TwoFactor.required(storage, hierarchyService.getAncestors(user.getId()), user)) {
+            throw new SecurityException("Two-factor authentication is required for this account");
+        }
+        checkCode(user, code(body));
+        user.setTotpKey(null);
+        user.getAttributes().remove(TwoFactor.RECOVERY);
+        save(user);
+        return status();
+    }
+
+    /**
+     * A manager requires two-factor for an account (itself or one it manages) and every account below it.
+     */
+    @PUT
+    @Path("required/{userId}")
+    public Map<String, Object> require(@PathParam("userId") long userId, Map<String, Object> body) throws Exception {
+        if (userId != getUserId()) {
+            permissionsService.checkUser(getUserId(), userId);
+        }
+        permissionsService.checkManager(getUserId());
+        User user = storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", userId)));
+        if (Boolean.TRUE.equals(body.get("required"))) {
+            user.set(TwoFactor.REQUIRED, true);
+        } else {
+            user.getAttributes().remove(TwoFactor.REQUIRED);
+        }
+        storage.updateObject(user, new Request(new Columns.Include("attributes"),
+                new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+        TwoFactorRequestFilter.invalidate(user.getId());
+        for (long descendant : hierarchyService.getDescendants(userId)) {
+            TwoFactorRequestFilter.invalidate(descendant);
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("userId", userId);
+        result.put("required", user.getBoolean(TwoFactor.REQUIRED));
+        return result;
+    }
+
+}
