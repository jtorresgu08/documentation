+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.assets.AssetService;
+import org.traccar.database.CommandsManager;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.model.Command;
+import org.traccar.model.Device;
+import org.traccar.model.QueuedCommand;
+import org.traccar.model.UserRestrictions;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Battery powered assets: list with last and next report, battery and days left; settings per asset; battery history;
+ * sending the report interval to the tracker.
+ */
+@Path("assets")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class AssetResource extends BaseResource {
+
+    @Inject
+    private AssetService assetService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private CommandsManager commandsManager;
+
+    @GET
+    public List<Map<String, Object>> list() throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            if (AssetService.isAsset(device)) {
+                result.add(assetService.summary(device, FleetUtil.latest(storage, cacheManager, device), true));
+            }
+        }
+        return result;
+    }
+
+    private Device device(long deviceId) throws Exception {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        return storage.getObject(Device.class, new Request(new Columns.All(), new Condition.Equals("id", deviceId)));
+    }
+
+    @PUT
+    @Path("{deviceId}")
+    public Map<String, Object> update(@PathParam("deviceId") long deviceId, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Device device = device(deviceId);
+        boolean asset = Boolean.TRUE.equals(body.get("assetMode"));
+        if (asset) {
+            device.set(AssetService.MODE, true);
+        } else {
+            device.getAttributes().remove(AssetService.MODE);
+        }
+        for (String key : List.of(AssetService.REPORT_HOURS, AssetService.BATTERY_LOW,
+                AssetService.FULL_VOLTS, AssetService.EMPTY_VOLTS)) {
+            if (body.get(key) instanceof Number number && number.doubleValue() > 0) {
+                device.set(key, number.doubleValue());
+            } else {
+                device.getAttributes().remove(key);
+            }
+        }
+        FleetUtil.saveAttributes(storage, cacheManager, device);
+        return assetService.summary(device, FleetUtil.latest(storage, cacheManager, device), true);
+    }
+
+    @GET
+    @Path("{deviceId}/battery")
+    public Map<String, Object> battery(@PathParam("deviceId") long deviceId, @QueryParam("days") int days)
+            throws Exception {
+        return assetService.batteryTrend(device(deviceId), days > 0 ? Math.min(days, 180) : 30);
+    }
+
+    /**
+     * Sends the report interval to the tracker (periodic position command); queued until it wakes up.
+     */
+    @POST
+    @Path("{deviceId}/interval")
+    public Map<String, Object> interval(@PathParam("deviceId") long deviceId) throws Exception {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getLimitCommands);
+        Device device = device(deviceId);
+        Command command = new Command();
+        command.setDeviceId(deviceId);
+        command.setType(Command.TYPE_POSITION_PERIODIC);
+        command.set(Command.KEY_FREQUENCY, Math.round(AssetService.reportHours(device) * 3600));
+        QueuedCommand queued = commandsManager.sendCommand(command);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("status", queued != null ? "queued" : "sent");
+        result.put("frequency", command.getAttributes().get(Command.KEY_FREQUENCY));
+        return result;
+    }
+
+    /**
+     * Runs the late report check now (administrators; it also runs every five minutes).
+     */
+    @POST
+    @Path("check")
+    public Map<String, Object> check() throws Exception {
+        permissionsService.checkAdmin(getUserId());
+        assetService.checkMissed();
+        return Map.of("checked", true);
+    }
+
+}
