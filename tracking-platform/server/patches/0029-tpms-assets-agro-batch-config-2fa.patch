+package org.traccar.schedule;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.assets.AssetService;
+
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Every five minutes, raises an alert for battery powered assets whose report is late.
+ */
+public class TaskAssetWatch extends SingleScheduleTask {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TaskAssetWatch.class);
+
+    private final AssetService assetService;
+
+    @Inject
+    public TaskAssetWatch(AssetService assetService) {
+        this.assetService = assetService;
+    }
+
+    @Override
+    public void schedule(ScheduledExecutorService executor) {
+        executor.scheduleAtFixedRate(this, 2, 5, TimeUnit.MINUTES);
+    }
+
+    @Override
+    public void run() {
+        try {
+            assetService.checkMissed();
+        } catch (Exception e) {
+            LOGGER.warn("Asset watch failed", e);
+        }
+    }
+
+}
