+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+import org.traccar.tpms.TpmsService;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Tire pressure monitoring: tires of the fleet with their state, configuration per vehicle and history.
+ */
+@Path("tpms")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class TpmsResource extends BaseResource {
+
+    @Inject
+    private TpmsService tpmsService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    private Map<String, Object> view(Device device, TpmsService.Config config, Position position) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("deviceId", device.getId());
+        result.put("name", device.getName());
+        result.put("config", config != null ? TpmsService.toMap(config) : null);
+        if (config != null) {
+            List<TpmsService.Wheel> wheels = tpmsService.evaluate(config, position);
+            result.put("wheels", wheels.stream().map(wheel -> {
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("number", wheel.number());
+                item.put("axle", wheel.axle());
+                item.put("index", wheel.index());
+                item.put("name", wheel.name());
+                item.put("pressure", wheel.pressure());
+                item.put("temperature", wheel.temperature());
+                item.put("status", wheel.status().name().toLowerCase());
+                return item;
+            }).toList());
+            result.put("alarms", wheels.stream().filter(wheel -> wheel.status() != TpmsService.Status.OK
+                    && wheel.status() != TpmsService.Status.NO_DATA).count());
+        }
+        result.put("fixTime", position != null ? position.getFixTime() : null);
+        return result;
+    }
+
+    @GET
+    public List<Map<String, Object>> fleet() throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            TpmsService.Config config = tpmsService.config(device);
+            if (config != null) {
+                result.add(view(device, config, FleetUtil.latest(storage, cacheManager, device)));
+            }
+        }
+        return result;
+    }
+
+    private Device device(long deviceId) throws Exception {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        return storage.getObject(Device.class, new Request(new Columns.All(), new Condition.Equals("id", deviceId)));
+    }
+
+    @GET
+    @Path("{deviceId}")
+    public Map<String, Object> get(@PathParam("deviceId") long deviceId) throws Exception {
+        Device device = device(deviceId);
+        return view(device, tpmsService.config(device), FleetUtil.latest(storage, cacheManager, device));
+    }
+
+    @PUT
+    @Path("{deviceId}")
+    public Map<String, Object> update(@PathParam("deviceId") long deviceId, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Device device = device(deviceId);
+        if (body == null || Boolean.FALSE.equals(body.get("enabled"))) {
+            device.getAttributes().remove(TpmsService.ATTRIBUTE);
+        } else {
+            TpmsService.Config config = TpmsService.config(body);
+            device.set(TpmsService.ATTRIBUTE, objectMapper.writeValueAsString(TpmsService.toMap(config)));
+        }
+        FleetUtil.saveAttributes(storage, cacheManager, device);
+        return view(device, tpmsService.config(device), FleetUtil.latest(storage, cacheManager, device));
+    }
+
+    /**
+     * Pressure and temperature of every tire over time (at most about 400 points).
+     */
+    @GET
+    @Path("{deviceId}/history")
+    public Map<String, Object> history(
+            @PathParam("deviceId") long deviceId, @QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        Device device = device(deviceId);
+        TpmsService.Config config = tpmsService.config(device);
+        List<Position> positions = FleetUtil.positions(storage, deviceId, from, to);
+        int step = Math.max(1, positions.size() / 400);
+        List<Map<String, Object>> points = new ArrayList<>();
+        for (int i = 0; config != null && i < positions.size(); i += step) {
+            Position position = positions.get(i);
+            Map<String, Object> point = new LinkedHashMap<>();
+            point.put("time", position.getFixTime());
+            for (TpmsService.Wheel wheel : tpmsService.evaluate(config, position)) {
+                point.put("p" + wheel.number(), wheel.pressure());
+                point.put("t" + wheel.number(), wheel.temperature());
+            }
+            points.add(point);
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("config", config != null ? TpmsService.toMap(config) : null);
+        result.put("points", points);
+        return result;
+    }
+
+}
diff --git a/src/main/java/org/traccar/api/security/LoginService.java b/src/main/java/org/traccar/api/security/LoginService.java
index 507288c..9fd82f6 100644
--- a/src/main/java/org/traccar/api/security/LoginService.java
+++ b/src/main/java/org/traccar/api/security/LoginService.java
@@ -40,6 +40,8 @@ import java.security.GeneralSecurityException;
 public class LoginService {
 
     private final Config config;
+    public static final String CODE_FAILED = "User authorization failed";
+
     private final Storage storage;
     private final TokenManager tokenManager;
     private final LdapProvider ldapProvider;
@@ -141,15 +143,22 @@ public class LoginService {
         user.checkDisabled();
     }
 
-    private void checkUserCode(User user, Integer code) throws SecurityException {
+    private void checkUserCode(User user, Integer code) throws SecurityException, StorageException {
         String key = user.getTotpKey();
         if (key != null && !key.isEmpty()) {
             if (code == null) {
                 throw new CodeRequiredException();
             }
+            // nine digits: one of the recovery codes, each valid once
+            if (code >= TwoFactor.RECOVERY_MIN) {
+                if (!TwoFactor.consumeRecovery(storage, user, code)) {
+                    throw new SecurityException(CODE_FAILED);
+                }
+                return;
+            }
             GoogleAuthenticator authenticator = new GoogleAuthenticator();
