+package org.traccar.api.security;
+
+import jakarta.annotation.Priority;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Priorities;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.container.ContainerRequestContext;
+import jakarta.ws.rs.container.ContainerRequestFilter;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.model.User;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Accounts that must use two-factor authentication and have not set it up can only reach the session, the server
+ * information and the security endpoints (to set it up); everything else answers 403 until they do.
+ */
+@Priority(Priorities.USER + 50)
+public class TwoFactorRequestFilter implements ContainerRequestFilter {
+
+    private static final List<String> OPEN = List.of("session", "server", "security");
+    private static final long CACHE_MILLIS = 30_000;
+
+    private record Cached(boolean blocked, long time) {
+    }
+
+    private static final Map<Long, Cached> CACHE = new ConcurrentHashMap<>();
+
+    @Inject
+    private Storage storage;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    public static void invalidate(long userId) {
+        CACHE.remove(userId);
+    }
+
+    @Override
+    public void filter(ContainerRequestContext requestContext) {
+        if (!(requestContext.getSecurityContext().getUserPrincipal() instanceof UserPrincipal principal)) {
+            return;
+        }
+        String path = requestContext.getUriInfo().getPath();
+        String clean = path.startsWith("/") ? path.substring(1) : path;
+        if (OPEN.stream().anyMatch(prefix -> clean.equals(prefix) || clean.startsWith(prefix + "/"))) {
+            return;
+        }
+        try {
+            Cached cached = CACHE.get(principal.getUserId());
+            if (cached == null || System.currentTimeMillis() - cached.time() > CACHE_MILLIS) {
+                User user = storage.getObject(User.class, new Request(
+                        new Columns.All(), new Condition.Equals("id", principal.getUserId())));
+                boolean blocked = user != null && !user.getAdministrator()
+                        && (user.getTotpKey() == null || user.getTotpKey().isEmpty())
+                        && TwoFactor.required(storage, hierarchyService.getAncestors(user.getId()), user);
+                cached = new Cached(blocked, System.currentTimeMillis());
+                CACHE.put(principal.getUserId(), cached);
+            }
+            if (cached.blocked()) {
+                throw new WebApplicationException(Response.status(Response.Status.FORBIDDEN)
+                        .type(MediaType.TEXT_PLAIN).entity("Two-factor authentication setup required").build());
+            }
+        } catch (StorageException e) {
+            throw new WebApplicationException(e);
+        }
+    }
+
+}
diff --git a/src/main/java/org/traccar/assets/AssetService.java b/src/main/java/org/traccar/assets/AssetService.java
new file mode 100644
index 0000000..3745c39
--- /dev/null
+++ b/src/main/java/org/traccar/assets/AssetService.java
@@ -0,0 +1,236 @@
+/*
