+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.database.CommandsManager;
+import org.traccar.model.Command;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.QueuedCommand;
+import org.traccar.model.User;
+import org.traccar.model.UserRestrictions;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Remote configuration of many devices at once: templates of commands (own and of the managers above, so a
+ * distributor shares them with its clients) and jobs that send them to the chosen devices. Each command is sent
+ * now or queued until the device connects; the job shows per device whether it was sent, is still queued, answered
+ * (with the device's reply) or failed. Engine stop and resume are never sent in batch.
+ */
+@Path("device-config")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class DeviceConfigResource extends BaseResource {
+
+    public static final String TEMPLATES = "configTemplates";
+    private static final int MAX_JOBS = 200;
+    private static final long REPLY_MARGIN = 60_000;
+    private static final Set<String> FORBIDDEN = Set.of(Command.TYPE_ENGINE_STOP, Command.TYPE_ENGINE_RESUME);
+
+    private static final Map<Long, Map<String, Object>> JOBS = Collections.synchronizedMap(new LinkedHashMap<>());
+    private static final AtomicLong IDS = new AtomicLong();
+
+    @Inject
+    private CommandsManager commandsManager;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    private List<Map<String, Object>> templatesOf(User user, boolean own) throws Exception {
+        String json = user != null ? user.getString(TEMPLATES) : null;
+        if (json == null || json.isBlank()) {
+            return new ArrayList<>();
+        }
+        List<Map<String, Object>> list = objectMapper.readValue(json, new TypeReference<>() { });
+        list.forEach(item -> {
+            item.put("own", own);
+            item.put("owner", user.getName());
+        });
+        return list;
+    }
+
+    @GET
+    @Path("templates")
+    public List<Map<String, Object>> templates() throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>(templatesOf(permissionsService.getUser(getUserId()), true));
+        for (long ancestorId : hierarchyService.getAncestors(getUserId())) {
+            result.addAll(templatesOf(storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ancestorId))), false));
+        }
+        return result;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Map<String, Object>> commands(Object raw) {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Map<String, Object> item : (List<Map<String, Object>>) raw) {
+            String type = String.valueOf(item.getOrDefault("type", ""));
+            if (type.isBlank()) {
+                throw new IllegalArgumentException("Every command needs a type");
+            }
+            if (FORBIDDEN.contains(type)) {
+                throw new IllegalArgumentException("Engine stop and resume are not sent in batch");
+            }
+            Map<String, Object> command = new LinkedHashMap<>();
+            command.put("type", type);
+            command.put("textChannel", Boolean.TRUE.equals(item.get("textChannel")));
+            command.put("attributes", item.get("attributes") instanceof Map<?, ?> map ? map : Map.of());
+            result.add(command);
+        }
+        if (result.isEmpty() || result.size() > 20) {
+            throw new IllegalArgumentException("Between 1 and 20 commands");
+        }
+        return result;
+    }
+
+    /**
+     * Replaces the own templates: [{id, name, description, commands: [{type, textChannel, attributes}]}].
+     */
+    @PUT
+    @Path("templates")
+    public List<Map<String, Object>> saveTemplates(List<Map<String, Object>> body) throws Exception {
+        User user = permissionsService.getUser(getUserId());
+        if (user.getReadonly()) {
+            throw new SecurityException("Read-only user");
+        }
+        List<Map<String, Object>> clean = new ArrayList<>();
+        for (Map<String, Object> item : body) {
+            if (Boolean.FALSE.equals(item.get("own"))) {
+                continue;
+            }
+            Map<String, Object> template = new LinkedHashMap<>();
+            template.put("id", String.valueOf(item.getOrDefault("id", Long.toString(System.nanoTime(), 36))));
+            template.put("name", String.valueOf(item.getOrDefault("name", "")).trim());
+            template.put("description", item.get("description"));
+            template.put("commands", commands(item.get("commands")));
+            if (((String) template.get("name")).isEmpty()) {
+                throw new IllegalArgumentException("Every template needs a name");
+            }
+            clean.add(template);
+        }
+        String json = objectMapper.writeValueAsString(clean);
+        if (json.length() > 3800) {
+            throw new IllegalArgumentException("Too many templates");
+        }
+        user.set(TEMPLATES, json);
+        storage.updateObject(user, new Request(new Columns.Include("attributes"),
+                new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+        return templates();
+    }
+
+    /**
+     * Sends the commands to every device: {name, deviceIds, commands}.
+     */
+    @POST
+    @Path("jobs")
+    @SuppressWarnings("unchecked")
+    public Map<String, Object> create(Map<String, Object> body) throws Exception {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getLimitCommands);
+        List<Map<String, Object>> commands = commands(body.get("commands"));
+        List<Long> deviceIds = ((List<Number>) body.getOrDefault("deviceIds", List.of())).stream()
+                .map(Number::longValue).distinct().toList();
+        if (deviceIds.isEmpty() || deviceIds.size() > 2000) {
+            throw new IllegalArgumentException("Between 1 and 2000 devices");
+        }
+        for (long deviceId : deviceIds) {
+            permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        }
+        Map<String, Object> job = new LinkedHashMap<>();
+        long id = IDS.incrementAndGet();
+        job.put("id", id);
+        job.put("userId", getUserId());
+        job.put("name", String.valueOf(body.getOrDefault("name", "Configuración")));
+        job.put("created", new Date());
+        job.put("commands", commands);
+        List<Map<String, Object>> results = new ArrayList<>();
+        for (long deviceId : deviceIds) {
+            Device device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", deviceId)));
+            Map<String, Object> result = new LinkedHashMap<>();
+            result.put("deviceId", deviceId);
+            result.put("name", device != null ? device.getName() : String.valueOf(deviceId));
+            result.put("queued", new ArrayList<Long>());
+            send(result, commands);
+            results.add(result);
+        }
+        job.put("results", results);
+        synchronized (JOBS) {
+            JOBS.put(id, job);
+            while (JOBS.size() > MAX_JOBS) {
+                JOBS.remove(JOBS.keySet().iterator().next());
+            }
+        }
+        return refresh(job);
+    }
+
+    @SuppressWarnings("unchecked")
+    private void send(Map<String, Object> result, List<Map<String, Object>> commands) {
+        List<Long> queued = (List<Long>) result.get("queued");
+        queued.clear();
+        result.remove("error");
+        result.remove("reply");
+        result.put("sentAt", new Date());
+        try {
+            for (Map<String, Object> item : commands) {
+                Command command = new Command();
+                command.setDeviceId((Long) result.get("deviceId"));
+                command.setType((String) item.get("type"));
+                command.setTextChannel(Boolean.TRUE.equals(item.get("textChannel")));
+                ((Map<String, Object>) item.get("attributes")).forEach((key, value) ->
+                        command.getAttributes().put(key, value));
+                QueuedCommand queuedCommand = commandsManager.sendCommand(command);
+                if (queuedCommand != null) {
+                    queued.add(queuedCommand.getId());
+                }
+            }
+            result.put("status", queued.isEmpty() ? "sent" : "queued");
+        } catch (Exception e) {
+            result.put("status", "failed");
+            result.put("error", e.getMessage() != null ? e.getMessage() : e.getClass().getSimpleName());
+        }
+    }
+
+    /**
+     * Current state: queued commands that left the queue were delivered when the device connected; a command
+     * result event from the device after sending marks it answered with its reply.
+     */
+    @SuppressWarnings("unchecked")
+    private Map<String, Object> refresh(Map<String, Object> job) throws Exception {
+        Map<String, Integer> counts = new LinkedHashMap<>();
+        for (Map<String, Object> result : (List<Map<String, Object>>) job.get("results")) {
+            if ("queued".equals(result.get("status"))) {
+                List<Long> queued = (List<Long>) result.get("queued");
+                queued.removeIf(queuedId -> {
+                    try {
+                        return storage.getObject(QueuedCommand.class, new Request(
+                                new Columns.Include("id"), new Condition.Equals("id", queuedId))) == null;
+                    } catch (Exception e) {
+                        return false;
+                    }
+                });
+                if (queued.isEmpty()) {
+                    result.put("status", "sent");
+                    result.put("sentAt", new Date());
+                }
+            }
+            if ("sent".equals(result.get("status"))) {
+                List<Event> replies = storage.getObjects(Event.class, new Request(
+                        new Columns.All(), Condition.merge(List.of(
+                                new Condition.Equals("deviceId", result.get("deviceId")),
+                                new Condition.Equals("type", Event.TYPE_COMMAND_RESULT),
+                                // replies carry the device clock (fix time), which may run a little behind
+                                new Condition.Between("eventTime", new Date(
+                                        ((Date) job.get("created")).getTime() - REPLY_MARGIN), new Date()))),
+                        new Order("eventTime", true, 1)));
+                if (!replies.isEmpty()) {
+                    result.put("status", "answered");
+                    result.put("reply", replies.get(0).getString("result"));
+                    result.put("repliedAt", replies.get(0).getEventTime());
+                }
+            }
+            counts.merge(String.valueOf(result.get("status")), 1, Integer::sum);
+        }
+        Map<String, Object> view = new LinkedHashMap<>(job);
+        view.remove("userId");
+        view.put("counts", counts);
+        return view;
+    }
+
+    private Map<String, Object> job(long id) throws Exception {
+        Map<String, Object> job = JOBS.get(id);
+        if (job == null || !Long.valueOf(getUserId()).equals(job.get("userId"))
+                && permissionsService.notAdmin(getUserId())) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return job;
+    }
+
+    @GET
+    @Path("jobs")
+    public List<Map<String, Object>> jobs() throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>();
+        List<Map<String, Object>> list;
+        synchronized (JOBS) {
+            list = new ArrayList<>(JOBS.values());
+        }
+        Collections.reverse(list);
+        for (Map<String, Object> job : list) {
+            if (Long.valueOf(getUserId()).equals(job.get("userId"))) {
+                result.add(refresh(job));
+            }
+        }
+        return result;
+    }
+
+    @GET
+    @Path("jobs/{id}")
+    public Map<String, Object> get(@PathParam("id") long id) throws Exception {
+        return refresh(job(id));
+    }
+
+    /**
+     * Sends again to the devices that failed.
+     */
+    @POST
+    @Path("jobs/{id}/retry")
+    @SuppressWarnings("unchecked")
+    public Map<String, Object> retry(@PathParam("id") long id) throws Exception {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getLimitCommands);
+        Map<String, Object> job = job(id);
+        for (Map<String, Object> result : (List<Map<String, Object>>) job.get("results")) {
+            if ("failed".equals(result.get("status"))) {
+                send(result, (List<Map<String, Object>>) job.get("commands"));
+            }
+        }
+        return refresh(job);
+    }
+
+}
