+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.assets.AssetService;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+
+/**
+ * Low battery of battery powered assets, and the end of a missed report alert when the asset reports again.
+ */
+public class AssetEventHandler extends BaseEventHandler {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(AssetEventHandler.class);
+
+    private final CacheManager cacheManager;
+    private final AssetService assetService;
+
+    @Inject
+    public AssetEventHandler(CacheManager cacheManager, AssetService assetService) {
+        this.cacheManager = cacheManager;
+        this.assetService = assetService;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        if (!PositionUtil.isLatest(cacheManager, position)) {
+            return;
+        }
+        Device device = cacheManager.getObject(Device.class, position.getDeviceId());
+        try {
+            for (Event event : assetService.onPosition(device, position)) {
+                callback.eventDetected(event);
+            }
+        } catch (StorageException e) {
+            LOGGER.warn("Asset check failed", e);
+        }
+    }
+
+}
