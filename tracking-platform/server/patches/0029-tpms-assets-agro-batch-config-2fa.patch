+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Agriculture and machinery: implements (width and how to know they work), fields (geofences marked as fields, with
+ * crop and area) and field work: worked hectares, overlap, coverage of the field, passes, hours and productivity.
+ */
+@Path("agro")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class AgroResource extends BaseResource {
+
+    public static final String IMPLEMENT = "agroImplementId";
+    public static final String FIELD = "agroField";
+    public static final String CROP = "crop";
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    private Set<Long> visibleOwners() throws StorageException {
+        if (!permissionsService.notAdmin(getUserId())) {
+            return null;
+        }
+        Set<Long> owners = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        owners.add(getUserId());
+        for (long ancestorId : hierarchyService.getAncestors(getUserId())) {
+            User ancestor = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ancestorId)));
+            if (ancestor != null && !ancestor.getAdministrator()) {
+                owners.add(ancestorId);
+            }
+        }
+        return owners;
+    }
+
+    public static long implementOf(Device device) {
+        Object value = device != null ? device.getAttributes().get(IMPLEMENT) : null;
+        try {
+            return value != null ? Long.parseLong(String.valueOf(value).replaceAll("\\.0$", "")) : 0;
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    // ---------- implements ----------
+
+    private Map<String, Object> view(AgroImplement implement) throws StorageException {
+        Map<String, Object> result = objectMapper.copy()
+                .configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false).convertValue(implement, Map.class);
+        List<Long> deviceIds = new ArrayList<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            if (implementOf(device) == implement.getId()) {
+                deviceIds.add(device.getId());
+            }
+        }
+        result.put("deviceIds", deviceIds);
+        return result;
+    }
+
+    @GET
+    @Path("implements")
+    public List<Map<String, Object>> implementsList() throws StorageException {
+        Set<Long> owners = visibleOwners();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (AgroImplement implement : storage.getObjects(AgroImplement.class, new Request(
+                new Columns.All(), new Order("name")))) {
+            if (owners == null || owners.contains(implement.getUserId())) {
+                result.add(view(implement));
+            }
+        }
+        return result;
+    }
+
+    private AgroImplement checkImplement(long id) throws StorageException {
+        AgroImplement implement = storage.getObject(AgroImplement.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        Set<Long> owners = visibleOwners();
+        if (implement == null || owners != null && !owners.contains(implement.getUserId())) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return implement;
+    }
+
+    private static void read(AgroImplement implement, Map<String, Object> body) {
+        String name = String.valueOf(body.getOrDefault("name", "")).trim();
+        double width = body.get("width") instanceof Number number ? number.doubleValue() : 0;
+        if (name.isEmpty() || width <= 0 || width > 60) {
+            throw new IllegalArgumentException("The implement needs a name and a width between 0 and 60 m");
+        }
+        implement.setName(name);
+        implement.setType((String) body.get("type"));
+        implement.setWidth(width);
+        String attribute = (String) body.get("workAttribute");
+        implement.setWorkAttribute(attribute != null && !attribute.isBlank() ? attribute.trim() : null);
+        implement.setMinSpeed(body.get("minSpeed") instanceof Number number ? number.doubleValue() : 0);
+        implement.setMaxSpeed(body.get("maxSpeed") instanceof Number number ? number.doubleValue() : 0);
+    }
+
+    @SuppressWarnings("unchecked")
+    private void assign(long implementId, Object deviceIds) throws Exception {
+        if (!(deviceIds instanceof List<?> list)) {
+            return;
+        }
+        Set<Long> wanted = new HashSet<>();
+        for (Object id : list) {
+            wanted.add(((Number) id).longValue());
+        }
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            boolean assigned = implementOf(device) == implementId;
+            boolean want = wanted.contains(device.getId());
+            if (assigned != want) {
+                permissionsService.checkPermission(Device.class, getUserId(), device.getId());
+                if (want) {
+                    device.set(IMPLEMENT, implementId);
+                } else {
+                    device.getAttributes().remove(IMPLEMENT);
+                }
+                FleetUtil.saveAttributes(storage, cacheManager, device);
+            }
+        }
+    }
+
+    @POST
+    @Path("implements")
+    public Map<String, Object> create(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        AgroImplement implement = new AgroImplement();
+        read(implement, body);
+        implement.setUserId(getUserId());
+        implement.setId(storage.addObject(implement, new Request(new Columns.Exclude("id"))));
+        assign(implement.getId(), body.get("deviceIds"));
+        return view(implement);
+    }
+
+    @PUT
+    @Path("implements/{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        AgroImplement implement = checkImplement(id);
+        read(implement, body);
+        storage.updateObject(implement, new Request(
+                new Columns.Exclude("id", "userId"), new Condition.Equals("id", id)));
+        assign(id, body.get("deviceIds"));
+        return view(implement);
+    }
+
+    @DELETE
+    @Path("implements/{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        checkImplement(id);
+        assign(id, List.of());
+        storage.removeObject(AgroImplement.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    // ---------- fields ----------
+
+    private static List<double[]> polygon(Geofence geofence) {
+        try {
+            GeofenceGeometry geometry = geofence.getGeometry();
+            List<double[]> result = new ArrayList<>();
+            if (geometry instanceof GeofencePolygon polygon) {
+                for (GeofenceGeometry.Coordinate coordinate : polygon.fromWkt(geofence.getArea())) {
+                    result.add(new double[] {coordinate.lat(), coordinate.lon()});
+                }
+            } else if (geometry instanceof GeofenceCircle circle) {
+                GeofenceCircle.DecodedCircle decoded = circle.fromWkt(geofence.getArea());
+                for (int i = 0; i < 64; i++) {
+                    double angle = 2 * Math.PI * i / 64;
+                    result.add(new double[] {
+                        decoded.latitude() + decoded.radius() * Math.cos(angle) / 111_320,
+                        decoded.longitude() + decoded.radius() * Math.sin(angle)
+                                / (111_320 * Math.cos(Math.toRadians(decoded.latitude())))});
+                }
+            }
+            return result.size() >= 3 ? result : null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private List<Geofence> geofences() throws StorageException {
+        return permissionsService.notAdmin(getUserId())
+                ? new ArrayList<>(storage.getObjects(Geofence.class, new Request(
+                        new Columns.All(), new Condition.Permission(User.class, getUserId(), Geofence.class))))
+                : new ArrayList<>(storage.getObjects(Geofence.class, new Request(new Columns.All())));
+    }
+
+    private Map<String, Object> fieldView(Geofence geofence) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", geofence.getId());
+        result.put("name", geofence.getName());
+        result.put("field", geofence.getBoolean(FIELD));
+        result.put("crop", geofence.getString(CROP));
+        List<double[]> polygon = polygon(geofence);
+        result.put("areaHa", polygon != null ? AgroAnalyzer.analyze(List.of(), 1, polygon).get("fieldHa") : null);
+        result.put("polygon", polygon);
+        return result;
+    }
+
+    /**
+     * Geofences that can be fields (polygons and circles); the ones marked as fields first.
+     */
+    @GET
+    @Path("fields")
+    public List<Map<String, Object>> fields(@QueryParam("all") boolean all) throws StorageException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Geofence geofence : geofences()) {
+            if ((all || geofence.getBoolean(FIELD)) && polygon(geofence) != null) {
+                result.add(fieldView(geofence));
+            }
+        }
+        result.sort((a, b) -> Boolean.compare((Boolean) b.get("field"), (Boolean) a.get("field")));
+        return result;
+    }
+
+    @PUT
+    @Path("fields/{id}")
+    public Map<String, Object> markField(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        permissionsService.checkPermission(Geofence.class, getUserId(), id);
+        Geofence geofence = storage.getObject(Geofence.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (Boolean.TRUE.equals(body.get("field"))) {
+            geofence.set(FIELD, true);
+        } else {
+            geofence.getAttributes().remove(FIELD);
+        }
+        String crop = (String) body.get("crop");
+        if (crop != null && !crop.isBlank()) {
+            geofence.set(CROP, crop.trim());
+        } else {
+            geofence.getAttributes().remove(CROP);
+        }
+        storage.updateObject(geofence, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", id)));
+        cacheManager.invalidateObject(true, Geofence.class, id, ObjectOperation.UPDATE);
+        return fieldView(geofence);
+    }
+
+    // ---------- field work ----------
+
+    /**
+     * Whether the implement works at a position: its input attribute when it has one, otherwise a speed range (and
+     * the ignition on, when the device reports it).
+     */
+    public static boolean working(AgroImplement implement, Position position) {
+        if (implement.getWorkAttribute() != null) {
+            Object value = position.getAttributes().get(implement.getWorkAttribute());
+            if (value instanceof Boolean flag) {
+                return flag;
+            }
+            if (value instanceof Number number) {
+                return number.doubleValue() > 0;
+            }
+            String text = String.valueOf(value);
+            return value != null && ("1".equals(text) || "true".equalsIgnoreCase(text));
+        }
+        double speed = UnitsConverter.kphFromKnots(position.getSpeed());
+        double min = implement.getMinSpeed() > 0 ? implement.getMinSpeed() : 2;
+        double max = implement.getMaxSpeed() > 0 ? implement.getMaxSpeed() : 20;
+        Object ignition = position.getAttributes().get(Position.KEY_IGNITION);
+        return speed >= min && speed <= max && !Boolean.FALSE.equals(ignition);
+    }
+
+    private Map<String, Object> analyze(
+            Device device, AgroImplement implement, Geofence field, Date from, Date to) throws StorageException {
+        List<AgroAnalyzer.Point> points = new ArrayList<>();
+        for (Position position : FleetUtil.positions(storage, device.getId(), from, to)) {
+            if (position.getValid()) {
+                points.add(new AgroAnalyzer.Point(position.getFixTime().getTime(), position.getLatitude(),
+                        position.getLongitude(), UnitsConverter.kphFromKnots(position.getSpeed()),
+                        working(implement, position)));
+            }
+        }
+        Map<String, Object> result = AgroAnalyzer.analyze(points, implement.getWidth(),
+                field != null ? polygon(field) : null);
+        result.put("deviceId", device.getId());
+        result.put("deviceName", device.getName());
+        result.put("implementId", implement.getId());
+        result.put("implementName", implement.getName());
+        result.put("width", implement.getWidth());
+        if (field != null) {
+            result.put("fieldId", field.getId());
+            result.put("fieldName", field.getName());
+            result.put("crop", field.getString(CROP));
+            result.put("fieldPolygon", polygon(field));
+        }
+        return result;
+    }
+
+    @GET
+    @Path("work")
+    public Map<String, Object> work(
+            @QueryParam("deviceId") long deviceId, @QueryParam("implementId") long implementId,
+            @QueryParam("fieldId") long fieldId, @QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        Device device = storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("id", deviceId)));
+        long id = implementId > 0 ? implementId : implementOf(device);
+        if (id == 0) {
+            throw new IllegalArgumentException("The unit has no implement");
+        }
+        Geofence field = null;
+        if (fieldId > 0) {
+            permissionsService.checkPermission(Geofence.class, getUserId(), fieldId);
+            field = storage.getObject(Geofence.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", fieldId)));
+        }
+        return analyze(device, checkImplement(id), field, from, to);
+    }
+
+    /**
+     * Worked hectares, hours and productivity of every unit with an implement in the period (no field limit).
+     */
+    @GET
+    @Path("summary")
+    public List<Map<String, Object>> summary(@QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            long id = implementOf(device);
+            if (id == 0 || result.size() >= 100) {
+                continue;
+            }
+            AgroImplement implement = storage.getObject(AgroImplement.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", id)));
+            if (implement == null) {
+                continue;
+            }
+            Map<String, Object> analysis = analyze(device, implement, null, from, to);
+            Map<String, Object> item = new LinkedHashMap<>();
+            for (String key : List.of("deviceId", "deviceName", "implementId", "implementName", "width", "workedHa",
+                    "appliedHa", "overlapPercent", "workHours", "workKm", "averageSpeedKmh", "haPerHour",
+                    "passCount")) {
+                item.put(key, analysis.get(key));
+            }
+            result.add(item);
+        }
+        return result;
+    }
+
+}
