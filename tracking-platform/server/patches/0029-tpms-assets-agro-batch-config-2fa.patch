diff --git a/src/main/java/org/traccar/agro/AgroAnalyzer.java b/src/main/java/org/traccar/agro/AgroAnalyzer.java
new file mode 100644
index 0000000..eed9d83
--- /dev/null
+++ b/src/main/java/org/traccar/agro/AgroAnalyzer.java
@@ -0,0 +1,365 @@
+/*
