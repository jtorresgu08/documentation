+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.assets;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.database.NotificationManager;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Battery powered asset trackers that report a few times a day. Each asset has its expected interval: it is "sleeping"
+ * (normal) between reports and late when the next report does not arrive in time. The battery comes from the
+ * battery level or the battery voltage (mapped between empty and full) and its trend over the last days estimates how
+ * many days are left. Alerts: missed report and low battery, once until it recovers.
+ */
+@Singleton
+public class AssetService {
+
+    public static final String MODE = "assetMode";
+    public static final String REPORT_HOURS = "reportHours";
+    public static final String BATTERY_LOW = "batteryLow";
+    public static final String FULL_VOLTS = "batteryFullVolts";
+    public static final String EMPTY_VOLTS = "batteryEmptyVolts";
+
+    private static final double GRACE = 0.25;
+
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final NotificationManager notificationManager;
+    private final Set<Long> missed = ConcurrentHashMap.newKeySet();
+    private final Set<Long> lowBattery = ConcurrentHashMap.newKeySet();
+
+    @Inject
+    public AssetService(Storage storage, CacheManager cacheManager, NotificationManager notificationManager) {
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.notificationManager = notificationManager;
+    }
+
+    public static boolean isAsset(Device device) {
+        return device != null && device.getBoolean(MODE);
+    }
+
+    public static double reportHours(Device device) {
+        double hours = device.getDouble(REPORT_HOURS);
+        return hours > 0 ? hours : 24;
+    }
+
+    public static Double battery(Device device, Position position) {
+        if (position == null) {
+            return null;
+        }
+        Object level = position.getAttributes().get(Position.KEY_BATTERY_LEVEL);
+        if (level instanceof Number number) {
+            return Math.max(0, Math.min(100, number.doubleValue()));
+        }
+        Object volts = position.getAttributes().get(Position.KEY_BATTERY);
+        if (volts instanceof Number number) {
+            double full = device.getDouble(FULL_VOLTS) > 0 ? device.getDouble(FULL_VOLTS) : 4.2;
+            double empty = device.getDouble(EMPTY_VOLTS) > 0 ? device.getDouble(EMPTY_VOLTS) : 3.4;
+            return Math.round(Math.max(0, Math.min(100, (number.doubleValue() - empty) / (full - empty) * 100)) * 10)
+                    / 10.0;
+        }
+        return null;
+    }
+
+    /**
+     * Battery points of the last days, the percent lost per day (least squares) and the days left at that pace.
+     */
+    public Map<String, Object> batteryTrend(Device device, int days) throws StorageException {
+        Date to = new Date();
+        Date from = new Date(to.getTime() - days * 86_400_000L);
+        List<Map<String, Object>> points = new ArrayList<>();
+        double n = 0;
+        double sx = 0;
+        double sy = 0;
+        double sxx = 0;
+        double sxy = 0;
+        int reports = 0;
+        Date previous = null;
+        double intervalSum = 0;
+        for (Position position : FleetUtil.positions(storage, device.getId(), from, to)) {
+            reports++;
+            if (previous != null) {
+                intervalSum += (position.getFixTime().getTime() - previous.getTime()) / 3_600_000.0;
+            }
+            previous = position.getFixTime();
+            Double percent = battery(device, position);
+            if (percent == null) {
+                continue;
+            }
+            Map<String, Object> point = new LinkedHashMap<>();
+            point.put("time", position.getFixTime());
+            point.put("battery", percent);
+            points.add(point);
+            double x = (position.getFixTime().getTime() - from.getTime()) / 86_400_000.0;
+            n++;
+            sx += x;
+            sy += percent;
+            sxx += x * x;
+            sxy += x * percent;
+        }
+        Double perDay = null;
+        if (n >= 3 && n * sxx - sx * sx > 1e-9) {
+            perDay = -(n * sxy - sx * sy) / (n * sxx - sx * sx);
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("points", points);
+        result.put("dropPerDay", perDay != null ? Math.round(perDay * 100) / 100.0 : null);
+        result.put("reports", reports);
+        result.put("averageIntervalHours", reports > 1 ? Math.round(intervalSum / (reports - 1) * 10) / 10.0 : null);
+        return result;
+    }
+
+    public Map<String, Object> summary(Device device, Position position, boolean trend) throws StorageException {
+        double hours = reportHours(device);
+        long now = System.currentTimeMillis();
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("deviceId", device.getId());
+        result.put("name", device.getName());
+        result.put("reportHours", hours);
+        result.put("batteryLow", device.getDouble(BATTERY_LOW) > 0 ? device.getDouble(BATTERY_LOW) : 20);
+        result.put("batteryFullVolts", device.getDouble(FULL_VOLTS) > 0 ? device.getDouble(FULL_VOLTS) : null);
+        result.put("batteryEmptyVolts", device.getDouble(EMPTY_VOLTS) > 0 ? device.getDouble(EMPTY_VOLTS) : null);
+        if (position == null) {
+            result.put("status", "noData");
+            return result;
+        }
+        long last = position.getFixTime().getTime();
+        long next = last + Math.round(hours * 3_600_000);
+        result.put("lastReport", position.getFixTime());
+        result.put("nextReport", new Date(next));
+        result.put("hoursSince", Math.round((now - last) / 360_000.0) / 10.0);
+        result.put("status", now > next + hours * GRACE * 3_600_000 ? "late" : "sleeping");
+        result.put("latitude", position.getLatitude());
+        result.put("longitude", position.getLongitude());
+        result.put("address", position.getAddress());
+        Double battery = battery(device, position);
+        result.put("battery", battery);
+        if (trend) {
+            Map<String, Object> history = batteryTrend(device, 30);
+            Double perDay = (Double) history.get("dropPerDay");
+            result.put("dropPerDay", perDay);
+            result.put("daysLeft", battery != null && perDay != null && perDay > 0.01
+                    ? Math.round(battery / perDay) : null);
+            result.put("reports30d", history.get("reports"));
+            result.put("averageIntervalHours", history.get("averageIntervalHours"));
+        }
+        return result;
+    }
+
+    /**
+     * On every position of an asset: clears the missed report alert and checks the battery.
+     */
+    public List<Event> onPosition(Device device, Position position) throws StorageException {
+        List<Event> events = new ArrayList<>();
+        if (!isAsset(device)) {
+            return events;
+        }
+        missed.remove(device.getId());
+        Double battery = battery(device, position);
+        double limit = device.getDouble(BATTERY_LOW) > 0 ? device.getDouble(BATTERY_LOW) : 20;
+        if (battery != null && battery < limit && lowBattery.add(device.getId())) {
+            Map<String, Object> trend = batteryTrend(device, 30);
+            Double perDay = (Double) trend.get("dropPerDay");
+            Event event = new Event(Event.TYPE_ASSET_LOW_BATTERY, position);
+            event.set("batteryPercent", Math.round(battery));
+            event.set("daysLeft", perDay != null && perDay > 0.01 ? String.valueOf(Math.round(battery / perDay)) : "?");
+            event.set("severity", "medium");
+            events.add(event);
+        } else if (battery != null && battery >= limit + 5) {
+            lowBattery.remove(device.getId());
+        }
+        return events;
+    }
+
+    /**
+     * Periodic check: assets whose report is late raise one alert until they report again.
+     */
+    public void checkMissed() throws StorageException {
+        long now = System.currentTimeMillis();
+        Map<Event, Position> events = new HashMap<>();
+        for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+            if (!isAsset(device) || missed.contains(device.getId())) {
+                continue;
+            }
+            Position position = FleetUtil.latest(storage, cacheManager, device);
+            if (position == null) {
+                continue;
+            }
+            double hours = reportHours(device);
+            double since = (now - position.getFixTime().getTime()) / 3_600_000.0;
+            if (since > hours * (1 + GRACE)) {
+                missed.add(device.getId());
+                Event event = new Event(Event.TYPE_ASSET_MISSED_REPORT, position);
+                event.setEventTime(new Date());
+                event.set("hours", String.valueOf(Math.round(since * 10) / 10.0));
+                event.set("reportHours", String.valueOf(hours));
+                event.set("severity", "medium");
+                events.put(event, position);
+            }
+        }
+        if (!events.isEmpty()) {
+            notificationManager.updateEvents(events);
+        }
+    }
+
+}
