+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.helper.model;
+
+import org.traccar.api.security.PermissionsService;
+import org.traccar.model.Device;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.Collection;
+import java.util.Date;
+import java.util.List;
+
+/**
+ * Helpers shared by the fleet modules: devices a user can see, latest position and saving device attributes.
+ */
+public final class FleetUtil {
+
+    private FleetUtil() {
+    }
+
+    public static Collection<Device> devices(
+            Storage storage, PermissionsService permissionsService, long userId) throws StorageException {
+        return permissionsService.notAdmin(userId)
+                ? storage.getObjects(Device.class, new Request(
+                        new Columns.All(), new Condition.Permission(User.class, userId, Device.class)))
+                : storage.getObjects(Device.class, new Request(new Columns.All()));
+    }
+
+    public static Position latest(Storage storage, CacheManager cacheManager, Device device) throws StorageException {
+        Position position = cacheManager.getPosition(device.getId());
+        if (position == null && device.getPositionId() > 0) {
+            position = storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", device.getPositionId())));
+        }
+        return position;
+    }
+
+    public static List<Position> positions(Storage storage, long deviceId, Date from, Date to) throws StorageException {
+        return storage.getObjects(Position.class, new Request(
+                new Columns.All(), new Condition.And(
+                        new Condition.Equals("deviceId", deviceId),
+                        new Condition.Between("fixTime", from, to)),
+                new Order("fixTime")));
+    }
+
+    public static void saveAttributes(Storage storage, CacheManager cacheManager, Device device) throws Exception {
+        storage.updateObject(device, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", device.getId())));
+        cacheManager.invalidateObject(true, Device.class, device.getId(), ObjectOperation.UPDATE);
+    }
+
+    public static void checkWritable(PermissionsService permissionsService, long userId) throws StorageException {
+        if (permissionsService.getUser(userId).getReadonly()) {
+            throw new SecurityException("Read-only user");
+        }
+    }
+
+}
