+                throw new SecurityException(CODE_FAILED);
             }
         }
     }
diff --git a/src/main/java/org/traccar/api/security/TwoFactor.java b/src/main/java/org/traccar/api/security/TwoFactor.java
new file mode 100644
index 0000000..94d396d
--- /dev/null
+++ b/src/main/java/org/traccar/api/security/TwoFactor.java
@@ -0,0 +1,124 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.security;
+
+import org.traccar.config.Keys;
+import org.traccar.model.Server;
+import org.traccar.model.User;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Two-factor authentication helpers: one-time recovery codes (nine digits, stored hashed) and whether an account must
+ * use a second factor (its own setting, a manager above it or the whole server).
+ */
+public final class TwoFactor {
+
+    public static final String RECOVERY = "totpRecovery";
+    public static final String REQUIRED = "totpRequired";
+    public static final int RECOVERY_MIN = 100_000_000;
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private TwoFactor() {
+    }
+
+    public static String hash(int code) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(
+                    String.valueOf(code).getBytes(StandardCharsets.US_ASCII));
+            return HexFormat.of().formatHex(digest);
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    public static List<Integer> generateRecovery(User user, int count) {
+        List<Integer> codes = new ArrayList<>();
+        List<String> hashes = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            int code = RECOVERY_MIN + RANDOM.nextInt(900_000_000);
+            codes.add(code);
+            hashes.add(hash(code));
+        }
+        user.set(RECOVERY, String.join(",", hashes));
+        return codes;
+    }
+
+    public static int recoveryLeft(User user) {
+        String value = user.getString(RECOVERY);
+        return value == null || value.isBlank() ? 0 : value.split(",").length;
+    }
+
+    /**
+     * Uses a recovery code: true and removed from the list when it matches one.
+     */
+    public static boolean consumeRecovery(Storage storage, User user, int code) throws StorageException {
+        String value = user.getString(RECOVERY);
+        if (value == null || value.isBlank()) {
+            return false;
+        }
+        List<String> hashes = new ArrayList<>(Arrays.asList(value.split(",")));
+        String hash = hash(code);
+        boolean found = false;
+        for (String item : hashes) {
+            found |= MessageDigest.isEqual(item.getBytes(StandardCharsets.US_ASCII),
+                    hash.getBytes(StandardCharsets.US_ASCII));
+        }
+        if (!found) {
+            return false;
+        }
+        hashes.remove(hash);
+        if (hashes.isEmpty()) {
+            user.getAttributes().remove(RECOVERY);
+        } else {
+            user.set(RECOVERY, String.join(",", hashes));
+        }
+        storage.updateObject(user, new Request(new Columns.Include("attributes"),
+                new Condition.Equals("id", user.getId())));
+        return true;
+    }
+
+    public static boolean required(Storage storage, Set<Long> ancestors, User user) throws StorageException {
+        if (user.getBoolean(REQUIRED)) {
+            return true;
+        }
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        if (server != null && server.getBoolean(Keys.WEB_TOTP_FORCE.getKey())) {
+            return true;
+        }
+        for (long ancestorId : ancestors) {
+            User ancestor = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ancestorId)));
+            if (ancestor != null && ancestor.getBoolean(REQUIRED)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+}
