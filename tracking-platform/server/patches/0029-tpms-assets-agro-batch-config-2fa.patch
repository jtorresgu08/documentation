+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.tpms;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Tire pressure monitoring. Each vehicle has its layout (wheels per axle, front to back, left to right), the position
+ * attributes that carry each tire's pressure and temperature ({n} = tire number), the unit the device reports and the
+ * limits; tires are evaluated on every position and an alert is raised when a tire goes low, high or hot.
+ */
+@Singleton
+public class TpmsService {
+
+    public static final String ATTRIBUTE = "tpms";
+
+    public enum Status { OK, LOW, HIGH, HOT, NO_DATA }
+
+    public record Config(
+            List<Integer> axles, String pressureAttribute, String temperatureAttribute, String sourceUnit,
+            String unit, double minPressure, double maxPressure, double maxTemperature, Map<String, String> names) {
+
+        public int wheels() {
+            return axles.stream().mapToInt(Integer::intValue).sum();
+        }
+    }
+
+    public record Wheel(
+            int number, int axle, int index, String name, Double pressure, Double temperature, Status status) {
+    }
+
+    private final ObjectMapper objectMapper;
+    private final Map<String, Status> alarms = new ConcurrentHashMap<>();
+
+    @Inject
+    public TpmsService(ObjectMapper objectMapper) {
+        this.objectMapper = objectMapper;
+    }
+
+    private static double kpa(String unit) {
+        return switch (unit == null ? "psi" : unit.toLowerCase()) {
+            case "bar" -> 100;
+            case "kpa" -> 1;
+            default -> 6.894757;
+        };
+    }
+
+    public static double convert(double value, String from, String to) {
+        return value * kpa(from) / kpa(to);
+    }
+
+    @SuppressWarnings("unchecked")
+    public Config config(Device device) {
+        Object raw = device != null ? device.getAttributes().get(ATTRIBUTE) : null;
+        if (raw == null) {
+            return null;
+        }
+        try {
+            Map<String, Object> map = raw instanceof Map<?, ?> value ? (Map<String, Object>) value
+                    : objectMapper.readValue(String.valueOf(raw), new TypeReference<>() { });
+            return config(map);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    public static Config config(Map<String, Object> map) {
+        List<Integer> axles = new ArrayList<>();
+        for (Object axle : (List<Object>) map.getOrDefault("axles", List.of(2, 4))) {
+            int wheels = ((Number) axle).intValue();
+            if (wheels != 2 && wheels != 4) {
+                throw new IllegalArgumentException("Each axle has 2 or 4 wheels");
+            }
+            axles.add(wheels);
+        }
+        if (axles.isEmpty() || axles.size() > 8) {
+            throw new IllegalArgumentException("Between 1 and 8 axles");
+        }
+        Map<String, String> names = new LinkedHashMap<>();
+        if (map.get("names") instanceof Map<?, ?> value) {
+            value.forEach((key, name) -> names.put(String.valueOf(key), String.valueOf(name)));
+        }
+        String unit = String.valueOf(map.getOrDefault("unit", "psi"));
+        return new Config(axles,
+                String.valueOf(map.getOrDefault("pressureAttribute", "tire{n}Pressure")),
+                String.valueOf(map.getOrDefault("temperatureAttribute", "tire{n}Temperature")),
+                String.valueOf(map.getOrDefault("sourceUnit", unit)), unit,
+                number(map.get("minPressure"), convert(90, "psi", unit)),
+                number(map.get("maxPressure"), convert(130, "psi", unit)),
+                number(map.get("maxTemperature"), 75), names);
+    }
+
+    private static double number(Object value, double fallback) {
+        return value instanceof Number number ? number.doubleValue() : fallback;
+    }
+
+    public static Map<String, Object> toMap(Config config) {
+        Map<String, Object> map = new LinkedHashMap<>();
+        map.put("axles", config.axles());
+        map.put("pressureAttribute", config.pressureAttribute());
+        map.put("temperatureAttribute", config.temperatureAttribute());
+        map.put("sourceUnit", config.sourceUnit());
+        map.put("unit", config.unit());
+        map.put("minPressure", config.minPressure());
+        map.put("maxPressure", config.maxPressure());
+        map.put("maxTemperature", config.maxTemperature());
+        map.put("names", config.names());
+        return map;
+    }
+
+    private static Double attribute(Position position, String pattern, int number) {
+        if (position == null) {
+            return null;
+        }
+        Object value = position.getAttributes().get(pattern.replace("{n}", String.valueOf(number)));
+        if (value instanceof Number numeric) {
+            return numeric.doubleValue();
+        }
+        try {
+            return value != null ? Double.parseDouble(String.valueOf(value)) : null;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    public static String defaultName(Config config, int axle, int index) {
+        int wheels = config.axles().get(axle);
+        String side = index < wheels / 2 ? "I" : "D";
+        String inner = wheels == 4 && (index == 1 || index == 2) ? "int" : wheels == 4 ? "ext" : "";
+        return "E" + (axle + 1) + " " + side + (inner.isEmpty() ? "" : " " + inner);
+    }
+
+    public List<Wheel> evaluate(Config config, Position position) {
+        List<Wheel> result = new ArrayList<>();
+        int number = 1;
+        for (int axle = 0; axle < config.axles().size(); axle++) {
+            for (int index = 0; index < config.axles().get(axle); index++) {
+                Double raw = attribute(position, config.pressureAttribute(), number);
+                Double pressure = raw != null
+                        ? Math.round(convert(raw, config.sourceUnit(), config.unit()) * 10) / 10.0 : null;
+                Double temperature = attribute(position, config.temperatureAttribute(), number);
+                Status status;
+                if (pressure == null) {
+                    status = Status.NO_DATA;
+                } else if (pressure < config.minPressure()) {
+                    status = Status.LOW;
+                } else if (pressure > config.maxPressure()) {
+                    status = Status.HIGH;
+                } else if (temperature != null && temperature > config.maxTemperature()) {
+                    status = Status.HOT;
+                } else {
+                    status = Status.OK;
+                }
+                String name = config.names().getOrDefault(String.valueOf(number), defaultName(config, axle, index));
+                result.add(new Wheel(number, axle, index, name, pressure, temperature, status));
+                number++;
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Alerts for tires that changed to low, high or hot since the last position (one per change).
+     */
+    public List<Event> onPosition(Device device, Position position) {
+        List<Event> events = new ArrayList<>();
+        Config config = config(device);
+        if (config == null) {
+            return events;
+        }
+        for (Wheel wheel : evaluate(config, position)) {
+            String key = device.getId() + ":" + wheel.number();
+            if (wheel.status() == Status.NO_DATA) {
+                continue;
+            }
+            Status previous = alarms.put(key, wheel.status());
+            if (wheel.status() != Status.OK && wheel.status() != previous) {
+                Event event = new Event(Event.TYPE_TPMS_ALARM, position);
+                event.set("wheel", wheel.number());
+                event.set("wheelName", wheel.name());
+                event.set("alarm", wheel.status().name().toLowerCase());
+                event.set("alarmText", switch (wheel.status()) {
+                    case LOW -> "con presión baja";
+                    case HIGH -> "con presión alta";
+                    default -> "con temperatura alta";
+                });
+                event.set("value", wheel.status() == Status.HOT ? wheel.temperature() : wheel.pressure());
+                event.set("unit", wheel.status() == Status.HOT ? "°C" : config.unit());
+                event.set("severity", wheel.status() == Status.HIGH ? "medium" : "high");
+                events.add(event);
+            }
+        }
+        return events;
+    }
+
+}
