+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.agro;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Field work from the track of a machine and the width of its implement. The working track is drawn on a grid as a
+ * swath as wide as the implement; every cell counts how many passes covered it (a pass ends when the heading turns
+ * more than 100 degrees from the direction it started with, as in a U-turn at the headland, or when work stops), so
+ * the worked area, the area applied twice or more (overlap) and the part of the field left without work come out of
+ * the same grid.
+ */
+public final class AgroAnalyzer {
+
+    private static final double EARTH = 6371008.8;
+    private static final double RAD = Math.PI / 180;
+    private static final int MAX_CELLS = 6_000_000;
+    private static final int MAX_DISPLAY_CELLS = 40_000;
+    private static final double TURN_DEGREES = 100;
+    private static final long MAX_GAP_MILLIS = 120_000;
+
+    public record Point(long time, double latitude, double longitude, double speedKmh, boolean working) {
+    }
+
+    private AgroAnalyzer() {
+    }
+
+    private static final class Projection {
+        private final double lat0;
+        private final double lon0;
+        private final double cos;
+
+        Projection(double lat0, double lon0) {
+            this.lat0 = lat0;
+            this.lon0 = lon0;
+            this.cos = Math.cos(lat0 * RAD);
+        }
+
+        double x(double lon) {
+            return (lon - lon0) * RAD * EARTH * cos;
+        }
+
+        double y(double lat) {
+            return (lat - lat0) * RAD * EARTH;
+        }
+
+        double lon(double x) {
+            return lon0 + x / (RAD * EARTH * cos);
+        }
+
+        double lat(double y) {
+            return lat0 + y / (RAD * EARTH);
+        }
+    }
+
+    private static double segmentDistance(double px, double py, double ax, double ay, double bx, double by) {
+        double dx = bx - ax;
+        double dy = by - ay;
+        double length2 = dx * dx + dy * dy;
+        double t = length2 > 0 ? Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / length2)) : 0;
+        return Math.hypot(px - ax - dx * t, py - ay - dy * t);
+    }
+
+    /**
+     * @param points track ordered by time
+     * @param width implement width in meters
+     * @param field field polygon as [lat, lon] points, or null to count all the work
+     */
+    public static Map<String, Object> analyze(List<Point> points, double width, List<double[]> field) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        if (width <= 0) {
+            throw new IllegalArgumentException("The implement needs a width");
+        }
+        List<Point> working = points.stream().filter(Point::working).toList();
+        double lat0;
+        double lon0;
+        if (field != null && field.size() >= 3) {
+            lat0 = field.stream().mapToDouble(p -> p[0]).average().orElse(0);
+            lon0 = field.stream().mapToDouble(p -> p[1]).average().orElse(0);
+        } else if (!working.isEmpty()) {
+            lat0 = working.get(0).latitude();
+            lon0 = working.get(0).longitude();
+        } else {
+            result.put("workedHa", 0.0);
+            result.put("passes", List.of());
+            return emptyResult(result, field);
+        }
+        Projection projection = new Projection(lat0, lon0);
+        double[] fx = null;
+        double[] fy = null;
+        double minX;
+        double minY;
+        double maxX;
+        double maxY;
+        if (field != null && field.size() >= 3) {
+            fx = field.stream().mapToDouble(p -> projection.x(p[1])).toArray();
+            fy = field.stream().mapToDouble(p -> projection.y(p[0])).toArray();
+            minX = Arrays.stream(fx).min().orElse(0);
+            maxX = Arrays.stream(fx).max().orElse(0);
+            minY = Arrays.stream(fy).min().orElse(0);
+            maxY = Arrays.stream(fy).max().orElse(0);
+        } else {
+            minX = working.stream().mapToDouble(p -> projection.x(p.longitude())).min().orElse(0) - width;
+            maxX = working.stream().mapToDouble(p -> projection.x(p.longitude())).max().orElse(0) + width;
+            minY = working.stream().mapToDouble(p -> projection.y(p.latitude())).min().orElse(0) - width;
+            maxY = working.stream().mapToDouble(p -> projection.y(p.latitude())).max().orElse(0) + width;
+        }
+        double cell = Math.max(0.5, Math.min(4, width / 4));
+        cell = Math.max(cell, Math.sqrt((maxX - minX) * (maxY - minY) / MAX_CELLS));
+        int nx = Math.max(1, (int) Math.ceil((maxX - minX) / cell));
+        int ny = Math.max(1, (int) Math.ceil((maxY - minY) / cell));
+        short[] counts = new short[nx * ny];
+        int[] lastPass = new int[nx * ny];
+        Arrays.fill(lastPass, -1);
+        boolean[] inside = new boolean[nx * ny];
+        if (fx != null) {
+            // scanline per row: the cells between pairs of edge crossings are inside the field
+            for (int row = 0; row < ny; row++) {
+                double y = minY + (row + 0.5) * cell;
+                List<Double> crossings = new ArrayList<>();
+                for (int i = 0, j = fx.length - 1; i < fx.length; j = i++) {
+                    if ((fy[i] > y) != (fy[j] > y)) {
+                        crossings.add(fx[i] + (y - fy[i]) / (fy[j] - fy[i]) * (fx[j] - fx[i]));
+                    }
+                }
+                crossings.sort(Double::compare);
+                for (int k = 0; k + 1 < crossings.size(); k += 2) {
+                    int from = Math.max(0, (int) Math.ceil((crossings.get(k) - minX) / cell - 0.5));
+                    int to = Math.min(nx - 1, (int) Math.floor((crossings.get(k + 1) - minX) / cell - 0.5));
+                    for (int col = from; col <= to; col++) {
+                        inside[row * nx + col] = true;
+                    }
+                }
+            }
+        } else {
+            Arrays.fill(inside, true);
+        }
+
+        double half = width / 2;
+        int pass = -1;
+        Double passHeading = null;
+        long workMillis = 0;
+        double workMeters = 0;
+        List<Map<String, Object>> passes = new ArrayList<>();
+        List<List<double[]>> tracks = new ArrayList<>();
+        List<double[]> track = null;
+        Map<String, Object> current = null;
+        for (int i = 1; i < points.size(); i++) {
+            Point a = points.get(i - 1);
+            Point b = points.get(i);
+            double ax = projection.x(a.longitude());
+            double ay = projection.y(a.latitude());
+            double bx = projection.x(b.longitude());
+            double by = projection.y(b.latitude());
+            double length = Math.hypot(bx - ax, by - ay);
+            long dt = b.time() - a.time();
+            if (!a.working() || !b.working() || dt <= 0 || dt > MAX_GAP_MILLIS || length > 300) {
+                passHeading = null;
+                current = null;
+                track = null;
+                continue;
+            }
+            if (length < 0.2) {
+                continue;
+            }
+            double heading = Math.toDegrees(Math.atan2(bx - ax, by - ay));
+            double turn = passHeading == null ? 360 : Math.abs(((heading - passHeading) % 360 + 540) % 360 - 180);
+            if (passHeading == null || turn > TURN_DEGREES) {
+                passHeading = heading;
+                pass++;
+                current = new LinkedHashMap<>();
+                current.put("number", pass + 1);
+                current.put("start", a.time());
+                current.put("meters", 0.0);
+                passes.add(current);
+                track = new ArrayList<>();
+                track.add(new double[] {a.latitude(), a.longitude()});
+                tracks.add(track);
+            }
+            current.put("end", b.time());
+            current.put("meters", (Double) current.get("meters") + length);
+            track.add(new double[] {b.latitude(), b.longitude()});
+            workMillis += dt;
+            workMeters += length;
+            int c0 = Math.max(0, (int) Math.floor((Math.min(ax, bx) - half - minX) / cell));
+            int c1 = Math.min(nx - 1, (int) Math.floor((Math.max(ax, bx) + half - minX) / cell));
+            int r0 = Math.max(0, (int) Math.floor((Math.min(ay, by) - half - minY) / cell));
+            int r1 = Math.min(ny - 1, (int) Math.floor((Math.max(ay, by) + half - minY) / cell));
+            for (int row = r0; row <= r1; row++) {
+                double cy = minY + (row + 0.5) * cell;
+                for (int col = c0; col <= c1; col++) {
+                    double cx = minX + (col + 0.5) * cell;
+                    int index = row * nx + col;
+                    if (lastPass[index] != pass && segmentDistance(cx, cy, ax, ay, bx, by) <= half) {
+                        lastPass[index] = pass;
+                        if (counts[index] < Short.MAX_VALUE) {
+                            counts[index]++;
+                        }
+                    }
+                }
+            }
+        }
+
+        double cellArea = cell * cell;
+        long worked = 0;
+        long applied = 0;
+        long outside = 0;
+        long fieldCells = 0;
+        for (int i = 0; i < counts.length; i++) {
+            if (inside[i]) {
+                fieldCells++;
+                if (counts[i] > 0) {
+                    worked++;
+                    applied += counts[i];
+                }
+            } else if (counts[i] > 0) {
+                outside++;
+            }
+        }
+        double workedHa = worked * cellArea / 10_000;
+        double appliedHa = applied * cellArea / 10_000;
+        double fieldHa = fx != null ? polygonArea(fx, fy) / 10_000 : 0;
+        double hours = workMillis / 3_600_000.0;
+        result.put("cellMeters", Math.round(cell * 100) / 100.0);
+        result.put("fieldHa", fx != null ? round(fieldHa, 2) : null);
+        result.put("workedHa", round(workedHa, 2));
+        result.put("appliedHa", round(appliedHa, 2));
+        result.put("overlapHa", round(appliedHa - workedHa, 2));
+        result.put("overlapPercent", appliedHa > 0 ? round((appliedHa - workedHa) / appliedHa * 100, 1) : 0.0);
+        result.put("coveragePercent", fx != null && fieldHa > 0 ? round(Math.min(100, workedHa / fieldHa * 100), 1)
+                : null);
+        result.put("missedHa", fx != null ? round(Math.max(0, fieldHa - workedHa), 2) : null);
+        result.put("outsideHa", fx != null ? round(outside * cellArea / 10_000, 2) : null);
+        result.put("workHours", round(hours, 2));
+        result.put("workKm", round(workMeters / 1000, 2));
+        result.put("averageSpeedKmh", hours > 0 ? round(workMeters / 1000 / hours, 1) : null);
+        result.put("haPerHour", hours > 0 ? round(workedHa / hours, 2) : null);
+        result.put("passCount", passes.size());
+        passes.forEach(item -> item.put("meters", Math.round((Double) item.get("meters"))));
+        result.put("passes", passes);
+        result.put("tracks", tracks);
+        result.put("coverage", display(counts, inside, nx, ny, cell, minX, minY, projection, fx != null));
+        return result;
+    }
+
+    private static Map<String, Object> emptyResult(Map<String, Object> result, List<double[]> field) {
+        result.put("appliedHa", 0.0);
+        result.put("overlapHa", 0.0);
+        result.put("overlapPercent", 0.0);
+        result.put("workHours", 0.0);
+        result.put("workKm", 0.0);
+        result.put("passCount", 0);
+        result.put("tracks", List.of());
+        result.put("coverage", Map.of("type", "FeatureCollection", "features", List.of()));
+        if (field != null && field.size() >= 3) {
+            Projection projection = new Projection(field.get(0)[0], field.get(0)[1]);
+            double[] fx = field.stream().mapToDouble(p -> projection.x(p[1])).toArray();
+            double[] fy = field.stream().mapToDouble(p -> projection.y(p[0])).toArray();
+            double fieldHa = polygonArea(fx, fy) / 10_000;
+            result.put("fieldHa", round(fieldHa, 2));
+            result.put("coveragePercent", 0.0);
+            result.put("missedHa", round(fieldHa, 2));
+        }
+        return result;
+    }
+
+    /**
+     * Coverage for the map: a coarser grid (at most about 40 000 cells) where each cell keeps the passes most of its
+     * covered cells had (1, 2 or 3+), cells left without work inside the field as 0, joined into rectangles per row.
+     */
+    private static Map<String, Object> display(
+            short[] counts, boolean[] inside, int nx, int ny, double cell, double minX, double minY,
+            Projection projection, boolean field) {
+        int factor = Math.max(1, (int) Math.ceil(Math.sqrt((double) nx * ny / MAX_DISPLAY_CELLS)));
+        int dx = (nx + factor - 1) / factor;
+        int dy = (ny + factor - 1) / factor;
+        List<Map<String, Object>> features = new ArrayList<>();
+        for (int row = 0; row < dy; row++) {
+            int runStart = -1;
+            int runValue = -1;
+            for (int col = 0; col <= dx; col++) {
+                int value = -1;
+                if (col < dx) {
+                    int[] buckets = new int[4];
+                    int insideCells = 0;
+                    int total = 0;
+                    for (int r = row * factor; r < Math.min(ny, (row + 1) * factor); r++) {
+                        for (int c = col * factor; c < Math.min(nx, (col + 1) * factor); c++) {
+                            int index = r * nx + c;
+                            total++;
+                            if (inside[index]) {
+                                insideCells++;
+                            }
+                            if (counts[index] > 0 && (inside[index] || !field)) {
+                                buckets[Math.min(3, counts[index])]++;
+                            } else if (inside[index] && field) {
+                                buckets[0]++;
+                            }
+                        }
+                    }
+                    int covered = buckets[1] + buckets[2] + buckets[3];
+                    if (covered * 2 >= Math.max(1, field ? insideCells : total) && covered > 0) {
+                        value = buckets[3] >= buckets[2] && buckets[3] >= buckets[1] ? 3
+                                : buckets[2] >= buckets[1] ? 2 : 1;
+                    } else if (field && insideCells * 2 >= total) {
+                        value = 0;
+                    }
+                }
+                if (value != runValue) {
+                    if (runValue >= 0) {
+                        double x0 = minX + runStart * factor * cell;
+                        double x1 = minX + Math.min(nx, col * factor) * cell;
+                        double y0 = minY + row * factor * cell;
+                        double y1 = minY + Math.min(ny, (row + 1) * factor) * cell;
+                        List<List<Double>> ring = new ArrayList<>();
+                        for (double[] corner : new double[][] {{x0, y0}, {x1, y0}, {x1, y1}, {x0, y1}, {x0, y0}}) {
+                            ring.add(List.of(round(projection.lon(corner[0]), 7), round(projection.lat(corner[1]), 7)));
+                        }
+                        Map<String, Object> feature = new LinkedHashMap<>();
+                        feature.put("type", "Feature");
+                        feature.put("properties", Map.of("passes", runValue));
+                        feature.put("geometry", Map.of("type", "Polygon", "coordinates", List.of(ring)));
+                        features.add(feature);
+                    }
+                    runStart = col;
+                    runValue = value;
+                }
+            }
+        }
+        Map<String, Object> collection = new LinkedHashMap<>();
+        collection.put("type", "FeatureCollection");
+        collection.put("features", features);
+        return collection;
+    }
+
+    private static double polygonArea(double[] x, double[] y) {
+        double sum = 0;
+        for (int i = 0, j = x.length - 1; i < x.length; j = i++) {
+            sum += (x[j] + x[i]) * (y[j] - y[i]);
+        }
+        return Math.abs(sum / 2);
+    }
+
+    private static double round(double value, int digits) {
+        double factor = Math.pow(10, digits);
+        return Math.round(value * factor) / factor;
+    }
+
+}
