diff --git a/src/test/java/org/traccar/agro/AgroAnalyzerTest.java b/src/test/java/org/traccar/agro/AgroAnalyzerTest.java
new file mode 100644
index 0000000..b510536
--- /dev/null
+++ b/src/test/java/org/traccar/agro/AgroAnalyzerTest.java
@@ -0,0 +1,70 @@
+package org.traccar.agro;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class AgroAnalyzerTest {
+
+    private static final double LAT = -12.0;
+    private static final double LON = -77.0;
+    private static final double M_LAT = 1 / 111_195.0;
+    private static final double M_LON = 1 / (111_195.0 * Math.cos(Math.toRadians(LAT)));
+
+    private static List<double[]> square(double meters) {
+        return List.of(new double[] {LAT, LON}, new double[] {LAT, LON + meters * M_LON},
+                new double[] {LAT + meters * M_LAT, LON + meters * M_LON}, new double[] {LAT + meters * M_LAT, LON});
+    }
+
+    // passes north-south 10 m apart, a point every 5 m at 9 km/h
+    private static List<AgroAnalyzer.Point> serpentine(int passes, double spacing) {
+        List<AgroAnalyzer.Point> points = new ArrayList<>();
+        long time = 0;
+        for (int pass = 0; pass < passes; pass++) {
+            double x = spacing / 2 + pass * spacing;
+            for (int step = 0; step <= 20; step++) {
+                double y = pass % 2 == 0 ? step * 5 : 100 - step * 5;
+                points.add(new AgroAnalyzer.Point(time, LAT + y * M_LAT, LON + x * M_LON, 9, true));
+                time += 2000;
+            }
+        }
+        return points;
+    }
+
+    @Test
+    public void testCoverage() {
+        Map<String, Object> result = AgroAnalyzer.analyze(serpentine(10, 10), 10, square(100));
+        assertEquals(1.0, (Double) result.get("fieldHa"), 0.01);
+        assertEquals(10, result.get("passCount"));
+        assertTrue((Double) result.get("coveragePercent") > 95, result.get("coveragePercent").toString());
+        assertTrue((Double) result.get("overlapPercent") < 5, result.get("overlapPercent").toString());
+        // only the headland turns (half the implement past the edge) fall outside the field
+        assertTrue((Double) result.get("outsideHa") < 0.1, result.get("outsideHa").toString());
+    }
+
+    @Test
+    public void testOverlapAndMissed() {
+        // 15 m implement at 10 m spacing on 6 passes: a third applied twice and the east part left without work
+        Map<String, Object> result = AgroAnalyzer.analyze(serpentine(6, 10), 15, square(100));
+        assertTrue((Double) result.get("overlapPercent") > 20, result.get("overlapPercent").toString());
+        assertTrue((Double) result.get("missedHa") > 0.3, result.get("missedHa").toString());
+        assertTrue((Double) result.get("coveragePercent") < 70, result.get("coveragePercent").toString());
+    }
+
+    @Test
+    public void testNotWorking() {
+        List<AgroAnalyzer.Point> points = new ArrayList<>();
+        for (AgroAnalyzer.Point point : serpentine(4, 10)) {
+            points.add(new AgroAnalyzer.Point(point.time(), point.latitude(), point.longitude(), 9, false));
+        }
+        Map<String, Object> result = AgroAnalyzer.analyze(points, 10, square(100));
+        assertEquals(0.0, (Double) result.get("workedHa"), 0.001);
+        assertEquals(0.0, (Double) result.get("coveragePercent"), 0.001);
+    }
+
+}
