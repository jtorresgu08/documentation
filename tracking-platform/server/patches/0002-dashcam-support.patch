+package org.traccar.protocol;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+
+/**
+ * Splits JT/T 808 messages (0x7e delimited) from raw file data frames, which start with 0x30316364 ("01cd")
+ * followed by file name (50), offset (4), length (4) and data.
+ */
+public class Jt808AttachFrameDecoder extends HuabaoFrameDecoder {
+
+    public static final int DATA_HEADER = 0x30316364;
+    public static final int DATA_HEADER_LENGTH = 4 + 50 + 4 + 4;
+
+    @Override
+    protected Object decode(
+            ChannelHandlerContext ctx, Channel channel, ByteBuf buf) throws Exception {
+
+        if (buf.readableBytes() >= 4 && buf.getInt(buf.readerIndex()) == DATA_HEADER) {
+            if (buf.readableBytes() < DATA_HEADER_LENGTH) {
+                return null;
+            }
+            long length = buf.getUnsignedInt(buf.readerIndex() + DATA_HEADER_LENGTH - 4);
+            if (buf.readableBytes() >= DATA_HEADER_LENGTH + length) {
+                return buf.readRetainedSlice(DATA_HEADER_LENGTH + (int) length);
+            }
+            return null;
+        }
+
+        return super.decode(ctx, channel, buf);
+    }
+
+}
