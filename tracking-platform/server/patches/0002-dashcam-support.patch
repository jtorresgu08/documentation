+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.protocol;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.ByteBufUtil;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+import org.traccar.BaseProtocolDecoder;
+import org.traccar.NetworkMessage;
+import org.traccar.Protocol;
+import org.traccar.model.Position;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.net.SocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+
+public class Jt808AttachProtocolDecoder extends BaseProtocolDecoder {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(Jt808AttachProtocolDecoder.class);
+
+    public static final int MSG_ALARM_ATTACHMENT_INFO = 0x1210;
+    public static final int MSG_FILE_INFO = 0x1211;
+    public static final int MSG_FILE_COMPLETE = 0x1212;
+    public static final int MSG_FILE_COMPLETE_RESPONSE = 0x9212;
+
+    public static final int MAX_FILE_SIZE = 64 * 1024 * 1024;
+    public static final int MAX_PENDING_FILES = 16;
+
+    private static final class PendingFile {
+        private final int type;
+        private final long size;
+        private final ByteBuf data;
+
+        private PendingFile(int type, long size) {
+            this.type = type;
+            this.size = size;
+            this.data = Unpooled.buffer((int) Math.min(size, 1024 * 1024));
+        }
+    }
+
+    private final Map<String, PendingFile> files = new HashMap<>();
+    private String alarmReference;
+    private String alarmNumber;
+    private HuabaoProtocolDecoder.AttachmentTarget target;
+
+    public Jt808AttachProtocolDecoder(Protocol protocol) {
+        super(protocol);
+    }
+
+    @Override
+    public void handlerRemoved(ChannelHandlerContext ctx) throws Exception {
+        files.values().forEach(file -> file.data.release());
+        files.clear();
+        super.handlerRemoved(ctx);
+    }
+
+    private void sendGeneralResponse(Channel channel, SocketAddress remoteAddress, ByteBuf id, int type, int index) {
+        if (channel != null) {
+            ByteBuf response = Unpooled.buffer();
+            response.writeShort(index);
+            response.writeShort(type);
+            response.writeByte(HuabaoProtocolDecoder.RESULT_SUCCESS);
+            channel.writeAndFlush(new NetworkMessage(HuabaoProtocolDecoder.formatMessage(
+                    0x7e, HuabaoProtocolDecoder.MSG_GENERAL_RESPONSE, id, false, response), remoteAddress));
+        }
+    }
+
+    private static String readName(ByteBuf buf) {
+        return buf.readCharSequence(buf.readUnsignedByte(), StandardCharsets.US_ASCII).toString();
+    }
+
+    private static String extension(String name, int type) {
+        int dot = name.lastIndexOf('.');
+        if (dot >= 0 && dot < name.length() - 1) {
+            return name.substring(dot + 1).toLowerCase();
+        }
+        return switch (type) {
+            case 0 -> "jpg";
+            case 1 -> "wav";
+            case 2 -> "mp4";
+            default -> "bin";
+        };
+    }
+
+    private static String baseName(String name) {
+        int dot = name.lastIndexOf('.');
+        return dot > 0 ? name.substring(0, dot) : name;
+    }
+
+    /**
+     * File names follow "type_channel_alarm_index_alarmNumber.ext", where alarm is 64xx (ADAS) or 65xx (DMS).
+     */
+    private static void decodeFileName(Position position, String name) {
+        String[] parts = baseName(name).split("_");
+        if (parts.length >= 3) {
+            try {
+                position.set("channel", Integer.parseInt(parts[1]));
+            } catch (NumberFormatException ignored) {
+                // non standard name
+            }
+            String code = parts[2];
+            if (code.length() == 4 && (code.startsWith("64") || code.startsWith("65"))) {
+                try {
+                    String alarm = HuabaoProtocolDecoder.getDriverAssistanceAlarm(
+                            code.startsWith("64"), Integer.parseInt(code.substring(2), 16));
+                    if (alarm != null) {
+                        position.set("mediaAlarm", alarm);
+                    }
+                } catch (NumberFormatException ignored) {
+                    // non standard name
+                }
+            }
+        }
+    }
+
+    @Override
+    protected Object decode(Channel channel, SocketAddress remoteAddress, Object msg) throws Exception {
+
+        ByteBuf buf = (ByteBuf) msg;
+
+        if (buf.getInt(buf.readerIndex()) == Jt808AttachFrameDecoder.DATA_HEADER) {
+            buf.skipBytes(4);
+            String name = buf.readCharSequence(50, StandardCharsets.US_ASCII).toString().trim().replace("\0", "");
+            long offset = buf.readUnsignedInt();
+            long length = buf.readUnsignedInt();
+            PendingFile file = files.get(name);
+            if (file != null && offset + length <= file.size) {
+                if (offset + length > file.data.capacity()) {
+                    file.data.capacity((int) (offset + length));
+                }
+                file.data.setBytes((int) offset, buf, buf.readerIndex(), (int) length);
+                file.data.writerIndex((int) Math.max(file.data.writerIndex(), offset + length));
+            }
+            return null;
+        }
+
+        buf.readUnsignedByte(); // delimiter
+        int type = buf.readUnsignedShort();
+        buf.readUnsignedShort(); // attributes
+        ByteBuf id = buf.readSlice(6);
+        int index = buf.readUnsignedShort();
+
+        switch (type) {
+            case MSG_ALARM_ATTACHMENT_INFO -> {
+                buf.skipBytes(7); // terminal id
+                alarmReference = ByteBufUtil.hexDump(buf.readSlice(16));
+                alarmNumber = buf.readCharSequence(32, StandardCharsets.US_ASCII).toString().trim();
+                target = HuabaoProtocolDecoder.findAttachmentTarget(alarmNumber);
+                if (target == null || !target.uniqueId().equals(HuabaoProtocolDecoder.decodeId(id))) {
+                    target = null;
+                    LOGGER.warn("Attachment upload for unknown alarm {} from {}",
+                            alarmNumber, HuabaoProtocolDecoder.decodeId(id));
+                }
+                sendGeneralResponse(channel, remoteAddress, id, type, index);
+            }
+            case MSG_FILE_INFO -> {
+                String name = readName(buf);
+                int fileType = buf.readUnsignedByte();
+                long size = buf.readUnsignedInt();
+                // only files of alarms this server asked for, bounded in number and size
+                if (target != null && size <= MAX_FILE_SIZE
+                        && (files.containsKey(name) || files.size() < MAX_PENDING_FILES)) {
+                    PendingFile previous = files.put(name, new PendingFile(fileType, size));
+                    if (previous != null) {
+                        previous.data.release();
+                    }
+                }
+                sendGeneralResponse(channel, remoteAddress, id, type, index);
+            }
+            case MSG_FILE_COMPLETE -> {
+                String name = readName(buf);
+                int fileType = buf.readUnsignedByte();
+                long size = buf.readUnsignedInt();
+                PendingFile file = files.get(name);
+                boolean complete = file != null && file.data.writerIndex() >= size;
+
+                if (channel != null) {
+                    ByteBuf response = Unpooled.buffer();
+                    response.writeByte(name.length());
+                    response.writeCharSequence(name, StandardCharsets.US_ASCII);
+                    response.writeByte(fileType);
+                    response.writeByte(complete ? 0 : 1);
+                    response.writeByte(0); // packets to retransmit
+                    channel.writeAndFlush(new NetworkMessage(HuabaoProtocolDecoder.formatMessage(
+                            0x7e, MSG_FILE_COMPLETE_RESPONSE, id, false, response), remoteAddress));
+                }
+
+                if (complete) {
+                    files.remove(name);
+                    try {
+                        if (target == null) {
+                            return null;
+                        }
+                        // reported as the main protocol so the latest position keeps offering its commands
+                        Position position = new Position("huabao");
+                        position.setDeviceId(target.deviceId());
+                        getLastLocation(position, null);
+                        file.data.writerIndex((int) size);
+                        String key = switch (file.type) {
+                            case 1 -> Position.KEY_AUDIO;
+                            case 2 -> Position.KEY_VIDEO;
+                            default -> Position.KEY_IMAGE;
+                        };
+                        position.set(key, writeMediaFile(
+                                target.uniqueId(), file.data, baseName(name), extension(name, file.type)));
+                        position.set("alarmReference", alarmReference);
+                        position.set("alarmNumber", alarmNumber);
+                        decodeFileName(position, name);
+                        return position;
+                    } finally {
+                        file.data.release();
+                    }
+                }
+            }
+            default -> sendGeneralResponse(channel, remoteAddress, id, type, index);
+        }
+
+        return null;
+    }
+
+}
