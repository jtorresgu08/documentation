+import io.netty.handler.codec.http.FullHttpRequest;
+import io.netty.handler.codec.http.HttpHeaderNames;
+import io.netty.handler.codec.http.HttpMethod;
+import io.netty.handler.codec.http.HttpResponseStatus;
+import io.netty.handler.codec.http.QueryStringDecoder;
+import io.netty.handler.codec.http.multipart.Attribute;
+import io.netty.handler.codec.http.multipart.DefaultHttpDataFactory;
+import io.netty.handler.codec.http.multipart.FileUpload;
+import io.netty.handler.codec.http.multipart.HttpPostRequestDecoder;
+import io.netty.handler.codec.http.multipart.InterfaceHttpData;
+import jakarta.inject.Inject;
+import org.traccar.BaseHttpProtocolDecoder;
+import org.traccar.Protocol;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.io.IOException;
+import java.net.SocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public class JimiUploadProtocolDecoder extends BaseHttpProtocolDecoder {
+
+    private static final Pattern IMEI_SEGMENT = Pattern.compile("^\\d{10,17}$");
+    private static final Pattern EVENT_FILE = Pattern.compile("^EVENT_(\\d{10,17})_.*_([FI])_\\d+$");
+
+    private Storage storage;
+
+    public JimiUploadProtocolDecoder(Protocol protocol) {
+        super(protocol);
+    }
+
+    @Inject
+    public void setStorage(Storage storage) {
+        this.storage = storage;
+    }
+
+    private static String baseName(String name) {
+        int dot = name.lastIndexOf('.');
+        return dot > 0 ? name.substring(0, dot) : name;
+    }
+
+    private static String extension(String name) {
+        int dot = name.lastIndexOf('.');
+        return dot > 0 && dot < name.length() - 1 ? name.substring(dot + 1).toLowerCase() : "bin";
+    }
+
+    private static String mediaKey(String extension) {
+        return switch (extension) {
+            case "jpg", "jpeg", "png", "bmp" -> Position.KEY_IMAGE;
+            case "wav", "mp3", "amr", "aac" -> Position.KEY_AUDIO;
+            default -> Position.KEY_VIDEO;
+        };
+    }
+
+    private static String findImei(String path, Map<String, String> fields, Map<String, ByteBuf> files) {
+        for (String key : List.of("imei", "deviceImei", "deviceId")) {
+            if (fields.containsKey(key)) {
+                return fields.get(key);
+            }
+        }
+        for (String segment : path.split("/")) {
+            if (IMEI_SEGMENT.matcher(segment).matches()) {
+                return segment;
+            }
+        }
+        for (String name : files.keySet()) {
+            Matcher matcher = EVENT_FILE.matcher(baseName(name));
+            if (matcher.matches()) {
+                return matcher.group(1);
+            }
+        }
+        return null;
+    }
+
+    private Device findDevice(String imei) throws StorageException {
+        if (imei == null) {
+            return null;
+        }
+        Device device = storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("uniqueId", imei)));
+        if (device == null && imei.length() == 16 && imei.startsWith("0")) {
+            device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("uniqueId", imei.substring(1))));
+        }
+        return device;
+    }
+
+    private static String headerFileName(FullHttpRequest request) {
+        String disposition = request.headers().get(HttpHeaderNames.CONTENT_DISPOSITION);
+        if (disposition != null) {
+            Matcher matcher = Pattern.compile("filename=\"?([^\";]+)\"?").matcher(disposition);
+            if (matcher.find()) {
+                return matcher.group(1);
+            }
+        }
+        return request.headers().get("fileName");
+    }
+
+    @Override
+    protected Object decode(Channel channel, SocketAddress remoteAddress, Object msg) throws Exception {
+
+        FullHttpRequest request = (FullHttpRequest) msg;
+        if (!HttpMethod.POST.equals(request.method()) && !HttpMethod.PUT.equals(request.method())) {
+            sendResponse(channel, HttpResponseStatus.METHOD_NOT_ALLOWED);
+            return null;
+        }
+
+        QueryStringDecoder query = new QueryStringDecoder(request.uri());
+        Map<String, String> fields = new LinkedHashMap<>();
+        query.parameters().forEach((key, values) -> fields.put(key, values.get(0)));
+        Map<String, ByteBuf> files = new LinkedHashMap<>();
+
+        HttpPostRequestDecoder multipart = null;
+        try {
+            if (HttpPostRequestDecoder.isMultipart(request)) {
+                multipart = new HttpPostRequestDecoder(new DefaultHttpDataFactory(false), request);
+                for (InterfaceHttpData data : multipart.getBodyHttpDatas()) {
+                    if (data instanceof FileUpload upload && upload.isCompleted()) {
+                        files.put(upload.getFilename(), upload.getByteBuf().retainedDuplicate());
+                    } else if (data instanceof Attribute attribute) {
+                        fields.put(attribute.getName(), attribute.getValue());
+                    }
+                }
+            } else if (request.content().isReadable()) {
+                String name = fields.getOrDefault("fileName", fields.getOrDefault("filename", headerFileName(request)));
+                if (name == null) {
+                    String path = query.path();
+                    name = path.substring(path.lastIndexOf('/') + 1);
+                }
+                if (name != null && name.contains(".")) {
+                    files.put(name, request.content().retainedDuplicate());
+                }
+            }
+
+            Device device = findDevice(findImei(query.path(), fields, files));
+            if (device == null || files.isEmpty()) {
+                sendResponse(channel, device == null ? HttpResponseStatus.NOT_FOUND : HttpResponseStatus.BAD_REQUEST);
+                return null;
+            }
+
+            List<Position> positions = new LinkedList<>();
+            for (var entry : files.entrySet()) {
+                String name = entry.getKey().substring(entry.getKey().lastIndexOf('/') + 1);
+                // reported as the tracking protocol so the latest position keeps offering its commands
+                Position position = new Position("gt06");
+                position.setDeviceId(device.getId());
+                getLastLocation(position, null);
+                String extension = extension(name);
+                position.set(mediaKey(extension), writeMediaFile(
+                        device.getUniqueId(), entry.getValue(), baseName(name), extension));
+                position.set("eventFile", name);
+                Matcher matcher = EVENT_FILE.matcher(baseName(name));
+                if (matcher.matches()) {
+                    position.set("channel", matcher.group(2).equals("F") ? 1 : 2);
+                }
+                positions.add(position);
+            }
+
+            sendResponse(channel, HttpResponseStatus.OK, Unpooled.copiedBuffer(
+                    "{\"code\":0,\"msg\":\"success\"}", StandardCharsets.US_ASCII));
+            return positions;
+
+        } catch (HttpPostRequestDecoder.ErrorDataDecoderException | IOException e) {
+            sendResponse(channel, HttpResponseStatus.BAD_REQUEST);
+            return null;
+        } finally {
+            files.values().forEach(ByteBuf::release);
+            if (multipart != null) {
+                multipart.destroy();
+            }
+        }
+    }
+
+}
