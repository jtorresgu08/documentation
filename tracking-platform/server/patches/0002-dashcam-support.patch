+package org.traccar.protocol;
+
+import jakarta.inject.Inject;
+import org.traccar.BaseProtocol;
+import org.traccar.PipelineBuilder;
+import org.traccar.TrackerServer;
+import org.traccar.config.Config;
+
+/**
+ * Attachment server of the JT/T 808 active safety extension: dashcams connect here to upload the photos and videos
+ * of ADAS / DMS alarms after the platform sends the attachment upload request (0x9208).
+ */
+public class Jt808AttachProtocol extends BaseProtocol {
+
+    @Inject
+    public Jt808AttachProtocol(Config config) {
+        addServer(new TrackerServer(config, getName(), false) {
+            @Override
+            protected void addProtocolHandlers(PipelineBuilder pipeline, Config config) {
+                pipeline.addLast(new HuabaoFrameEncoder());
+                pipeline.addLast(new Jt808AttachFrameDecoder());
+                pipeline.addLast(new Jt808AttachProtocolDecoder(Jt808AttachProtocol.this));
+            }
+        });
+    }
+
+}
