+    /**
+     * Stores the custom field values of the given scope (order or delivery) on the order or stop, typed, checking
+     * the options of lists and, when asked, the required fields that apply to its type.
+     */
+    @SuppressWarnings("unchecked")
+    private void applyCustom(
+            ExtendedModel target, Object raw, List<Map<String, Object>> fields, String scope, String type,
+            boolean requireAll) {
+        Map<String, Object> values = raw instanceof Map<?, ?> map ? (Map<String, Object>) map : Map.of();
+        for (Map<String, Object> field : fields) {
+            List<String> types = field.get("types") instanceof List<?> list ? (List<String>) list : List.of();
+            if (!scope.equals(field.get("scope")) || !types.isEmpty() && !types.contains(type)) {
+                continue;
+            }
+            String key = String.valueOf(field.get("key"));
+            Object value = values.get(key);
+            String text = value == null ? "" : String.valueOf(value).trim();
+            if (text.isEmpty() || "checkbox".equals(field.get("type")) && !Boolean.parseBoolean(text)) {
+                if (requireAll && Boolean.TRUE.equals(field.get("required"))) {
+                    throw new IllegalArgumentException("Required field: " + field.get("label"));
+                }
+                if (!text.isEmpty()) {
+                    target.set(CUSTOM + key, false);
+                }
+                continue;
+            }
+            switch (String.valueOf(field.get("type"))) {
+                case "number" -> {
+                    try {
+                        target.set(CUSTOM + key, Double.parseDouble(text.replace(',', '.')));
+                    } catch (NumberFormatException e) {
+                        throw new IllegalArgumentException("Invalid number in field: " + field.get("label"));
+                    }
+                }
+                case "checkbox" -> target.set(CUSTOM + key, true);
+                case "select" -> {
+                    List<String> options = field.get("options") instanceof List<?> list
+                            ? (List<String>) list : List.of();
+                    if (!options.contains(text)) {
+                        throw new IllegalArgumentException("Invalid option in field: " + field.get("label"));
+                    }
+                    target.set(CUSTOM + key, text);
+                }
+                default -> target.set(CUSTOM + key, text.substring(0, Math.min(text.length(), 500)));
+            }
+        }
+    }
