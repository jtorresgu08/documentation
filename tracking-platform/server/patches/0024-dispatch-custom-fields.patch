+    public Map<String, Object> saveFields(List<Map<String, Object>> fields) throws Exception {
+        checkWritable();
+        permissionsService.checkManager(getUserId());
+        Set<String> keys = new HashSet<>();
+        List<Map<String, Object>> clean = new ArrayList<>();
+        for (Map<String, Object> field : fields) {
+            String key = String.valueOf(field.getOrDefault("key", "")).trim();
+            String label = String.valueOf(field.getOrDefault("label", "")).trim();
+            String type = String.valueOf(field.getOrDefault("type", "text"));
+            String scope = String.valueOf(field.getOrDefault("scope", "order"));
+            if (!key.matches("[a-z][a-z0-9_]{0,31}") || !keys.add(key) || label.isEmpty()
+                    || !FIELD_TYPES.contains(type) || !FIELD_SCOPES.contains(scope)) {
+                throw new IllegalArgumentException("Invalid field: " + label);
+            }
+            List<String> options = field.get("options") instanceof List<?> list
+                    ? list.stream().map(String::valueOf).map(String::trim).filter(item -> !item.isEmpty()).toList()
+                    : List.of();
+            if ("select".equals(type) && options.isEmpty()) {
+                throw new IllegalArgumentException("A list field needs options: " + label);
+            }
+            List<String> types = field.get("types") instanceof List<?> list
+                    ? list.stream().map(String::valueOf).filter(item -> List.of(DispatchOrder.DELIVERY,
+                            DispatchOrder.PICKUP, DispatchOrder.SERVICE).contains(item)).toList()
+                    : List.of();
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("key", key);
+            item.put("label", label.substring(0, Math.min(label.length(), 64)));
+            item.put("type", type);
+            item.put("scope", scope);
+            item.put("required", Boolean.TRUE.equals(field.get("required")));
+            item.put("showToCustomer", Boolean.TRUE.equals(field.get("showToCustomer")));
+            item.put("options", options);
+            item.put("types", types);
+            clean.add(item);
+        }
+        User user = permissionsService.getUser(getUserId());
+        user.set(FIELDS, objectMapper.writeValueAsString(clean));
+        storage.updateObject(user, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+        return fields();
+    }
