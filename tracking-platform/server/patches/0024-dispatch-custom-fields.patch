+    /**
+     * Fields of an account: its own and those of every manager above it (the closest definition of a key wins).
+     */
+    public List<Map<String, Object>> fieldsFor(long userId) throws StorageException {
+        List<Long> chain = new ArrayList<>(hierarchyService.getAncestorChain(userId));
+        java.util.Collections.reverse(chain);
+        chain.add(userId);
+        Map<String, Map<String, Object>> merged = new LinkedHashMap<>();
+        for (long id : chain) {
+            User user = storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", id)));
+            for (Map<String, Object> field : ownFields(user)) {
+                Map<String, Object> item = new LinkedHashMap<>(field);
+                item.put("ownerId", id);
+                merged.put(String.valueOf(field.get("key")), item);
+            }
+        }
+        return new ArrayList<>(merged.values());
+    }
