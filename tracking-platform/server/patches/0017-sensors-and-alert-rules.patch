+        public long now() {
+            return 10_000_000;
+        }
+    };
+
+    private static Position position(double speedKmh, Map<String, Object> attributes) {
+        Position position = new Position();
+        position.setFixTime(new Date());
+        position.setValid(true);
+        position.setLatitude(-12);
+        position.setLongitude(-77);
+        position.setSpeed(speedKmh / 1.852);
+        position.getAttributes().putAll(attributes);
+        return position;
+    }
+
+    @Test
+    public void testSensorRanges() throws Exception {
+        Device device = new Device();
+        JsonNode outside = json("{\"type\":\"sensor\",\"condition\":{\"sensor\":\"temp\",\"op\":\"outside\",\"min\":2,\"max\":8}}");
+        assertTrue(RuleConditions.check(outside, device, position(0, Map.of("sensor.temp", 9.5)), CONTEXT, null).holds());
+        assertFalse(RuleConditions.check(outside, device, position(0, Map.of("sensor.temp", 5.0)), CONTEXT, null).holds());
+        device.set("sensors", "[{\"id\":\"t9\",\"name\":\"Temperatura cámara\",\"type\":\"temperature\",\"source\":\"temp1\"}]");
+        JsonNode byName = json("{\"type\":\"sensor\",\"condition\":{\"sensorName\":\"temperatura cámara\",\"op\":\"gt\",\"value\":8}}");
+        assertTrue(RuleConditions.check(byName, device, position(0, Map.of("sensor.t9", 9.0)), CONTEXT, null).holds());
+        JsonNode byType = json("{\"type\":\"sensor\",\"condition\":{\"sensorType\":\"temperature\",\"op\":\"lt\",\"value\":2}}");
+        assertTrue(RuleConditions.check(byType, device, position(0, Map.of("sensor.t9", 1.0)), CONTEXT, null).holds());
+        JsonNode change = json("{\"type\":\"parameter\",\"condition\":{\"param\":\"adc1\",\"op\":\"change\",\"value\":100}}");
+        assertTrue(RuleConditions.isEdge(change));
+        assertTrue(RuleConditions.check(change, device, position(0, Map.of("adc1", 500)), CONTEXT, 300).holds());
+        assertFalse(RuleConditions.check(change, device, position(0, Map.of("adc1", 350)), CONTEXT, 300).holds());
+    }
+
+    @Test
+    public void testSpeedIdleDriverProximityAndConnection() throws Exception {
+        Device device = new Device();
+        device.setId(1);
+        JsonNode speed = json("{\"type\":\"speed\",\"condition\":{\"limit\":90}}");
+        assertTrue(RuleConditions.check(speed, device, position(95, Map.of()), CONTEXT, null).holds());
+        assertFalse(RuleConditions.check(speed, device, position(80, Map.of()), CONTEXT, null).holds());
+        JsonNode idle = json("{\"type\":\"idle\",\"condition\":{\"minutes\":10}}");
+        assertTrue(RuleConditions.check(idle, device, position(0, Map.of("ignition", true)), CONTEXT, null).holds());
+        assertFalse(RuleConditions.check(idle, device, position(40, Map.of("ignition", true)), CONTEXT, null).holds());
+        assertEquals(600_000, RuleEngine.duration(idle));
+        JsonNode driver = json("{\"type\":\"driver\",\"condition\":{}}");
+        assertTrue(RuleConditions.check(driver, device, position(0, Map.of("ignition", true)), CONTEXT, null).holds());
+        JsonNode near = json("{\"type\":\"proximity\",\"condition\":{\"deviceIds\":[2],\"radius\":100}}");
+        assertTrue(RuleConditions.check(near, device, position(0, Map.of()), CONTEXT, null).holds());
+        JsonNode silent = json("{\"type\":\"connection\",\"condition\":{\"minutes\":30}}");
+        device.setLastUpdate(new Date(10_000_000 - 40 * 60_000));
+        assertTrue(RuleConditions.check(silent, device, null, CONTEXT, null).holds());
+    }
+
+    @Test
+    public void testExtraConditionsScheduleAndEvents() throws Exception {
+        JsonNode rule = json("{\"type\":\"digital\",\"condition\":{\"param\":\"door\",\"state\":\"on\"},"
+                + "\"extra\":[{\"kind\":\"speed\",\"op\":\"gt\",\"value\":5}],"
+                + "\"schedule\":{\"days\":[1,2,3,4,5],\"from\":\"22:00\",\"to\":\"06:00\"}}");
+        assertTrue(RuleConditions.extra(rule, null, position(30, Map.of()), CONTEXT));
+        assertFalse(RuleConditions.extra(rule, null, position(0, Map.of()), CONTEXT));
+        ZoneId zone = ZoneId.of("America/Lima");
+        long mondayNight = ZonedDateTime.of(2026, 11, 2, 23, 0, 0, 0, zone).toInstant().toEpochMilli();
+        long mondayNoon = ZonedDateTime.of(2026, 11, 2, 12, 0, 0, 0, zone).toInstant().toEpochMilli();
+        long sundayNight = ZonedDateTime.of(2026, 11, 1, 23, 0, 0, 0, zone).toInstant().toEpochMilli();
+        assertTrue(RuleConditions.inSchedule(rule, mondayNight, zone));
+        assertFalse(RuleConditions.inSchedule(rule, mondayNoon, zone));
+        assertFalse(RuleConditions.inSchedule(rule, sundayNight, zone));
+        JsonNode events = json("{\"type\":\"event\",\"condition\":{\"events\":[\"alarm:sos\",\"deviceFuelDrop\"]}}");
+        assertTrue(RuleConditions.matchesEvent(events, "alarm", "sos"));
+        assertTrue(RuleConditions.matchesEvent(events, "deviceFuelDrop", null));
+        assertFalse(RuleConditions.matchesEvent(events, "alarm", "door"));
+        assertEquals("Exceso: ABC-123 a 95 km/h",
+                RuleConditions.render("Exceso: {unit} a {speed} km/h", Map.of("unit", "ABC-123", "speed", "95")));
+    }
+
+}
