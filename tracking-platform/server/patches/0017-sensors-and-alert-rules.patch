+package org.traccar.schedule;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.rules.RuleEngine;
+
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Checks the custom alert rules every minute, so silences, durations and schedules count without new messages.
+ */
+public class TaskAlertRules extends SingleScheduleTask {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TaskAlertRules.class);
+
+    private final RuleEngine ruleEngine;
+
+    @Inject
+    public TaskAlertRules(RuleEngine ruleEngine) {
+        this.ruleEngine = ruleEngine;
+    }
+
+    @Override
+    public void schedule(ScheduledExecutorService executor) {
+        executor.scheduleAtFixedRate(this, 1, 1, TimeUnit.MINUTES);
+    }
+
+    @Override
+    public void run() {
+        try {
+            ruleEngine.onTimer();
+        } catch (Exception e) {
+            LOGGER.warn("Alert rules check failed", e);
+        }
+    }
+
+}
