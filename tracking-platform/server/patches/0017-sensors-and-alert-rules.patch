+package org.traccar.sensor;
+
+import jakarta.inject.Singleton;
+import org.traccar.model.Position;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Computes all the sensors of a unit for a message, Wialon style, in the order they are defined so a formula can use
+ * the sensors above it (#id):
+ * <ul>
+ * <li>value: parameter or formula, calibration table or multiplier and offset, lower and upper bounds;</li>
+ * <li>accumulated sensors (relative mileage, impulse fuel, counters, relative engine hours) add each message's
+ * increment, the positive difference of a counter, or the time the source is on, to the previous total;</li>
+ * * <li>calculated fuel consumption adds the distance by the rate per 100 km plus idle time by the hourly rate;</li>
+ * <li>engine efficiency is on while the source is at or above its threshold (RPM, voltage);</li>
+ * <li>smoothing averages the last N readings of live messages;</li>
+ * <li>validation by another sensor: valid only if it is not zero, logical and / or, sum, subtract, multiply, divide,
+ * or replace an invalid value with the validator's.</li>
+ * </ul>
+ */
+@Singleton
+public class SensorEngine {
+
+    public static final String RAW_SUFFIX = ".raw";
+    static final long MAX_STEP = 15 * 60 * 1000L;
+
+    private final Map<String, Deque<Double>> history = new ConcurrentHashMap<>();
+
+    private static double round(double value) {
+        return Math.round(value * 1000) / 1000.0;
+    }
+
+    private static Double previousValue(Position previous, String key) {
+        return previous != null ? Sensor.readRaw(previous, key) : null;
+    }
+
+    private static long step(Position position, Position previous) {
+        if (previous == null || position.getFixTime() == null || previous.getFixTime() == null) {
+            return 0;
+        }
+        long step = position.getFixTime().getTime() - previous.getFixTime().getTime();
+        return step > 0 && step <= MAX_STEP ? step : 0;
+    }
+
+    private Double smooth(String scope, Sensor sensor, double value) {
+        if (sensor.getSmoothing() <= 1 || scope == null) {
+            return value;
+        }
+        Deque<Double> values = history.computeIfAbsent(scope + ":" + sensor.getId(), key -> new ArrayDeque<>());
+        synchronized (values) {
+            values.addLast(value);
+            while (values.size() > sensor.getSmoothing()) {
+                values.removeFirst();
+            }
+            return values.stream().mapToDouble(Double::doubleValue).average().orElse(value);
+        }
+    }
+
+    static Double validate(String mode, Double value, Double validator) {
+        if (mode == null) {
+            mode = "nonZero";
+        }
+        switch (mode) {
+            case "replace":
+                return value != null ? value : validator;
+            case "nonZero":
+                return validator != null && validator != 0 ? value : null;
+            default:
+                break;
+        }
+        if (value == null || validator == null) {
+            return null;
+        }
+        return switch (mode) {
+            case "and" -> value != 0 && validator != 0 ? 1.0 : 0.0;
+            case "or" -> value != 0 || validator != 0 ? 1.0 : 0.0;
+            case "sum" -> value + validator;
+            case "subtract" -> value - validator;
+            case "multiply" -> value * validator;
+            case "divide" -> validator != 0 ? value / validator : null;
+            default -> value;
+        };
+    }
+
+    /**
+     * Values of the sensors for a message: numbers, or text for driver and trailer binding. Accumulated sensors also
+     * leave their last raw reading under "sensor.&lt;id&gt;.raw" in the result, to take the next difference from.
+     */
+    public Map<String, Object> compute(List<Sensor> sensors, Position position, Position previous, boolean live) {
+        return compute(sensors, position, previous, live ? String.valueOf(position.getDeviceId()) : null);
+    }
+
+    /** Forgets the smoothing readings of a scope, e.g. a finished preview. */
+    public void clear(String scope) {
+        history.keySet().removeIf(key -> key.startsWith(scope + ":"));
+    }
+
+    /** Values of the sensors, smoothing within the given scope (a unit, or a preview run; null for none). */
+    public Map<String, Object> compute(List<Sensor> sensors, Position position, Position previous, String scope) {
+        Map<String, Object> values = new LinkedHashMap<>();
+        Map<String, Double> numbers = new LinkedHashMap<>();
+        long step = step(position, previous);
+        for (Sensor sensor : sensors) {
+            String key = sensor.getKey();
+            if (sensor.isText()) {
+                Object text = sensor.getSource() != null ? position.getAttributes().get(sensor.getSource()) : null;
+                if (text != null && !text.toString().isBlank() && !"0".equals(text.toString())) {
+                    values.put(sensor.getId(), text.toString());
+                }
+                continue;
+            }
+            Double value;
+            if (Sensor.TYPE_FUEL_CALCULATED.equals(sensor.getType())) {
+                double total = previous != null ? orZero(previousValue(previous, key)) : 0;
+                double kilometers = position.getDouble(Position.KEY_DISTANCE) / 1000;
+                boolean moving = position.getSpeed() * 1.852 > sensor.getSpeedThreshold();
+                boolean ignition = position.getBoolean(Position.KEY_IGNITION);
+                total += kilometers * sensor.getRate() / 100;
+                if (!moving && ignition) {
+                    total += step / 3600000.0 * sensor.getIdleRate();
+                }
+                value = total;
+            } else {
+                Double raw = sensor.raw(position, name -> name.startsWith("#") ? numbers.get(name.substring(1)) : null);
+                if (raw == null) {
+                    continue;
+                }
+                String accumulate = sensor.getAccumulate();
+                double total = orZero(previousValue(previous, key));
+                if (Sensor.ACCUMULATE_INCREMENT.equals(accumulate)) {
+                    Double increment = sensor.convert(raw);
+                    value = total + (increment != null ? increment : 0);
+                } else if (Sensor.ACCUMULATE_DELTA.equals(accumulate)) {
+                    Double last = previousValue(previous, key + RAW_SUFFIX);
+                    double difference = last != null && raw >= last ? raw - last : 0;
+                    values.put(sensor.getId() + RAW_SUFFIX, raw);
+                    value = total + difference * sensor.getMultiplier();
+                } else if (Sensor.ACCUMULATE_TIME.equals(accumulate)) {
+                    value = total + (raw != 0 ? step / 3600000.0 : 0);
+                } else if (Sensor.TYPE_ENGINE_EFFICIENCY.equals(sensor.getType())) {
+                    value = raw >= (sensor.getThreshold() != null ? sensor.getThreshold() : 0) ? 1.0 : 0.0;
+                } else {
+                    value = sensor.convertBounded(raw);
+                    if (value != null) {
+                        value = smooth(scope, sensor, value);
+                    }
+                }
+            }
+            if (value != null) {
+                numbers.put(sensor.getId(), value);
+            }
+        }
+        for (Sensor sensor : sensors) {
+            if (sensor.getValidatorId() != null && !sensor.getValidatorId().isBlank() && !sensor.isText()) {
+                Double value = validate(sensor.getValidation(), numbers.get(sensor.getId()),
+                        numbers.get(sensor.getValidatorId()));
+                if (value != null) {
+                    numbers.put(sensor.getId(), value);
+                } else {
+                    numbers.remove(sensor.getId());
+                }
+            }
+        }
+        numbers.forEach((id, value) -> values.put(id, round(value)));
+        return values;
+    }
+
+    private static double orZero(Double value) {
+        return value != null ? value : 0;
+    }
+
+}
