+import java.time.ZoneId;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Date;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TimeZone;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Custom alerts engine. Every rule is checked with each new message of its units and once a minute (for silences,
+ * durations and schedules); event rules are checked with every stored event. A rule fires once per episode: the
+ * condition must hold for the minimum duration, inside the schedule, with the extra conditions, respecting the
+ * pause between alerts and the daily maximum. Change-type rules (entering, switching on, approaching) do not fire
+ * for the state found when the rule starts. Firing stores a "ruleTriggered" event (alert center, notifications) and
+ * runs the actions: channels to the rule owner, extra e-mails and WhatsApp numbers, and a command (engine stop only
+ * through the safe cut). States live in memory.
+ */
+@Singleton
+public class RuleEngine {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(RuleEngine.class);
+
+    private static final long RELOAD = 60_000;
+    private static final long DAY = 24 * 3600_000L;
+
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final ObjectMapper objectMapper;
+    private final NotificationManager notificationManager;
+    private final NotificatorManager notificatorManager;
+    private final MailManager mailManager;
+    private final WhatsappClient whatsappClient;
+    private final CommandsManager commandsManager;
+    private final EngineStopGuard engineStopGuard;
+
+    public record Compiled(AlertRule rule, JsonNode config, Set<Long> deviceIds) {
+    }
+
+    private static final class State {
+        private long since;
+        private boolean holding;
+        private boolean fired;
+        private boolean initialized;
+        private Object lastValue;
+        private final Deque<Long> fires = new ArrayDeque<>();
+    }
+
+    private volatile List<Compiled> rules = List.of();
+    private volatile long loaded;
+    private final Map<String, State> states = new ConcurrentHashMap<>();
+
+    @Inject
+    public RuleEngine(
+            Storage storage, CacheManager cacheManager, ObjectMapper objectMapper,
+            NotificationManager notificationManager, NotificatorManager notificatorManager, MailManager mailManager,
+            WhatsappClient whatsappClient, CommandsManager commandsManager, EngineStopGuard engineStopGuard) {
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.objectMapper = objectMapper;
+        this.notificationManager = notificationManager;
+        this.notificatorManager = notificatorManager;
+        this.mailManager = mailManager;
+        this.whatsappClient = whatsappClient;
+        this.commandsManager = commandsManager;
+        this.engineStopGuard = engineStopGuard;
+        notificationManager.addListener(this::onEvent);
+    }
+
+    public void invalidate() {
+        loaded = 0;
+    }
+
+    public JsonNode parse(String config) {
+        try {
+            return objectMapper.readTree(config != null ? config : "{}");
+        } catch (Exception e) {
+            return objectMapper.createObjectNode();
+        }
+    }
+
+    /** Units a rule applies to: all the owner's units, or the chosen units and groups (with subgroups). */
+    public Set<Long> devicesOf(long userId, JsonNode config) throws StorageException {
+        User user = storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", userId)));
+        if (user == null) {
+            return Set.of();
+        }
+        Collection<Device> accessible = user.getAdministrator()
+                ? storage.getObjects(Device.class, new Request(new Columns.All()))
+                : storage.getObjects(Device.class, new Request(
+                        new Columns.All(), new Condition.Permission(User.class, userId, Device.class)));
+        Set<Long> result = new HashSet<>();
+        if (config.path("all").asBoolean()
+                || !config.path("deviceIds").isArray() && !config.path("groupIds").isArray()) {
+            accessible.forEach(device -> result.add(device.getId()));
+            return result;
+        }
+        Set<Long> chosen = new HashSet<>(RuleConditions.ids(config.path("deviceIds")));
+        Set<Long> groups = new HashSet<>(RuleConditions.ids(config.path("groupIds")));
+        Map<Long, Long> parents = new HashMap<>();
+        if (!groups.isEmpty()) {
+            for (Group group : storage.getObjects(Group.class, new Request(new Columns.All()))) {
+                parents.put(group.getId(), group.getGroupId());
+            }
+        }
+        for (Device device : accessible) {
+            boolean match = chosen.contains(device.getId());
+            long groupId = device.getGroupId();
+            Set<Long> visited = new HashSet<>();
+            while (!match && groupId > 0 && visited.add(groupId)) {
+                match = groups.contains(groupId);
+                groupId = parents.getOrDefault(groupId, 0L);
+            }
+            if (match) {
+                result.add(device.getId());
+            }
+        }
+        return result;
+    }
+
+    public List<Compiled> rules() {
+        long now = System.currentTimeMillis();
+        if (now - loaded > RELOAD) {
+            synchronized (this) {
+                if (now - loaded > RELOAD) {
+                    List<Compiled> result = new ArrayList<>();
+                    try {
+                        for (AlertRule rule : storage.getObjects(AlertRule.class, new Request(new Columns.All()))) {
+                            if (rule.getEnabled()) {
+                                JsonNode config = parse(rule.getConfig());
+                                result.add(new Compiled(rule, config, devicesOf(rule.getUserId(), config)));
+                            }
+                        }
+                    } catch (StorageException e) {
+                        LOGGER.warn("Alert rules load failed", e);
+                    }
+                    rules = result;
+                    loaded = now;
+                }
+            }
+        }
+        return rules;
+    }
+
+    private final RuleConditions.Context context = new RuleConditions.Context() {
+        @Override
+        public Collection<Geofence> geofences(Position position) {
+            List<Geofence> result = new ArrayList<>();
+            if (position.getGeofenceIds() != null) {
+                for (long id : position.getGeofenceIds()) {
+                    Geofence geofence = cacheManager.getObject(Geofence.class, id);
+                    if (geofence != null) {
+                        result.add(geofence);
+                    }
+                }
+            }
+            return result;
+        }
+
+        @Override
+        public Position latest(long deviceId) {
+            return RuleEngine.this.latest(deviceId);
+        }
+
+        @Override
+        public long now() {
+            return System.currentTimeMillis();
+        }
+    };
+
+    public RuleConditions.Context context() {
+        return context;
+    }
+
+    public Position latest(long deviceId) {
+        Position position = cacheManager.getPosition(deviceId);
+        if (position != null) {
+            return position;
+        }
+        try {
+            Device device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", deviceId)));
+            return device != null && device.getPositionId() > 0 ? storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", device.getPositionId()))) : null;
+        } catch (StorageException e) {
+            return null;
+        }
+    }
+
+    static long duration(JsonNode config) {
+        long seconds = config.path("minDuration").asLong(0);
+        String type = config.path("type").asText();
+        long minutes = config.path("condition").path("minutes").asLong(0);
+        if (!"connection".equals(type) && minutes > 0) {
+            seconds = Math.max(seconds, minutes * 60);
+        }
+        return seconds * 1000;
+    }
+
+    private ZoneId zone(long userId) {
+        try {
+            User user = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", userId)));
+            String timezone = user != null ? user.getString("timezone") : null;
+            return timezone != null ? ZoneId.of(timezone) : ZoneId.systemDefault();
+        } catch (Exception e) {
+            return ZoneId.systemDefault();
+        }
+    }
+
+    private boolean allowed(Compiled compiled, State state, long now) {
+        JsonNode config = compiled.config();
+        long cooldown = config.path("cooldown").asLong(0) * 60_000;
+        while (!state.fires.isEmpty() && now - state.fires.peekFirst() > DAY) {
+            state.fires.removeFirst();
+        }
+        if (cooldown > 0 && !state.fires.isEmpty() && now - state.fires.peekLast() < cooldown) {
+            return false;
+        }
+        int maxPerDay = config.path("maxPerDay").asInt(0);
+        return maxPerDay <= 0 || state.fires.size() < maxPerDay;
+    }
+
+    /** Checks one rule for one unit and fires it when due. */
+    void evaluate(Compiled compiled, Device device, Position position, long now) {
+        JsonNode config = compiled.config();
+        if ("event".equals(config.path("type").asText())) {
+            return;
+        }
+        State state = states.computeIfAbsent(compiled.rule().getId() + ":" + device.getId(), key -> new State());
+        RuleConditions.Check check;
+        synchronized (state) {
+            check = RuleConditions.check(config, device, position, context, state.lastValue);
+            boolean holds = check.holds() && RuleConditions.extra(config, device, position, context);
+            if (check.value() != null) {
+                state.lastValue = check.value();
+            }
+            boolean edge = RuleConditions.isEdge(config);
+            if (!state.initialized) {
+                state.initialized = true;
+                if (holds && edge) {
+                    // the unit was already in that state when the rule started: wait for the next change
+                    state.holding = true;
+                    state.fired = true;
+                    state.since = now;
+                    return;
+                }
+            }
+            if (!holds) {
+                state.holding = false;
+                state.fired = false;
+                return;
+            }
+            if (!state.holding) {
+                state.holding = true;
+                state.since = now;
+                state.fired = false;
+            }
+            if (state.fired || now - state.since < duration(config)
+                    || !RuleConditions.inSchedule(config, now, zone(compiled.rule().getUserId()))
+                    || !allowed(compiled, state, now)) {
+                return;
+            }
+            state.fired = true;
+            state.fires.addLast(now);
+        }
+        fire(compiled, device, position, check, now);
+    }
+
+    public void onPosition(Position position) {
+        Device device = cacheManager.getObject(Device.class, position.getDeviceId());
+        if (device == null) {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        for (Compiled compiled : rules()) {
+            if (compiled.deviceIds().contains(device.getId())) {
+                try {
+                    evaluate(compiled, device, position, now);
+                } catch (RuntimeException e) {
+                    LOGGER.warn("Alert rule {} failed", compiled.rule().getId(), e);
+                }
+            }
+        }
+    }
+
+    /** Once a minute: silences, durations and schedules also count without new messages. */
+    public void onTimer() throws StorageException {
+        long now = System.currentTimeMillis();
+        List<Compiled> current = rules();
+        if (current.isEmpty()) {
+            return;
+        }
+        Map<Long, Device> devices = new HashMap<>();
+        for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+            devices.put(device.getId(), device);
+        }
+        for (Compiled compiled : current) {
+            for (long deviceId : compiled.deviceIds()) {
+                Device device = devices.get(deviceId);
+                if (device != null) {
+                    try {
+                        evaluate(compiled, device, latest(deviceId), now);
+                    } catch (RuntimeException e) {
+                        LOGGER.warn("Alert rule {} failed", compiled.rule().getId(), e);
+                    }
+                }
+            }
+        }
+    }
+
+    private void onEvent(Event event, Position position) {
+        if (AlertRule.EVENT_TYPE.equals(event.getType())) {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        for (Compiled compiled : rules()) {
+            JsonNode config = compiled.config();
+            if (!"event".equals(config.path("type").asText()) || !compiled.deviceIds().contains(event.getDeviceId())
+                    || !RuleConditions.matchesEvent(config, event.getType(), event.getString(Position.KEY_ALARM))) {
+                continue;
+            }
+            Position current = position != null ? position : latest(event.getDeviceId());
+            Device device = cacheManager.getObject(Device.class, event.getDeviceId());
+            if (device == null || !RuleConditions.extra(config, device, current, context)
+                    || !RuleConditions.inSchedule(config, now, zone(compiled.rule().getUserId()))) {
+                continue;
+            }
+            State state = states.computeIfAbsent(
+                    compiled.rule().getId() + ":" + event.getDeviceId(), key -> new State());
+            synchronized (state) {
+                if (!allowed(compiled, state, now)) {
+                    continue;
+                }
+                state.fires.addLast(now);
+            }
+            String detail = Event.TYPE_ALARM.equals(event.getType())
+                    ? "alarma " + event.getString(Position.KEY_ALARM) : event.getType();
+            fire(compiled, device, current, new RuleConditions.Check(true, null, detail, event.getGeofenceId()), now);
+        }
+    }
+
+    Map<String, String> variables(Compiled compiled, Device device, Position position, RuleConditions.Check check) {
+        Map<String, String> variables = new LinkedHashMap<>();
+        variables.put("unit", device.getName());
+        variables.put("rule", compiled.rule().getName());
+        variables.put("detail", check.detail() != null ? check.detail() : "");
+        variables.put("value", check.value() != null ? RuleConditions.format(check.value()) : "");
+        variables.put("severity", compiled.config().path("severity").asText("high"));
+        SimpleDateFormat format = new SimpleDateFormat("dd/MM/yyyy HH:mm");
+        format.setTimeZone(TimeZone.getTimeZone(zone(compiled.rule().getUserId())));
+        variables.put("time", format.format(new Date()));
+        if (position != null) {
+            variables.put("speed", String.valueOf(Math.round(RuleConditions.speedKmh(position))));
+            variables.put("address", position.getAddress() != null ? position.getAddress()
+                    : String.format(Locale.ROOT, "%.5f, %.5f", position.getLatitude(), position.getLongitude()));
+            variables.put("lat", String.format(Locale.ROOT, "%.6f", position.getLatitude()));
+            variables.put("lon", String.format(Locale.ROOT, "%.6f", position.getLongitude()));
+            Object driver = position.getAttributes().get(Position.KEY_DRIVER_UNIQUE_ID);
+            variables.put("driver", driver != null ? driver.toString() : "");
+        }
+        if (check.geofenceId() > 0) {
+            Geofence geofence = cacheManager.getObject(Geofence.class, check.geofenceId());
+            variables.put("geofence", geofence != null ? geofence.getName() : "");
+        }
+        return variables;
+    }
+
+    public String message(Compiled compiled, Device device, Position position, RuleConditions.Check check) {
+        String template = compiled.config().path("message").asText("");
+        if (template.isBlank()) {
+            template = "{rule}: {unit} · {detail}";
+        }
+        return RuleConditions.render(template, variables(compiled, device, position, check)).trim();
+    }
+
+    private void fire(Compiled compiled, Device device, Position position, RuleConditions.Check check, long now) {
+        JsonNode config = compiled.config();
+        AlertRule rule = compiled.rule();
+        String message = message(compiled, device, position, check);
+        Event event = position != null
+                ? new Event(AlertRule.EVENT_TYPE, position) : new Event(AlertRule.EVENT_TYPE, device.getId());
+        event.setEventTime(new Date(now));
+        event.setGeofenceId(check.geofenceId());
+        event.set("ruleId", rule.getId());
+        event.set("ruleName", rule.getName());
+        event.set("ruleType", config.path("type").asText());
+        event.set("severity", config.path("severity").asText("high"));
+        event.set("message", message);
+        if (check.value() != null) {
+            event.set("value", RuleConditions.format(check.value()));
+        }
+        LOGGER.info("Alert rule {} fired for {}: {}", rule.getId(), device.getUniqueId(), message);
+        try {
+            Map<Event, Position> events = new HashMap<>();
+            events.put(event, position);
+            notificationManager.updateEvents(events);
+        } catch (RuntimeException e) {
+            LOGGER.warn("Alert rule event failed", e);
+        }
+        deliver(compiled, device, event, position, message);
+        runCommand(compiled, device);
+    }
+
+    private void deliver(Compiled compiled, Device device, Event event, Position position, String message) {
+        JsonNode config = compiled.config();
+        try {
+            User owner = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", compiled.rule().getUserId())));
+            List<String> channels = new ArrayList<>();
+            config.path("channels").forEach(item -> channels.add(item.asText()));
+            if (owner != null && !channels.isEmpty()) {
+                Notification notification = new Notification();
+                notification.setType(AlertRule.EVENT_TYPE);
+                notification.setNotificators(String.join(",", channels));
+                for (String channel : channels) {
+                    try {
+                        notificatorManager.getNotificator(channel).send(notification, owner, event, position);
+                    } catch (Exception e) {
+                        LOGGER.warn("Alert rule channel {} failed", channel, e);
+                    }
+                }
+            }
+        } catch (StorageException e) {
+            LOGGER.warn("Alert rule owner lookup failed", e);
+        }
+        String subject = compiled.rule().getName() + " - " + device.getName();
+        for (String email : config.path("emails").asText("").split("[,;\\s]+")) {
+            if (email.contains("@") && mailManager.getEmailEnabled()) {
+                User recipient = new User();
+                recipient.setEmail(email.trim());
+                try {
+                    mailManager.sendMessage(recipient, true, subject, message);
+                } catch (Exception e) {
+                    LOGGER.warn("Alert rule mail failed", e);
+                }
+            }
+        }
+        for (String phone : config.path("phones").asText("").split("[,;]+")) {
+            if (WhatsappClient.normalize(phone).length() >= 7 && whatsappClient.configured()) {
+                try {
+                    whatsappClient.sendAlert(phone, message);
+                } catch (Exception e) {
+                    LOGGER.warn("Alert rule WhatsApp failed", e);
+                }
+            }
+        }
+    }
+
+    private void runCommand(Compiled compiled, Device device) {
+        JsonNode action = compiled.config().path("command");
+        String type = action.path("type").asText("");
+        if (type.isEmpty()) {
+            return;
+        }
+        Command command = new Command();
+        command.setDeviceId(device.getId());
+        command.setType(type);
+        if (action.hasNonNull("data")) {
+            command.set(Command.KEY_DATA, action.path("data").asText());
+        }
+        try {
+            if (Command.TYPE_ENGINE_STOP.equals(type)) {
+                if (engineStopGuard.check(device.getId()).allowed()) {
+                    commandsManager.sendCommand(command);
+                } else {
+                    // never cut a moving unit: the cut waits until it stops
+                    engineStopGuard.addPending(command, compiled.rule().getUserId());
+                }
+            } else {
+                commandsManager.sendCommand(command);
+            }
+        } catch (Exception e) {
+            LOGGER.warn("Alert rule command failed", e);
+        }
+    }
+
+}
