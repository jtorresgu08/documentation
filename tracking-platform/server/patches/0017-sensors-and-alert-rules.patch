diff --git a/src/main/java/org/traccar/rules/RuleConditions.java b/src/main/java/org/traccar/rules/RuleConditions.java
new file mode 100644
index 0000000..bd4e004
--- /dev/null
+++ b/src/main/java/org/traccar/rules/RuleConditions.java
@@ -0,0 +1,446 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.rules;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.traccar.model.Device;
+import org.traccar.model.Geofence;
+import org.traccar.model.Position;
+import org.traccar.sensor.Sensor;
+import org.traccar.sensor.SensorConfig;
+
+import java.time.DayOfWeek;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Conditions of the custom alerts, kept free of storage so they can be tested and used for the "test now" preview.
+ * Each check answers whether the condition holds for a unit at a moment, with the value and a readable detail.
+ */
+public final class RuleConditions {
+
+    public static final Set<String> TYPES = Set.of(
+            "sensor", "parameter", "digital", "speed", "geofence", "idle", "stop", "connection", "gps", "fuel",
+            "driver", "proximity", "event");
+
+    /** Types that fire on a change (entering, switching on...) rather than on a lasting state. */
+    public static final Set<String> EDGE_MODES = Set.of("enter", "exit", "change", "approach");
+
+    public record Check(boolean holds, Object value, String detail, long geofenceId) {
+        public static Check no() {
+            return new Check(false, null, null, 0);
+        }
+    }
+
+    /** What a condition may need besides the message. */
+    public interface Context {
+        Collection<Geofence> geofences(Position position);
+
+        Position latest(long deviceId);
+
+        long now();
+    }
+
+    private RuleConditions() {
+    }
+
+    public static boolean isEdge(JsonNode config) {
+        JsonNode condition = config.path("condition");
+        String type = config.path("type").asText();
+        return "digital".equals(type) || "proximity".equals(type)
+                || EDGE_MODES.contains(condition.path("mode").asText())
+                || "change".equals(condition.path("op").asText());
+    }
+
+    public static double speedKmh(Position position) {
+        return position.getSpeed() * 1.852;
+    }
+
+    static Object attribute(Position position, String key) {
+        if (key == null || key.isEmpty()) {
+            return null;
+        }
+        switch (key) {
+            case "speed":
+                return speedKmh(position);
+            case "altitude":
+                return position.getAltitude();
+            case "course":
+                return position.getCourse();
+            case "satellites":
+                return position.getAttributes().get(Position.KEY_SATELLITES);
+            default:
+                return position.getAttributes().get(key);
+        }
+    }
+
+    static Double number(Object value) {
+        if (value instanceof Number number) {
+            return number.doubleValue();
+        } else if (value instanceof Boolean bool) {
+            return bool ? 1.0 : 0.0;
+        } else if (value instanceof String text) {
+            try {
+                return Double.parseDouble(text);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    static String format(Object value) {
+        if (value instanceof Double number) {
+            return number == Math.rint(number) ? String.valueOf(number.longValue())
+                    : String.format(Locale.ROOT, "%.2f", number);
+        }
+        return String.valueOf(value);
+    }
+
+    /** Comparison of a value: gt, lt, ge, le, eq, ne, between (inclusive), outside, text eq / ne / contains. */
+    public static boolean compare(String op, Object value, JsonNode condition) {
+        if (value == null) {
+            return false;
+        }
+        Double number = number(value);
+        JsonNode target = condition.path("value");
+        if (number == null || target.isTextual() && number(target.asText()) == null) {
+            String text = String.valueOf(value);
+            String expected = target.asText();
+            return switch (op) {
+                case "ne" -> !text.equalsIgnoreCase(expected);
+                case "contains" -> text.toLowerCase(Locale.ROOT).contains(expected.toLowerCase(Locale.ROOT));
+                default -> text.equalsIgnoreCase(expected);
+            };
+        }
+        double expected = target.asDouble();
+        double min = condition.path("min").asDouble(Double.NEGATIVE_INFINITY);
+        double max = condition.path("max").asDouble(Double.POSITIVE_INFINITY);
+        return switch (op == null ? "gt" : op) {
+            case "lt" -> number < expected;
+            case "ge" -> number >= expected;
+            case "le" -> number <= expected;
+            case "eq" -> number == expected;
+            case "ne" -> number != expected;
+            case "between" -> number >= min && number <= max;
+            case "outside" -> number < min || number > max;
+            default -> number > expected;
+        };
+    }
+
+    static String opText(String op, JsonNode condition) {
+        return switch (op == null ? "gt" : op) {
+            case "lt" -> "< " + format(condition.path("value").asDouble());
+            case "ge" -> "≥ " + format(condition.path("value").asDouble());
+            case "le" -> "≤ " + format(condition.path("value").asDouble());
+            case "eq" -> "= " + condition.path("value").asText();
+            case "ne" -> "≠ " + condition.path("value").asText();
+            case "between" -> "entre " + format(condition.path("min").asDouble()) + " y "
+                    + format(condition.path("max").asDouble());
+            case "outside" -> "fuera de " + format(condition.path("min").asDouble()) + "–"
+                    + format(condition.path("max").asDouble());
+            case "change" -> "cambio ≥ " + format(condition.path("value").asDouble());
+            case "contains" -> "contiene " + condition.path("value").asText();
+            default -> "> " + format(condition.path("value").asDouble());
+        };
+    }
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+
+    static Object sensorValue(Position position, String sensorId) {
+        return sensorId != null ? position.getAttributes().get(Sensor.ATTRIBUTE_PREFIX + sensorId) : null;
+    }
+
+    /**
+     * Sensor a condition refers to on this unit: by id ("sensor"), by name ("sensorName", as units of a fleet have
+     * their own sensor ids) or the first of a type ("sensorType", e.g. any temperature sensor).
+     */
+    static String sensorId(Device device, JsonNode condition) {
+        String id = condition.path("sensor").asText("");
+        if (!id.isEmpty()) {
+            return id;
+        }
+        String name = condition.path("sensorName").asText("");
+        String type = condition.path("sensorType").asText("");
+        if (device == null || name.isEmpty() && type.isEmpty()) {
+            return null;
+        }
+        for (Sensor sensor : SensorConfig.parse(MAPPER, device)) {
+            if (!name.isEmpty() ? name.equalsIgnoreCase(sensor.getName()) : type.equals(sensor.getType())) {
+                return sensor.getId();
+            }
+        }
+        return null;
+    }
+
+    static boolean refersSensor(JsonNode condition) {
+        return !condition.path("sensor").asText("").isEmpty() || !condition.path("sensorName").asText("").isEmpty()
+                || !condition.path("sensorType").asText("").isEmpty();
+    }
+
+    static boolean truthy(Object value) {
+        Double number = number(value);
+        if (number != null) {
+            return number != 0;
+        }
+        return value != null && !String.valueOf(value).isBlank();
+    }
+
+    static List<Long> ids(JsonNode array) {
+        List<Long> result = new ArrayList<>();
+        array.forEach(item -> result.add(item.asLong()));
+        return result;
+    }
+
+    static long insideOf(Position position, List<Long> geofenceIds) {
+        List<Long> current = position.getGeofenceIds();
+        if (current == null) {
+            return 0;
+        }
+        for (Long id : current) {
+            if (geofenceIds.isEmpty() || geofenceIds.contains(id)) {
+                return id;
+            }
+        }
+        return 0;
+    }
+
+    static boolean ignition(Position position) {
+        return position.getBoolean(Position.KEY_IGNITION);
+    }
+
+    static boolean stopped(Position position) {
+        return speedKmh(position) < 3 && !position.getBoolean(Position.KEY_MOTION);
+    }
+
+    /**
+     * Main condition of a rule for a unit's latest message. Event rules never hold here: they fire from the event
+     * itself. Previous is the value of the last check, for "change".
+     */
+    public static Check check(
+            JsonNode config, Device device, Position position, Context context, Object previous) {
+        String type = config.path("type").asText();
+        JsonNode condition = config.path("condition");
+        String op = condition.path("op").asText("gt");
+        if ("connection".equals(type)) {
+            long minutes = condition.path("minutes").asLong(30);
+            long last = device.getLastUpdate() != null ? device.getLastUpdate().getTime() : 0;
+            long silent = (context.now() - last) / 60000;
+            return new Check(last > 0 && silent >= minutes, silent, "sin datos hace " + silent + " min", 0);
+        }
+        if (position == null) {
+            return Check.no();
+        }
+        switch (type) {
+            case "sensor", "parameter" -> {
+                Object value = "sensor".equals(type) ? sensorValue(position, sensorId(device, condition))
+                        : attribute(position, condition.path("param").asText());
+                if ("change".equals(op)) {
+                    Double now = number(value);
+                    Double before = number(previous);
+                    boolean holds = now != null && before != null
+                            && Math.abs(now - before) >= condition.path("value").asDouble();
+                    return new Check(holds, value, now != null && before != null
+                            ? "de " + format(before) + " a " + format(now) : null, 0);
+                }
+                return new Check(compare(op, value, condition), value,
+                        value != null ? format(value) + " (" + opText(op, condition) + ")" : null, 0);
+            }
+            case "digital" -> {
+                Object value = refersSensor(condition) ? sensorValue(position, sensorId(device, condition))
+                        : attribute(position, condition.path("param").asText());
+                boolean on = !"off".equals(condition.path("state").asText("on"));
+                boolean holds = value != null && truthy(value) == on;
+                return new Check(holds, value, on ? "activado" : "desactivado", 0);
+            }
+            case "speed" -> {
+                double speed = speedKmh(position);
+                double limit = condition.path("limit").asDouble(0);
+                if (condition.path("useGeofence").asBoolean()) {
+                    for (Geofence geofence : context.geofences(position)) {
+                        double geofenceLimit = geofence.getDouble("speedLimit") * 1.852;
+                        if (geofenceLimit > 0 && (limit <= 0 || geofenceLimit < limit)) {
+                            limit = geofenceLimit;
+                        }
+                    }
+                }
+                if (limit <= 0) {
+                    limit = device.getDouble("speedLimit") * 1.852;
+                }
+                return new Check(limit > 0 && speed > limit, Math.round(speed),
+                        Math.round(speed) + " km/h (límite " + Math.round(limit) + ")", 0);
+            }
+            case "geofence" -> {
+                List<Long> geofenceIds = ids(condition.path("geofenceIds"));
+                long inside = insideOf(position, geofenceIds);
+                String mode = condition.path("mode").asText("enter");
+                boolean holds = "exit".equals(mode) || "outside".equals(mode) ? inside == 0 : inside != 0;
+                return new Check(holds, inside, switch (mode) {
+                    case "exit" -> "salió de la geocerca";
+                    case "outside" -> "fuera de la geocerca";
+                    case "inside" -> "dentro de la geocerca";
+                    default -> "entró a la geocerca";
+                }, inside);
+            }
+            case "idle" -> {
+                boolean holds = ignition(position) && stopped(position);
+                return new Check(holds, null, "motor encendido detenido", 0);
+            }
+            case "stop" -> {
+                boolean holds = stopped(position);
+                List<Long> geofenceIds = ids(condition.path("geofenceIds"));
+                String where = condition.path("where").asText("any");
+                long inside = insideOf(position, geofenceIds);
+                if ("inside".equals(where)) {
+                    holds &= inside != 0;
+                } else if ("outside".equals(where)) {
+                    holds &= inside == 0;
+                }
+                return new Check(holds, null, "detenido", inside);
+            }
+            case "gps" -> {
+                Double satellites = number(position.getAttributes().get(Position.KEY_SATELLITES));
+                boolean holds = !position.getValid() || satellites != null && satellites < 3;
+                return new Check(holds, satellites, "sin señal GPS válida", 0);
+            }
+            case "fuel" -> {
+                Object value = refersSensor(condition) ? sensorValue(position, sensorId(device, condition))
+                        : position.getAttributes().get(Position.KEY_FUEL_LEVEL);
+                return new Check(compare(op.equals("gt") ? "lt" : op, value, condition), value,
+                        value != null ? "nivel " + format(value) : null, 0);
+            }
+            case "driver" -> {
+                Object driver = position.getAttributes().get(Position.KEY_DRIVER_UNIQUE_ID);
+                boolean holds = ignition(position) && (driver == null || String.valueOf(driver).isBlank());
+                return new Check(holds, driver, "encendido sin conductor identificado", 0);
+            }
+            case "proximity" -> {
+                double radius = condition.path("radius").asDouble(500);
+                double best = Double.MAX_VALUE;
+                if (condition.has("latitude")) {
+                    best = distance(position.getLatitude(), position.getLongitude(),
+                            condition.path("latitude").asDouble(), condition.path("longitude").asDouble());
+                }
+                for (long other : ids(condition.path("deviceIds"))) {
+                    Position target = other != device.getId() ? context.latest(other) : null;
+                    if (target != null) {
+                        best = Math.min(best, distance(position.getLatitude(), position.getLongitude(),
+                                target.getLatitude(), target.getLongitude()));
+                    }
+                }
+                boolean holds = best <= radius;
+                return new Check(holds, best == Double.MAX_VALUE ? null : Math.round(best),
+                        best == Double.MAX_VALUE ? null : "a " + Math.round(best) + " m", 0);
+            }
+            default -> {
+                return Check.no();
+            }
+        }
+    }
+
+    /** Additional conditions that must all hold too (door open AND moving, temperature AND ignition...). */
+    public static boolean extra(JsonNode config, Device device, Position position, Context context) {
+        for (JsonNode item : config.path("extra")) {
+            if (position == null) {
+                return false;
+            }
+            String kind = item.path("kind").asText();
+            String op = item.path("op").asText("gt");
+            boolean holds = switch (kind) {
+                case "sensor" -> compare(op, sensorValue(position, sensorId(device, item)), item);
+                case "parameter" -> compare(op, attribute(position, item.path("param").asText()), item);
+                case "speed" -> compare(op, speedKmh(position), item);
+                case "ignition" -> ignition(position) == !"off".equals(item.path("state").asText("on"));
+                case "motion" -> !stopped(position) == !"off".equals(item.path("state").asText("on"));
+                case "geofence" -> {
+                    long inside = insideOf(position, ids(item.path("geofenceIds")));
+                    yield "outside".equals(item.path("mode").asText("inside")) ? inside == 0 : inside != 0;
+                }
+                default -> true;
+            };
+            if (!holds) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Whether the moment is inside the rule's schedule (days 1 = Monday … 7 = Sunday, from–to, maybe overnight). */
+    public static boolean inSchedule(JsonNode config, long time, ZoneId zone) {
+        JsonNode schedule = config.path("schedule");
+        if (schedule.isMissingNode() || schedule.isNull()) {
+            return true;
+        }
+        ZonedDateTime moment = ZonedDateTime.ofInstant(java.time.Instant.ofEpochMilli(time), zone);
+        boolean inside = true;
+        JsonNode days = schedule.path("days");
+        if (days.isArray() && !days.isEmpty()) {
+            DayOfWeek day = moment.getDayOfWeek();
+            boolean found = false;
+            for (JsonNode item : days) {
+                found |= item.asInt() == day.getValue();
+            }
+            inside = found;
+        }
+        String from = schedule.path("from").asText("");
+        String to = schedule.path("to").asText("");
+        if (inside && !from.isEmpty() && !to.isEmpty()) {
+            LocalTime start = LocalTime.parse(from);
+            LocalTime end = LocalTime.parse(to);
+            LocalTime now = moment.toLocalTime();
+            inside = start.isBefore(end) ? !now.isBefore(start) && now.isBefore(end)
+                    : !now.isBefore(start) || now.isBefore(end);
+        }
+        return schedule.path("invert").asBoolean() != inside;
+    }
+
+    /** Whether an event matches an event rule: its types ("alarm:sos" for one alarm) and, for alarms, the list. */
+    public static boolean matchesEvent(JsonNode config, String type, String alarm) {
+        JsonNode types = config.path("condition").path("events");
+        if (!types.isArray() || types.isEmpty()) {
+            return false;
+        }
+        for (JsonNode item : types) {
+            String value = item.asText();
+            if (value.equals(type) || alarm != null && value.equals("alarm:" + alarm.split(",")[0])) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static String render(String template, Map<String, String> variables) {
+        String result = template;
+        for (Map.Entry<String, String> entry : variables.entrySet()) {
+            result = result.replace("{" + entry.getKey() + "}", entry.getValue() != null ? entry.getValue() : "");
+        }
+        return result;
+    }
+
+    public static double distance(double lat1, double lon1, double lat2, double lon2) {
+        double rad = Math.PI / 180;
+        double a = Math.pow(Math.sin((lat2 - lat1) * rad / 2), 2)
+                + Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.pow(Math.sin((lon2 - lon1) * rad / 2), 2);
+        return 12742000 * Math.asin(Math.sqrt(a));
+    }
+
+}
