+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Position;
+import org.traccar.rules.RuleEngine;
+import org.traccar.session.cache.CacheManager;
+
+/**
+ * Checks the custom alert rules with every new message; the rules store and deliver their own events.
+ */
+public class RuleEventHandler extends BaseEventHandler {
+
+    private final CacheManager cacheManager;
+    private final RuleEngine ruleEngine;
+
+    @Inject
+    public RuleEventHandler(CacheManager cacheManager, RuleEngine ruleEngine) {
+        this.cacheManager = cacheManager;
+        this.ruleEngine = ruleEngine;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        if (PositionUtil.isLatest(cacheManager, position)) {
+            ruleEngine.onPosition(position);
+        }
+    }
+
+}
