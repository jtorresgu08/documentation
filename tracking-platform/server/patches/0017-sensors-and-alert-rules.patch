+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Group;
+import org.traccar.model.Position;
+import org.traccar.model.UserRestrictions;
+import org.traccar.rules.RuleConditions;
+import org.traccar.rules.RuleEngine;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Custom alert rules of the user: list with the alerts of the last 7 days, create, change, delete, enable, test a
+ * rule (saved or not) against the units' latest messages, and the alerts a rule raised.
+ */
+@Path("alert-rules")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class AlertRuleResource extends BaseResource {
+
+    private static final int MAX_CONFIG = 100_000;
+    private static final long WEEK = 7 * 24 * 3600_000L;
+
+    @Inject
+    private RuleEngine ruleEngine;
+
+    private AlertRule owned(long id) throws StorageException {
+        AlertRule rule = storage.getObject(AlertRule.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (rule == null || rule.getUserId() != getUserId() && permissionsService.notAdmin(getUserId())) {
+            throw new NotFoundException();
+        }
+        return rule;
+    }
+
+    private JsonNode validate(AlertRule rule) throws StorageException {
+        if (rule.getName() == null || rule.getName().isBlank() || rule.getConfig() == null
+                || rule.getConfig().length() > MAX_CONFIG) {
+            throw new BadRequestException("Invalid rule");
+        }
+        JsonNode config = ruleEngine.parse(rule.getConfig());
+        if (!RuleConditions.TYPES.contains(config.path("type").asText())) {
+            throw new BadRequestException("Unknown rule type");
+        }
+        for (JsonNode id : config.path("deviceIds")) {
+            permissionsService.checkPermission(Device.class, getUserId(), id.asLong());
+        }
+        for (JsonNode id : config.path("groupIds")) {
+            permissionsService.checkPermission(Group.class, getUserId(), id.asLong());
+        }
+        return config;
+    }
+
+    private Map<Long, Integer> weekCounts() throws StorageException {
+        Map<Long, Integer> counts = new HashMap<>();
+        Set<Long> devices = ruleEngine.devicesOf(getUserId(), ruleEngine.parse("{\"all\":true}"));
+        Date to = new Date();
+        Date from = new Date(to.getTime() - WEEK);
+        for (Event event : storage.getObjects(Event.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("type", AlertRule.EVENT_TYPE),
+                        new Condition.Between("eventTime", from, to))))) {
+            if (devices.contains(event.getDeviceId())) {
+                counts.merge(event.getLong("ruleId"), 1, Integer::sum);
+            }
+        }
+        return counts;
+    }
+
+    @GET
+    public List<Map<String, Object>> list() throws StorageException {
+        Map<Long, Integer> counts = weekCounts();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (AlertRule rule : storage.getObjects(AlertRule.class, new Request(
+                new Columns.All(), new Condition.Equals("userId", getUserId()), new Order("name")))) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("id", rule.getId());
+            item.put("name", rule.getName());
+            item.put("enabled", rule.getEnabled());
+            item.put("config", rule.getConfig());
+            item.put("attributes", rule.getAttributes());
+            item.put("week", counts.getOrDefault(rule.getId(), 0));
+            result.add(item);
+        }
+        return result;
+    }
+
+    @POST
+    public AlertRule add(AlertRule rule) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        validate(rule);
+        rule.setUserId(getUserId());
+        rule.setId(storage.addObject(rule, new Request(new Columns.Exclude("id"))));
+        ruleEngine.invalidate();
+        return rule;
+    }
+
+    @PUT
+    @Path("{id}")
+    public AlertRule update(@PathParam("id") long id, AlertRule rule) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        AlertRule current = owned(id);
+        validate(rule);
+        rule.setId(id);
+        rule.setUserId(current.getUserId());
+        storage.updateObject(rule, new Request(
+                new Columns.Include("name", "enabled", "config", "attributes"), new Condition.Equals("id", id)));
+        ruleEngine.invalidate();
+        return rule;
+    }
+
+    @DELETE
+    @Path("{id}")
+    public Response remove(@PathParam("id") long id) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        owned(id);
+        storage.removeObject(AlertRule.class, new Request(new Condition.Equals("id", id)));
+        ruleEngine.invalidate();
+        return Response.noContent().build();
+    }
+
+    /** Which units meet the condition right now (without duration, schedule or limits), for a saved or new rule. */
+    @POST
+    @Path("test")
+    public Map<String, Object> test(AlertRule rule) throws StorageException {
+        JsonNode config = validate(rule);
+        List<Map<String, Object>> units = new ArrayList<>();
+        RuleConditions.Context context = ruleEngine.context();
+        int matching = 0;
+        for (long deviceId : ruleEngine.devicesOf(getUserId(), config)) {
+            Device device = storage.getObject(Device.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", deviceId)));
+            Position position = ruleEngine.latest(deviceId);
+            boolean holds;
+            Object value = null;
+            String detail = null;
+            if ("event".equals(config.path("type").asText())) {
+                holds = false;
+            } else {
+                RuleConditions.Check check = RuleConditions.check(config, device, position, context, null);
+                holds = check.holds() && RuleConditions.extra(config, device, position, context);
+                value = check.value();
+                detail = check.detail();
+            }
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("deviceId", deviceId);
+            item.put("name", device.getName());
+            item.put("holds", holds);
+            item.put("value", value);
+            item.put("detail", detail);
+            units.add(item);
+            matching += holds ? 1 : 0;
+        }
+        units.sort((a, b) -> Boolean.compare((Boolean) b.get("holds"), (Boolean) a.get("holds")));
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("units", units);
+        result.put("matching", matching);
+        result.put("inSchedule", RuleConditions.inSchedule(config, System.currentTimeMillis(), ZoneId.systemDefault()));
+        return result;
+    }
+
+    @GET
+    @Path("events")
+    public List<Event> events(@QueryParam("ruleId") long ruleId, @QueryParam("days") int days)
+            throws StorageException {
+        if (ruleId > 0) {
+            owned(ruleId);
+        }
+        Set<Long> devices = ruleEngine.devicesOf(getUserId(), ruleEngine.parse("{\"all\":true}"));
+        Date to = new Date();
+        Date from = new Date(to.getTime() - Math.max(1, Math.min(days > 0 ? days : 7, 93)) * 24 * 3600_000L);
+        return storage.getObjects(Event.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("type", AlertRule.EVENT_TYPE),
+                        new Condition.Between("eventTime", from, to)),
+                new Order("eventTime", true, 500))).stream()
+                .filter(event -> devices.contains(event.getDeviceId()))
+                .filter(event -> ruleId <= 0 || event.getLong("ruleId") == ruleId)
+                .toList();
+    }
+
+}
