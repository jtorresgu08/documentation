@@ -0,0 +1,311 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.sensor;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.function.Function;
+
+/**
+ * Formula of a sensor, Wialon style: numbers, device parameters (io201, adc1, can_fuel…), other sensors by id
+ * (#tank1), bits of a parameter (in1:3 is bit 3 of in1), arithmetic (+ - * / % ^), comparisons (&gt; &lt; &gt;= &lt;=
+ * == !=), logic (&amp;&amp; || !), parentheses and functions abs, min, max, round, floor, ceil, sqrt, if(c, a, b),
+ * bit(x, n). A missing parameter makes the whole result null, like Wialon's "invalid value".
+ */
+public final class Expression {
+
+    private final String text;
+    private int index;
+    private final Function<String, Double> variables;
+    private boolean missing;
+
+    private Expression(String text, Function<String, Double> variables) {
+        this.text = text;
+        this.variables = variables;
+    }
+
+    public static Double evaluate(String text, Function<String, Double> variables) {
+        Expression expression = new Expression(text, variables);
+        double value = expression.parse();
+        if (expression.missing || Double.isNaN(value) || Double.isInfinite(value)) {
+            return null;
+        }
+        return value;
+    }
+
+    /** Checks the syntax only; returns the error message, or null when the formula is valid. */
+    public static String validate(String text) {
+        try {
+            new Expression(text, name -> 1.0).parse();
+            return null;
+        } catch (IllegalArgumentException e) {
+            return e.getMessage();
+        }
+    }
+
+    private double parse() {
+        if (text == null || text.isBlank()) {
+            throw new IllegalArgumentException("Empty formula");
+        }
+        double value = parseOr();
+        skipSpaces();
+        if (index < text.length()) {
+            throw new IllegalArgumentException("Unexpected '" + text.charAt(index) + "' at " + (index + 1));
+        }
+        return value;
+    }
+
+    private void skipSpaces() {
+        while (index < text.length() && Character.isWhitespace(text.charAt(index))) {
+            index++;
+        }
+    }
+
+    private boolean accept(String token) {
+        skipSpaces();
+        if (text.startsWith(token, index)) {
+            index += token.length();
+            return true;
+        }
+        return false;
+    }
+
+    private static double bool(boolean value) {
+        return value ? 1 : 0;
+    }
+
+    private double parseOr() {
+        double value = parseAnd();
+        while (accept("||")) {
+            double right = parseAnd();
+            value = bool(value != 0 || right != 0);
+        }
+        return value;
+    }
+
+    private double parseAnd() {
+        double value = parseComparison();
+        while (accept("&&")) {
+            double right = parseComparison();
+            value = bool(value != 0 && right != 0);
+        }
+        return value;
+    }
+
+    private double parseComparison() {
+        double value = parseSum();
+        while (true) {
+            if (accept(">=")) {
+                value = bool(value >= parseSum());
+            } else if (accept("<=")) {
+                value = bool(value <= parseSum());
+            } else if (accept("==")) {
+                value = bool(value == parseSum());
+            } else if (accept("!=")) {
+                value = bool(value != parseSum());
+            } else if (accept(">")) {
+                value = bool(value > parseSum());
+            } else if (accept("<")) {
+                value = bool(value < parseSum());
+            } else {
+                return value;
+            }
+        }
+    }
+
+    private double parseSum() {
+        double value = parseProduct();
+        while (true) {
+            if (accept("+")) {
+                value += parseProduct();
+            } else if (accept("-")) {
+                value -= parseProduct();
+            } else {
+                return value;
+            }
+        }
+    }
+
+    private double parseProduct() {
+        double value = parsePower();
+        while (true) {
+            if (accept("*")) {
+                value *= parsePower();
+            } else if (accept("/")) {
+                double divisor = parsePower();
+                value = divisor == 0 ? Double.NaN : value / divisor;
+            } else if (accept("%")) {
+                double divisor = parsePower();
+                value = divisor == 0 ? Double.NaN : value % divisor;
+            } else {
+                return value;
+            }
+        }
+    }
+
+    private double parsePower() {
+        double value = parseUnary();
+        if (accept("^")) {
+            return Math.pow(value, parsePower());
+        }
+        return value;
+    }
+
+    private double parseUnary() {
+        if (accept("-")) {
+            return -parseUnary();
+        }
+        if (accept("+")) {
+            return parseUnary();
+        }
+        if (accept("!")) {
+            return bool(parseUnary() == 0);
+        }
+        return parsePrimary();
+    }
+
+    private double parsePrimary() {
+        skipSpaces();
+        if (index >= text.length()) {
+            throw new IllegalArgumentException("Unexpected end of formula");
+        }
+        char c = text.charAt(index);
+        if (c == '(') {
+            index++;
+            double value = parseOr();
+            if (!accept(")")) {
+                throw new IllegalArgumentException("Missing ')'");
+            }
+            return value;
+        }
+        if (Character.isDigit(c) || c == '.') {
+            int start = index;
+            while (index < text.length()
+                    && (Character.isDigit(text.charAt(index)) || text.charAt(index) == '.')) {
+                index++;
+            }
+            if (index + 1 < text.length() && text.charAt(start) == '0' && index == start + 1
+                    && (text.charAt(index) == 'x' || text.charAt(index) == 'X')) {
+                index++;
+                int hexStart = index;
+                while (index < text.length() && Character.digit(text.charAt(index), 16) >= 0) {
+                    index++;
+                }
+                return Long.parseLong(text.substring(hexStart, index), 16);
+            }
+            try {
+                return Double.parseDouble(text.substring(start, index));
+            } catch (NumberFormatException e) {
+                throw new IllegalArgumentException("Invalid number at " + (start + 1));
+            }
+        }
+        if (Character.isLetter(c) || c == '_' || c == '#') {
+            int start = index;
+            index++;
+            while (index < text.length()) {
+                char next = text.charAt(index);
+                if (Character.isLetterOrDigit(next) || next == '_' || next == '.') {
+                    index++;
+                } else {
+                    break;
+                }
+            }
+            String name = text.substring(start, index);
+            skipSpaces();
+            if (index < text.length() && text.charAt(index) == '(' && !name.startsWith("#")) {
+                return function(name.toLowerCase(Locale.ROOT));
+            }
+            Integer bit = null;
+            if (index < text.length() && text.charAt(index) == ':') {
+                index++;
+                int bitStart = index;
+                while (index < text.length() && Character.isDigit(text.charAt(index))) {
+                    index++;
+                }
+                if (bitStart == index) {
+                    throw new IllegalArgumentException("Missing bit number after '" + name + ":'");
+                }
+                bit = Integer.parseInt(text.substring(bitStart, index));
+            }
+            Double value = variables.apply(name);
+            if (value == null) {
+                missing = true;
+                return 0;
+            }
+            return bit != null ? (((long) (double) value) >> bit) & 1 : value;
+        }
+        throw new IllegalArgumentException("Unexpected '" + c + "' at " + (index + 1));
+    }
+
+    private double function(String name) {
+        index++;
+        List<Double> arguments = new ArrayList<>();
+        if (!accept(")")) {
+            do {
+                arguments.add(parseOr());
+            } while (accept(","));
+            if (!accept(")")) {
+                throw new IllegalArgumentException("Missing ')' after arguments of " + name);
+            }
+        }
+        int count = arguments.size();
+        switch (name) {
+            case "abs":
+                check(name, count, 1);
+                return Math.abs(arguments.get(0));
+            case "round":
+                if (count == 2) {
+                    double scale = Math.pow(10, arguments.get(1));
+                    return Math.round(arguments.get(0) * scale) / scale;
+                }
+                check(name, count, 1);
+                return Math.round(arguments.get(0));
+            case "floor":
+                check(name, count, 1);
+                return Math.floor(arguments.get(0));
+            case "ceil":
+                check(name, count, 1);
+                return Math.ceil(arguments.get(0));
+            case "sqrt":
+                check(name, count, 1);
+                return Math.sqrt(arguments.get(0));
+            case "min":
+                if (count == 0) {
+                    throw new IllegalArgumentException("min needs arguments");
+                }
+                return arguments.stream().mapToDouble(Double::doubleValue).min().getAsDouble();
+            case "max":
+                if (count == 0) {
+                    throw new IllegalArgumentException("max needs arguments");
+                }
+                return arguments.stream().mapToDouble(Double::doubleValue).max().getAsDouble();
+            case "if":
+                check(name, count, 3);
+                return arguments.get(0) != 0 ? arguments.get(1) : arguments.get(2);
+            case "bit":
+                check(name, count, 2);
+                return (((long) (double) arguments.get(0)) >> (int) (double) arguments.get(1)) & 1;
+            default:
+                throw new IllegalArgumentException("Unknown function " + name);
+        }
+    }
+
+    private static void check(String name, int count, int expected) {
+        if (count != expected) {
+            throw new IllegalArgumentException(name + " needs " + expected + " argument(s)");
+        }
+    }
+
+}
