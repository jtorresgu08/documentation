@@ -0,0 +1,55 @@
+package org.traccar.sensor;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public class ExpressionTest {
+
+    private static Double eval(String formula) {
+        Map<String, Double> values = Map.of("io201", 2048.0, "in1", 10.0, "can_fuel", 50.0, "#tank1", 120.0);
+        return Expression.evaluate(formula, values::get);
+    }
+
+    @Test
+    public void testArithmeticAndPrecedence() {
+        assertEquals(14.0, eval("2 + 3 * 4"));
+        assertEquals(20.0, eval("(2 + 3) * 4"));
+        assertEquals(512.0, eval("2 ^ 3 ^ 2"));
+        assertEquals(-3.0, eval("-(1 + 2)"));
+        assertEquals(255.0, eval("0xFF"));
+    }
+
+    @Test
+    public void testParametersBitsAndSensors() {
+        assertEquals(20.0, eval("can_fuel * 0.4"));
+        assertEquals(1.0, eval("in1:1"));
+        assertEquals(0.0, eval("in1:2"));
+        assertEquals(1.0, eval("bit(in1, 3)"));
+        assertEquals(240.0, eval("#tank1 * 2"));
+        assertNull(eval("missing * 2"));
+        assertNull(eval("io201 / 0"));
+    }
+
+    @Test
+    public void testLogicAndFunctions() {
+        assertEquals(1.0, eval("io201 > 1000 && in1 == 10"));
+        assertEquals(0.0, eval("!(io201 > 1000)"));
+        assertEquals(5.0, eval("if(in1 > 5, 5, in1)"));
+        assertEquals(3.14, eval("round(3.14159, 2)"));
+        assertEquals(10.0, eval("max(1, in1, 3)"));
+    }
+
+    @Test
+    public void testValidation() {
+        assertNull(Expression.validate("io201 * 0.5 + 2"));
+        assertNotNull(Expression.validate("io201 *"));
+        assertNotNull(Expression.validate("foo(1)"));
+        assertNotNull(Expression.validate("(1 + 2"));
+    }
+
+}
diff --git a/src/test/java/org/traccar/sensor/SensorEngineTest.java b/src/test/java/org/traccar/sensor/SensorEngineTest.java
new file mode 100644
index 0000000..1a7787e
--- /dev/null
+++ b/src/test/java/org/traccar/sensor/SensorEngineTest.java
@@ -0,0 +1,110 @@
+package org.traccar.sensor;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Position;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public class SensorEngineTest {
+
+    private static Sensor sensor(String id, String type, String source) {
+        Sensor sensor = new Sensor();
+        sensor.setId(id);
+        sensor.setType(type);
+        sensor.setSource(source);
+        return sensor;
+    }
+
+    private static Position position(long time, Map<String, Object> attributes) {
+        Position position = new Position();
+        position.setDeviceId(1);
+        position.setFixTime(new Date(time));
+        position.getAttributes().putAll(attributes);
+        return position;
+    }
+
+    private static void store(Position position, Map<String, Object> values) {
+        values.forEach((id, value) -> position.getAttributes().put(Sensor.ATTRIBUTE_PREFIX + id, value));
+    }
+
+    @Test
+    public void testFormulaBoundsAndValidation() {
+        Sensor ignition = sensor("ign", "ignition", "in1");
+        Sensor fuel = sensor("fuel", "fuel", null);
+        fuel.setFormula("adc1 * 0.1");
+        fuel.setUpperBound(400.0);
+        fuel.setValidatorId("ign");
+        fuel.setValidation("nonZero");
+        Sensor doubled = sensor("two", "numeric", null);
+        doubled.setFormula("#fuel * 2");
+        SensorEngine engine = new SensorEngine();
+
+        Map<String, Object> on = engine.compute(
+                List.of(ignition, fuel, doubled), position(0, Map.of("in1", true, "adc1", 1500)), null, false);
+        assertEquals(1.0, on.get("ign"));
+        assertEquals(150.0, on.get("fuel"));
+        assertEquals(300.0, on.get("two"));
+
+        Map<String, Object> off = engine.compute(
+                List.of(ignition, fuel), position(0, Map.of("in1", false, "adc1", 1500)), null, false);
+        assertFalse(off.containsKey("fuel"));
+
+        Map<String, Object> outOfBounds = engine.compute(
+                List.of(ignition, fuel), position(0, Map.of("in1", true, "adc1", 9000)), null, false);
+        assertNull(outOfBounds.get("fuel"));
+    }
+
+    @Test
+    public void testAccumulators() {
+        Sensor impulses = sensor("imp", "fuelImpulse", "pulses");
+        impulses.setAccumulate(Sensor.ACCUMULATE_DELTA);
+        impulses.setMultiplier(0.01);
+        Sensor hours = sensor("hours", "engineHours", "ign");
+        hours.setAccumulate(Sensor.ACCUMULATE_TIME);
+        SensorEngine engine = new SensorEngine();
+        List<Sensor> sensors = List.of(impulses, hours);
+
+        Position first = position(0, Map.of("pulses", 1000, "ign", 1));
+        store(first, engine.compute(sensors, first, null, false));
+        Position second = position(600_000, Map.of("pulses", 1500, "ign", 1));
+        Map<String, Object> values = engine.compute(sensors, second, first, false);
+        assertEquals(5.0, values.get("imp"));
+        assertEquals(0.167, values.get("hours"));
+        store(second, values);
+
+        // counter reset: no negative consumption
+        Position third = position(1_200_000, Map.of("pulses", 10, "ign", 0));
+        values = engine.compute(sensors, third, second, false);
+        assertEquals(5.0, values.get("imp"));
+        assertEquals(0.167, values.get("hours"));
+    }
+
+    @Test
+    public void testCalculatedFuelAndEfficiency() {
+        Sensor consumption = sensor("cons", Sensor.TYPE_FUEL_CALCULATED, null);
+        consumption.setRate(30);
+        consumption.setIdleRate(2);
+        Sensor efficiency = sensor("eff", Sensor.TYPE_ENGINE_EFFICIENCY, "rpm");
+        efficiency.setThreshold(800.0);
+        SensorEngine engine = new SensorEngine();
+        Position first = position(0, Map.of("rpm", 600));
+        store(first, engine.compute(List.of(consumption, efficiency), first, null, false));
+        Position moving = position(600_000, Map.of(Position.KEY_DISTANCE, 10000.0, "rpm", 1800));
+        moving.setSpeed(30);
+        Map<String, Object> values = engine.compute(List.of(consumption, efficiency), moving, first, false);
+        assertEquals(3.0, values.get("cons"));
+        assertEquals(1.0, values.get("eff"));
+        store(moving, values);
+        Position idle = position(2_400_000, Map.of(Position.KEY_IGNITION, true, "rpm", 700));
+        values = engine.compute(List.of(consumption, efficiency), idle, moving, false);
+        assertEquals(3.0, values.get("cons")); // 30 min gap is above the 15 min step limit
+        assertEquals(0.0, values.get("eff"));
+    }
+
+}
