+package org.traccar.dispatch;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.database.NotificationManager;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Device;
+import org.traccar.model.DispatchStop;
+import org.traccar.model.DispatchTrip;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.plans.PlanService;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+import org.traccar.whatsapp.WhatsappClient;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Dispatch logic: arrival at stops detected from the unit position (inside the stop radius), departure, late stops
+ * (delivery window missed), estimated arrival times, trip start and completion, delivery events and WhatsApp
+ * messages to the customer (tracking link when the trip starts, confirmation when delivered).
+ */
+@Singleton
+public class DispatchService {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(DispatchService.class);
+
+    public static final String MODULE = "dispatch";
+    public static final double MIN_ETA_SPEED_KMH = 25;
+    public static final double ROAD_FACTOR = 1.3;
+    public static final double DEFAULT_SERVICE_MINUTES = 10;
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final NotificationManager notificationManager;
+    private final WhatsappClient whatsappClient;
+    private final PlanService planService;
+    private final String webUrl;
+
+    /** device id to the ids of its planned and in progress trips (null = not loaded) */
+    private final Map<Long, List<Long>> activeTrips = new ConcurrentHashMap<>();
+
+    @Inject
+    public DispatchService(
+            Config config, Storage storage, CacheManager cacheManager, NotificationManager notificationManager,
+            WhatsappClient whatsappClient, PlanService planService) {
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.notificationManager = notificationManager;
+        this.whatsappClient = whatsappClient;
+        this.planService = planService;
+        String url = config.getString(Keys.WEB_URL);
+        this.webUrl = url != null ? url.replaceAll("/+$", "") : null;
+    }
+
+    public static String token() {
+        byte[] bytes = new byte[18];
+        RANDOM.nextBytes(bytes);
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+    }
+
+    public static double distance(double lat1, double lon1, double lat2, double lon2) {
+        double rad = Math.PI / 180;
+        double a = Math.pow(Math.sin((lat2 - lat1) * rad / 2), 2)
+                + Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.pow(Math.sin((lon2 - lon1) * rad / 2), 2);
+        return 2 * 6371008.8 * Math.asin(Math.sqrt(a));
+    }
+
+    public void invalidate(long deviceId) {
+        activeTrips.remove(deviceId);
+    }
+
+    public DispatchTrip getTrip(long tripId) throws StorageException {
+        return storage.getObject(DispatchTrip.class, new Request(
+                new Columns.All(), new Condition.Equals("id", tripId)));
+    }
+
+    public List<DispatchStop> getStops(long tripId) throws StorageException {
+        return storage.getObjects(DispatchStop.class, new Request(
+                new Columns.All(), new Condition.Equals("tripId", tripId), new Order("sequence")));
+    }
+
+    private List<Long> loadActive(long deviceId) throws StorageException {
+        List<Long> result = new ArrayList<>();
+        for (DispatchTrip trip : storage.getObjects(DispatchTrip.class, new Request(
+                new Columns.All(), new Condition.Equals("deviceId", deviceId)))) {
+            if (DispatchTrip.IN_PROGRESS.equals(trip.getStatus())
+                    || DispatchTrip.PLANNED.equals(trip.getStatus()) && trip.getPlannedStart() != null
+                    && Math.abs(trip.getPlannedStart().getTime() - System.currentTimeMillis()) < 86_400_000L) {
+                result.add(trip.getId());
+            }
+        }
+        return result;
+    }
+
+    private void update(Object model, String... columns) throws StorageException {
+        long id = model instanceof DispatchTrip trip ? trip.getId() : ((DispatchStop) model).getId();
+        storage.updateObject(model, new Request(new Columns.Include(columns), new Condition.Equals("id", id)));
+    }
+
+    private Event event(String type, DispatchTrip trip, DispatchStop stop, Position position) {
+        Event event = position != null ? new Event(type, position) : new Event(type, trip.getDeviceId());
+        event.set("tripId", trip.getId());
+        event.set("tripName", trip.getName());
+        event.set("stopId", stop.getId());
+        event.set("stopName", stop.getName());
+        event.set("stopSequence", stop.getSequence());
+        if (stop.getRecipient() != null) {
+            event.set("recipient", stop.getRecipient());
+        }
+        if (stop.getFailureReason() != null) {
+            event.set("reason", stop.getFailureReason());
+        }
+        event.set("severity", switch (type) {
+            case Event.TYPE_DISPATCH_FAILED, Event.TYPE_DISPATCH_LATE -> "high";
+            default -> "low";
+        });
+        return event;
+    }
+
+    public void startTrip(DispatchTrip trip, Date time) throws StorageException {
+        trip.setStatus(DispatchTrip.IN_PROGRESS);
+        trip.setStartTime(time);
+        update(trip, "status", "startTime");
+        invalidate(trip.getDeviceId());
+        for (DispatchStop stop : getStops(trip.getId())) {
+            sendWhatsapp(trip, stop.getPhone(), String.format(
+                    "Tu pedido «%s» ya está en camino. Síguelo en vivo: %s", stop.getName(), trackingUrl(stop)));
+        }
+    }
+
+    private void checkCompleted(DispatchTrip trip, Date time) throws StorageException {
+        if (getStops(trip.getId()).stream().allMatch(DispatchStop::done)) {
+            trip.setStatus(DispatchTrip.COMPLETED);
+            trip.setEndTime(time);
+            update(trip, "status", "endTime");
+            invalidate(trip.getDeviceId());
+        }
+    }
+
+    public String trackingUrl(DispatchStop stop) {
+        return webUrl != null ? webUrl + "/track/" + stop.getTrackingToken() : null;
+    }
+
+    private void sendWhatsapp(DispatchTrip trip, String phone, String text) {
+        if (phone == null || WhatsappClient.normalize(phone).isEmpty() || !whatsappClient.configured()
+                || text.contains("null")) {
+            return;
+        }
+        try {
+            if (planService.hasModule(trip.getUserId(), "whatsapp")) {
+                whatsappClient.sendText(phone, text);
+            }
+        } catch (Exception e) {
+            LOGGER.warn("Dispatch WhatsApp message failed", e);
+        }
+    }
+
+    /**
+     * Arrival (entering the stop radius) and departure from the position of the unit, plus late stops.
+     */
+    public List<Event> onPosition(Position position) throws StorageException {
+        List<Event> events = new ArrayList<>();
+        long deviceId = position.getDeviceId();
+        List<Long> tripIds = activeTrips.get(deviceId);
+        if (tripIds == null) {
+            tripIds = loadActive(deviceId);
+            activeTrips.put(deviceId, tripIds);
+        }
+        Date time = position.getFixTime();
+        for (long tripId : tripIds) {
+            DispatchTrip trip = getTrip(tripId);
+            if (trip == null) {
+                continue;
+            }
+            boolean changed = false;
+            for (DispatchStop stop : getStops(tripId)) {
+                if (stop.done()) {
+                    continue;
+                }
+                double meters = distance(position.getLatitude(), position.getLongitude(),
+                        stop.getLatitude(), stop.getLongitude());
+                boolean inside = meters <= Math.max(stop.getRadius(), 30);
+                if (DispatchStop.PENDING.equals(stop.getStatus()) && inside) {
+                    if (DispatchTrip.PLANNED.equals(trip.getStatus())) {
+                        startTrip(trip, time);
+                    }
+                    stop.setStatus(DispatchStop.ARRIVED);
+                    stop.setArrivalTime(time);
+                    update(stop, "status", "arrivalTime");
+                    events.add(event(Event.TYPE_DISPATCH_ARRIVAL, trip, stop, position));
+                    changed = true;
+                } else if (DispatchStop.ARRIVED.equals(stop.getStatus()) && !inside
+                        && stop.getDepartureTime() == null && meters > Math.max(stop.getRadius(), 30) * 1.5) {
+                    stop.setDepartureTime(time);
+                    update(stop, "departureTime");
+                } else if (DispatchStop.ARRIVED.equals(stop.getStatus()) && inside && stop.getDepartureTime() != null) {
+                    stop.setDepartureTime(null);
+                    update(stop, "departureTime");
+                }
+                if (!stop.getLate() && stop.getWindowEnd() != null && DispatchStop.PENDING.equals(stop.getStatus())
+                        && time.after(stop.getWindowEnd())) {
+                    stop.setLate(true);
+                    update(stop, "late");
+                    events.add(event(Event.TYPE_DISPATCH_LATE, trip, stop, position));
+                }
+            }
+            if (changed) {
+                invalidate(deviceId);
+            }
+        }
+        return events;
+    }
+
+    /**
+     * Delivery reported by the driver or the dispatcher: delivered, failed, skipped, arrived or back to pending.
+     */
+    public void setStopStatus(
+            DispatchTrip trip, DispatchStop stop, String status, Map<String, Object> details) throws StorageException {
+        Date now = new Date();
+        Position position = getPosition(trip.getDeviceId());
+        stop.setStatus(status);
+        if (details.get("recipient") instanceof String recipient && !recipient.isBlank()) {
+            stop.setRecipient(recipient.trim());
+        }
+        if (details.get("notes") instanceof String notes) {
+            stop.setNotes(notes.trim());
+        }
+        if (details.get("failureReason") instanceof String reason && !reason.isBlank()) {
+            stop.setFailureReason(reason.trim());
+        }
+        if (details.get("latitude") instanceof Number latitude
+                && details.get("longitude") instanceof Number longitude) {
+            stop.setProofLatitude(latitude.doubleValue());
+            stop.setProofLongitude(longitude.doubleValue());
+        } else if (position != null && stop.done()) {
+            stop.setProofLatitude(position.getLatitude());
+            stop.setProofLongitude(position.getLongitude());
+        }
+        if (DispatchStop.ARRIVED.equals(status) && stop.getArrivalTime() == null) {
+            stop.setArrivalTime(now);
+        }
+        if (DispatchStop.PENDING.equals(status)) {
+            stop.setCompletedTime(null);
+        } else if (stop.done()) {
+            stop.setCompletedTime(now);
+            if (stop.getArrivalTime() == null) {
+                stop.setArrivalTime(now);
+            }
+        }
+        update(stop, "status", "recipient", "notes", "failureReason", "proofLatitude", "proofLongitude",
+                "arrivalTime", "completedTime", "photo", "signature");
+        if (DispatchTrip.PLANNED.equals(trip.getStatus()) && !DispatchStop.PENDING.equals(status)) {
+            startTrip(trip, now);
+        }
+        Map<Event, Position> events = new HashMap<>();
+        if (DispatchStop.DELIVERED.equals(status)) {
+            events.put(event(Event.TYPE_DISPATCH_DELIVERED, trip, stop, position), position);
+            sendWhatsapp(trip, stop.getPhone(), String.format("Pedido «%s» entregado%s. ¡Gracias!", stop.getName(),
+                    stop.getRecipient() != null ? " a " + stop.getRecipient() : ""));
+        } else if (DispatchStop.FAILED.equals(status)) {
+            events.put(event(Event.TYPE_DISPATCH_FAILED, trip, stop, position), position);
+        }
+        if (!events.isEmpty()) {
+            notificationManager.updateEvents(events);
+        }
+        checkCompleted(trip, now);
+        invalidate(trip.getDeviceId());
+    }
+
+    /**
+     * Estimated arrival at every pending stop, in order, from the last position: road distance estimated from the
+     * straight line, current speed (at least 25 km/h) and a service time at each stop.
+     */
+    public Map<Long, Date> estimate(DispatchTrip trip, List<DispatchStop> stops) {
+        Map<Long, Date> result = new LinkedHashMap<>();
+        if (!DispatchTrip.IN_PROGRESS.equals(trip.getStatus())) {
+            return result;
+        }
+        Position position = getPosition(trip.getDeviceId());
+        if (position == null) {
+            return result;
+        }
+        double speed = Math.max(UnitsConverter.kphFromKnots(position.getSpeed()), MIN_ETA_SPEED_KMH);
+        double lat = position.getLatitude();
+        double lon = position.getLongitude();
+        long time = Math.max(System.currentTimeMillis(), position.getFixTime().getTime());
+        for (DispatchStop stop : stops) {
+            if (stop.done()) {
+                continue;
+            }
+            if (DispatchStop.ARRIVED.equals(stop.getStatus())) {
+                result.put(stop.getId(), stop.getArrivalTime());
+                time += (long) (DEFAULT_SERVICE_MINUTES * 60_000);
+            } else {
+                double meters = distance(lat, lon, stop.getLatitude(), stop.getLongitude()) * ROAD_FACTOR;
+                time += (long) (meters / (speed / 3.6) * 1000);
+                result.put(stop.getId(), new Date(time));
+                time += (long) (DEFAULT_SERVICE_MINUTES * 60_000);
+            }
+            lat = stop.getLatitude();
+            lon = stop.getLongitude();
+        }
+        return result;
+    }
+
+    public Device getDevice(long deviceId) {
+        Device device = cacheManager.getObject(Device.class, deviceId);
+        if (device == null) {
+            try {
+                device = storage.getObject(Device.class, new Request(
+                        new Columns.All(), new Condition.Equals("id", deviceId)));
+            } catch (StorageException e) {
+                LOGGER.warn("Device lookup failed", e);
+            }
+        }
+        return device;
+    }
+
+    /**
+     * Last position of the unit: from the cache when the unit is connected, otherwise from the database.
+     */
+    public Position getPosition(long deviceId) {
+        Position position = cacheManager.getPosition(deviceId);
+        if (position == null) {
+            Device device = getDevice(deviceId);
+            if (device != null && device.getPositionId() > 0) {
+                try {
+                    position = storage.getObject(Position.class, new Request(
+                            new Columns.All(), new Condition.Equals("id", device.getPositionId())));
+                } catch (StorageException e) {
+                    LOGGER.warn("Position lookup failed", e);
+                }
+            }
+        }
+        return position;
+    }
+
+}
