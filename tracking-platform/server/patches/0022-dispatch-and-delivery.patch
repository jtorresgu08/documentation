+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.dispatch.DispatchService;
+import org.traccar.model.Device;
+import org.traccar.model.DispatchStop;
+import org.traccar.model.DispatchTrip;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.time.OffsetDateTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Dispatch and delivery: trips with ordered stops for a unit, public driver link to report deliveries (photo,
+ * signature, recipient), public customer tracking link per stop with the estimated arrival, and the compliance report.
+ */
+@Path("dispatch")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class DispatchResource extends BaseResource {
+
+    private static final int MAX_IMAGE = 3 * 1024 * 1024;
+    private static final Set<String> DRIVER_STATUSES = Set.of(
+            DispatchStop.ARRIVED, DispatchStop.DELIVERED, DispatchStop.FAILED);
+    private static final Set<String> STATUSES = Set.of(
+            DispatchStop.PENDING, DispatchStop.ARRIVED, DispatchStop.DELIVERED, DispatchStop.FAILED,
+            DispatchStop.SKIPPED);
+
+    @Inject
+    private DispatchService dispatchService;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    @Inject
+    private Config config;
+
+    // ---------- helpers ----------
+
+    private Set<Long> accessibleDevices() throws StorageException {
+        Collection<Device> devices = permissionsService.notAdmin(getUserId())
+                ? storage.getObjects(Device.class, new Request(
+                        new Columns.Include("id"), new Condition.Permission(User.class, getUserId(), Device.class)))
+                : storage.getObjects(Device.class, new Request(new Columns.Include("id")));
+        Set<Long> result = new HashSet<>();
+        devices.forEach(device -> result.add(device.getId()));
+        return result;
+    }
+
+    private DispatchTrip checkTrip(long tripId) throws StorageException {
+        DispatchTrip trip = dispatchService.getTrip(tripId);
+        if (trip == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        permissionsService.checkPermission(Device.class, getUserId(), trip.getDeviceId());
+        return trip;
+    }
+
+    private void checkWritable() throws StorageException {
+        if (permissionsService.getUser(getUserId()).getReadonly()) {
+            throw new SecurityException("Read-only user");
+        }
+    }
+
+    private Map<String, Object> view(DispatchTrip trip, boolean withStops) throws StorageException {
+        List<DispatchStop> stops = dispatchService.getStops(trip.getId());
+        Map<String, Object> result = objectMapper.convertValue(trip, new TypeReference<>() { });
+        Device device = dispatchService.getDevice(trip.getDeviceId());
+        result.put("deviceName", device != null ? device.getName() : null);
+        Map<String, Long> progress = new LinkedHashMap<>();
+        progress.put("total", (long) stops.size());
+        for (String status : STATUSES) {
+            progress.put(status, stops.stream().filter(stop -> status.equals(stop.getStatus())).count());
+        }
+        progress.put("late", stops.stream().filter(DispatchStop::getLate).count());
+        result.put("progress", progress);
+        Map<Long, Date> etas = dispatchService.estimate(trip, stops);
+        if (withStops) {
+            List<Map<String, Object>> items = new ArrayList<>();
+            for (DispatchStop stop : stops) {
+                Map<String, Object> item = objectMapper.convertValue(stop, new TypeReference<>() { });
+                Date eta = etas.get(stop.getId());
+                item.put("eta", eta);
+                item.put("atRisk", eta != null && stop.getWindowEnd() != null && eta.after(stop.getWindowEnd()));
+                items.add(item);
+            }
+            result.put("stops", items);
+        }
+        Position position = dispatchService.getPosition(trip.getDeviceId());
+        if (position != null && DispatchTrip.IN_PROGRESS.equals(trip.getStatus())) {
+            result.put("position", Map.of("latitude", position.getLatitude(), "longitude", position.getLongitude(),
+                    "course", position.getCourse(), "fixTime", position.getFixTime()));
+        }
+        return result;
+    }
+
+    private List<DispatchStop> readStops(Object value) {
+        List<DispatchStop> stops = value == null ? new ArrayList<>()
+                : lenient().convertValue(value, new TypeReference<List<DispatchStop>>() { });
+        if (stops.isEmpty()) {
+            throw new IllegalArgumentException("A trip needs at least one stop");
+        }
+        for (DispatchStop stop : stops) {
+            if (stop.getName() == null || stop.getName().isBlank()
+                    || Math.abs(stop.getLatitude()) > 90 || Math.abs(stop.getLongitude()) > 180
+                    || stop.getLatitude() == 0 && stop.getLongitude() == 0) {
+                throw new IllegalArgumentException("Every stop needs a name and valid coordinates");
+            }
+            if (stop.getRadius() <= 0) {
+                stop.setRadius(100);
+            }
+        }
+        return stops;
+    }
+
+    private ObjectMapper lenient() {
+        // the editor sends back computed fields (eta, progress...) that are not part of the models
+        return objectMapper.copy().configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
+    }
+
+    private DispatchTrip readTrip(Map<String, Object> body) {
+        Map<String, Object> copy = new HashMap<>(body);
+        copy.remove("stops");
+        for (String key : List.of("id", "status", "startTime", "endTime", "driverToken", "userId", "created",
+                "deviceName", "progress", "position")) {
+            copy.remove(key);
+        }
+        DispatchTrip trip = lenient().convertValue(copy, DispatchTrip.class);
+        if (trip.getName() == null || trip.getName().isBlank() || trip.getDeviceId() <= 0) {
+            throw new IllegalArgumentException("A trip needs a name and a unit");
+        }
+        return trip;
+    }
+
+    private void saveStops(DispatchTrip trip, List<DispatchStop> stops) throws StorageException {
+        Map<Long, DispatchStop> existing = new HashMap<>();
+        for (DispatchStop stop : dispatchService.getStops(trip.getId())) {
+            existing.put(stop.getId(), stop);
+        }
+        int sequence = 1;
+        for (DispatchStop stop : stops) {
+            DispatchStop before = existing.remove(stop.getId());
+            stop.setTripId(trip.getId());
+            stop.setSequence(sequence++);
+            if (before != null) {
+                // progress and proof stay as they were, only the plan of the stop changes
+                stop.setStatus(before.getStatus());
+                stop.setArrivalTime(before.getArrivalTime());
+                stop.setDepartureTime(before.getDepartureTime());
+                stop.setCompletedTime(before.getCompletedTime());
+                stop.setRecipient(before.getRecipient());
+                stop.setFailureReason(before.getFailureReason());
+                stop.setPhoto(before.getPhoto());
+                stop.setSignature(before.getSignature());
+                stop.setProofLatitude(before.getProofLatitude());
+                stop.setProofLongitude(before.getProofLongitude());
+                stop.setLate(before.getLate());
+                stop.setTrackingToken(before.getTrackingToken());
+                storage.updateObject(stop, new Request(
+                        new Columns.Exclude("id"), new Condition.Equals("id", stop.getId())));
+            } else {
+                stop.setStatus(DispatchStop.PENDING);
+                stop.setTrackingToken(DispatchService.token());
+                stop.setLate(false);
+                stop.setId(storage.addObject(stop, new Request(new Columns.Exclude("id"))));
+            }
+        }
+        for (DispatchStop removed : existing.values()) {
+            storage.removeObject(DispatchStop.class, new Request(new Condition.Equals("id", removed.getId())));
+        }
+        dispatchService.invalidate(trip.getDeviceId());
+    }
+
+    private String saveImage(DispatchTrip trip, DispatchStop stop, String kind, Object value) throws IOException {
+        if (!(value instanceof String data) || !data.startsWith("data:image/")) {
+            return null;
+        }
+        String mediaPath = config.getString(Keys.MEDIA_PATH);
+        if (mediaPath == null) {
+            return null;
+        }
+        int comma = data.indexOf(',');
+        String extension = data.startsWith("data:image/png") ? "png" : "jpg";
+        byte[] bytes = Base64.getDecoder().decode(data.substring(comma + 1));
+        if (bytes.length > MAX_IMAGE) {
+            throw new IllegalArgumentException("Image too large");
+        }
+        String name = String.format("dispatch/%d/stop%d-%s-%d.%s",
+                trip.getId(), stop.getId(), kind, System.currentTimeMillis(), extension);
+        java.nio.file.Path file = Paths.get(mediaPath, name);
+        Files.createDirectories(file.getParent());
+        Files.write(file, bytes);
+        return name;
+    }
+
+    private DispatchStop findStop(DispatchTrip trip, long stopId) throws StorageException {
+        return dispatchService.getStops(trip.getId()).stream().filter(stop -> stop.getId() == stopId)
+                .findFirst().orElseThrow(() -> new WebApplicationException(
+                        Response.status(Response.Status.NOT_FOUND).build()));
+    }
+
+    private void applyStatus(DispatchTrip trip, DispatchStop stop, Map<String, Object> body) throws Exception {
+        String status = String.valueOf(body.getOrDefault("status", ""));
+        if (!STATUSES.contains(status)) {
+            throw new IllegalArgumentException("Invalid status");
+        }
+        if (DispatchTrip.CANCELLED.equals(trip.getStatus())) {
+            throw new IllegalArgumentException("Trip cancelled");
+        }
+        String photo = saveImage(trip, stop, "photo", body.get("photo"));
+        if (photo != null) {
+            stop.setPhoto(photo);
+        }
+        String signature = saveImage(trip, stop, "signature", body.get("signature"));
+        if (signature != null) {
+            stop.setSignature(signature);
+        }
+        dispatchService.setStopStatus(trip, stop, status, body);
+    }
+
+    // ---------- dispatcher ----------
+
+    @GET
+    @Path("trips")
+    public List<Map<String, Object>> trips(
+            @QueryParam("from") Date from, @QueryParam("to") Date to, @QueryParam("deviceId") long deviceId,
+            @QueryParam("status") String status) throws StorageException {
+        Set<Long> devices = accessibleDevices();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (DispatchTrip trip : storage.getObjects(DispatchTrip.class, new Request(new Columns.All()))) {
+            Date reference = trip.getPlannedStart() != null ? trip.getPlannedStart() : trip.getCreated();
+            boolean active = DispatchTrip.IN_PROGRESS.equals(trip.getStatus());
+            if (!devices.contains(trip.getDeviceId()) || deviceId > 0 && trip.getDeviceId() != deviceId
+                    || status != null && !status.isEmpty() && !status.equals(trip.getStatus())
+                    || !active && (from != null && reference != null && reference.before(from)
+                    || to != null && reference != null && reference.after(to))) {
+                continue;
+            }
+            result.add(view(trip, true));
+        }
+        result.sort(Comparator.comparing(item -> String.valueOf(item.get("plannedStart"))));
+        return result;
+    }
+
+    @GET
+    @Path("trips/{id}")
+    public Map<String, Object> trip(@PathParam("id") long id) throws StorageException {
+        return view(checkTrip(id), true);
+    }
+
+    @POST
+    @Path("trips")
+    public Map<String, Object> create(Map<String, Object> body) throws Exception {
+        checkWritable();
+        DispatchTrip trip = readTrip(body);
+        permissionsService.checkPermission(Device.class, getUserId(), trip.getDeviceId());
+        List<DispatchStop> stops = readStops(body.get("stops"));
+        trip.setUserId(getUserId());
+        trip.setStatus(DispatchTrip.PLANNED);
+        trip.setDriverToken(DispatchService.token());
+        trip.setCreated(new Date());
+        if (trip.getPlannedStart() == null) {
+            trip.setPlannedStart(new Date());
+        }
+        trip.setId(storage.addObject(trip, new Request(new Columns.Exclude("id"))));
+        stops.forEach(stop -> stop.setId(0));
+        saveStops(trip, stops);
+        return view(trip, true);
+    }
+
+    @PUT
+    @Path("trips/{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkWritable();
+        DispatchTrip trip = checkTrip(id);
+        DispatchTrip changes = readTrip(body);
+        permissionsService.checkPermission(Device.class, getUserId(), changes.getDeviceId());
+        long previousDevice = trip.getDeviceId();
+        trip.setName(changes.getName());
+        trip.setDeviceId(changes.getDeviceId());
+        trip.setDriverName(changes.getDriverName());
+        trip.setDriverPhone(changes.getDriverPhone());
+        trip.setPlannedStart(changes.getPlannedStart());
+        trip.setNotes(changes.getNotes());
+        trip.setAttributes(changes.getAttributes());
+        storage.updateObject(trip, new Request(
+                new Columns.Include("name", "deviceId", "driverName", "driverPhone", "plannedStart", "notes",
+                        "attributes"), new Condition.Equals("id", trip.getId())));
+        saveStops(trip, readStops(body.get("stops")));
+        dispatchService.invalidate(previousDevice);
+        return view(trip, true);
+    }
+
+    @DELETE
+    @Path("trips/{id}")
+    public Response remove(@PathParam("id") long id) throws StorageException {
+        checkWritable();
+        DispatchTrip trip = checkTrip(id);
+        storage.removeObject(DispatchTrip.class, new Request(new Condition.Equals("id", id)));
+        dispatchService.invalidate(trip.getDeviceId());
+        return Response.noContent().build();
+    }
+
+    @POST
+    @Path("trips/{id}/{action: start|cancel|complete|reopen}")
+    public Map<String, Object> action(@PathParam("id") long id, @PathParam("action") String action) throws Exception {
+        checkWritable();
+        DispatchTrip trip = checkTrip(id);
+        switch (action) {
+            case "start" -> dispatchService.startTrip(trip, new Date());
+            case "cancel" -> trip.setStatus(DispatchTrip.CANCELLED);
+            case "complete" -> {
+                trip.setStatus(DispatchTrip.COMPLETED);
+                trip.setEndTime(new Date());
+            }
+            default -> {
+                trip.setStatus(DispatchTrip.PLANNED);
+                trip.setEndTime(null);
+            }
+        }
+        storage.updateObject(trip, new Request(
+                new Columns.Include("status", "endTime"), new Condition.Equals("id", trip.getId())));
+        dispatchService.invalidate(trip.getDeviceId());
+        return view(trip, true);
+    }
+
+    @POST
+    @Path("stops/{id}/status")
+    public Map<String, Object> stopStatus(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkWritable();
+        DispatchStop stop = storage.getObject(DispatchStop.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (stop == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        DispatchTrip trip = checkTrip(stop.getTripId());
+        applyStatus(trip, stop, body);
+        return view(dispatchService.getTrip(trip.getId()), true);
+    }
+
+    @GET
+    @Path("stops/{id}/{kind: photo|signature}")
+    @Produces({"image/jpeg", "image/png"})
+    public Response proof(@PathParam("id") long id, @PathParam("kind") String kind) throws Exception {
+        DispatchStop stop = storage.getObject(DispatchStop.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (stop == null) {
+            return Response.status(Response.Status.NOT_FOUND).build();
+        }
+        checkTrip(stop.getTripId());
+        String name = "photo".equals(kind) ? stop.getPhoto() : stop.getSignature();
+        String mediaPath = config.getString(Keys.MEDIA_PATH);
+        if (name == null || mediaPath == null || name.contains("..")) {
+            return Response.status(Response.Status.NOT_FOUND).build();
+        }
+        java.nio.file.Path file = Paths.get(mediaPath, name);
+        if (!Files.exists(file)) {
+            return Response.status(Response.Status.NOT_FOUND).build();
+        }
+        return Response.ok(Files.readAllBytes(file), name.endsWith(".png") ? "image/png" : "image/jpeg").build();
+    }
+
+    /**
+     * Compliance: trips, delivered and failed stops, on time deliveries, late stops, service time, by unit and
+     * driver, and failure reasons.
+     */
+    @GET
+    @Path("report")
+    public Map<String, Object> report(
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        List<Map<String, Object>> trips = trips(from, to, 0, null);
+        Map<String, Object> summary = new LinkedHashMap<>();
+        Map<String, Map<String, Object>> byUnit = new TreeMap<>();
+        Map<String, Map<String, Object>> byDriver = new TreeMap<>();
+        Map<String, Long> reasons = new TreeMap<>();
+        long stops = 0;
+        long delivered = 0;
+        long failed = 0;
+        long onTime = 0;
+        long late = 0;
+        long serviceMinutes = 0;
+        long serviceCount = 0;
+        long completed = 0;
+        for (Map<String, Object> trip : trips) {
+            if (DispatchTrip.CANCELLED.equals(trip.get("status"))) {
+                continue;
+            }
+            if (DispatchTrip.COMPLETED.equals(trip.get("status"))) {
+                completed++;
+            }
+            long tripDelivered = 0;
+            long tripTotal = 0;
+            @SuppressWarnings("unchecked")
+            List<Map<String, Object>> items = (List<Map<String, Object>>) trip.get("stops");
+            for (Map<String, Object> stop : items) {
+                tripTotal++;
+                stops++;
+                Date window = toDate(stop.get("windowEnd"));
+                Date done = toDate(stop.get("completedTime"));
+                Date arrival = toDate(stop.get("arrivalTime"));
+                if (DispatchStop.DELIVERED.equals(stop.get("status"))) {
+                    delivered++;
+                    tripDelivered++;
+                    if (window == null || done != null && !done.after(window)) {
+                        onTime++;
+                    }
+                } else if (DispatchStop.FAILED.equals(stop.get("status"))) {
+                    failed++;
+                    reasons.merge(String.valueOf(stop.getOrDefault("failureReason", "-")), 1L, Long::sum);
+                }
+                if (Boolean.TRUE.equals(stop.get("late"))) {
+                    late++;
+                }
+                if (arrival != null && done != null && !done.before(arrival)) {
+                    serviceMinutes += (done.getTime() - arrival.getTime()) / 60000;
+                    serviceCount++;
+                }
+            }
+            accumulate(byUnit, String.valueOf(trip.get("deviceName")), tripTotal, tripDelivered);
+            String driver = (String) trip.get("driverName");
+            accumulate(byDriver, driver != null && !driver.isBlank() ? driver : "-", tripTotal, tripDelivered);
+        }
+        summary.put("trips", trips.stream().filter(trip -> !DispatchTrip.CANCELLED.equals(trip.get("status"))).count());
+        summary.put("completedTrips", completed);
+        summary.put("stops", stops);
+        summary.put("delivered", delivered);
+        summary.put("failed", failed);
+        summary.put("onTime", onTime);
+        summary.put("late", late);
+        summary.put("onTimeRate", delivered > 0 ? Math.round(onTime * 1000.0 / delivered) / 10.0 : null);
+        summary.put("deliveryRate", stops > 0 ? Math.round(delivered * 1000.0 / stops) / 10.0 : null);
+        summary.put("avgServiceMinutes",
+                serviceCount > 0 ? Math.round(serviceMinutes * 10.0 / serviceCount) / 10.0 : null);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("summary", summary);
+        result.put("byUnit", byUnit.values());
+        result.put("byDriver", byDriver.values());
+        result.put("reasons", reasons);
+        result.put("trips", trips);
+        return result;
+    }
+
+    private static Date toDate(Object value) {
+        if (value instanceof Date date) {
+            return date;
+        } else if (value instanceof Number number) {
+            return new Date(number.longValue());
+        } else if (value instanceof String text && !text.isEmpty()) {
+            try {
+                return Date.from(OffsetDateTime.parse(text, DateTimeFormatter.ISO_OFFSET_DATE_TIME).toInstant());
+            } catch (DateTimeParseException e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    private static void accumulate(Map<String, Map<String, Object>> map, String name, long stops, long delivered) {
+        Map<String, Object> item = map.computeIfAbsent(name, key -> new LinkedHashMap<>(Map.of(
+                "name", key, "trips", 0L, "stops", 0L, "delivered", 0L)));
+        item.put("trips", (Long) item.get("trips") + 1);
+        item.put("stops", (Long) item.get("stops") + stops);
+        item.put("delivered", (Long) item.get("delivered") + delivered);
+    }
+
+    // ---------- public: driver ----------
+
+    private DispatchTrip tripByToken(String token) throws StorageException {
+        DispatchTrip trip = token == null || token.length() < 16 ? null : storage.getObject(DispatchTrip.class,
+                new Request(new Columns.All(), new Condition.Equals("driverToken", token)));
+        if (trip == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return trip;
+    }
+
+    @GET
+    @PermitAll
+    @Path("driver/{token}")
+    public Map<String, Object> driver(@PathParam("token") String token) throws StorageException {
+        Map<String, Object> result = view(tripByToken(token), true);
+        result.remove("driverToken");
+        result.remove("userId");
+        @SuppressWarnings("unchecked")
+        List<Map<String, Object>> stops = (List<Map<String, Object>>) result.get("stops");
+        stops.forEach(stop -> {
+            stop.remove("trackingToken");
+            stop.remove("photo");
+            stop.remove("signature");
+        });
+        return result;
+    }
+
+    @POST
+    @PermitAll
+    @Path("driver/{token}/start")
+    public Map<String, Object> driverStart(@PathParam("token") String token) throws StorageException {
+        DispatchTrip trip = tripByToken(token);
+        if (DispatchTrip.PLANNED.equals(trip.getStatus())) {
+            dispatchService.startTrip(trip, new Date());
+        }
+        return driver(token);
+    }
+
+    @POST
+    @PermitAll
+    @Path("driver/{token}/stops/{id}")
+    public Map<String, Object> driverStop(
+            @PathParam("token") String token, @PathParam("id") long id, Map<String, Object> body) throws Exception {
+        DispatchTrip trip = tripByToken(token);
+        if (!DRIVER_STATUSES.contains(String.valueOf(body.get("status")))) {
+            throw new IllegalArgumentException("Invalid status");
+        }
+        applyStatus(trip, findStop(trip, id), body);
+        return driver(token);
+    }
+
+    // ---------- public: customer ----------
+
+    @GET
+    @PermitAll
+    @Path("track/{token}")
+    public Map<String, Object> track(@PathParam("token") String token) throws StorageException {
+        DispatchStop stop = token == null || token.length() < 16 ? null : storage.getObject(DispatchStop.class,
+                new Request(new Columns.All(), new Condition.Equals("trackingToken", token)));
+        if (stop == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        DispatchTrip trip = dispatchService.getTrip(stop.getTripId());
+        List<DispatchStop> stops = dispatchService.getStops(trip.getId());
+        Date eta = dispatchService.estimate(trip, stops).get(stop.getId());
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("name", stop.getName());
+        result.put("address", stop.getAddress());
+        result.put("latitude", stop.getLatitude());
+        result.put("longitude", stop.getLongitude());
+        result.put("status", stop.getStatus());
+        result.put("windowStart", stop.getWindowStart());
+        result.put("windowEnd", stop.getWindowEnd());
+        result.put("arrivalTime", stop.getArrivalTime());
+        result.put("completedTime", stop.getCompletedTime());
+        result.put("recipient", stop.getRecipient());
+        result.put("failureReason", stop.getFailureReason());
+        result.put("eta", eta);
+        result.put("tripStatus", trip.getStatus());
+        result.put("plannedStart", trip.getPlannedStart());
+        String driver = trip.getDriverName();
+        result.put("driverName", driver != null ? driver.trim().split("\\s+")[0] : null);
+        Device device = dispatchService.getDevice(trip.getDeviceId());
+        result.put("vehicle", device != null ? device.getName() : null);
+        result.put("stopsBefore", stops.stream().filter(item -> item.getSequence() < stop.getSequence()
+                && !item.done()).count());
+        result.put("ownerId", trip.getUserId());
+        Position position = dispatchService.getPosition(trip.getDeviceId());
+        if (position != null && DispatchTrip.IN_PROGRESS.equals(trip.getStatus()) && !stop.done()) {
+            result.put("position", Map.of("latitude", position.getLatitude(), "longitude", position.getLongitude(),
+                    "course", position.getCourse(), "fixTime", position.getFixTime()));
+        }
+        return result;
+    }
+
+}
