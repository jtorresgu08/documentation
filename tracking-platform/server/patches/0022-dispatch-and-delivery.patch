diff --git a/src/main/java/org/traccar/dispatch/DispatchService.java b/src/main/java/org/traccar/dispatch/DispatchService.java
new file mode 100644
index 0000000..b145073
--- /dev/null
+++ b/src/main/java/org/traccar/dispatch/DispatchService.java
@@ -0,0 +1,372 @@
