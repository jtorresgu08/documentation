+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.dispatch.DispatchService;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+
+/**
+ * Dispatch events from positions: arrival at a stop and stops whose delivery window was missed.
+ */
+public class DispatchEventHandler extends BaseEventHandler {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(DispatchEventHandler.class);
+
+    private final CacheManager cacheManager;
+    private final DispatchService dispatchService;
+
+    @Inject
+    public DispatchEventHandler(CacheManager cacheManager, DispatchService dispatchService) {
+        this.cacheManager = cacheManager;
+        this.dispatchService = dispatchService;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        if (!PositionUtil.isLatest(cacheManager, position) || !position.getValid()) {
+            return;
+        }
+        try {
+            for (Event event : dispatchService.onPosition(position)) {
+                callback.eventDetected(event);
+            }
+        } catch (StorageException e) {
+            LOGGER.warn("Dispatch processing failed", e);
+        }
+    }
+
+}
