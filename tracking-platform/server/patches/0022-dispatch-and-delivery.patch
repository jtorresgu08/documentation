diff --git a/src/main/java/org/traccar/api/resource/DispatchResource.java b/src/main/java/org/traccar/api/resource/DispatchResource.java
new file mode 100644
index 0000000..9ad13a9
--- /dev/null
+++ b/src/main/java/org/traccar/api/resource/DispatchResource.java
@@ -0,0 +1,615 @@
