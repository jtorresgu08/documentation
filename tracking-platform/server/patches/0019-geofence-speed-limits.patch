+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.geofence.GeofenceSpeed;
+import org.traccar.geofence.GeofenceSpeedReport;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Geofence;
+import org.traccar.model.User;
+import org.traccar.model.UserRestrictions;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Geofence speeding report: episodes above the geofence limits of the chosen units in the period, by level (mild,
+ * dangerous, critical, or within tolerance), with totals by level, by geofence and a ranking of units weighted by
+ * seriousness (mild 1, dangerous 3, critical 5 points).
+ */
+@Path("geofence-speed")
+@Produces(MediaType.APPLICATION_JSON)
+public class GeofenceSpeedResource extends BaseResource {
+
+    private static final long MAX_PERIOD = 31L * 24 * 3600_000L;
+    private static final Map<String, Integer> WEIGHT = Map.of(
+            GeofenceSpeed.MILD, 1, GeofenceSpeed.DANGER, 3, GeofenceSpeed.CRITICAL, 5);
+
+    @GET
+    @Path("report")
+    public Map<String, Object> report(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("geofenceId") List<Long> geofenceIds, @QueryParam("level") List<String> levels,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getDisableReports);
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+        Request request = permissionsService.notAdmin(getUserId())
+                ? new Request(new Columns.All(), new Condition.Permission(User.class, getUserId(), Geofence.class))
+                : new Request(new Columns.All());
+        Map<Long, Geofence> geofences = new HashMap<>();
+        for (Geofence geofence : storage.getObjects(Geofence.class, request)) {
+            if (GeofenceSpeed.limit(geofence) > 0) {
+                geofences.put(geofence.getId(), geofence);
+            }
+        }
+        List<Map<String, Object>> episodes = new ArrayList<>();
+        List<Map<String, Object>> units = new ArrayList<>();
+        Map<String, Integer> episodesByLevel = new LinkedHashMap<>();
+        Map<String, Integer> pointsByLevel = new LinkedHashMap<>();
+        GeofenceSpeed.ORDER.forEach(level -> {
+            episodesByLevel.put(level, 0);
+            pointsByLevel.put(level, 0);
+        });
+        Map<String, Map<String, Object>> byGeofence = new LinkedHashMap<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            List<Map<String, Object>> deviceEpisodes = GeofenceSpeedReport.episodes(
+                    PositionUtil.getPositions(storage, device.getId(), from, to), geofences, geofenceIds).stream()
+                    .filter(item -> levels.isEmpty() || levels.contains((String) item.get("level")))
+                    .toList();
+            if (deviceEpisodes.isEmpty()) {
+                continue;
+            }
+            Map<String, Object> unit = new LinkedHashMap<>();
+            Map<String, Integer> unitLevels = new LinkedHashMap<>();
+            GeofenceSpeed.ORDER.forEach(level -> unitLevels.put(level, 0));
+            int score = 0;
+            long maxExcess = 0;
+            for (Map<String, Object> episode : deviceEpisodes) {
+                String level = (String) episode.get("level");
+                episode.put("deviceId", device.getId());
+                episode.put("deviceName", device.getName());
+                episodes.add(episode);
+                episodesByLevel.merge(level, 1, Integer::sum);
+                unitLevels.merge(level, 1, Integer::sum);
+                score += WEIGHT.getOrDefault(level, 0);
+                maxExcess = Math.max(maxExcess, (Long) episode.get("maxExcess"));
+                @SuppressWarnings("unchecked")
+                Map<String, Integer> points = (Map<String, Integer>) episode.get("points");
+                points.forEach((key, count) -> pointsByLevel.merge(key, count, Integer::sum));
+                Map<String, Object> geofence = byGeofence.computeIfAbsent(
+                        (String) episode.get("geofenceName"), key -> {
+                            Map<String, Object> entry = new LinkedHashMap<>();
+                            entry.put("geofenceId", episode.get("geofenceId"));
+                            entry.put("speedLimit", episode.get("speedLimit"));
+                            GeofenceSpeed.ORDER.forEach(item -> entry.put(item, 0));
+                            entry.put("episodes", 0);
+                            return entry;
+                        });
+                geofence.merge("episodes", 1, (a, b) -> (Integer) a + (Integer) b);
+                geofence.merge(level, 1, (a, b) -> (Integer) a + (Integer) b);
+            }
+            unit.put("deviceId", device.getId());
+            unit.put("deviceName", device.getName());
+            unit.put("episodes", deviceEpisodes.size());
+            unit.put("levels", unitLevels);
+            unit.put("maxExcess", maxExcess);
+            unit.put("score", score);
+            units.add(unit);
+        }
+        episodes.sort(Comparator.comparing(item -> -((Long) item.get("start"))));
+        units.sort(Comparator.comparing(item -> -((Integer) item.get("score"))));
+        Map<String, Object> summary = new LinkedHashMap<>();
+        summary.put("episodes", episodes.size());
+        summary.put("episodesByLevel", episodesByLevel);
+        summary.put("pointsByLevel", pointsByLevel);
+        summary.put("byGeofence", byGeofence);
+        summary.put("geofencesWithLimit", geofences.size());
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("summary", summary);
+        result.put("units", units);
+        result.put("episodes", episodes.size() > 2000 ? episodes.subList(0, 2000) : episodes);
+        return result;
+    }
+
+}
diff --git a/src/main/java/org/traccar/geofence/GeofenceSpeed.java b/src/main/java/org/traccar/geofence/GeofenceSpeed.java
