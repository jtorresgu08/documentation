--- /dev/null
+++ b/src/test/java/org/traccar/geofence/GeofenceSpeedTest.java
@@ -0,0 +1,73 @@
+package org.traccar.geofence;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Geofence;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public class GeofenceSpeedTest {
+
+    private static Geofence geofence(long id, double limit) {
+        Geofence geofence = new Geofence();
+        geofence.setId(id);
+        geofence.setName("Zona " + id);
+        geofence.set(GeofenceSpeed.LIMIT, limit);
+        return geofence;
+    }
+
+    private static Position position(long second, double speedKmh, Long geofenceId) {
+        Position position = new Position();
+        position.setFixTime(new Date(second * 1000));
+        position.setSpeed(speedKmh / 1.852);
+        position.setGeofenceIds(geofenceId != null ? List.of(geofenceId) : null);
+        return position;
+    }
+
+    @Test
+    public void testLevels() {
+        double[] levels = GeofenceSpeed.levels(geofence(1, 40));
+        assertArrayEquals(new double[] {5, 10, 15}, levels);
+        assertNull(GeofenceSpeed.level(0, levels));
+        assertEquals(GeofenceSpeed.TOLERANCE, GeofenceSpeed.level(3, levels));
+        assertEquals(GeofenceSpeed.MILD, GeofenceSpeed.level(5, levels));
+        assertEquals(GeofenceSpeed.DANGER, GeofenceSpeed.level(12, levels));
+        assertEquals(GeofenceSpeed.CRITICAL, GeofenceSpeed.level(15, levels));
+        Geofence custom = geofence(2, 30);
+        custom.set(GeofenceSpeed.LEVELS, "3,6,9");
+        assertArrayEquals(new double[] {3, 6, 9}, GeofenceSpeed.levels(custom));
+        custom.set(GeofenceSpeed.LEVELS, "9,6,3");
+        assertArrayEquals(new double[] {5, 10, 15}, GeofenceSpeed.levels(custom));
+        assertEquals(2, GeofenceSpeed.limiting(List.of(geofence(1, 40), custom)).getId());
+    }
+
+    @Test
+    public void testEpisodes() {
+        Map<Long, Geofence> geofences = Map.of(1L, geofence(1, 40));
+        List<Position> positions = new ArrayList<>();
+        positions.add(position(0, 35, 1L));
+        positions.add(position(10, 44, 1L)); // tolerance
+        positions.add(position(20, 52, 1L)); // dangerous
+        positions.add(position(30, 58, 1L)); // critical (peak)
+        positions.add(position(40, 38, 1L)); // under the limit: ends
+        positions.add(position(50, 47, 1L)); // mild
+        positions.add(position(60, 90, null)); // outside: ends
+        List<Map<String, Object>> episodes = GeofenceSpeedReport.episodes(positions, geofences, List.of());
+        assertEquals(2, episodes.size());
+        Map<String, Object> first = episodes.get(0);
+        assertEquals(GeofenceSpeed.CRITICAL, first.get("level"));
+        assertEquals(18L, first.get("maxExcess"));
+        assertEquals(20000L, first.get("duration"));
+        assertEquals(Map.of("tolerance", 1, "danger", 1, "critical", 1), first.get("points"));
+        assertEquals(GeofenceSpeed.MILD, episodes.get(1).get("level"));
+        assertEquals(0, GeofenceSpeedReport.episodes(positions, geofences, List.of(5L)).size());
+    }
+
+}
