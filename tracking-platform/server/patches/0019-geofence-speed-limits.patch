@@ -0,0 +1,121 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.geofence;
+
+import org.traccar.model.Geofence;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Speeding episodes of a unit inside geofences with a limit: consecutive messages above the limit in the same
+ * geofence (a gap over 5 minutes or a message at or under the limit ends it). Each episode keeps the start, end,
+ * maximum speed and excess, average excess, the messages at each level and the place of the maximum; its level is
+ * the one of its maximum excess.
+ */
+public final class GeofenceSpeedReport {
+
+    static final long MAX_GAP = 5 * 60 * 1000L;
+
+    private GeofenceSpeedReport() {
+    }
+
+    private static final class Episode {
+        private Geofence geofence;
+        private double limit;
+        private double[] levels;
+        private long start;
+        private long end;
+        private double maxSpeed;
+        private double excessTotal;
+        private Position peak;
+        private final Map<String, Integer> points = new LinkedHashMap<>();
+    }
+
+    private static Map<String, Object> close(Episode episode) {
+        int count = episode.points.values().stream().mapToInt(Integer::intValue).sum();
+        double maxExcess = episode.maxSpeed - episode.limit;
+        Map<String, Object> item = new LinkedHashMap<>();
+        item.put("geofenceId", episode.geofence.getId());
+        item.put("geofenceName", episode.geofence.getName());
+        item.put("speedLimit", Math.round(episode.limit));
+        item.put("start", episode.start);
+        item.put("end", episode.end);
+        item.put("duration", episode.end - episode.start);
+        item.put("maxSpeed", Math.round(episode.maxSpeed));
+        item.put("maxExcess", Math.round(maxExcess));
+        item.put("averageExcess", Math.round(episode.excessTotal / count * 10) / 10.0);
+        item.put("level", GeofenceSpeed.level(maxExcess, episode.levels));
+        item.put("points", episode.points);
+        item.put("count", count);
+        item.put("latitude", episode.peak.getLatitude());
+        item.put("longitude", episode.peak.getLongitude());
+        item.put("positionId", episode.peak.getId());
+        return item;
+    }
+
+    /** Episodes of one unit; geofences by id, filter empty for all the geofences with a limit. */
+    public static List<Map<String, Object>> episodes(
+            List<Position> positions, Map<Long, Geofence> geofences, List<Long> filter) {
+        List<Map<String, Object>> result = new ArrayList<>();
+        Episode current = null;
+        long last = 0;
+        for (Position position : positions) {
+            List<Geofence> inside = new ArrayList<>();
+            if (position.getGeofenceIds() != null) {
+                for (long id : position.getGeofenceIds()) {
+                    Geofence geofence = geofences.get(id);
+                    if (geofence != null && (filter.isEmpty() || filter.contains(id))) {
+                        inside.add(geofence);
+                    }
+                }
+            }
+            Geofence geofence = GeofenceSpeed.limiting(inside);
+            long time = position.getFixTime().getTime();
+            double speed = GeofenceSpeed.speedKmh(position);
+            double limit = GeofenceSpeed.limit(geofence);
+            boolean over = geofence != null && speed > limit;
+            if (current != null && (!over || current.geofence.getId() != geofence.getId() || time - last > MAX_GAP)) {
+                result.add(close(current));
+                current = null;
+            }
+            if (over) {
+                if (current == null) {
+                    current = new Episode();
+                    current.geofence = geofence;
+                    current.limit = limit;
+                    current.levels = GeofenceSpeed.levels(geofence);
+                    current.start = time;
+                    current.peak = position;
+                }
+                current.end = time;
+                current.excessTotal += speed - limit;
+                if (speed > current.maxSpeed) {
+                    current.maxSpeed = speed;
+                    current.peak = position;
+                }
+                current.points.merge(GeofenceSpeed.level(speed - limit, current.levels), 1, Integer::sum);
+                last = time;
+            }
+        }
+        if (current != null) {
+            result.add(close(current));
+        }
+        return result;
+    }
+
+}
