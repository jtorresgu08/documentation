+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.traccar.geofence.GeofenceSpeed;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Event;
+import org.traccar.model.Geofence;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Speeding inside geofences with their own limit: raises "geofenceOverspeed" when a unit goes above the mild
+ * threshold (tolerance does not alert) and again if the excess gets worse (mild, dangerous, critical) within the same
+ * episode; the episode ends when the unit is back under the limit or leaves the geofence. Geofences with
+ * "speedAlert" = false keep the limit for reports without alerting.
+ */
+public class GeofenceOverspeedEventHandler extends BaseEventHandler {
+
+    private final CacheManager cacheManager;
+
+    private record State(long geofenceId, int level) {
+    }
+
+    private final Map<Long, State> states = new ConcurrentHashMap<>();
+
+    @Inject
+    public GeofenceOverspeedEventHandler(CacheManager cacheManager) {
+        this.cacheManager = cacheManager;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        if (!PositionUtil.isLatest(cacheManager, position)) {
+            return;
+        }
+        long deviceId = position.getDeviceId();
+        List<Geofence> geofences = new ArrayList<>();
+        if (position.getGeofenceIds() != null) {
+            for (long id : position.getGeofenceIds()) {
+                Geofence geofence = cacheManager.getObject(Geofence.class, id);
+                if (geofence != null && !"false".equals(geofence.getString(GeofenceSpeed.ALERT))) {
+                    geofences.add(geofence);
+                }
+            }
+        }
+        Geofence geofence = GeofenceSpeed.limiting(geofences);
+        if (geofence == null) {
+            states.remove(deviceId);
+            return;
+        }
+        double limit = GeofenceSpeed.limit(geofence);
+        double speed = GeofenceSpeed.speedKmh(position);
+        String level = GeofenceSpeed.level(speed - limit, GeofenceSpeed.levels(geofence));
+        if (level == null) {
+            states.remove(deviceId);
+            return;
+        }
+        int rank = GeofenceSpeed.ORDER.indexOf(level);
+        State state = states.get(deviceId);
+        if (state != null && state.geofenceId() != geofence.getId()) {
+            state = null;
+        }
+        if (rank == 0 || state != null && state.level() >= rank) {
+            if (state == null) {
+                states.put(deviceId, new State(geofence.getId(), 0));
+            }
+            return;
+        }
+        states.put(deviceId, new State(geofence.getId(), rank));
+        Event event = new Event(Event.TYPE_GEOFENCE_OVERSPEED, position);
+        event.setGeofenceId(geofence.getId());
+        event.set("speed", Math.round(speed));
+        event.set("speedLimit", Math.round(limit));
+        event.set("excess", Math.round(speed - limit));
+        event.set("level", level);
+        event.set("severity", GeofenceSpeed.severity(level));
+        callback.eventDetected(event);
+    }
+
+}
