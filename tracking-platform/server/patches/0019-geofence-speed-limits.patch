--- /dev/null
+++ b/src/main/java/org/traccar/geofence/GeofenceSpeed.java
@@ -0,0 +1,109 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.geofence;
+
+import org.traccar.model.Geofence;
+import org.traccar.model.Position;
+
+import java.util.Collection;
+import java.util.List;
+
+/**
+ * Optional speed limit of a geofence (km/h, attribute "speedLimitKmh") and how serious an excess is: below the mild
+ * threshold it is within tolerance, then mild, dangerous and critical (by default 5, 10 and 15 km/h above the limit,
+ * changeable per geofence with "speedLevels" = "5,10,15"). Kept apart from Traccar's own "speedLimit" so the standard
+ * overspeed event is not duplicated.
+ */
+public final class GeofenceSpeed {
+
+    public static final String LIMIT = "speedLimitKmh";
+    public static final String ALERT = "speedAlert";
+    public static final String LEVELS = "speedLevels";
+
+    public static final String TOLERANCE = "tolerance";
+    public static final String MILD = "mild";
+    public static final String DANGER = "danger";
+    public static final String CRITICAL = "critical";
+
+    public static final List<String> ORDER = List.of(TOLERANCE, MILD, DANGER, CRITICAL);
+
+    static final double[] DEFAULT_LEVELS = {5, 10, 15};
+
+    private GeofenceSpeed() {
+    }
+
+    public static double limit(Geofence geofence) {
+        return geofence != null ? geofence.getDouble(LIMIT) : 0;
+    }
+
+    public static double[] levels(Geofence geofence) {
+        String text = geofence != null ? geofence.getString(LEVELS) : null;
+        if (text != null) {
+            String[] parts = text.split("[,;\\s]+");
+            if (parts.length == 3) {
+                try {
+                    double mild = Double.parseDouble(parts[0]);
+                    double danger = Double.parseDouble(parts[1]);
+                    double critical = Double.parseDouble(parts[2]);
+                    if (mild >= 0 && danger > mild && critical > danger) {
+                        return new double[] {mild, danger, critical};
+                    }
+                } catch (NumberFormatException e) {
+                    return DEFAULT_LEVELS;
+                }
+            }
+        }
+        return DEFAULT_LEVELS;
+    }
+
+    /** Level of an excess over the limit in km/h; null when not above the limit. */
+    public static String level(double excess, double[] levels) {
+        if (excess <= 0) {
+            return null;
+        }
+        if (excess >= levels[2]) {
+            return CRITICAL;
+        }
+        if (excess >= levels[1]) {
+            return DANGER;
+        }
+        return excess >= levels[0] ? MILD : TOLERANCE;
+    }
+
+    /** Priority in the alert center for a level. */
+    public static String severity(String level) {
+        return switch (level) {
+            case CRITICAL -> "critical";
+            case DANGER -> "high";
+            default -> "medium";
+        };
+    }
+
+    public static double speedKmh(Position position) {
+        return position.getSpeed() * 1.852;
+    }
+
+    /** The geofence with a limit the unit is in; with several, the one with the lowest limit. */
+    public static Geofence limiting(Collection<Geofence> geofences) {
+        Geofence result = null;
+        for (Geofence geofence : geofences) {
+            double limit = limit(geofence);
+            if (limit > 0 && (result == null || limit < limit(result))) {
+                result = geofence;
+            }
+        }
+        return result;
+    }
+
+}
