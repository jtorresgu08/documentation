+package org.traccar.sensor;
+
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Sensor report of a unit over a period, from the values stored with each message: readings, minimum, maximum,
+ * average weighted by time, first and last, the period's amount for running totals (mileage, engine hours, fuel
+ * consumption, counters), time on and number of activations for digital sensors, and time spent in each color range.
+ * A gap longer than 15 minutes between messages does not count as time in any state.
+ */
+public final class SensorStatistics {
+
+    static final long MAX_STEP = 15 * 60 * 1000L;
+
+    private SensorStatistics() {
+    }
+
+    private static Double number(Object value) {
+        if (value instanceof Number number) {
+            return number.doubleValue();
+        } else if (value instanceof Boolean bool) {
+            return bool ? 1.0 : 0.0;
+        }
+        return null;
+    }
+
+    private static double round(double value) {
+        return Math.round(value * 1000) / 1000.0;
+    }
+
+    public static Map<String, Object> compute(Sensor sensor, List<Position> positions) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", sensor.getId());
+        result.put("name", sensor.getName());
+        result.put("type", sensor.getType());
+        result.put("unit", sensor.getUnit());
+        String key = sensor.getKey();
+        int count = 0;
+        double min = Double.POSITIVE_INFINITY;
+        double max = Double.NEGATIVE_INFINITY;
+        double weighted = 0;
+        long weightedTime = 0;
+        Double first = null;
+        Double last = null;
+        long firstTime = 0;
+        long lastTime = 0;
+        long onTime = 0;
+        int activations = 0;
+        Double previous = null;
+        long previousTime = 0;
+        List<Map<String, Object>> ranges = sensor.getRanges();
+        long[] rangeTime = new long[ranges.size()];
+        String lastText = null;
+        for (Position position : positions) {
+            Object raw = position.getAttributes().get(key);
+            long time = position.getFixTime().getTime();
+            if (raw instanceof String text) {
+                lastText = text;
+                count++;
+                continue;
+            }
+            Double value = number(raw);
+            if (value == null) {
+                continue;
+            }
+            count++;
+            if (first == null) {
+                first = value;
+                firstTime = time;
+            }
+            if (previous != null) {
+                long step = time - previousTime;
+                if (step > 0 && step <= MAX_STEP) {
+                    weighted += previous * step;
+                    weightedTime += step;
+                    if (previous != 0) {
+                        onTime += step;
+                    }
+                    for (int i = 0; i < ranges.size(); i++) {
+                        Double from = number(parse(ranges.get(i).get("from")));
+                        Double to = number(parse(ranges.get(i).get("to")));
+                        if (from != null && to != null && previous >= from && previous < to) {
+                            rangeTime[i] += step;
+                        }
+                    }
+                }
+                if (previous == 0 && value != 0) {
+                    activations++;
+                }
+            } else if (value != 0) {
+                activations++;
+            }
+            min = Math.min(min, value);
+            max = Math.max(max, value);
+            last = value;
+            lastTime = time;
+            previous = value;
+            previousTime = time;
+        }
+        result.put("count", count);
+        if (lastText != null && first == null) {
+            result.put("last", lastText);
+            return result;
+        }
+        if (first == null) {
+            return result;
+        }
+        result.put("min", round(min));
+        result.put("max", round(max));
+        result.put("average", round(weightedTime > 0 ? weighted / weightedTime : last));
+        result.put("first", round(first));
+        result.put("last", round(last));
+        result.put("firstTime", firstTime);
+        result.put("lastTime", lastTime);
+        if (sensor.isTotal()) {
+            result.put("total", round(Math.max(0, last - first)));
+        }
+        if (sensor.isDigital()) {
+            result.put("onTime", onTime);
+            result.put("onPercent", weightedTime > 0 ? Math.round(onTime * 1000.0 / weightedTime) / 10.0 : 0);
+            result.put("activations", activations);
+        }
+        if (!ranges.isEmpty()) {
+            List<Map<String, Object>> times = new ArrayList<>();
+            for (int i = 0; i < ranges.size(); i++) {
+                Map<String, Object> item = new LinkedHashMap<>(ranges.get(i));
+                item.put("time", rangeTime[i]);
+                item.put("percent", weightedTime > 0 ? Math.round(rangeTime[i] * 1000.0 / weightedTime) / 10.0 : 0);
+                times.add(item);
+            }
+            result.put("ranges", times);
+        }
+        return result;
+    }
+
+    private static Object parse(Object value) {
+        if (value instanceof String text) {
+            try {
+                return Double.parseDouble(text);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+        return value;
+    }
+
+}
diff --git a/src/test/java/org/traccar/sensor/SensorStatisticsTest.java b/src/test/java/org/traccar/sensor/SensorStatisticsTest.java
new file mode 100644
index 0000000..e39fe76
--- /dev/null
+++ b/src/test/java/org/traccar/sensor/SensorStatisticsTest.java
@@ -0,0 +1,65 @@
+package org.traccar.sensor;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class SensorStatisticsTest {
+
+    private static Position position(long minute, Object value) {
+        Position position = new Position();
+        position.setFixTime(new Date(minute * 60_000));
+        position.set("sensor.s", value instanceof Double number ? number : null);
+        if (value instanceof Boolean bool) {
+            position.getAttributes().put("sensor.s", bool ? 1.0 : 0.0);
+        }
+        return position;
+    }
+
+    @Test
+    public void testGaugeWithRanges() {
+        Sensor sensor = new Sensor();
+        sensor.setId("s");
+        sensor.setType("temperature");
+        sensor.setRanges(List.of(Map.of("from", 2, "to", 8), Map.of("from", "8", "to", "99")));
+        List<Position> positions = new ArrayList<>();
+        positions.add(position(0, 4.0));
+        positions.add(position(10, 10.0));
+        positions.add(position(20, 6.0));
+        positions.add(position(60, 5.0)); // 40 min gap: not counted
+        Map<String, Object> result = SensorStatistics.compute(sensor, positions);
+        assertEquals(4, result.get("count"));
+        assertEquals(4.0, result.get("min"));
+        assertEquals(10.0, result.get("max"));
+        assertEquals(7.0, result.get("average"));
+        @SuppressWarnings("unchecked")
+        List<Map<String, Object>> ranges = (List<Map<String, Object>>) result.get("ranges");
+        assertEquals(600_000L, ranges.get(0).get("time"));
+        assertEquals(50.0, ranges.get(1).get("percent"));
+    }
+
+    @Test
+    public void testDigitalAndTotal() {
+        Sensor door = new Sensor();
+        door.setId("s");
+        door.setType("door");
+        List<Position> positions = List.of(position(0, false), position(5, true), position(10, true),
+                position(15, false), position(20, true), position(25, false));
+        Map<String, Object> result = SensorStatistics.compute(door, positions);
+        assertEquals(900_000L, result.get("onTime"));
+        assertEquals(2, result.get("activations"));
+        assertEquals(60.0, result.get("onPercent"));
+
+        Sensor mileage = new Sensor();
+        mileage.setId("s");
+        mileage.setType("mileage");
+        assertEquals(25.0, SensorStatistics.compute(mileage, List.of(position(0, 100.0), position(5, 125.0))).get("total"));
+    }
+
+}
