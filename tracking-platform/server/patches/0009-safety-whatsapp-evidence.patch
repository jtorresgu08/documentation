+ * limitations under the License.
+ */
+package org.traccar.whatsapp;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import jakarta.ws.rs.client.Client;
+import jakarta.ws.rs.client.Entity;
+import jakarta.ws.rs.core.Response;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Sends WhatsApp messages through the Meta Cloud API. Free text only reaches users who wrote in the last 24 hours;
+ * alerts use the approved template when one is configured.
+ */
+@Singleton
+public class WhatsappClient {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(WhatsappClient.class);
+
+    private final Client client;
+    private final String url;
+    private final String token;
+    private final String template;
+    private final String language;
+
+    @Inject
+    public WhatsappClient(Config config, Client client) {
+        this.client = client;
+        this.url = String.format("%s/%s/%s/messages",
+                config.getString(Keys.NOTIFICATOR_WHATSAPP_URL),
+                config.getString(Keys.NOTIFICATOR_WHATSAPP_API_VERSION),
+                config.getString(Keys.NOTIFICATOR_WHATSAPP_PHONE_NUMBER_ID));
+        this.token = config.getString(Keys.NOTIFICATOR_WHATSAPP_TOKEN);
+        this.template = config.getString(Keys.NOTIFICATOR_WHATSAPP_TEMPLATE);
+        this.language = config.getString(Keys.NOTIFICATOR_WHATSAPP_LANGUAGE);
+    }
+
+    public static String normalize(String phone) {
+        return phone != null ? phone.replaceAll("[^0-9]", "") : "";
+    }
+
+    public boolean configured() {
+        return token != null && !token.isBlank();
+    }
+
+    public void sendText(String to, String text) {
+        post(Map.of(
+                "messaging_product", "whatsapp",
+                "to", normalize(to),
+                "type", "text",
+                "text", Map.of("preview_url", true, "body", text)));
+    }
+
+    public void sendAlert(String to, String text) {
+        if (template == null || template.isBlank()) {
+            sendText(to, text);
+            return;
+        }
+        // template variables cannot contain new lines or more than four spaces in a row
+        String parameter = text.replaceAll("\\s*\\n\\s*", " · ").replaceAll(" {4,}", " ");
+        post(Map.of(
+                "messaging_product", "whatsapp",
+                "to", normalize(to),
+                "type", "template",
+                "template", Map.of(
+                        "name", template,
+                        "language", Map.of("code", language),
+                        "components", List.of(Map.of(
+                                "type", "body",
+                                "parameters", List.of(Map.of("type", "text", "text", parameter)))))));
+    }
+
+    private void post(Map<String, Object> message) {
+        if (!configured()) {
+            throw new IllegalStateException("WhatsApp is not configured");
+        }
+        try (Response response = client.target(url).request()
+                .header("Authorization", "Bearer " + token)
+                .post(Entity.json(message))) {
+            if (response.getStatus() >= 300) {
+                LOGGER.warn("WhatsApp send failed: {} {}", response.getStatus(), response.readEntity(String.class));
+            }
+        }
+    }
+
+}
diff --git a/src/test/java/org/traccar/api/resource/WhatsappResourceTest.java b/src/test/java/org/traccar/api/resource/WhatsappResourceTest.java
new file mode 100644
index 0000000..912115d
--- /dev/null
+++ b/src/test/java/org/traccar/api/resource/WhatsappResourceTest.java
@@ -0,0 +1,22 @@
+package org.traccar.api.resource;
+
+import org.apache.commons.codec.digest.HmacUtils;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class WhatsappResourceTest {
+
+    @Test
+    public void testSignature() {
+        String body = "{\"entry\":[]}";
+        String signature = "sha256=" + new HmacUtils("HmacSHA256", "secret").hmacHex(body);
+        assertTrue(WhatsappResource.validSignature("secret", body, signature));
+        assertFalse(WhatsappResource.validSignature("other", body, signature));
+        assertFalse(WhatsappResource.validSignature("secret", body + " ", signature));
+        assertFalse(WhatsappResource.validSignature(null, body, signature));
+        assertFalse(WhatsappResource.validSignature("secret", body, null));
+    }
+
+}
