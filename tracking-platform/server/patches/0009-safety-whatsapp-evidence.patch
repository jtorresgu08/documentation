+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.HeaderParam;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.api.BaseResource;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.model.User;
+import org.traccar.whatsapp.WhatsappBot;
+import org.traccar.whatsapp.WhatsappClient;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+
+/**
+ * WhatsApp Cloud API webhook: registration check and incoming messages, answered by the unit query bot. Messages
+ * must carry a valid Meta signature (app secret), otherwise they are rejected.
+ */
+@Path("whatsapp")
+public class WhatsappResource extends BaseResource {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(WhatsappResource.class);
+
+    @Inject
+    private Config config;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    @Inject
+    private WhatsappBot bot;
+
+    @Inject
+    private WhatsappClient whatsappClient;
+
+    static boolean validSignature(String secret, String body, String signature) {
+        if (secret == null || secret.isBlank() || signature == null || !signature.startsWith("sha256=")) {
+            return false;
+        }
+        try {
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
+            byte[] expected = mac.doFinal(body.getBytes(StandardCharsets.UTF_8));
+            byte[] received = HexFormat.of().parseHex(signature.substring(7));
+            return MessageDigest.isEqual(expected, received);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    @PermitAll
+    @GET
+    @Path("webhook")
+    @Produces(MediaType.TEXT_PLAIN)
+    public Response verify(
+            @QueryParam("hub.mode") String mode, @QueryParam("hub.verify_token") String token,
+            @QueryParam("hub.challenge") String challenge) {
+        String expected = config.getString(Keys.WHATSAPP_VERIFY_TOKEN);
+        if ("subscribe".equals(mode) && expected != null && !expected.isBlank() && expected.equals(token)) {
+            return Response.ok(challenge).build();
+        }
+        return Response.status(Response.Status.FORBIDDEN).build();
+    }
+
+    @PermitAll
+    @POST
+    @Path("webhook")
+    @Consumes(MediaType.WILDCARD)
+    public Response receive(String body, @HeaderParam("X-Hub-Signature-256") String signature) {
+        if (!validSignature(config.getString(Keys.WHATSAPP_APP_SECRET), body, signature)) {
+            return Response.status(Response.Status.FORBIDDEN).build();
+        }
+        try {
+            for (JsonNode entry : objectMapper.readTree(body).path("entry")) {
+                for (JsonNode change : entry.path("changes")) {
+                    for (JsonNode message : change.path("value").path("messages")) {
+                        if (!"text".equals(message.path("type").asText())) {
+                            continue;
+                        }
+                        String from = message.path("from").asText();
+                        User user = bot.findUser(from);
+                        String reply = user != null
+                                ? bot.answer(user, message.path("text").path("body").asText())
+                                : "Este número no está registrado en la plataforma. Pide a tu administrador que lo "
+                                        + "agregue a tu usuario.";
+                        whatsappClient.sendText(from, reply);
+                    }
+                }
+            }
+        } catch (Exception e) {
+            LOGGER.warn("WhatsApp message failed", e);
+        }
+        // always acknowledge, Meta retries otherwise
+        return Response.ok().build();
+    }
+
+}
