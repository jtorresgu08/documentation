+package org.traccar.handler.events;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Command;
+import org.traccar.model.Device;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class FuelSensorPhotoTest {
+
+    @Test
+    public void testPhotoCommands() {
+        Device device = new Device();
+        device.setId(7);
+        assertTrue(FuelSensorEventHandler.photoCommands(device, "huabao").isEmpty());
+
+        device.set("dashcam.kind", "mdvr");
+        device.set("dashcam.channels", 8);
+        var commands = FuelSensorEventHandler.photoCommands(device, "huabao");
+        assertEquals(4, commands.size());
+        assertEquals(Command.TYPE_REQUEST_PHOTO, commands.get(0).getType());
+        assertEquals(3, commands.get(2).getInteger(Command.KEY_INDEX));
+
+        device.set("dashcam.kind", "dashcam");
+        device.set("dashcam.channels", 2);
+        commands = FuelSensorEventHandler.photoCommands(device, "gt06");
+        assertEquals(2, commands.size());
+        assertEquals("PICTURE,OUT", commands.get(0).getString(Command.KEY_DATA));
+        assertEquals("PICTURE,IN", commands.get(1).getString(Command.KEY_DATA));
+
+        device.set("fuel.drainPhotos", false);
+        assertTrue(FuelSensorEventHandler.photoCommands(device, "gt06").isEmpty());
+    }
+
+}
