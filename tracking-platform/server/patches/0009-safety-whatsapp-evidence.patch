+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.database.CommandsManager;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.safety.EngineStopGuard;
+
+/**
+ * Sends a pending "cut when stopped" engine stop as soon as the unit reports a speed at or below the limit, and
+ * reports it (or its expiry) as a command result event.
+ */
+public class EngineStopEventHandler extends BaseEventHandler {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(EngineStopEventHandler.class);
+
+    private final EngineStopGuard guard;
+    private final CommandsManager commandsManager;
+
+    @Inject
+    public EngineStopEventHandler(EngineStopGuard guard, CommandsManager commandsManager) {
+        this.guard = guard;
+        this.commandsManager = commandsManager;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        long deviceId = position.getDeviceId();
+        if (!guard.hasPending(deviceId)) {
+            return;
+        }
+        try {
+            EngineStopGuard.Pending pending = guard.getPending(deviceId);
+            if (pending == null) {
+                // the command result notification template reads the result from the position
+                position.set(Position.KEY_RESULT, "engineStop: pending cut expired, not sent");
+                Event event = new Event(Event.TYPE_COMMAND_RESULT, position);
+                event.set(Position.KEY_RESULT, position.getString(Position.KEY_RESULT));
+                callback.eventDetected(event);
+                return;
+            }
+            if (guard.allowedNow(position, guard.limit(deviceId))) {
+                guard.takePending(deviceId);
+                commandsManager.sendCommand(pending.command());
+                long speed = Math.round(UnitsConverter.kphFromKnots(position.getSpeed()));
+                position.set(Position.KEY_RESULT, String.format("engineStop: sent when stopped (%d km/h)", speed));
+                Event event = new Event(Event.TYPE_COMMAND_RESULT, position);
+                event.set(Position.KEY_RESULT, position.getString(Position.KEY_RESULT));
+                event.set("userId", pending.userId());
+                callback.eventDetected(event);
+            }
+        } catch (Exception e) {
+            LOGGER.warn("Pending engine stop failed", e);
+        }
+    }
+
+}
