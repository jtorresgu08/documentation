+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.Context;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.LogAction;
+import org.traccar.model.Device;
+import org.traccar.model.UserRestrictions;
+import org.traccar.safety.EngineStopGuard;
+import org.traccar.storage.StorageException;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Safe engine stop state of a unit: current speed, allowed limit and the pending "cut when stopped" request.
+ */
+@Path("safety")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SafetyResource extends BaseResource {
+
+    @Inject
+    private EngineStopGuard engineStopGuard;
+
+    @Inject
+    private LogAction actionLogger;
+
+    @Context
+    private HttpServletRequest request;
+
+    @GET
+    @Path("engine/{deviceId}")
+    public Map<String, Object> engine(@PathParam("deviceId") long deviceId) throws StorageException {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        EngineStopGuard.Check check = engineStopGuard.check(deviceId);
+        EngineStopGuard.Pending pending = engineStopGuard.getPending(deviceId);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("speed", Math.round(check.speed()));
+        result.put("limit", check.limit());
+        result.put("allowed", check.allowed());
+        result.put("pending", pending != null ? Map.of("time", pending.time(), "userId", pending.userId()) : null);
+        return result;
+    }
+
+    @DELETE
+    @Path("engine/{deviceId}/pending")
+    public Response cancel(@PathParam("deviceId") long deviceId) throws StorageException {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getLimitCommands);
+        if (engineStopGuard.takePending(deviceId) != null) {
+            actionLogger.command(request, getUserId(), 0, deviceId, "engineStopCancel");
+        }
+        return Response.noContent().build();
+    }
+
+}
