+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.whatsapp;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.sensor.Sensor;
+import org.traccar.sensor.SensorConfig;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.text.Normalizer;
+import java.util.Collection;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.stream.Collectors;
+
+/**
+ * Answers WhatsApp questions from registered users about their own units: "ABC-123", "dónde está la cisterna 7",
+ * "lista" or "ayuda". Only users whose "whatsapp" attribute or phone matches the sender get an answer, and only
+ * about the units they can see on the platform.
+ */
+@Singleton
+public class WhatsappBot {
+
+    static final int MAX_RESULTS = 3;
+
+    private final Storage storage;
+    private final ObjectMapper objectMapper;
+
+    @Inject
+    public WhatsappBot(Storage storage, ObjectMapper objectMapper) {
+        this.storage = storage;
+        this.objectMapper = objectMapper;
+    }
+
+    static String simplify(String text) {
+        String plain = Normalizer.normalize(text == null ? "" : text, Normalizer.Form.NFD).replaceAll("\\p{M}", "");
+        return plain.toLowerCase(Locale.ROOT).replaceAll("[^a-z0-9 ]", " ").replaceAll("\\s+", " ").trim();
+    }
+
+    static String searchTerm(String text) {
+        String term = " " + simplify(text) + " ";
+        for (String word : List.of("donde esta", "donde", "ubicacion de", "ubicacion", "ubica", "esta", "el", "la",
+                "los", "las", "mi", "unidad", "camion", "vehiculo", "por favor", "hola")) {
+            term = term.replace(" " + word + " ", " ");
+        }
+        return term.trim();
+    }
+
+    public User findUser(String phone) throws StorageException {
+        String sender = WhatsappClient.normalize(phone);
+        if (sender.length() < 7) {
+            return null;
+        }
+        for (User user : storage.getObjects(User.class, new Request(new Columns.All()))) {
+            if (user.getDisabled() || user.getTemporary()
+                    || user.getExpirationTime() != null && user.getExpirationTime().before(new Date())) {
+                continue;
+            }
+            for (String number : new String[] {user.getString("whatsapp"), user.getPhone()}) {
+                String candidate = WhatsappClient.normalize(number);
+                // numbers may be saved with or without the country code
+                if (candidate.length() >= 7 && (sender.endsWith(candidate) || candidate.endsWith(sender))) {
+                    return user;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Collection<Device> devices(User user) throws StorageException {
+        if (user.getAdministrator()) {
+            return storage.getObjects(Device.class, new Request(new Columns.All()));
+        }
+        return storage.getObjects(Device.class, new Request(
+                new Columns.All(), new Condition.Permission(User.class, user.getId(), Device.class)));
+    }
+
+    private Position position(Device device) throws StorageException {
+        return device.getPositionId() > 0 ? storage.getObject(Position.class, new Request(
+                new Columns.All(), new Condition.Equals("id", device.getPositionId()))) : null;
+    }
+
+    static String ago(Date time) {
+        long minutes = Math.max(0, (System.currentTimeMillis() - time.getTime()) / 60000);
+        if (minutes < 1) {
+            return "hace instantes";
+        }
+        if (minutes < 60) {
+            return "hace " + minutes + " min";
+        }
+        long hours = minutes / 60;
+        return hours < 48 ? "hace " + hours + " h " + minutes % 60 + " min" : "hace " + hours / 24 + " días";
+    }
+
+    String describe(Device device, Position position) {
+        StringBuilder text = new StringBuilder("*").append(device.getName()).append("*");
+        String plate = device.getString("info.plate");
+        if (plate != null && !plate.equals(device.getName())) {
+            text.append(" (").append(plate).append(")");
+        }
+        if (position == null) {
+            return text.append("\nSin posición todavía.").toString();
+        }
+        boolean offline = "offline".equals(device.getStatus());
+        boolean moving = position.getBoolean(Position.KEY_MOTION);
+        long speed = Math.round(UnitsConverter.kphFromKnots(position.getSpeed()));
+        text.append("\n").append(offline ? "🔴 Sin conexión" : moving ? "🟢 En movimiento" : "🟡 Detenido");
+        text.append(" · ").append(speed).append(" km/h");
+        if (position.hasAttribute(Position.KEY_IGNITION)) {
+            text.append(" · motor ").append(position.getBoolean(Position.KEY_IGNITION) ? "encendido" : "apagado");
+        }
+        for (Sensor sensor : SensorConfig.fuelSensors(objectMapper, device)) {
+            if (position.hasAttribute(sensor.getKey())) {
+                text.append(String.format(Locale.ROOT, "%n⛽ %s: %.1f %s", sensor.getName(),
+                        position.getDouble(sensor.getKey()), sensor.getUnit() != null ? sensor.getUnit() : "L"));
+            }
+        }
+        text.append("\n🕒 ").append(ago(position.getFixTime()));
+        if (position.getAddress() != null) {
+            text.append("\n📍 ").append(position.getAddress());
+        }
+        text.append(String.format(Locale.ROOT, "%nhttps://maps.google.com/?q=%.6f,%.6f",
+                position.getLatitude(), position.getLongitude()));
+        return text.toString();
+    }
+
+    public String answer(User user, String message) throws StorageException {
+        String simple = simplify(message);
+        if (simple.isEmpty() || List.of("ayuda", "menu", "hola", "help", "inicio").contains(simple)) {
+            return "Hola " + user.getName() + " 👋\nEscribe la placa o el nombre de la unidad para ver dónde está "
+                    + "(por ejemplo: *ABC-123* o *dónde está la cisterna 7*).\nEscribe *lista* para ver tus unidades.";
+        }
+        Collection<Device> devices = devices(user);
+        if (List.of("lista", "unidades", "flota", "todas").contains(simple)) {
+            if (devices.isEmpty()) {
+                return "No tienes unidades asignadas.";
+            }
+            String list = devices.stream().limit(30).map(device -> {
+                String status = device.getStatus();
+                String icon = "offline".equals(status) ? "🔴" : "online".equals(status) ? "🟢" : "⚪";
+                return icon + " " + device.getName();
+            }).collect(Collectors.joining("\n"));
+            return "Tus unidades (" + devices.size() + "):\n" + list
+                    + (devices.size() > 30 ? "\n…" : "") + "\n\nEscribe el nombre o la placa para ver su ubicación.";
+        }
+        String term = searchTerm(message);
+        if (term.isEmpty()) {
+            return "¿Qué unidad buscas? Escribe su placa o nombre.";
+        }
+        List<Device> matches = devices.stream().filter(device -> {
+            String name = simplify(device.getName());
+            String plate = simplify(device.getString("info.plate"));
+            String compactTerm = term.replace(" ", "");
+            return name.contains(term) || name.replace(" ", "").contains(compactTerm)
+                    || !plate.isEmpty() && plate.replace(" ", "").contains(compactTerm);
+        }).toList();
+        if (matches.isEmpty()) {
+            return "No encontré una unidad con \"" + term + "\". Escribe *lista* para ver tus unidades.";
+        }
+        StringBuilder text = new StringBuilder();
+        for (Device device : matches.stream().limit(MAX_RESULTS).toList()) {
+            if (!text.isEmpty()) {
+                text.append("\n\n");
+            }
+            text.append(describe(device, position(device)));
+        }
+        if (matches.size() > MAX_RESULTS) {
+            text.append("\n\n…y ").append(matches.size() - MAX_RESULTS).append(" más. Sé más específico.");
+        }
+        return text.toString();
+    }
+
+}
