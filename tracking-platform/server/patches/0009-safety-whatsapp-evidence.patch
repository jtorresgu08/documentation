+ * limitations under the License.
+ */
+package org.traccar.safety;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Command;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Safe engine stop: the cut is only sent while the unit goes at or below the configured speed. Above it the request
+ * is refused, or kept until the unit stops when the user asks for it. Pending cuts live in memory, so a restart
+ * drops them (the safe outcome: no cut).
+ */
+@Singleton
+public class EngineStopGuard {
+
+    public static final String KEY_WHEN_STOPPED = "whenStopped";
+
+    public record Pending(Command command, long userId, long time) {
+    }
+
+    public record Check(boolean allowed, double speed, double limit, boolean known) {
+    }
+
+    private final Config config;
+    private final Storage storage;
+    private final CacheManager cacheManager;
+
+    private final Map<Long, Pending> pending = new ConcurrentHashMap<>();
+
+    @Inject
+    public EngineStopGuard(Config config, Storage storage, CacheManager cacheManager) {
+        this.config = config;
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+    }
+
+    // device attribute first, then the server attribute, then the default
+    public double limit(long deviceId) throws StorageException {
+        String key = Keys.ENGINE_STOP_MAX_SPEED.getKey();
+        Device device = storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("id", deviceId)));
+        if (device != null && device.hasAttribute(key)) {
+            return device.getDouble(key);
+        }
+        if (cacheManager.getServer() != null && cacheManager.getServer().hasAttribute(key)) {
+            return cacheManager.getServer().getDouble(key);
+        }
+        return Keys.ENGINE_STOP_MAX_SPEED.getDefaultValue();
+    }
+
+    public Position latest(long deviceId) throws StorageException {
+        Position position = cacheManager.getPosition(deviceId);
+        if (position == null) {
+            position = storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.LatestPositions(deviceId)));
+        }
+        return position;
+    }
+
+    public Check check(long deviceId) throws StorageException {
+        double limit = limit(deviceId);
+        Position position = latest(deviceId);
+        double speed = position != null ? UnitsConverter.kphFromKnots(position.getSpeed()) : 0;
+        return new Check(limit <= 0 || speed <= limit, speed, limit, position != null);
+    }
+
+    public boolean allowedNow(Position position, double limit) {
+        return limit <= 0 || UnitsConverter.kphFromKnots(position.getSpeed()) <= limit;
+    }
+
+    public void addPending(Command command, long userId) {
+        pending.put(command.getDeviceId(), new Pending(command, userId, System.currentTimeMillis()));
+    }
+
+    public Pending getPending(long deviceId) {
+        Pending item = pending.get(deviceId);
+        if (item != null && System.currentTimeMillis() - item.time() > maxAge()) {
+            pending.remove(deviceId);
+            return null;
+        }
+        return item;
+    }
+
+    public Pending takePending(long deviceId) {
+        return pending.remove(deviceId);
+    }
+
+    public boolean hasPending(long deviceId) {
+        return pending.containsKey(deviceId);
+    }
+
+    public long maxAge() {
+        return config.getInteger(Keys.ENGINE_STOP_PENDING_HOURS) * 3600_000L;
+    }
+
+}
