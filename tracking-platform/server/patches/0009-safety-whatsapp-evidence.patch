+package org.traccar.notificators;
+
+import jakarta.inject.Inject;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.notification.MessageException;
+import org.traccar.notification.NotificationFormatter;
+import org.traccar.notification.NotificationMessage;
+import org.traccar.whatsapp.WhatsappClient;
+
+/**
+ * WhatsApp alerts to the user's "whatsapp" attribute, or to the user phone when it is not set.
+ */
+public class NotificatorWhatsapp extends Notificator {
+
+    private final WhatsappClient whatsappClient;
+
+    @Inject
+    public NotificatorWhatsapp(NotificationFormatter notificationFormatter, WhatsappClient whatsappClient) {
+        super(notificationFormatter);
+        this.whatsappClient = whatsappClient;
+    }
+
+    @Override
+    public void send(User user, NotificationMessage message, Event event, Position position) throws MessageException {
+        String phone = user.getString("whatsapp");
+        if (phone == null || phone.isBlank()) {
+            phone = user.getPhone();
+        }
+        if (phone == null || WhatsappClient.normalize(phone).isEmpty()) {
+            throw new MessageException("User has no WhatsApp number");
+        }
+        String text = message.digest();
+        if (position != null) {
+            text += String.format(
+                    "%nhttps://maps.google.com/?q=%.6f,%.6f", position.getLatitude(), position.getLongitude());
+        }
+        whatsappClient.sendAlert(phone, text);
+    }
+
+}
