@@ -0,0 +1,219 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.machinery;
+
+import java.time.DayOfWeek;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Use of a heavy machine from its positions: every interval between two messages takes the state of the first one,
+ * off (ignition off), work (the work input on or, without it, moving) or idle (engine on without work). Intervals
+ * longer than the gap limit only count the limit while the engine is on (the rest is time without data). Totals by
+ * day, site (geofence) and operator, engine time outside the work schedule, fuel per engine hour and segments for a
+ * timeline.
+ */
+public final class MachineryAnalyzer {
+
+    public static final String OFF = "off";
+    public static final String IDLE = "idle";
+    public static final String WORK = "work";
+    private static final long MAX_GAP = 30 * 60_000L;
+
+    public record Sample(long time, Boolean ignition, Boolean working, double speedKmh, List<Long> sites,
+            String operator, Double fuelUsed) {
+    }
+
+    public record Schedule(LocalTime from, LocalTime to, Set<DayOfWeek> days) {
+
+        boolean contains(ZonedDateTime moment) {
+            LocalTime time = moment.toLocalTime();
+            return days.contains(moment.getDayOfWeek()) && !time.isBefore(from) && time.isBefore(to);
+        }
+    }
+
+    private MachineryAnalyzer() {
+    }
+
+    public static String state(Sample sample) {
+        if (sample.ignition() != null && !sample.ignition()) {
+            return OFF;
+        }
+        if (sample.ignition() == null && sample.working() == null) {
+            return sample.speedKmh() >= 2 ? WORK : OFF;
+        }
+        if (sample.working() != null) {
+            return sample.working() ? WORK : IDLE;
+        }
+        return sample.speedKmh() >= 2 ? WORK : IDLE;
+    }
+
+    private static double hours(long millis) {
+        return Math.round(millis / 36_000.0) / 100.0;
+    }
+
+    private static Map<String, Object> bucket(long[] values) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("workHours", hours(values[0]));
+        result.put("idleHours", hours(values[1]));
+        result.put("offHours", hours(values[2]));
+        result.put("engineHours", hours(values[0] + values[1]));
+        result.put("utilization", values[0] + values[1] > 0
+                ? Math.round(values[0] * 1000.0 / (values[0] + values[1])) / 10.0 : null);
+        return result;
+    }
+
+    private static void add(long[] values, String state, long millis) {
+        values[WORK.equals(state) ? 0 : IDLE.equals(state) ? 1 : 2] += millis;
+    }
+
+    /**
+     * @param samples positions ordered by time
+     * @param from period start (millis)
+     * @param to period end (millis)
+     */
+    public static Map<String, Object> analyze(
+            List<Sample> samples, long from, long to, ZoneId zone, Schedule schedule, boolean withSegments) {
+        long[] total = new long[3];
+        long noData = 0;
+        long outOfHours = 0;
+        Map<LocalDate, long[]> days = new TreeMap<>();
+        Map<Long, long[]> sites = new LinkedHashMap<>();
+        Map<String, long[]> operators = new LinkedHashMap<>();
+        List<Map<String, Object>> segments = new ArrayList<>();
+        Double firstFuel = null;
+        Double lastFuel = null;
+        for (int i = 0; i < samples.size(); i++) {
+            Sample sample = samples.get(i);
+            if (sample.fuelUsed() != null) {
+                firstFuel = firstFuel == null ? sample.fuelUsed() : firstFuel;
+                lastFuel = sample.fuelUsed();
+            }
+            long start = Math.max(from, sample.time());
+            long end = Math.min(to, i + 1 < samples.size() ? samples.get(i + 1).time() : Math.min(to,
+                    System.currentTimeMillis()));
+            if (end <= start) {
+                continue;
+            }
+            String state = state(sample);
+            if (!OFF.equals(state) && end - start > MAX_GAP) {
+                noData += end - start - MAX_GAP;
+                end = start + MAX_GAP;
+            }
+            long duration = end - start;
+            add(total, state, duration);
+            for (Long site : sample.sites()) {
+                add(sites.computeIfAbsent(site, key -> new long[3]), state, duration);
+            }
+            if (sample.operator() != null && !OFF.equals(state)) {
+                add(operators.computeIfAbsent(sample.operator(), key -> new long[3]), state, duration);
+            }
+            // split by day (and count engine time outside the schedule) in steps of at most one hour
+            long cursor = start;
+            while (cursor < end) {
+                ZonedDateTime moment = Instant.ofEpochMilli(cursor).atZone(zone);
+                long dayEnd = moment.toLocalDate().plusDays(1).atStartOfDay(zone).toInstant().toEpochMilli();
+                long stepEnd = Math.min(end, Math.min(dayEnd, cursor + 3_600_000L));
+                add(days.computeIfAbsent(moment.toLocalDate(), key -> new long[3]), state, stepEnd - cursor);
+                if (schedule != null && !OFF.equals(state) && !schedule.contains(moment)) {
+                    outOfHours += stepEnd - cursor;
+                }
+                cursor = stepEnd;
+            }
+            if (withSegments) {
+                Map<String, Object> last = segments.isEmpty() ? null : segments.get(segments.size() - 1);
+                if (last != null && last.get("state").equals(state) && (Long) last.get("end") == start) {
+                    last.put("end", end);
+                } else if (segments.size() < 3000) {
+                    Map<String, Object> segment = new LinkedHashMap<>();
+                    segment.put("state", state);
+                    segment.put("start", start);
+                    segment.put("end", end);
+                    segments.add(segment);
+                }
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>(bucket(total));
+        result.put("noDataHours", hours(noData));
+        result.put("outOfHoursHours", schedule != null ? hours(outOfHours) : null);
+        double engine = (total[0] + total[1]) / 3_600_000.0;
+        boolean fuel = firstFuel != null && lastFuel > firstFuel;
+        result.put("fuelUsed", fuel ? Math.round((lastFuel - firstFuel) * 10) / 10.0 : null);
+        result.put("fuelPerHour", firstFuel != null && lastFuel > firstFuel && engine > 0.1
+                ? Math.round((lastFuel - firstFuel) / engine * 10) / 10.0 : null);
+        List<Map<String, Object>> dayList = new ArrayList<>();
+        days.forEach((date, values) -> {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("date", date.toString());
+            item.putAll(bucket(values));
+            dayList.add(item);
+        });
+        result.put("days", dayList);
+        List<Map<String, Object>> siteList = new ArrayList<>();
+        sites.forEach((site, values) -> {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("geofenceId", site);
+            item.putAll(bucket(values));
+            siteList.add(item);
+        });
+        result.put("sites", siteList);
+        List<Map<String, Object>> operatorList = new ArrayList<>();
+        operators.forEach((operator, values) -> {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("operator", operator);
+            item.putAll(bucket(values));
+            operatorList.add(item);
+        });
+        result.put("operators", operatorList);
+        if (withSegments) {
+            result.put("segments", segments);
+        }
+        return result;
+    }
+
+    /**
+     * "07:00-18:00" and days "1-6" (Monday = 1) or a list "1,2,3,4,5".
+     */
+    public static Schedule schedule(String hours, String days) {
+        if (hours == null || !hours.matches("\\d{1,2}:\\d{2}\\s*-\\s*\\d{1,2}:\\d{2}")) {
+            return null;
+        }
+        String[] parts = hours.split("-");
+        Set<DayOfWeek> set = new java.util.TreeSet<>();
+        String value = days == null || days.isBlank() ? "1-6" : days.trim();
+        for (String item : value.split(",")) {
+            String[] range = item.trim().split("-");
+            int a = Integer.parseInt(range[0].trim());
+            int b = range.length > 1 ? Integer.parseInt(range[1].trim()) : a;
+            for (int day = a; day <= b; day++) {
+                set.add(DayOfWeek.of(day));
+            }
+        }
+        return new Schedule(LocalTime.parse(pad(parts[0].trim())), LocalTime.parse(pad(parts[1].trim())), set);
+    }
+
+    private static String pad(String time) {
+        return time.length() == 4 ? "0" + time : time;
+    }
+
+}
