+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.machinery.MachineryAnalyzer;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+import org.traccar.model.Geofence;
+import org.traccar.model.Maintenance;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Heavy machinery: hour meter (engine hours of the device plus the offset that matches the dashboard), work, idle
+ * and off hours with utilization, hours by site and operator, engine time outside the work schedule, fuel per engine
+ * hour, next maintenance by hours and the rental amount by hour.
+ */
+@Path("machinery")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class MachineryResource extends BaseResource {
+
+    public static final String MODE = "machineMode";
+    public static final String TYPE = "machineType";
+    public static final String OFFSET = "hourMeterOffset";
+    public static final String WORK = "workAttribute";
+    public static final String SCHEDULE = "workSchedule";
+    public static final String DAYS = "workDays";
+    public static final String RATE = "hourRate";
+    public static final String BILLING = "billing";
+
+    private static final long LIVE_MILLIS = 30 * 60_000L;
+    private static final long OFF_MILLIS = 24 * 3_600_000L;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    private ZoneId zone() throws StorageException {
+        User user = permissionsService.getUser(getUserId());
+        String value = user.getString("timezone");
+        if (value == null) {
+            value = permissionsService.getServer().getString("timezone");
+        }
+        try {
+            return value != null ? ZoneId.of(value) : ZoneId.systemDefault();
+        } catch (RuntimeException e) {
+            return ZoneId.systemDefault();
+        }
+    }
+
+    private static Boolean flag(Object value) {
+        if (value instanceof Boolean bool) {
+            return bool;
+        }
+        if (value instanceof Number number) {
+            return number.doubleValue() > 0;
+        }
+        if (value != null) {
+            String text = String.valueOf(value);
+            return "1".equals(text) || "true".equalsIgnoreCase(text);
+        }
+        return null;
+    }
+
+    private static MachineryAnalyzer.Sample sample(Device device, Position position) {
+        String work = device.getString(WORK);
+        Boolean working = work != null && !work.isBlank()
+                ? Boolean.TRUE.equals(flag(position.getAttributes().get(work))) : null;
+        Object fuel = position.getAttributes().get(Position.KEY_FUEL_USED);
+        return new MachineryAnalyzer.Sample(position.getFixTime().getTime(),
+                flag(position.getAttributes().get(Position.KEY_IGNITION)), working,
+                UnitsConverter.kphFromKnots(position.getSpeed()),
+                position.getGeofenceIds() != null ? position.getGeofenceIds() : List.of(),
+                position.getString(Position.KEY_DRIVER_UNIQUE_ID),
+                fuel instanceof Number number ? number.doubleValue() : null);
+    }
+
+    public static double hourMeter(Device device, Position position) {
+        double raw = position != null ? position.getLong(Position.KEY_HOURS) / 3_600_000.0 : 0;
+        return Math.round((raw + device.getDouble(OFFSET)) * 10) / 10.0;
+    }
+
+    private List<Map<String, Object>> maintenances(Device device, Position position) throws StorageException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        long raw = position != null ? position.getLong(Position.KEY_HOURS) : 0;
+        for (Maintenance maintenance : storage.getObjects(Maintenance.class, new Request(new Columns.All(),
+                new Condition.Permission(Device.class, device.getId(), Maintenance.class)))) {
+            if (!Position.KEY_HOURS.equals(maintenance.getType()) || maintenance.getPeriod() <= 0) {
+                continue;
+            }
+            double done = Math.max(0, Math.floor((raw - maintenance.getStart()) / maintenance.getPeriod()) + 1);
+            double next = maintenance.getStart() + done * maintenance.getPeriod();
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("name", maintenance.getName());
+            item.put("everyHours", Math.round(maintenance.getPeriod() / 360_000.0) / 10.0);
+            item.put("remainingHours", Math.round((next - raw) / 360_000.0) / 10.0);
+            result.add(item);
+        }
+        result.sort((a, b) -> Double.compare((Double) a.get("remainingHours"), (Double) b.get("remainingHours")));
+        return result;
+    }
+
+    private Map<String, Object> summary(Device device, Date from, Date to, boolean detail) throws Exception {
+        Position latest = FleetUtil.latest(storage, cacheManager, device);
+        List<MachineryAnalyzer.Sample> samples = new ArrayList<>();
+        for (Position position : FleetUtil.positions(storage, device.getId(),
+                new Date(from.getTime() - 6 * 3_600_000L), to)) {
+            samples.add(sample(device, position));
+        }
+        // the state at the start of the period comes from the last message before it
+        int first = 0;
+        for (int i = 0; i < samples.size(); i++) {
+            if (samples.get(i).time() <= from.getTime()) {
+                first = i;
+            }
+        }
+        samples = samples.subList(first, samples.size());
+        Map<String, Object> analysis = MachineryAnalyzer.analyze(samples, from.getTime(), to.getTime(), zone(),
+                MachineryAnalyzer.schedule(device.getString(SCHEDULE), device.getString(DAYS)), detail);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("deviceId", device.getId());
+        result.put("name", device.getName());
+        result.put("machineType", device.getString(TYPE));
+        result.put("hourMeter", hourMeter(device, latest));
+        result.put("workAttribute", device.getString(WORK));
+        result.put("workSchedule", device.getString(SCHEDULE));
+        result.put("workDays", device.getString(DAYS));
+        result.put("hourRate", device.getDouble(RATE) > 0 ? device.getDouble(RATE) : null);
+        result.put("billing", device.getString(BILLING) != null ? device.getString(BILLING) : "engine");
+        // many trackers stop reporting with the engine off: an off machine stays off for a day, an engine on without
+        // news for half an hour is without signal
+        String now = "noSignal";
+        if (latest != null) {
+            String state = MachineryAnalyzer.state(sample(device, latest));
+            long age = System.currentTimeMillis() - latest.getFixTime().getTime();
+            if (age < LIVE_MILLIS || MachineryAnalyzer.OFF.equals(state) && age < OFF_MILLIS) {
+                now = state;
+            }
+        }
+        result.put("now", now);
+        result.put("lastUpdate", latest != null ? latest.getFixTime() : null);
+        if (latest != null) {
+            result.put("latitude", latest.getLatitude());
+            result.put("longitude", latest.getLongitude());
+        }
+        result.putAll(analysis);
+        Map<Long, String> geofenceNames = new HashMap<>();
+        for (Geofence geofence : storage.getObjects(Geofence.class, new Request(new Columns.All()))) {
+            geofenceNames.put(geofence.getId(), geofence.getName());
+        }
+        @SuppressWarnings("unchecked")
+        List<Map<String, Object>> sites = (List<Map<String, Object>>) analysis.get("sites");
+        sites.forEach(site -> site.put("name", geofenceNames.getOrDefault((Long) site.get("geofenceId"), "—")));
+        result.put("site", latest != null && latest.getGeofenceIds() != null && !latest.getGeofenceIds().isEmpty()
+                ? geofenceNames.get(latest.getGeofenceIds().get(0)) : null);
+        Map<String, String> driverNames = new HashMap<>();
+        for (Driver driver : storage.getObjects(Driver.class, new Request(new Columns.All()))) {
+            driverNames.put(driver.getUniqueId(), driver.getName());
+        }
+        @SuppressWarnings("unchecked")
+        List<Map<String, Object>> operators = (List<Map<String, Object>>) analysis.get("operators");
+        operators.forEach(item -> item.put("name", driverNames.getOrDefault((String) item.get("operator"),
+                (String) item.get("operator"))));
+        double billable = "work".equals(result.get("billing"))
+                ? (Double) analysis.get("workHours") : (Double) analysis.get("engineHours");
+        result.put("billableHours", billable);
+        result.put("amount", device.getDouble(RATE) > 0 ? Math.round(billable * device.getDouble(RATE) * 100) / 100.0
+                : null);
+        List<Map<String, Object>> maintenances = maintenances(device, latest);
+        result.put("maintenances", maintenances);
+        result.put("nextMaintenance", maintenances.isEmpty() ? null : maintenances.get(0));
+        return result;
+    }
+
+    @GET
+    public List<Map<String, Object>> fleet(@QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            if (device.getBoolean(MODE)) {
+                Map<String, Object> item = summary(device, from, to, false);
+                item.remove("days");
+                result.add(item);
+            }
+        }
+        return result;
+    }
+
+    private Device device(long deviceId) throws Exception {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        return storage.getObject(Device.class, new Request(new Columns.All(), new Condition.Equals("id", deviceId)));
+    }
+
+    @GET
+    @Path("{deviceId}")
+    public Map<String, Object> detail(
+            @PathParam("deviceId") long deviceId, @QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        return summary(device(deviceId), from, to, true);
+    }
+
+    /**
+     * Settings of a machine; hourMeter is the current dashboard reading, kept as the offset to the engine hours.
+     */
+    @PUT
+    @Path("{deviceId}")
+    public Map<String, Object> update(@PathParam("deviceId") long deviceId, Map<String, Object> body)
+            throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Device device = device(deviceId);
+        if (!Boolean.TRUE.equals(body.get("machineMode"))) {
+            device.getAttributes().remove(MODE);
+        } else {
+            device.set(MODE, true);
+        }
+        for (String key : List.of(TYPE, WORK, SCHEDULE, DAYS, BILLING)) {
+            Object value = body.get(key);
+            if (value != null && !String.valueOf(value).isBlank()) {
+                device.set(key, String.valueOf(value).trim());
+            } else {
+                device.getAttributes().remove(key);
+            }
+        }
+        if (body.get(SCHEDULE) != null && !String.valueOf(body.get(SCHEDULE)).isBlank()
+                && MachineryAnalyzer.schedule(String.valueOf(body.get(SCHEDULE)), (String) body.get(DAYS)) == null) {
+            throw new IllegalArgumentException("Schedule like 07:00-18:00");
+        }
+        if (body.get(RATE) instanceof Number number && number.doubleValue() > 0) {
+            device.set(RATE, number.doubleValue());
+        } else {
+            device.getAttributes().remove(RATE);
+        }
+        if (body.get("hourMeter") instanceof Number reading) {
+            Position latest = FleetUtil.latest(storage, cacheManager, device);
+            double raw = latest != null ? latest.getLong(Position.KEY_HOURS) / 3_600_000.0 : 0;
+            device.set(OFFSET, Math.round((reading.doubleValue() - raw) * 100) / 100.0);
+        }
+        FleetUtil.saveAttributes(storage, cacheManager, device);
+        Date now = new Date();
+        return summary(device, new Date(now.getTime() - 86_400_000L), now, false);
+    }
+
+}
