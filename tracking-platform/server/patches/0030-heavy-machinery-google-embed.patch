diff --git a/src/test/java/org/traccar/machinery/MachineryAnalyzerTest.java b/src/test/java/org/traccar/machinery/MachineryAnalyzerTest.java
new file mode 100644
index 0000000..d71eae5
--- /dev/null
+++ b/src/test/java/org/traccar/machinery/MachineryAnalyzerTest.java
@@ -0,0 +1,78 @@
+package org.traccar.machinery;
+
+import org.junit.jupiter.api.Test;
+
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public class MachineryAnalyzerTest {
+
+    private static final ZoneId ZONE = ZoneId.of("America/Lima");
+
+    private static long at(int day, int hour, int minute) {
+        return ZonedDateTime.of(2026, 10, day, hour, minute, 0, 0, ZONE).toInstant().toEpochMilli();
+    }
+
+    private static MachineryAnalyzer.Sample sample(long time, Boolean ignition, Boolean working, long site, String operator) {
+        return new MachineryAnalyzer.Sample(time, ignition, working, 0, site > 0 ? List.of(site) : List.of(), operator,
+                null);
+    }
+
+    @Test
+    public void testDay() {
+        // 06:00 off, 07:00 on idle, 07:30 working until 12:00, 12:00 idle, 12:30 off, 19:00 on working (out of hours)
+        List<MachineryAnalyzer.Sample> samples = new ArrayList<>();
+        samples.add(sample(at(5, 6, 0), false, false, 0, null));
+        samples.add(sample(at(5, 7, 0), true, false, 7, "A1"));
+        for (int minute = 30; minute < 300; minute += 10) {
+            samples.add(sample(at(5, 7, 0) + minute * 60_000L, true, true, 7, "A1"));
+        }
+        samples.add(sample(at(5, 12, 0), true, false, 7, "A1"));
+        samples.add(sample(at(5, 12, 30), false, false, 7, null));
+        samples.add(sample(at(5, 19, 0), true, true, 0, "B2"));
+        samples.add(sample(at(5, 19, 20), true, true, 0, "B2"));
+        samples.add(sample(at(5, 19, 40), true, true, 0, "B2"));
+        samples.add(sample(at(5, 20, 0), false, false, 0, null));
+        Map<String, Object> result = MachineryAnalyzer.analyze(samples, at(5, 0, 0), at(6, 0, 0), ZONE,
+                MachineryAnalyzer.schedule("07:00-18:00", "1-6"), true);
+        assertEquals(5.5, (Double) result.get("workHours"), 0.01);
+        assertEquals(1.0, (Double) result.get("idleHours"), 0.01);
+        assertEquals(6.5, (Double) result.get("engineHours"), 0.01);
+        assertEquals(84.6, (Double) result.get("utilization"), 0.1);
+        assertEquals(1.0, (Double) result.get("outOfHoursHours"), 0.01);
+        List<?> sites = (List<?>) result.get("sites");
+        assertEquals(1, sites.size());
+        assertEquals(5.5, (Double) ((Map<?, ?>) sites.get(0)).get("engineHours"), 0.01);
+        assertEquals(2, ((List<?>) result.get("operators")).size());
+        assertEquals(1, ((List<?>) result.get("days")).size());
+    }
+
+    @Test
+    public void testGapAndDays() {
+        // engine on with no data for 5 hours across midnight: only 30 minutes count, the rest is without data
+        List<MachineryAnalyzer.Sample> samples = List.of(
+                sample(at(5, 22, 0), true, true, 0, null),
+                sample(at(6, 3, 0), false, false, 0, null),
+                sample(at(6, 4, 0), false, false, 0, null));
+        Map<String, Object> result = MachineryAnalyzer.analyze(samples, at(5, 20, 0), at(6, 5, 0), ZONE, null, false);
+        assertEquals(0.5, (Double) result.get("workHours"), 0.01);
+        assertEquals(4.5, (Double) result.get("noDataHours"), 0.01);
+        assertNull(result.get("outOfHoursHours"));
+    }
+
+    @Test
+    public void testNoWorkInput() {
+        // without a work input, moving is work and engine on standing is idle
+        MachineryAnalyzer.Sample moving = new MachineryAnalyzer.Sample(0, true, null, 5, List.of(), null, null);
+        MachineryAnalyzer.Sample standing = new MachineryAnalyzer.Sample(0, true, null, 0, List.of(), null, null);
+        assertEquals(MachineryAnalyzer.WORK, MachineryAnalyzer.state(moving));
+        assertEquals(MachineryAnalyzer.IDLE, MachineryAnalyzer.state(standing));
+    }
+
+}
