@@ -0,0 +1,36 @@
+package org.traccar.protocol;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.TimeZone;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class JimiRecordingsTest {
+
+    @Test
+    public void testParseAndMerge() {
+        String text = "{\"fileNameList\":\"2021_05_31_08_10_45_01.mp4,2021_05_31_08_11_45_01.mp4,"
+                + "2021_05_31_08_12_45_01.mp4\\n2021_05_31_08_30_00_01.mp4;2021_05_31_08_10_50_02.mp4,"
+                + "EVENT_862798052429087_00000000_2021_05_31_08_10_45_F_1.mp4,2021_05_31_08_10_45_01.mp4\"}";
+        var files = JimiRecordings.parse(text, TimeZone.getTimeZone("GMT-5"));
+        assertEquals(5, files.size()); // duplicate and event file ignored
+        assertEquals(1622466645000L, files.get(0).start()); // 08:10:45 GMT-5 = 13:10:45 UTC
+
+        var all = JimiRecordings.merge(files, 0, 0, 0);
+        assertEquals(3, all.size());
+        assertEquals(List.of("2021_05_31_08_10_45_01.mp4", "2021_05_31_08_11_45_01.mp4",
+                "2021_05_31_08_12_45_01.mp4"), all.get(0).files());
+        assertEquals(3 * 60_000, all.get(0).end() - all.get(0).start());
+        assertEquals(2, all.get(2).channel());
+
+        var cabin = JimiRecordings.merge(files, 2, 0, 0);
+        assertEquals(1, cabin.size());
+
+        var late = JimiRecordings.merge(files, 1, 1622467700000L, 0); // after 08:28:20 local
+        assertEquals(1, late.size());
+        assertEquals(List.of("2021_05_31_08_30_00_01.mp4"), late.get(0).files());
+    }
+
+}
