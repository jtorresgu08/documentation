+package org.traccar.protocol;
+
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TimeZone;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Recordings of Jimi GT06 dashcams (JC400, JC261). The camera loops one-minute files named
+ * YYYY_MM_DD_HH_MM_SS_CC.mp4 (local time, CC camera: 01 road, 02 cabin) and uploads the list of names on FILELIST;
+ * REPLAYLIST streams up to eight of them by name.
+ */
+public final class JimiRecordings {
+
+    public static final long FILE_LENGTH = 60_000;
+    public static final int MAX_REPLAY_FILES = 8;
+    private static final long MAX_GAP = 5_000;
+
+    private static final Pattern NAME = Pattern.compile(
+            "(?<![\\d_])((\\d{4})_(\\d{2})_(\\d{2})_(\\d{2})_(\\d{2})_(\\d{2})_(\\d{2})\\.(?:mp4|ts|avi|h264|h265))",
+            Pattern.CASE_INSENSITIVE);
+
+    private JimiRecordings() {
+    }
+
+    /**
+     * Extracts the file names from whatever the camera uploaded (TXT file, JSON or plain text), one minute each.
+     */
+    public static List<VideoRecordings.Recording> parse(String text, TimeZone timeZone) {
+        Map<String, VideoRecordings.Recording> result = new LinkedHashMap<>();
+        Matcher matcher = NAME.matcher(text);
+        Calendar calendar = Calendar.getInstance(timeZone);
+        while (matcher.find()) {
+            String name = matcher.group(1);
+            calendar.clear();
+            calendar.set(
+                    Integer.parseInt(matcher.group(2)), Integer.parseInt(matcher.group(3)) - 1,
+                    Integer.parseInt(matcher.group(4)), Integer.parseInt(matcher.group(5)),
+                    Integer.parseInt(matcher.group(6)), Integer.parseInt(matcher.group(7)));
+            long start = calendar.getTimeInMillis();
+            int channel = Math.max(1, Integer.parseInt(matcher.group(8)));
+            result.putIfAbsent(name, new VideoRecordings.Recording(
+                    channel, start, start + FILE_LENGTH, 0, 0, 0, 0, 0, List.of(name)));
+        }
+        return new ArrayList<>(result.values());
+    }
+
+    /**
+     * Joins consecutive files of the same camera into continuous recordings within the period.
+     */
+    public static List<VideoRecordings.Recording> merge(
+            List<VideoRecordings.Recording> files, int channel, long from, long to) {
+        List<VideoRecordings.Recording> sorted = new ArrayList<>(files.stream()
+                .filter(file -> channel <= 0 || file.channel() == channel)
+                .filter(file -> (to <= 0 || file.start() < to) && (from <= 0 || file.end() > from))
+                .toList());
+        sorted.sort(Comparator.comparingInt(VideoRecordings.Recording::channel)
+                .thenComparingLong(VideoRecordings.Recording::start));
+        List<VideoRecordings.Recording> result = new ArrayList<>();
+        int currentChannel = -1;
+        long start = 0;
+        long end = 0;
+        List<String> names = new ArrayList<>();
+        for (VideoRecordings.Recording file : sorted) {
+            if (file.channel() != currentChannel || file.start() - end > MAX_GAP) {
+                if (!names.isEmpty()) {
+                    result.add(new VideoRecordings.Recording(currentChannel, start, end, 0, 0, 0, 0, 0, names));
+                }
+                currentChannel = file.channel();
+                start = file.start();
+                end = file.end();
+                names = new ArrayList<>();
+            }
+            end = Math.max(end, file.end());
+            names.add(file.files().get(0));
+        }
+        if (!names.isEmpty()) {
+            result.add(new VideoRecordings.Recording(currentChannel, start, end, 0, 0, 0, 0, 0, names));
+        }
+        return result;
+    }
+
+}
