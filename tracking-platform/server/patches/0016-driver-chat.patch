@@ -0,0 +1,33 @@
+package org.traccar.whatsapp;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class DriverChatTest {
+
+    @Test
+    public void testPhoneOf() {
+        Device device = new Device();
+        Driver driver = new Driver();
+        assertNull(DriverChat.phoneOf(driver, device));
+        device.set("driverPhone", "987 654 321");
+        assertEquals("987654321", DriverChat.phoneOf(null, device));
+        driver.set("phone", "+51 999-111-222");
+        assertEquals("51999111222", DriverChat.phoneOf(driver, device));
+    }
+
+    @Test
+    public void testSamePhone() {
+        assertTrue(DriverChat.samePhone("+51 987 654 222", "987654222"));
+        assertTrue(DriverChat.samePhone("51987654222", "+51 (987) 654-222"));
+        assertFalse(DriverChat.samePhone("51987654222", "51987654223"));
+        assertFalse(DriverChat.samePhone("123", "123"));
+    }
+
+}
