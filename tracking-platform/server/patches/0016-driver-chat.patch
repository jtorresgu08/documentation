+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+import org.traccar.model.DriverMessage;
+import org.traccar.model.User;
+import org.traccar.model.UserRestrictions;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+import org.traccar.whatsapp.DriverChat;
+
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/**
+ * WhatsApp chat with the driver of a unit: conversation, sending a message and the latest replies of the drivers of
+ * the units the user can see.
+ */
+@Path("chat")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class ChatResource extends BaseResource {
+
+    private static final int MAX_TEXT = 1000;
+
+    @Inject
+    private DriverChat driverChat;
+
+    private Device device(long deviceId) throws StorageException {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        return storage.getObject(Device.class, new Request(new Columns.All(), new Condition.Equals("id", deviceId)));
+    }
+
+    @GET
+    public Map<String, Object> conversation(
+            @QueryParam("deviceId") long deviceId, @QueryParam("limit") int limit) throws StorageException {
+        Device device = device(deviceId);
+        Driver driver = driverChat.driverOf(device);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("configured", driverChat.configured());
+        result.put("driverId", driver != null ? driver.getId() : null);
+        result.put("driverName", driver != null ? driver.getName() : null);
+        result.put("phone", DriverChat.phoneOf(driver, device));
+        result.put("messages", driverChat.conversation(deviceId, limit > 0 ? Math.min(limit, 500) : 100));
+        return result;
+    }
+
+    public static class Outgoing {
+        private long deviceId;
+        private String text;
+
+        public long getDeviceId() {
+            return deviceId;
+        }
+
+        public void setDeviceId(long deviceId) {
+            this.deviceId = deviceId;
+        }
+
+        public String getText() {
+            return text;
+        }
+
+        public void setText(String text) {
+            this.text = text;
+        }
+    }
+
+    @POST
+    public DriverMessage send(Outgoing outgoing) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        Device device = device(outgoing.getDeviceId());
+        String text = outgoing.getText() != null ? outgoing.getText().trim() : "";
+        if (text.isEmpty() || text.length() > MAX_TEXT) {
+            throw new BadRequestException("Invalid message");
+        }
+        try {
+            return driverChat.send(getUserId(), device, text);
+        } catch (IllegalArgumentException e) {
+            throw new BadRequestException(e.getMessage());
+        }
+    }
+
+    @GET
+    @Path("recent")
+    public List<DriverMessage> recent(@QueryParam("since") Date since) throws StorageException {
+        Request request = permissionsService.notAdmin(getUserId())
+                ? new Request(new Columns.All(), new Condition.Permission(User.class, getUserId(), Device.class))
+                : new Request(new Columns.All());
+        Set<Long> deviceIds = storage.getObjects(Device.class, request).stream()
+                .map(Device::getId).collect(Collectors.toSet());
+        Date from = since != null ? since : new Date(System.currentTimeMillis() - 24 * 3600 * 1000L);
+        return storage.getObjects(DriverMessage.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("direction", DriverMessage.IN),
+                        new Condition.Compare("time", ">", from)),
+                new Order("time", true, 200))).stream()
+                .filter(message -> deviceIds.contains(message.getDeviceId()))
+                .toList();
+    }
+
+}
