+package org.traccar.model;
+
+import org.traccar.storage.StorageName;
+
+import java.util.Date;
+
+/**
+ * WhatsApp message between the operators and the driver of a unit: direction "out" (sent by a user) or "in" (reply of
+ * the driver), with its delivery status.
+ */
+@StorageName("tc_driver_messages")
+public class DriverMessage extends ExtendedModel {
+
+    public static final String OUT = "out";
+    public static final String IN = "in";
+
+    private long deviceId;
+
+    public long getDeviceId() {
+        return deviceId;
+    }
+
+    public void setDeviceId(long deviceId) {
+        this.deviceId = deviceId;
+    }
+
+    private long driverId;
+
+    public long getDriverId() {
+        return driverId;
+    }
+
+    public void setDriverId(long driverId) {
+        this.driverId = driverId;
+    }
+
+    private long userId;
+
+    public long getUserId() {
+        return userId;
+    }
+
+    public void setUserId(long userId) {
+        this.userId = userId;
+    }
+
+    private String phone;
+
+    public String getPhone() {
+        return phone;
+    }
+
+    public void setPhone(String phone) {
+        this.phone = phone;
+    }
+
+    private String direction;
+
+    public String getDirection() {
+        return direction;
+    }
+
+    public void setDirection(String direction) {
+        this.direction = direction;
+    }
+
+    private String text;
+
+    public String getText() {
+        return text;
+    }
+
+    public void setText(String text) {
+        this.text = text;
+    }
+
+    private Date time;
+
+    public Date getTime() {
+        return time;
+    }
+
+    public void setTime(Date time) {
+        this.time = time;
+    }
+
+    private String status;
+
+    public String getStatus() {
+        return status;
+    }
+
+    public void setStatus(String status) {
+        this.status = status;
+    }
+
+}
diff --git a/src/main/java/org/traccar/whatsapp/DriverChat.java b/src/main/java/org/traccar/whatsapp/DriverChat.java
new file mode 100644
index 0000000..11e7ecf
--- /dev/null
+++ b/src/main/java/org/traccar/whatsapp/DriverChat.java
@@ -0,0 +1,169 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.whatsapp;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.model.Device;
+import org.traccar.model.Driver;
+import org.traccar.model.DriverMessage;
+import org.traccar.model.Position;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+
+/**
+ * Chat between the operators and the driver of a unit over WhatsApp. The driver is the one identified in the last
+ * position (driverUniqueId) or else the first driver linked to the unit; the number comes from the driver's "phone"
+ * (or "whatsapp") attribute, or the unit's "driverPhone" attribute. Replies from a driver's number are stored on the
+ * unit the last message was sent from.
+ */
+@Singleton
+public class DriverChat {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(DriverChat.class);
+
+    public static final String SENT = "sent";
+    public static final String FAILED = "failed";
+    public static final String RECEIVED = "received";
+
+    private final Storage storage;
+    private final WhatsappClient whatsappClient;
+
+    @Inject
+    public DriverChat(Storage storage, WhatsappClient whatsappClient) {
+        this.storage = storage;
+        this.whatsappClient = whatsappClient;
+    }
+
+    public boolean configured() {
+        return whatsappClient.configured();
+    }
+
+    public static String phoneOf(Driver driver, Device device) {
+        for (String value : new String[] {
+                driver != null ? driver.getString("phone") : null,
+                driver != null ? driver.getString("whatsapp") : null,
+                device.getString("driverPhone")}) {
+            if (WhatsappClient.normalize(value).length() >= 7) {
+                return WhatsappClient.normalize(value);
+            }
+        }
+        return null;
+    }
+
+    static boolean samePhone(String a, String b) {
+        String first = WhatsappClient.normalize(a);
+        String second = WhatsappClient.normalize(b);
+        return first.length() >= 7 && second.length() >= 7 && (first.endsWith(second) || second.endsWith(first));
+    }
+
+    public Driver driverOf(Device device) throws StorageException {
+        if (device.getPositionId() > 0) {
+            Position position = storage.getObject(Position.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", device.getPositionId())));
+            String uniqueId = position != null ? position.getString(Position.KEY_DRIVER_UNIQUE_ID) : null;
+            if (uniqueId != null) {
+                Driver driver = storage.getObject(Driver.class, new Request(
+                        new Columns.All(), new Condition.Equals("uniqueId", uniqueId)));
+                if (driver != null) {
+                    return driver;
+                }
+            }
+        }
+        List<Driver> linked = storage.getObjects(Driver.class, new Request(
+                new Columns.All(), new Condition.Permission(Device.class, device.getId(), Driver.class)));
+        return linked.isEmpty() ? null : linked.get(0);
+    }
+
+    public List<DriverMessage> conversation(long deviceId, int limit) throws StorageException {
+        List<DriverMessage> messages = new ArrayList<>(storage.getObjects(DriverMessage.class, new Request(
+                new Columns.All(), new Condition.Equals("deviceId", deviceId), new Order("time", true, limit))));
+        Collections.reverse(messages);
+        return messages;
+    }
+
+    public DriverMessage send(long userId, Device device, String text) throws StorageException {
+        Driver driver = driverOf(device);
+        String phone = phoneOf(driver, device);
+        if (phone == null) {
+            throw new IllegalArgumentException("El conductor no tiene número de WhatsApp");
+        }
+        DriverMessage message = new DriverMessage();
+        message.setDeviceId(device.getId());
+        message.setDriverId(driver != null ? driver.getId() : 0);
+        message.setUserId(userId);
+        message.setPhone(phone);
+        message.setDirection(DriverMessage.OUT);
+        message.setText(text);
+        message.setTime(new Date());
+        try {
+            whatsappClient.sendText(phone, text);
+            message.setStatus(SENT);
+        } catch (Exception e) {
+            LOGGER.warn("Driver message failed", e);
+            message.setStatus(FAILED);
+            message.set("error", e.getMessage());
+        }
+        message.setId(storage.addObject(message, new Request(new Columns.Exclude("id"))));
+        return message;
+    }
+
+    /** Stores a message from a driver's number; null when the number is not a driver's. */
+    public DriverMessage receive(String from, String text) throws StorageException {
+        Driver driver = storage.getObjects(Driver.class, new Request(new Columns.All())).stream()
+                .filter(item -> samePhone(item.getString("phone"), from) || samePhone(item.getString("whatsapp"), from))
+                .findFirst().orElse(null);
+        long deviceId = 0;
+        List<DriverMessage> last = storage.getObjects(DriverMessage.class, new Request(
+                new Columns.All(), new Condition.Equals("phone", WhatsappClient.normalize(from)),
+                new Order("time", true, 1)));
+        if (!last.isEmpty()) {
+            deviceId = last.get(0).getDeviceId();
+        } else {
+            for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+                Driver current = driver != null ? driverOf(device) : null;
+                if (samePhone(device.getString("driverPhone"), from)
+                        || current != null && current.getId() == driver.getId()) {
+                    deviceId = device.getId();
+                    break;
+                }
+            }
+        }
+        if (driver == null && deviceId == 0) {
+            return null;
+        }
+        DriverMessage message = new DriverMessage();
+        message.setDeviceId(deviceId);
+        message.setDriverId(driver != null ? driver.getId() : 0);
+        message.setPhone(WhatsappClient.normalize(from));
+        message.setDirection(DriverMessage.IN);
+        message.setText(text);
+        message.setTime(new Date());
+        message.setStatus(RECEIVED);
+        message.setId(storage.addObject(message, new Request(new Columns.Exclude("id"))));
+        return message;
+    }
+
+}
