+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.model.RegulatorDestination;
+import org.traccar.regulator.RegulatorService;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/**
+ * Transmission of positions to authorities: destinations (administrator), vehicles enrolled in each destination
+ * and the transmission status of every enrolled vehicle.
+ */
+@Path("regulator")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class RegulatorResource extends BaseResource {
+
+    private static final String MASK = "********";
+    private static final List<String> TYPES = List.of("sutran", "atu", "custom");
+
+    /** delay after which a transmission is late, and after which a vehicle is considered not reporting */
+    private static final long LATE_MILLIS = 5 * 60_000L;
+    private static final long OFFLINE_MILLIS = 30 * 60_000L;
+
+    public static final Map<String, Map<String, Object>> PRESETS = Map.of(
+            "sutran", Map.of(
+                    "name", "SUTRAN",
+                    "authHeader", "Authorization",
+                    "batch", false,
+                    "template", "{\"plate\":\"${plate}\",\"imei\":\"${imei}\",\"latitude\":${lat},"
+                            + "\"longitude\":${lon},\"speed\":${speedKmh},\"course\":${course},"
+                            + "\"altitude\":${altitude},\"event\":\"${event}\",\"ignition\":${ignition01},"
+                            + "\"gpsDate\":\"${fixTime}\"}"),
+            "atu", Map.of(
+                    "name", "ATU",
+                    "authHeader", "Authorization",
+                    "batch", false,
+                    "template", "{\"imei\":\"${imei}\",\"placa\":\"${plate}\",\"ruta\":\"${route}\","
+                            + "\"latitud\":${lat},\"longitud\":${lon},\"velocidad\":${speedKmh},"
+                            + "\"rumbo\":${course},\"fecha\":\"${fixTimeIso}\",\"evento\":\"${event}\"}"));
+
+    @Inject
+    private RegulatorService regulatorService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    private boolean admin() throws StorageException {
+        return !permissionsService.notAdmin(getUserId());
+    }
+
+    private void checkAdmin() throws StorageException {
+        if (!admin()) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+    }
+
+    private RegulatorDestination check(long id) throws StorageException {
+        RegulatorDestination destination = storage.getObject(RegulatorDestination.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (destination == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return destination;
+    }
+
+    private Map<String, Object> view(RegulatorDestination destination, boolean full) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", destination.getId());
+        result.put("name", destination.getName());
+        result.put("type", destination.getType());
+        result.put("enabled", destination.getEnabled());
+        if (full) {
+            result.put("url", destination.getUrl());
+            result.put("authHeader", destination.getAuthHeader());
+            String value = destination.getAuthValue();
+            result.put("authValue", value == null || value.isEmpty() ? "" : MASK);
+            result.put("template", destination.getTemplate());
+            result.put("batch", destination.getBatch());
+            result.put("attributes", destination.getAttributes());
+            RegulatorService.Stats stats = regulatorService.destinationStats(destination.getId());
+            result.put("queued", regulatorService.queued(destination.getId()));
+            result.put("dropped", regulatorService.dropped(destination.getId()));
+            result.put("sent", stats.getSent());
+            result.put("failed", stats.getFailed());
+            result.put("lastSent", stats.getLastSent());
+            result.put("lastError", stats.getLastError());
+            result.put("lastErrorTime", stats.getLastErrorTime());
+        }
+        return result;
+    }
+
+    @GET
+    @Path("destinations")
+    public List<Map<String, Object>> destinations() throws StorageException {
+        boolean full = admin();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (RegulatorDestination destination : storage.getObjects(RegulatorDestination.class, new Request(
+                new Columns.All(), new Order("name")))) {
+            if (full || destination.getEnabled()) {
+                result.add(view(destination, full));
+            }
+        }
+        return result;
+    }
+
+    @GET
+    @Path("presets")
+    public Map<String, Map<String, Object>> presets() {
+        return PRESETS;
+    }
+
+    private static String text(Object value) {
+        if (value == null) {
+            return null;
+        }
+        String result = String.valueOf(value).trim();
+        return result.isEmpty() ? null : result;
+    }
+
+    private static void read(RegulatorDestination destination, Map<String, Object> body) {
+        String name = text(body.get("name"));
+        String url = text(body.get("url"));
+        if (name == null || url == null || !url.matches("(?i)https?://.+")) {
+            throw new IllegalArgumentException("The destination needs a name and an http(s) URL");
+        }
+        String type = text(body.get("type"));
+        destination.setName(name);
+        destination.setType(type != null && TYPES.contains(type) ? type : "custom");
+        destination.setUrl(url);
+        destination.setAuthHeader(text(body.get("authHeader")));
+        String value = body.get("authValue") != null ? String.valueOf(body.get("authValue")) : null;
+        if (value != null && !MASK.equals(value)) {
+            destination.setAuthValue(value.isEmpty() ? null : value);
+        }
+        destination.setTemplate(text(body.get("template")));
+        destination.setBatch(Boolean.TRUE.equals(body.get("batch")));
+        destination.setEnabled(!Boolean.FALSE.equals(body.get("enabled")));
+        if (body.get("attributes") instanceof Map<?, ?> attributes) {
+            Map<String, Object> copy = new HashMap<>();
+            attributes.forEach((key, item) -> copy.put(String.valueOf(key), item));
+            destination.setAttributes(copy);
+        }
+    }
+
+    @POST
+    @Path("destinations")
+    public Map<String, Object> add(Map<String, Object> body) throws Exception {
+        checkAdmin();
+        RegulatorDestination destination = new RegulatorDestination();
+        read(destination, body);
+        destination.setId(storage.addObject(destination, new Request(new Columns.Exclude("id"))));
+        regulatorService.reload();
+        return view(destination, true);
+    }
+
+    @PUT
+    @Path("destinations/{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkAdmin();
+        RegulatorDestination destination = check(id);
+        read(destination, body);
+        storage.updateObject(destination, new Request(new Columns.Exclude("id"), new Condition.Equals("id", id)));
+        regulatorService.reload();
+        return view(destination, true);
+    }
+
+    @DELETE
+    @Path("destinations/{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        checkAdmin();
+        check(id);
+        storage.removeObject(RegulatorDestination.class, new Request(new Condition.Equals("id", id)));
+        regulatorService.reload();
+        return Response.noContent().build();
+    }
+
+    /** sends one position (the latest of an enrolled vehicle, or a sample) and returns the reply */
+    @POST
+    @Path("destinations/{id}/test")
+    public Map<String, Object> test(@PathParam("id") long id) throws Exception {
+        checkAdmin();
+        RegulatorDestination destination = check(id);
+        Device sample = null;
+        Position position = null;
+        for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+            if (RegulatorService.enrolled(device).contains(id)) {
+                Position latest = FleetUtil.latest(storage, cacheManager, device);
+                if (latest != null) {
+                    sample = device;
+                    position = latest;
+                    break;
+                }
+            }
+        }
+        if (sample == null) {
+            sample = new Device();
+            sample.setName("PRUEBA-001");
+            sample.setUniqueId("000000000000000");
+            position = new Position();
+            position.setLatitude(-12.0464);
+            position.setLongitude(-77.0428);
+            position.setFixTime(new Date());
+            position.setValid(true);
+        }
+        String template = destination.getTemplate() != null ? destination.getTemplate() : "";
+        String json = RegulatorService.render(template,
+                RegulatorService.values(sample, position, RegulatorService.zone(destination)),
+                destination.getAttributes());
+        if (destination.getBatch()) {
+            json = "[" + json + "]";
+        }
+        RegulatorService.Result result = regulatorService.post(destination, json);
+        Map<String, Object> response = new LinkedHashMap<>();
+        response.put("request", json);
+        response.put("status", result.status());
+        response.put("body", result.body());
+        response.put("error", result.error());
+        return response;
+    }
+
+    /** enrolls (or removes) vehicles the caller can see in a destination */
+    @PUT
+    @Path("devices")
+    public Map<String, Object> enroll(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        long destinationId = body.get("destinationId") instanceof Number number ? number.longValue() : 0;
+        RegulatorDestination destination = check(destinationId);
+        if (!destination.getEnabled() && !admin()) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+        boolean enrolled = !Boolean.FALSE.equals(body.get("enrolled"));
+        Set<Long> ids = new LinkedHashSet<>();
+        if (body.get("deviceIds") instanceof List<?> list) {
+            list.forEach(item -> {
+                if (item instanceof Number number) {
+                    ids.add(number.longValue());
+                }
+            });
+        }
+        int changed = 0;
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            if (!ids.contains(device.getId())) {
+                continue;
+            }
+            Set<Long> current = new LinkedHashSet<>(RegulatorService.enrolled(device));
+            boolean modified = enrolled ? current.add(destinationId) : current.remove(destinationId);
+            if (modified) {
+                if (current.isEmpty()) {
+                    device.getAttributes().remove(RegulatorService.ENROLLED);
+                } else {
+                    device.set(RegulatorService.ENROLLED,
+                            current.stream().map(String::valueOf).collect(Collectors.joining(",")));
+                }
+                FleetUtil.saveAttributes(storage, cacheManager, device);
+                changed += 1;
+            }
+        }
+        return Map.of("changed", changed);
+    }
+
+    /** every enrolled vehicle the caller can see, per destination, with its transmission state */
+    @GET
+    @Path("status")
+    public Map<String, Object> status() throws StorageException {
+        Map<Long, RegulatorDestination> destinations = new LinkedHashMap<>();
+        for (RegulatorDestination destination : storage.getObjects(RegulatorDestination.class, new Request(
+                new Columns.All(), new Order("name")))) {
+            destinations.put(destination.getId(), destination);
+        }
+        long now = System.currentTimeMillis();
+        List<Map<String, Object>> vehicles = new ArrayList<>();
+        Map<String, Integer> counts = new LinkedHashMap<>();
+        for (String state : List.of("ok", "late", "failing", "offline", "pending")) {
+            counts.put(state, 0);
+        }
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            for (long destinationId : RegulatorService.enrolled(device)) {
+                RegulatorDestination destination = destinations.get(destinationId);
+                if (destination == null) {
+                    continue;
+                }
+                RegulatorService.Stats stats = regulatorService.deviceStats(destinationId).get(device.getId());
+                Date lastSent = stats != null ? stats.getLastSent() : null;
+                Date lastErrorTime = stats != null ? stats.getLastErrorTime() : null;
+                boolean reporting = device.getLastUpdate() != null
+                        && now - device.getLastUpdate().getTime() < OFFLINE_MILLIS;
+                String state;
+                if (!reporting) {
+                    state = "offline";
+                } else if (lastErrorTime != null && (lastSent == null || lastErrorTime.after(lastSent))) {
+                    state = "failing";
+                } else if (lastSent == null) {
+                    state = "pending";
+                } else if (now - lastSent.getTime() > LATE_MILLIS) {
+                    state = "late";
+                } else {
+                    state = "ok";
+                }
+                counts.merge(state, 1, Integer::sum);
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("deviceId", device.getId());
+                item.put("name", device.getName());
+                String plate = device.getString("plate");
+                item.put("plate", plate != null ? plate : device.getName());
+                item.put("destinationId", destinationId);
+                item.put("destination", destination.getName());
+                item.put("destinationEnabled", destination.getEnabled());
+                item.put("lastUpdate", device.getLastUpdate());
+                item.put("lastSent", lastSent);
+                item.put("sent", stats != null ? stats.getSent() : 0);
+                item.put("failed", stats != null ? stats.getFailed() : 0);
+                item.put("lastError", stats != null ? stats.getLastError() : null);
+                item.put("lastErrorTime", lastErrorTime);
+                item.put("state", state);
+                vehicles.add(item);
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("counts", counts);
+        result.put("vehicles", vehicles);
+        return result;
+    }
+
+}
