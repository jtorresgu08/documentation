+package org.traccar.schedule;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.billing.BillingService;
+
+import java.util.Date;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Every hour: issues the monthly invoices that are due, marks late ones and suspends or reactivates accounts.
+ */
+public class TaskBilling extends SingleScheduleTask {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TaskBilling.class);
+
+    private final BillingService billingService;
+
+    @Inject
+    public TaskBilling(BillingService billingService) {
+        this.billingService = billingService;
+    }
+
+    @Override
+    public void schedule(ScheduledExecutorService executor) {
+        executor.scheduleAtFixedRate(this, 3, 60, TimeUnit.MINUTES);
+    }
+
+    @Override
+    public void run() {
+        try {
+            billingService.run(new Date());
+        } catch (Exception e) {
+            LOGGER.warn("Billing run failed", e);
+        }
+    }
+
+}
