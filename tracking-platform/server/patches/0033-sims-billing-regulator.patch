diff --git a/src/main/java/org/traccar/api/resource/BillingResource.java b/src/main/java/org/traccar/api/resource/BillingResource.java
new file mode 100644
index 0000000..525543a
--- /dev/null
+++ b/src/main/java/org/traccar/api/resource/BillingResource.java
@@ -0,0 +1,413 @@
+/*
