+package org.traccar.regulator;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+
+import java.time.ZoneId;
+import java.util.Date;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class RegulatorServiceTest {
+
+    @Test
+    public void testRender() throws Exception {
+        Device device = new Device();
+        device.setName("Bus 12");
+        device.setUniqueId("123456789012345");
+        device.set("plate", "AB\"C-1\\2");
+        Position position = new Position();
+        position.setLatitude(-12.046374);
+        position.setLongitude(-77.042793);
+        position.setSpeed(10.0);
+        position.setFixTime(new Date(1_793_577_600_000L));
+        position.setValid(true);
+        position.set(Position.KEY_IGNITION, true);
+
+        Map<String, String> values = RegulatorService.values(device, position, ZoneId.of("America/Lima"));
+        String json = RegulatorService.render(
+                "{\"plate\":\"${plate}\",\"lat\":${lat},\"speed\":${speedKmh},\"on\":${ignition01},"
+                        + "\"time\":\"${fixTime}\",\"token\":\"${token}\",\"x\":\"${unknown}\"}",
+                values, Map.of("token", "abc"));
+        JsonNode node = new ObjectMapper().readTree(json);
+        assertEquals("AB\"C-1\\2", node.get("plate").asText());
+        assertEquals(-12.046374, node.get("lat").asDouble(), 0.0000001);
+        assertEquals(18.5, node.get("speed").asDouble(), 0.01);
+        assertEquals(1, node.get("on").asInt());
+        assertEquals("2026-11-01 19:00:00", node.get("time").asText());
+        assertEquals("abc", node.get("token").asText());
+        assertEquals("", node.get("x").asText());
+    }
+
+    @Test
+    public void testEnrolled() {
+        Device device = new Device();
+        assertEquals(Set.of(), RegulatorService.enrolled(device));
+        device.set(RegulatorService.ENROLLED, "3, 7;x");
+        assertEquals(Set.of(3L, 7L), RegulatorService.enrolled(device));
+    }
+
+}
