+import org.traccar.model.Position;
+import org.traccar.model.RegulatorDestination;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Request;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Sends the positions of enrolled vehicles to authorities (SUTRAN, ATU or any HTTP endpoint): one queue per
+ * destination, a JSON template per destination, retries with growing waits and transmission figures per vehicle so
+ * the operator can see which units are transmitting and which are not.
+ */
+@Singleton
+public class RegulatorService {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(RegulatorService.class);
+
+    public static final String ENROLLED = "regulator";
+
+    private static final int QUEUE_LIMIT = 20_000;
+    private static final int BATCH_LIMIT = 50;
+    private static final int MAX_ATTEMPTS = 6;
+    private static final long RELOAD_MILLIS = 60_000;
+    private static final Pattern PLACEHOLDER = Pattern.compile("\\$\\{([A-Za-z0-9]+)}");
+
+    private static final DateTimeFormatter LOCAL_TIME = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
+
+    private record Item(long deviceId, Map<String, String> values, int attempts, long notBefore) {
+    }
+
+    /** transmission figures of one vehicle to one destination */
+    public static final class Stats {
+        private volatile Date lastSent;
+        private volatile Date lastFix;
+        private volatile Date lastErrorTime;
+        private volatile String lastError;
+        private volatile long sent;
+        private volatile long failed;
+
+        public Date getLastSent() {
+            return lastSent;
+        }
+
+        public Date getLastFix() {
+            return lastFix;
+        }
+
+        public Date getLastErrorTime() {
+            return lastErrorTime;
+        }
+
+        public String getLastError() {
+            return lastError;
+        }
+
+        public long getSent() {
+            return sent;
+        }
+
+        public long getFailed() {
+            return failed;
+        }
+    }
+
+    private final Storage storage;
+    private final Client client;
+
+    private final Map<Long, Deque<Item>> queues = new ConcurrentHashMap<>();
+    private final Map<Long, Map<Long, Stats>> stats = new ConcurrentHashMap<>();
+    private final Map<Long, Stats> destinationStats = new ConcurrentHashMap<>();
+    private final Map<Long, Long> dropped = new ConcurrentHashMap<>();
+    private volatile Map<Long, RegulatorDestination> destinations = Map.of();
+    private volatile long loaded;
+    private ScheduledExecutorService executor;
+
+    @Inject
+    public RegulatorService(Storage storage, Client client) {
+        this.storage = storage;
+        this.client = client;
+    }
+
+    public void reload() {
+        try {
+            Map<Long, RegulatorDestination> result = new HashMap<>();
+            for (RegulatorDestination destination : storage.getObjects(
+                    RegulatorDestination.class, new Request(new Columns.All()))) {
+                result.put(destination.getId(), destination);
+            }
+            destinations = result;
+            queues.keySet().removeIf(id -> !result.containsKey(id));
+        } catch (StorageException e) {
+            LOGGER.warn("Regulator destinations not loaded", e);
+        }
+        loaded = System.currentTimeMillis();
+    }
+
+    private Map<Long, RegulatorDestination> destinations() {
+        if (System.currentTimeMillis() - loaded > RELOAD_MILLIS) {
+            reload();
+        }
+        return destinations;
+    }
+
+    public static Set<Long> enrolled(Device device) {
+        String value = device != null ? device.getString(ENROLLED) : null;
+        if (value == null || value.isBlank()) {
+            return Set.of();
+        }
+        return Arrays.stream(value.split("[,;\\s]+")).map(String::trim).filter(item -> item.matches("\\d+"))
+                .map(Long::parseLong).collect(Collectors.toSet());
+    }
+
+    private synchronized void start() {
+        if (executor == null) {
+            executor = Executors.newSingleThreadScheduledExecutor(runnable -> {
+                Thread thread = new Thread(runnable, "regulator");
+                thread.setDaemon(true);
+                return thread;
+            });
+            executor.scheduleWithFixedDelay(this::flush, 1, 1, TimeUnit.SECONDS);
+        }
+    }
+
+    private static String number(double value, int decimals) {
+        return String.format(Locale.ROOT, "%." + decimals + "f", value);
+    }
+
+    /** values a template can use as ${name} */
+    public static Map<String, String> values(Device device, Position position, ZoneId zone) {
+        Map<String, String> values = new LinkedHashMap<>();
+        String plate = device.getString("plate");
+        values.put("plate", plate != null && !plate.isBlank() ? plate : device.getName());
+        values.put("name", device.getName());
+        values.put("imei", device.getUniqueId());
+        values.put("deviceId", String.valueOf(device.getId()));
+        values.put("route", device.getString("route") != null ? device.getString("route") : "");
+        values.put("lat", number(position.getLatitude(), 6));
+        values.put("lon", number(position.getLongitude(), 6));
+        values.put("speedKmh", number(UnitsConverter.kphFromKnots(position.getSpeed()), 1));
+        values.put("speedKnots", number(position.getSpeed(), 1));
+        values.put("course", number(position.getCourse(), 0));
+        values.put("altitude", number(position.getAltitude(), 0));
+        values.put("valid", String.valueOf(position.getValid()));
+        Object satellites = position.getAttributes().get(Position.KEY_SATELLITES);
+        values.put("satellites", satellites != null ? String.valueOf(satellites) : "0");
+        boolean ignition = position.getBoolean(Position.KEY_IGNITION);
+        values.put("ignition", String.valueOf(ignition));
+        values.put("ignition01", ignition ? "1" : "0");
+        values.put("motion", String.valueOf(position.getBoolean(Position.KEY_MOTION)));
+        values.put("odometerKm", number(position.getDouble(Position.KEY_TOTAL_DISTANCE) / 1000, 1));
+        String alarm = position.getString(Position.KEY_ALARM);
+        values.put("alarm", alarm != null ? alarm : "");
+        values.put("event", alarm != null ? alarm : ignition ? "position" : "stopped");
+        String driver = position.getString(Position.KEY_DRIVER_UNIQUE_ID);
+        values.put("driver", driver != null ? driver : "");
+        Instant fix = (position.getFixTime() != null ? position.getFixTime() : new Date()).toInstant();
+        values.put("fixTime", LOCAL_TIME.format(fix.atZone(zone)));
+        values.put("fixTimeIso", DateTimeFormatter.ISO_INSTANT.format(fix));
+        values.put("fixTimeEpoch", String.valueOf(fix.getEpochSecond()));
+        values.put("fixTimeMillis", String.valueOf(fix.toEpochMilli()));
+        return values;
+    }
+
+    private static String escape(String value) {
+        StringBuilder result = new StringBuilder();
+        for (char c : value.toCharArray()) {
+            switch (c) {
+                case '"' -> result.append("\\\"");
+                case '\\' -> result.append("\\\\");
+                case '\n' -> result.append("\\n");
+                case '\r' -> result.append("\\r");
+                case '\t' -> result.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        result.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        result.append(c);
+                    }
+                }
+            }
+        }
+        return result.toString();
+    }
+
+    /** fills the template; unknown placeholders stay empty and every value is escaped for JSON strings */
+    public static String render(String template, Map<String, String> values, Map<String, Object> extra) {
+        Matcher matcher = PLACEHOLDER.matcher(template);
+        StringBuilder result = new StringBuilder();
+        while (matcher.find()) {
+            String key = matcher.group(1);
+            Object value = values.containsKey(key) ? values.get(key) : extra.get(key);
+            String text = value != null ? String.valueOf(value) : "";
+            matcher.appendReplacement(result, Matcher.quoteReplacement(escape(text)));
+        }
+        matcher.appendTail(result);
+        return result.toString();
+    }
+
+    public static ZoneId zone(RegulatorDestination destination) {
+        try {
+            String timezone = destination.getString("timezone");
+            return ZoneId.of(timezone != null ? timezone : "America/Lima");
+        } catch (Exception e) {
+            return ZoneId.of("America/Lima");
+        }
+    }
+
+    public void onPosition(Device device, Position position) {
+        Set<Long> ids = enrolled(device);
+        if (ids.isEmpty() || !position.getValid()) {
+            return;
+        }
+        Map<Long, RegulatorDestination> all = destinations();
+        for (long id : ids) {
+            RegulatorDestination destination = all.get(id);
+            if (destination == null || !destination.getEnabled()) {
+                continue;
+            }
+            start();
+            Deque<Item> queue = queues.computeIfAbsent(id, key -> new ArrayDeque<>());
+            synchronized (queue) {
+                if (queue.size() >= QUEUE_LIMIT) {
+                    queue.pollFirst();
+                    dropped.merge(id, 1L, Long::sum);
+                }
+                queue.addLast(new Item(device.getId(), values(device, position, zone(destination)), 0, 0));
+            }
+            stats(id, device.getId()).lastFix = position.getFixTime();
+        }
+    }
+
+    private Stats stats(long destinationId, long deviceId) {
+        return stats.computeIfAbsent(destinationId, key -> new ConcurrentHashMap<>())
+                .computeIfAbsent(deviceId, key -> new Stats());
+    }
+
+    public Map<Long, Stats> deviceStats(long destinationId) {
+        return stats.getOrDefault(destinationId, Map.of());
+    }
+
+    public Stats destinationStats(long destinationId) {
+        return destinationStats.computeIfAbsent(destinationId, key -> new Stats());
+    }
+
+    public int queued(long destinationId) {
+        Deque<Item> queue = queues.get(destinationId);
+        if (queue == null) {
+            return 0;
+        }
+        synchronized (queue) {
+            return queue.size();
+        }
+    }
+
+    public long dropped(long destinationId) {
+        return dropped.getOrDefault(destinationId, 0L);
+    }
+
+    /** status code and start of the reply, or the error */
+    public record Result(int status, String body, String error) {
+        boolean success() {
+            return error == null && status / 100 == 2;
+        }
+    }
+
+    public Result post(RegulatorDestination destination, String json) {
+        try {
+            Invocation.Builder request = client.target(destination.getUrl()).request();
+            if (destination.getAuthHeader() != null && !destination.getAuthHeader().isBlank()
+                    && destination.getAuthValue() != null) {
+                request = request.header(destination.getAuthHeader(), destination.getAuthValue());
+            }
+            try (Response response = request.post(Entity.entity(json, MediaType.APPLICATION_JSON))) {
+                String body = response.hasEntity() ? response.readEntity(String.class) : "";
+                return new Result(response.getStatus(), body.length() > 300 ? body.substring(0, 300) : body, null);
+            }
+        } catch (Exception e) {
+            Throwable cause = e;
+            while (cause.getCause() != null && cause.getCause() != cause) {
+                cause = cause.getCause();
+            }
+            return new Result(0, null, cause.getClass().getSimpleName() + ": " + cause.getMessage());
+        }
+    }
+
+    private void flush() {
+        for (var entry : queues.entrySet()) {
+            RegulatorDestination destination = destinations().get(entry.getKey());
+            if (destination == null) {
+                continue;
+            }
+            try {
+                flush(destination, entry.getValue());
+            } catch (RuntimeException e) {
+                LOGGER.warn("Regulator {} flush failed", destination.getName(), e);
+            }
+        }
+    }
+
+    private void flush(RegulatorDestination destination, Deque<Item> queue) {
+        long now = System.currentTimeMillis();
+        List<Item> items = new ArrayList<>();
+        synchronized (queue) {
+            int skipped = 0;
+            while (!queue.isEmpty() && items.size() < BATCH_LIMIT && skipped < queue.size()) {
+                Item item = queue.pollFirst();
+                if (item.notBefore() > now) {
+                    queue.addLast(item);
+                    skipped += 1;
+                } else {
+                    items.add(item);
+                }
+            }
+        }
+        if (items.isEmpty()) {
+            return;
+        }
+        String template = destination.getTemplate() != null && !destination.getTemplate().isBlank()
+                ? destination.getTemplate() : "{\"imei\":\"${imei}\",\"lat\":${lat},\"lon\":${lon}}";
+        Map<String, Object> extra = destination.getAttributes();
+        if (destination.getBatch()) {
+            String json = items.stream().map(item -> render(template, item.values(), extra))
+                    .collect(Collectors.joining(",", "[", "]"));
+            Result result = post(destination, json);
+            items.forEach(item -> done(destination, queue, item, result));
+        } else {
+            for (Item item : items) {
+                done(destination, queue, item, post(destination, render(template, item.values(), extra)));
+            }
+        }
+    }
+
+    private void done(RegulatorDestination destination, Deque<Item> queue, Item item, Result result) {
+        Stats device = stats(destination.getId(), item.deviceId());
+        Stats total = destinationStats(destination.getId());
+        Date now = new Date();
+        if (result.success()) {
+            device.lastSent = now;
+            device.sent += 1;
+            total.lastSent = now;
+            total.sent += 1;
+            return;
+        }
+        String error = result.error() != null ? result.error() : "HTTP " + result.status() + " " + result.body();
+        device.lastError = error;
+        device.lastErrorTime = now;
+        total.lastError = error;
+        total.lastErrorTime = now;
+        int attempts = item.attempts() + 1;
+        if (attempts < MAX_ATTEMPTS) {
+            long wait = 2000L << attempts;
+            synchronized (queue) {
+                queue.addLast(new Item(item.deviceId(), item.values(), attempts, System.currentTimeMillis() + wait));
+            }
+        } else {
+            device.failed += 1;
+            total.failed += 1;
+        }
+    }
+
+}
