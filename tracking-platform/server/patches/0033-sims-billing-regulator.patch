+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Monthly billing of client accounts: on the billing day an invoice is issued for the units of the client (price
+ * per unit plus a fixed fee), it becomes overdue after its due date and, past the grace days, the account can be
+ * suspended until it is paid. Payments are registered by hand or through Mercado Pago payment links.
+ */
+@Singleton
+public class BillingService {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(BillingService.class);
+
+    public static final String PRICE = "billingPrice";
+    public static final String FIXED = "billingFixed";
+    public static final String CURRENCY = "billingCurrency";
+    public static final String DAY = "billingDay";
+    public static final String DUE_DAYS = "billingDueDays";
+    public static final String GRACE_DAYS = "billingGraceDays";
+    public static final String AUTO_SUSPEND = "billingAutoSuspend";
+    public static final String ISSUER = "billingIssuerId";
+    public static final String SUSPENDED = "billingSuspended";
+
+    public static final String PENDING = "pending";
+    public static final String OVERDUE = "overdue";
+    public static final String PAID = "paid";
+    public static final String VOID = "void";
+
+    private static final long DAY_MILLIS = 86_400_000L;
+
+    private final Config config;
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final Client client;
+    private final ObjectMapper objectMapper;
+
+    @Inject
+    public BillingService(
+            Config config, Storage storage, CacheManager cacheManager, Client client, ObjectMapper objectMapper) {
+        this.config = config;
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.client = client;
+        this.objectMapper = objectMapper;
+    }
+
+    public static boolean billed(User user) {
+        return user.getDouble(PRICE) > 0 || user.getDouble(FIXED) > 0;
+    }
+
+    public static int day(User user) {
+        int day = user.getInteger(DAY);
+        return day >= 1 && day <= 28 ? day : 1;
+    }
+
+    public static int dueDays(User user) {
+        return user.getAttributes().containsKey(DUE_DAYS) ? Math.max(0, user.getInteger(DUE_DAYS)) : 10;
+    }
+
+    public static int graceDays(User user) {
+        return user.getAttributes().containsKey(GRACE_DAYS) ? Math.max(0, user.getInteger(GRACE_DAYS)) : 5;
+    }
+
+    public static String currency(User user) {
+        String currency = user.getString(CURRENCY);
+        return currency != null && !currency.isBlank() ? currency.toUpperCase(Locale.ROOT) : "PEN";
+    }
+
+    private ZoneId zone() throws StorageException {
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        String timezone = server.getString("timezone");
+        try {
+            return timezone != null ? ZoneId.of(timezone) : ZoneId.systemDefault();
+        } catch (Exception e) {
+            return ZoneId.systemDefault();
+        }
+    }
+
+    public String currentPeriod() throws StorageException {
+        return period(ZonedDateTime.now(zone()));
+    }
+
+    public static String period(ZonedDateTime time) {
+        return String.format(Locale.ROOT, "%04d-%02d", time.getYear(), time.getMonthValue());
+    }
+
+    public Invoice find(long userId, String period) throws StorageException {
+        return storage.getObject(Invoice.class, new Request(new Columns.All(), new Condition.And(
+                new Condition.Equals("userId", userId), new Condition.Equals("period", period))));
+    }
+
+    /** devices of the account (every device for an administrator) */
+    public int units(User user) throws StorageException {
+        Request request = user.getAdministrator()
+                ? new Request(new Columns.Include("id"))
+                : new Request(new Columns.Include("id"),
+                        new Condition.Permission(User.class, user.getId(), Device.class));
+        return storage.getObjects(Device.class, request).size();
+    }
+
+    /** issues the invoice of a client for a period (one per period), counting the units it has now */
+    public Invoice issue(User user, String period, Date now) throws StorageException {
+        Invoice existing = find(user.getId(), period);
+        if (existing != null) {
+            return existing;
+        }
+        Invoice invoice = new Invoice();
+        invoice.setUserId(user.getId());
+        invoice.setIssuerId(user.getLong(ISSUER));
+        invoice.setPeriod(period);
+        invoice.setUnits(units(user));
+        invoice.setUnitPrice(Math.max(0, user.getDouble(PRICE)));
+        invoice.setFixedFee(Math.max(0, user.getDouble(FIXED)));
+        invoice.setAmount(Math.round((invoice.getUnits() * invoice.getUnitPrice() + invoice.getFixedFee()) * 100)
+                / 100.0);
+        invoice.setCurrency(currency(user));
+        invoice.setStatus(PENDING);
+        invoice.setIssueDate(now);
+        invoice.setDueDate(new Date(now.getTime() + dueDays(user) * DAY_MILLIS));
+        invoice.setId(storage.addObject(invoice, new Request(new Columns.Exclude("id"))));
+        LOGGER.info("Invoice {} issued to user {} for {}: {} {}",
+                invoice.getId(), user.getId(), period, invoice.getAmount(), invoice.getCurrency());
+        return invoice;
+    }
+
+    private void saveUser(User user) throws Exception {
+        storage.updateObject(user, new Request(
+                new Columns.Include("disabled", "attributes"), new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+    }
+
+    private User user(long userId) throws StorageException {
+        return storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", userId)));
+    }
+
+    /**
+     * Issues the invoices that are due, marks the late ones and suspends or reactivates accounts. Runs every hour
+     * and can be called at any time: it never issues twice for the same month.
+     */
+    public synchronized Map<String, Integer> run(Date now) throws Exception {
+        ZonedDateTime local = now.toInstant().atZone(zone());
+        String period = period(local);
+        int issued = 0;
+        int overdue = 0;
+        int suspended = 0;
+        int reactivated = 0;
+        for (User user : storage.getObjects(User.class, new Request(new Columns.All()))) {
+            if (billed(user) && local.getDayOfMonth() >= day(user) && find(user.getId(), period) == null) {
+                issue(user, period, now);
+                issued += 1;
+            }
+        }
+        for (Invoice invoice : storage.getObjects(Invoice.class, new Request(
+                new Columns.All(), new Condition.Equals("status", PENDING)))) {
+            if (invoice.getDueDate() != null && now.after(invoice.getDueDate())) {
+                invoice.setStatus(OVERDUE);
+                storage.updateObject(invoice, new Request(
+                        new Columns.Include("status"), new Condition.Equals("id", invoice.getId())));
+                overdue += 1;
+            }
+        }
+        for (User user : storage.getObjects(User.class, new Request(new Columns.All()))) {
+            boolean late = mustSuspend(user, now);
+            if (late && !user.getDisabled() && user.getBoolean(AUTO_SUSPEND)) {
+                user.setDisabled(true);
+                user.set(SUSPENDED, true);
+                saveUser(user);
+                suspended += 1;
+                LOGGER.info("User {} suspended for unpaid invoices", user.getId());
+            } else if (!late && user.getBoolean(SUSPENDED)) {
+                reactivate(user);
+                reactivated += 1;
+            }
+        }
+        Map<String, Integer> result = new LinkedHashMap<>();
+        result.put("issued", issued);
+        result.put("overdue", overdue);
+        result.put("suspended", suspended);
+        result.put("reactivated", reactivated);
+        return result;
+    }
+
+    /** an overdue invoice past the grace days */
+    private boolean mustSuspend(User user, Date now) throws StorageException {
+        for (Invoice invoice : storage.getObjects(Invoice.class, new Request(new Columns.All(), new Condition.And(
+                new Condition.Equals("userId", user.getId()), new Condition.Equals("status", OVERDUE))))) {
+            if (invoice.getDueDate() != null
+                    && now.getTime() > invoice.getDueDate().getTime() + graceDays(user) * DAY_MILLIS) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void reactivate(User user) throws Exception {
+        user.setDisabled(false);
+        user.getAttributes().remove(SUSPENDED);
+        saveUser(user);
+        LOGGER.info("User {} reactivated after payment", user.getId());
+    }
+
+    public synchronized Invoice markPaid(Invoice invoice, String method, String reference) throws Exception {
+        if (PAID.equals(invoice.getStatus())) {
+            return invoice;
+        }
+        if (VOID.equals(invoice.getStatus())) {
+            throw new IllegalArgumentException("The invoice was voided");
+        }
+        invoice.setStatus(PAID);
+        invoice.setPaidDate(new Date());
+        invoice.setPaymentMethod(method);
+        invoice.setPaymentRef(reference);
+        storage.updateObject(invoice, new Request(
+                new Columns.Include("status", "paidDate", "paymentMethod", "paymentRef"),
+                new Condition.Equals("id", invoice.getId())));
+        User user = user(invoice.getUserId());
+        if (user != null && user.getBoolean(SUSPENDED) && !mustSuspend(user, new Date())) {
+            reactivate(user);
+        }
+        return invoice;
+    }
+
+    public synchronized Invoice markVoid(Invoice invoice) throws Exception {
+        if (PAID.equals(invoice.getStatus())) {
+            throw new IllegalArgumentException("A paid invoice cannot be voided");
+        }
+        invoice.setStatus(VOID);
+        storage.updateObject(invoice, new Request(
+                new Columns.Include("status"), new Condition.Equals("id", invoice.getId())));
+        User user = user(invoice.getUserId());
+        if (user != null && user.getBoolean(SUSPENDED) && !mustSuspend(user, new Date())) {
+            reactivate(user);
+        }
+        return invoice;
+    }
+
+    // ---------- Mercado Pago ----------
+
+    public boolean mercadoPagoEnabled() {
+        String token = config.getString(Keys.BILLING_MERCADO_PAGO_TOKEN);
+        return token != null && !token.isBlank();
+    }
+
+    private String mercadoPagoUrl(String path) {
+        String base = config.getString(Keys.BILLING_MERCADO_PAGO_URL);
+        return (base.endsWith("/") ? base.substring(0, base.length() - 1) : base) + path;
+    }
+
+    /** creates (once) the Mercado Pago payment link of an invoice */
+    public Invoice checkout(Invoice invoice, String title) throws Exception {
+        if (invoice.getPaymentUrl() != null) {
+            return invoice;
+        }
+        if (!mercadoPagoEnabled()) {
+            throw new IllegalArgumentException("Mercado Pago is not configured");
+        }
+        String webUrl = config.getString(Keys.WEB_URL);
+        Map<String, Object> item = new LinkedHashMap<>();
+        item.put("title", title);
+        item.put("quantity", 1);
+        item.put("unit_price", invoice.getAmount());
+        item.put("currency_id", invoice.getCurrency());
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("items", List.of(item));
+        body.put("external_reference", "invoice-" + invoice.getId());
+        if (webUrl != null) {
+            String base = webUrl.endsWith("/") ? webUrl.substring(0, webUrl.length() - 1) : webUrl;
+            body.put("notification_url", base + "/api/billing/mercadopago/webhook");
+            body.put("back_urls", Map.of("success", base + "/billing", "pending", base + "/billing",
+                    "failure", base + "/billing"));
+            body.put("auto_return", "approved");
+        }
+        try (Response response = client.target(mercadoPagoUrl("/checkout/preferences")).request()
+                .header("Authorization", "Bearer " + config.getString(Keys.BILLING_MERCADO_PAGO_TOKEN))
+                .post(Entity.entity(objectMapper.writeValueAsString(body), MediaType.APPLICATION_JSON))) {
+            String text = response.readEntity(String.class);
+            if (response.getStatus() / 100 != 2) {
+                throw new IllegalArgumentException("Mercado Pago rejected the payment link: " + response.getStatus());
+            }
+            JsonNode json = objectMapper.readTree(text);
+            String link = json.path("init_point").asText(null);
+            if (link == null) {
+                throw new IllegalArgumentException("Mercado Pago returned no payment link");
+            }
+            invoice.setPaymentUrl(link);
+            storage.updateObject(invoice, new Request(
+                    new Columns.Include("paymentUrl"), new Condition.Equals("id", invoice.getId())));
+            return invoice;
+        }
+    }
+
+    /**
+     * Payment notified by Mercado Pago: the payment is read back from Mercado Pago (never trusted from the
+     * notification) and, when approved for the full amount, the invoice of its reference is paid.
+     */
+    public boolean paymentNotified(String paymentId) throws Exception {
+        if (!mercadoPagoEnabled() || paymentId == null || !paymentId.matches("\\d{1,20}")) {
+            return false;
+        }
+        try (Response response = client.target(mercadoPagoUrl("/v1/payments/" + paymentId)).request()
+                .header("Authorization", "Bearer " + config.getString(Keys.BILLING_MERCADO_PAGO_TOKEN)).get()) {
+            if (response.getStatus() / 100 != 2) {
+                return false;
+            }
+            JsonNode json = objectMapper.readTree(response.readEntity(String.class));
+            String reference = json.path("external_reference").asText("");
+            if (!"approved".equals(json.path("status").asText()) || !reference.startsWith("invoice-")) {
+                return false;
+            }
+            long id;
+            try {
+                id = Long.parseLong(reference.substring("invoice-".length()));
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            Invoice invoice = storage.getObject(Invoice.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", id)));
+            String currency = json.path("currency_id").asText(invoice != null ? invoice.getCurrency() : "");
+            if (invoice == null || json.path("transaction_amount").asDouble() + 0.005 < invoice.getAmount()
+                    || !invoice.getCurrency().equalsIgnoreCase(currency)) {
+                LOGGER.warn("Mercado Pago payment {} does not match invoice {}", paymentId, id);
+                return false;
+            }
+            markPaid(invoice, "mercadopago", paymentId);
+            return true;
+        }
+    }
+
+    public List<Invoice> invoicesOf(long userId) throws StorageException {
+        return new ArrayList<>(storage.getObjects(Invoice.class, new Request(
+                new Columns.All(), new Condition.Equals("userId", userId))));
+    }
+
+}
