+package org.traccar.api.resource;
+
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.billing.BillingService;
+import org.traccar.helper.model.FleetUtil;
+import org.traccar.model.Invoice;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.User;
+import org.traccar.plans.PlanService;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Billing of client accounts: settings per client, invoices, manual payments, Mercado Pago payment links and the
+ * invoices a client has to pay.
+ */
+@Path("billing")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class BillingResource extends BaseResource {
+
+    @Inject
+    private BillingService billingService;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private PlanService planService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    private boolean admin() throws StorageException {
+        return !permissionsService.notAdmin(getUserId());
+    }
+
+    /** administrators, and managers whose plan includes billing, bill the accounts below them */
+    private void checkBiller() throws StorageException {
+        if (admin()) {
+            return;
+        }
+        User user = permissionsService.getUser(getUserId());
+        if (user.getUserLimit() == 0 || !planService.getModules(getUserId()).contains("billing")) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+    }
+
+    private Map<Long, User> managedUsers() throws StorageException {
+        Map<Long, User> result = new LinkedHashMap<>();
+        if (admin()) {
+            for (User user : storage.getObjects(User.class, new Request(new Columns.All()))) {
+                if (!user.getAdministrator()) {
+                    result.put(user.getId(), user);
+                }
+            }
+        } else {
+            for (long id : hierarchyService.getDescendants(getUserId())) {
+                User user = storage.getObject(User.class, new Request(
+                        new Columns.All(), new Condition.Equals("id", id)));
+                if (user != null) {
+                    result.put(id, user);
+                }
+            }
+        }
+        return result;
+    }
+
+    private User checkManaged(long userId) throws StorageException {
+        User user = managedUsers().get(userId);
+        if (user == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return user;
+    }
+
+    private Invoice checkInvoice(long id, boolean manage) throws StorageException {
+        Invoice invoice = storage.getObject(Invoice.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (invoice == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        boolean own = invoice.getUserId() == getUserId();
+        if (manage || !own) {
+            checkBiller();
+            checkManaged(invoice.getUserId());
+        }
+        return invoice;
+    }
+
+    private static Map<String, Object> settings(User user) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("price", user.getDouble(BillingService.PRICE));
+        result.put("fixedFee", user.getDouble(BillingService.FIXED));
+        result.put("currency", BillingService.currency(user));
+        result.put("day", BillingService.day(user));
+        result.put("dueDays", BillingService.dueDays(user));
+        result.put("graceDays", BillingService.graceDays(user));
+        result.put("autoSuspend", user.getBoolean(BillingService.AUTO_SUSPEND));
+        return result;
+    }
+
+    private Map<String, Object> view(Invoice invoice, Map<Long, User> users) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", invoice.getId());
+        result.put("userId", invoice.getUserId());
+        User user = users.get(invoice.getUserId());
+        result.put("userName", user != null ? user.getName() : null);
+        result.put("period", invoice.getPeriod());
+        result.put("units", invoice.getUnits());
+        result.put("unitPrice", invoice.getUnitPrice());
+        result.put("fixedFee", invoice.getFixedFee());
+        result.put("amount", invoice.getAmount());
+        result.put("currency", invoice.getCurrency());
+        result.put("status", invoice.getStatus());
+        result.put("issueDate", invoice.getIssueDate());
+        result.put("dueDate", invoice.getDueDate());
+        result.put("paidDate", invoice.getPaidDate());
+        result.put("paymentMethod", invoice.getPaymentMethod());
+        result.put("paymentRef", invoice.getPaymentRef());
+        result.put("paymentUrl", invoice.getPaymentUrl());
+        return result;
+    }
+
+    @GET
+    @Path("clients")
+    public List<Map<String, Object>> clients() throws StorageException {
+        checkBiller();
+        List<Map<String, Object>> result = new ArrayList<>();
+        Map<Long, List<Invoice>> invoices = new HashMap<>();
+        for (Invoice invoice : storage.getObjects(Invoice.class, new Request(new Columns.All()))) {
+            invoices.computeIfAbsent(invoice.getUserId(), key -> new ArrayList<>()).add(invoice);
+        }
+        for (User user : managedUsers().values()) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("id", user.getId());
+            item.put("name", user.getName());
+            item.put("email", user.getEmail());
+            item.put("plan", user.getString("plan"));
+            item.put("units", billingService.units(user));
+            item.put("billed", BillingService.billed(user));
+            item.put("settings", settings(user));
+            item.put("disabled", user.getDisabled());
+            item.put("suspended", user.getBoolean(BillingService.SUSPENDED));
+            double open = 0;
+            int overdue = 0;
+            for (Invoice invoice : invoices.getOrDefault(user.getId(), List.of())) {
+                if (BillingService.PENDING.equals(invoice.getStatus())
+                        || BillingService.OVERDUE.equals(invoice.getStatus())) {
+                    open += invoice.getAmount();
+                }
+                if (BillingService.OVERDUE.equals(invoice.getStatus())) {
+                    overdue += 1;
+                }
+            }
+            item.put("openAmount", Math.round(open * 100) / 100.0);
+            item.put("overdue", overdue);
+            result.add(item);
+        }
+        return result;
+    }
+
+    private static double number(Object value) {
+        return value instanceof Number number ? number.doubleValue() : 0;
+    }
+
+    @PUT
+    @Path("clients/{id}")
+    public Map<String, Object> saveClient(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkBiller();
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        User user = checkManaged(id);
+        double price = number(body.get("price"));
+        double fixed = number(body.get("fixedFee"));
+        int day = (int) number(body.get("day"));
+        if (price < 0 || fixed < 0 || day < 0 || day > 28) {
+            throw new IllegalArgumentException("Invalid billing settings");
+        }
+        user.set(BillingService.PRICE, price);
+        user.set(BillingService.FIXED, fixed);
+        Object currency = body.get("currency");
+        user.set(BillingService.CURRENCY, currency != null ? String.valueOf(currency) : "PEN");
+        user.set(BillingService.DAY, day > 0 ? day : 1);
+        user.set(BillingService.DUE_DAYS, (int) Math.max(0, number(body.get("dueDays"))));
+        user.set(BillingService.GRACE_DAYS, (int) Math.max(0, number(body.get("graceDays"))));
+        user.set(BillingService.AUTO_SUSPEND, Boolean.TRUE.equals(body.get("autoSuspend")));
+        user.set(BillingService.ISSUER, getUserId());
+        storage.updateObject(user, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", user.getId())));
+        cacheManager.invalidateObject(true, User.class, user.getId(), ObjectOperation.UPDATE);
+        return settings(user);
+    }
+
+    /** issues the invoice of the current month now, whatever the billing day */
+    @POST
+    @Path("clients/{id}/issue")
+    public Map<String, Object> issue(@PathParam("id") long id) throws Exception {
+        checkBiller();
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        User user = checkManaged(id);
+        if (!BillingService.billed(user)) {
+            throw new IllegalArgumentException("The client has no price");
+        }
+        String period = billingService.currentPeriod();
+        Invoice invoice = billingService.issue(user, period, new Date());
+        return view(invoice, Map.of(user.getId(), user));
+    }
+
+    @GET
+    @Path("invoices")
+    public List<Map<String, Object>> invoices(@QueryParam("status") String status) throws StorageException {
+        Map<Long, User> users = new HashMap<>();
+        Set<Long> visible = new HashSet<>();
+        visible.add(getUserId());
+        users.put(getUserId(), permissionsService.getUser(getUserId()));
+        boolean biller;
+        try {
+            checkBiller();
+            biller = true;
+        } catch (WebApplicationException e) {
+            biller = false;
+        }
+        if (biller) {
+            users.putAll(managedUsers());
+            visible.addAll(users.keySet());
+        }
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Invoice invoice : storage.getObjects(Invoice.class, new Request(new Columns.All()))) {
+            if (visible.contains(invoice.getUserId())
+                    && (status == null || status.isEmpty() || status.equals(invoice.getStatus()))) {
+                result.add(view(invoice, users));
+            }
+        }
+        result.sort(Comparator.comparing((Map<String, Object> item) -> (String) item.get("period")).reversed()
+                .thenComparing(item -> String.valueOf(item.get("userName"))));
+        return result;
+    }
+
+    @PUT
+    @Path("invoices/{id}/paid")
+    public Map<String, Object> paid(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Invoice invoice = checkInvoice(id, true);
+        Object method = body.get("method");
+        Object reference = body.get("reference");
+        billingService.markPaid(invoice, method != null ? String.valueOf(method) : "manual",
+                reference != null ? String.valueOf(reference) : null);
+        return view(invoice, managedUsers());
+    }
+
+    @PUT
+    @Path("invoices/{id}/void")
+    public Map<String, Object> markVoid(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Invoice invoice = checkInvoice(id, true);
+        billingService.markVoid(invoice);
+        return view(invoice, managedUsers());
+    }
+
+    /** only voided invoices can be deleted, by an administrator */
+    @DELETE
+    @Path("invoices/{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        if (!admin()) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+        Invoice invoice = checkInvoice(id, true);
+        if (!BillingService.VOID.equals(invoice.getStatus())) {
+            throw new IllegalArgumentException("Void the invoice first");
+        }
+        storage.removeObject(Invoice.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    @POST
+    @Path("invoices/{id}/checkout")
+    public Map<String, Object> checkout(@PathParam("id") long id) throws Exception {
+        Invoice invoice = checkInvoice(id, false);
+        if (!BillingService.PENDING.equals(invoice.getStatus())
+                && !BillingService.OVERDUE.equals(invoice.getStatus())) {
+            throw new IllegalArgumentException("The invoice is not open");
+        }
+        billingService.checkout(invoice, "Servicio de rastreo " + invoice.getPeriod()
+                + " (" + invoice.getUnits() + " unidades)");
+        return view(invoice, Map.of());
+    }
+
+    /** open invoices of the caller, for the payment reminder */
+    @GET
+    @Path("me")
+    public Map<String, Object> mine() throws StorageException {
+        List<Map<String, Object>> open = new ArrayList<>();
+        long now = System.currentTimeMillis();
+        for (Invoice invoice : billingService.invoicesOf(getUserId())) {
+            if (BillingService.PENDING.equals(invoice.getStatus())
+                    || BillingService.OVERDUE.equals(invoice.getStatus())) {
+                Map<String, Object> item = view(invoice, Map.of());
+                item.put("daysLeft", invoice.getDueDate() != null
+                        ? Math.floorDiv(invoice.getDueDate().getTime() - now, 86_400_000L) : null);
+                open.add(item);
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("open", open);
+        result.put("mercadoPago", billingService.mercadoPagoEnabled());
+        return result;
+    }
+
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary() throws StorageException {
+        checkBiller();
+        Map<Long, User> users = managedUsers();
+        String month = billingService.currentPeriod();
+        Map<String, Map<String, Double>> totals = new LinkedHashMap<>();
+        for (Invoice invoice : storage.getObjects(Invoice.class, new Request(new Columns.All()))) {
+            if (!users.containsKey(invoice.getUserId())) {
+                continue;
+            }
+            String key = switch (invoice.getStatus()) {
+                case BillingService.PENDING -> "pending";
+                case BillingService.OVERDUE -> "overdue";
+                case BillingService.PAID -> invoice.getPeriod().equals(month) ? "paidThisMonth" : null;
+                default -> null;
+            };
+            if (key != null) {
+                totals.computeIfAbsent(key, k -> new LinkedHashMap<>())
+                        .merge(invoice.getCurrency(), invoice.getAmount(), Double::sum);
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>(totals);
+        result.put("billedClients", users.values().stream().filter(BillingService::billed).count());
+        result.put("suspended", users.values().stream()
+                .filter(user -> user.getBoolean(BillingService.SUSPENDED)).count());
+        result.put("mercadoPago", billingService.mercadoPagoEnabled());
+        return result;
+    }
+
+    @POST
+    @Path("run")
+    public Map<String, Integer> run() throws Exception {
+        if (!admin()) {
+            throw new WebApplicationException(Response.Status.FORBIDDEN);
+        }
+        return billingService.run(new Date());
+    }
+
+    /** Mercado Pago payment notification; the payment itself is always checked with Mercado Pago */
+    @POST
+    @PermitAll
+    @Path("mercadopago/webhook")
+    public Response webhook(
+            @QueryParam("type") String type, @QueryParam("topic") String topic,
+            @QueryParam("data.id") String dataId, @QueryParam("id") String id,
+            Map<String, Object> body) throws Exception {
+        String kind = type != null ? type : topic;
+        String paymentId = dataId != null ? dataId : id;
+        if (body != null) {
+            if (kind == null && body.get("type") != null) {
+                kind = String.valueOf(body.get("type"));
+            }
+            if (body.get("data") instanceof Map<?, ?> data && data.get("id") != null) {
+                paymentId = String.valueOf(data.get("id"));
+            }
+        }
+        if (kind == null || "payment".equals(kind)) {
+            billingService.paymentNotified(paymentId);
+        }
+        return Response.ok().build();
+    }
+
+}
