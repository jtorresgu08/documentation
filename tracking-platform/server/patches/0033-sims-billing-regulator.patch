+
+/**
+ * SIM inventory: carrier lines, data plans and costs, the device each SIM is installed in, usage imported from the
+ * carrier and SIMs that went silent (their device stopped reporting).
+ */
+@Path("sims")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SimResource extends BaseResource {
+
+    public static final String ACTIVE = "active";
+    public static final String INVENTORY = "inventory";
+    public static final String SUSPENDED = "suspended";
+    public static final String CANCELLED = "cancelled";
+    private static final List<String> STATUSES = List.of(ACTIVE, INVENTORY, SUSPENDED, CANCELLED);
+
+    private static final long HOUR = 3_600_000L;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    /** accounts whose SIMs the caller sees: its own and those below it, or {@code null} for everything */
+    private Set<Long> visibleOwners() throws StorageException {
+        if (!permissionsService.notAdmin(getUserId())) {
+            return null;
+        }
+        Set<Long> owners = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        owners.add(getUserId());
+        return owners;
+    }
+
+    private List<Sim> visibleSims() throws StorageException {
+        Set<Long> owners = visibleOwners();
+        List<Sim> result = new ArrayList<>();
+        for (Sim sim : storage.getObjects(Sim.class, new Request(new Columns.All(), new Order("iccid")))) {
+            if (owners == null || owners.contains(sim.getUserId())) {
+                result.add(sim);
+            }
+        }
+        return result;
+    }
+
+    private Sim checkSim(long id) throws StorageException {
+        Sim sim = storage.getObject(Sim.class, new Request(new Columns.All(), new Condition.Equals("id", id)));
+        Set<Long> owners = visibleOwners();
+        if (sim == null || owners != null && !owners.contains(sim.getUserId())) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return sim;
+    }
+
+    private Map<Long, Device> visibleDevices() throws StorageException {
+        Map<Long, Device> result = new HashMap<>();
+        for (Device device : FleetUtil.devices(storage, permissionsService, getUserId())) {
+            result.put(device.getId(), device);
+        }
+        return result;
+    }
+
+    private double silentHours() throws StorageException {
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        double hours = server.getDouble("simSilentHours");
+        return hours > 0 ? hours : 24;
+    }
+
+    private static boolean reporting(Device device, long now, double hours) {
+        return device != null && device.getLastUpdate() != null
+                && now - device.getLastUpdate().getTime() < hours * HOUR;
+    }
+
+    private Map<String, Object> view(Sim sim, Map<Long, Device> devices, long now, double hours) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", sim.getId());
+        result.put("userId", sim.getUserId());
+        result.put("iccid", sim.getIccid());
+        result.put("phone", sim.getPhone());
+        result.put("carrier", sim.getCarrier());
+        result.put("apn", sim.getApn());
+        result.put("planName", sim.getPlanName());
+        result.put("dataLimitMb", sim.getDataLimitMb());
+        result.put("usageMb", sim.getUsageMb());
+        result.put("usageDate", sim.getUsageDate());
+        result.put("monthlyCost", sim.getMonthlyCost());
+        result.put("status", sim.getStatus());
+        result.put("deviceId", sim.getDeviceId());
+        result.put("activatedAt", sim.getActivatedAt());
+        result.put("attributes", sim.getAttributes());
+        Device device = devices.get(sim.getDeviceId());
+        result.put("deviceName", device != null ? device.getName() : null);
+        result.put("lastUpdate", device != null ? device.getLastUpdate() : null);
+        boolean active = ACTIVE.equals(sim.getStatus());
+        result.put("silent", active && sim.getDeviceId() > 0 && !reporting(device, now, hours));
+        result.put("overLimit", sim.getDataLimitMb() > 0 && sim.getUsageMb() >= sim.getDataLimitMb());
+        result.put("usagePercent", sim.getDataLimitMb() > 0
+                ? Math.round(sim.getUsageMb() * 1000 / sim.getDataLimitMb()) / 10.0 : null);
+        return result;
+    }
+
+    @GET
+    public List<Map<String, Object>> list() throws StorageException {
+        Map<Long, Device> devices = visibleDevices();
+        long now = System.currentTimeMillis();
+        double hours = silentHours();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Sim sim : visibleSims()) {
+            result.add(view(sim, devices, now, hours));
+        }
+        return result;
+    }
+
+    private static String text(Object value) {
+        if (value == null) {
+            return null;
+        }
+        String result = String.valueOf(value).trim();
+        return result.isEmpty() ? null : result;
+    }
+
+    private static double number(Object value) {
+        if (value instanceof Number number) {
+            return number.doubleValue();
+        }
+        try {
+            return value != null ? Double.parseDouble(String.valueOf(value).trim().replace(',', '.')) : 0;
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private static String cleanIccid(Object value) {
+        String iccid = text(value);
+        iccid = iccid != null ? iccid.replaceAll("[^0-9A-Za-z]", "") : null;
+        if (iccid == null || iccid.length() < 10 || iccid.length() > 22) {
+            throw new IllegalArgumentException("Invalid ICCID: " + value);
+        }
+        return iccid;
+    }
+
+    private void read(Sim sim, Map<String, Object> body, Map<Long, Device> devices) {
+        sim.setIccid(cleanIccid(body.get("iccid")));
+        sim.setPhone(text(body.get("phone")));
+        sim.setCarrier(text(body.get("carrier")));
+        sim.setApn(text(body.get("apn")));
+        sim.setPlanName(text(body.get("planName")));
+        sim.setDataLimitMb(Math.max(0, number(body.get("dataLimitMb"))));
+        sim.setMonthlyCost(Math.max(0, number(body.get("monthlyCost"))));
+        if (body.containsKey("usageMb")) {
+            sim.setUsageMb(Math.max(0, number(body.get("usageMb"))));
+        }
+        String status = text(body.get("status"));
+        long deviceId = (long) number(body.get("deviceId"));
+        if (deviceId > 0 && !devices.containsKey(deviceId)) {
+            throw new SecurityException("Device not accessible");
+        }
+        sim.setDeviceId(deviceId);
+        if (status == null) {
+            status = deviceId > 0 ? ACTIVE : INVENTORY;
+        }
+        if (!STATUSES.contains(status)) {
+            throw new IllegalArgumentException("Unknown status " + status);
+        }
+        if (ACTIVE.equals(status) && sim.getActivatedAt() == null) {
+            sim.setActivatedAt(new Date());
+        }
+        sim.setStatus(status);
+        if (body.get("attributes") instanceof Map<?, ?> attributes) {
+            Map<String, Object> copy = new HashMap<>();
+            attributes.forEach((key, value) -> copy.put(String.valueOf(key), value));
+            sim.setAttributes(copy);
+        }
+    }
+
+    private Sim byIccid(String iccid) throws StorageException {
+        return storage.getObject(Sim.class, new Request(new Columns.All(), new Condition.Equals("iccid", iccid)));
+    }
+
+    /** a device holds one SIM: installing it elsewhere frees it from the previous one, and the phone follows */
+    private void install(Sim sim, Map<Long, Device> devices) throws Exception {
+        if (sim.getDeviceId() <= 0) {
+            return;
+        }
+        for (Sim other : storage.getObjects(Sim.class, new Request(
+                new Columns.All(), new Condition.Equals("deviceId", sim.getDeviceId())))) {
+            if (other.getId() != sim.getId()) {
+                other.setDeviceId(0);
+                storage.updateObject(other, new Request(
+                        new Columns.Include("deviceId"), new Condition.Equals("id", other.getId())));
+            }
+        }
+        Device device = devices.get(sim.getDeviceId());
+        if (device != null && sim.getPhone() != null && !sim.getPhone().equals(device.getPhone())) {
+            device.setPhone(sim.getPhone());
+            storage.updateObject(device, new Request(
+                    new Columns.Include("phone"), new Condition.Equals("id", device.getId())));
+            cacheManager.invalidateObject(true, Device.class, device.getId(), ObjectOperation.UPDATE);
+        }
+    }
+
+    private Sim save(Sim sim, Map<Long, Device> devices) throws Exception {
+        Sim existing = byIccid(sim.getIccid());
+        if (existing != null && existing.getId() != sim.getId()) {
+            throw new IllegalArgumentException("ICCID already registered: " + sim.getIccid());
+        }
+        if (sim.getId() == 0) {
+            sim.setId(storage.addObject(sim, new Request(new Columns.Exclude("id"))));
+        } else {
+            storage.updateObject(sim, new Request(
+                    new Columns.Exclude("id", "userId"), new Condition.Equals("id", sim.getId())));
+        }
+        install(sim, devices);
+        return sim;
+    }
+
+    @POST
+    public Map<String, Object> add(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Map<Long, Device> devices = visibleDevices();
+        Sim sim = new Sim();
+        sim.setUserId(getUserId());
+        read(sim, body, devices);
+        save(sim, devices);
+        return view(sim, devices, System.currentTimeMillis(), silentHours());
+    }
+
+    @PUT
+    @Path("{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Map<Long, Device> devices = visibleDevices();
+        Sim sim = checkSim(id);
+        read(sim, body, devices);
+        save(sim, devices);
+        return view(sim, devices, System.currentTimeMillis(), silentHours());
+    }
+
+    @DELETE
+    @Path("{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        checkSim(id);
+        storage.removeObject(Sim.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+    private static List<String> splitLine(String line, char separator) {
+        List<String> result = new ArrayList<>();
+        StringBuilder current = new StringBuilder();
+        boolean quoted = false;
+        for (char c : line.toCharArray()) {
+            if (c == '"') {
+                quoted = !quoted;
+            } else if (c == separator && !quoted) {
+                result.add(current.toString().trim());
+                current.setLength(0);
+            } else {
+                current.append(c);
+            }
+        }
+        result.add(current.toString().trim());
+        return result;
+    }
+
+    private static final Map<String, String> HEADERS = Map.ofEntries(
+            Map.entry("iccid", "iccid"), Map.entry("sim", "iccid"),
+            Map.entry("phone", "phone"), Map.entry("telefono", "phone"), Map.entry("msisdn", "phone"),
+            Map.entry("numero", "phone"),
+            Map.entry("carrier", "carrier"), Map.entry("operador", "carrier"),
+            Map.entry("apn", "apn"),
+            Map.entry("plan", "planName"), Map.entry("planname", "planName"),
+            Map.entry("limitmb", "dataLimitMb"), Map.entry("datalimitmb", "dataLimitMb"),
+            Map.entry("mb", "dataLimitMb"),
+            Map.entry("cost", "monthlyCost"), Map.entry("costo", "monthlyCost"),
+            Map.entry("monthlycost", "monthlyCost"),
+            Map.entry("usagemb", "usageMb"), Map.entry("consumomb", "usageMb"), Map.entry("consumo", "usageMb"),
+            Map.entry("status", "status"), Map.entry("estado", "status"),
+            Map.entry("imei", "imei"), Map.entry("uniqueid", "imei"));
+
+    /**
+     * Creates or updates SIMs from a CSV (header row required): iccid, phone, carrier, apn, plan, limitMb, cost,
+     * usageMb, status and imei of the device it is installed in. Existing ICCIDs are updated.
+     */
+    @POST
+    @Path("import")
+    public Map<String, Object> importCsv(Map<String, Object> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        String csv = text(body.get("csv"));
+        if (csv == null) {
+            throw new IllegalArgumentException("Empty CSV");
+        }
+        String[] lines = csv.replace("\r", "").split("\n");
+        char separator = lines[0].contains(";") ? ';' : ',';
+        List<String> header = new ArrayList<>();
+        for (String name : splitLine(lines[0], separator)) {
+            header.add(HEADERS.get(name.toLowerCase(Locale.ROOT).replaceAll("[^a-z]", "")));
+        }
+        if (!header.contains("iccid")) {
+            throw new IllegalArgumentException("The CSV needs an iccid column");
+        }
+        Map<Long, Device> devices = visibleDevices();
+        Map<String, Device> byImei = new HashMap<>();
+        devices.values().forEach(device -> byImei.put(device.getUniqueId(), device));
+        Set<Long> owners = visibleOwners();
+        int created = 0;
+        int updated = 0;
+        List<String> errors = new ArrayList<>();
+        for (int i = 1; i < lines.length; i++) {
+            if (lines[i].isBlank()) {
+                continue;
+            }
+            List<String> values = splitLine(lines[i], separator);
+            Map<String, Object> row = new HashMap<>();
+            for (int j = 0; j < header.size() && j < values.size(); j++) {
+                if (header.get(j) != null && !values.get(j).isEmpty()) {
+                    row.put(header.get(j), values.get(j));
+                }
+            }
+            try {
+                Sim sim = byIccid(cleanIccid(row.get("iccid")));
+                boolean exists = sim != null;
+                if (exists && owners != null && !owners.contains(sim.getUserId())) {
+                    throw new SecurityException("ICCID belongs to another account");
+                }
+                if (!exists) {
+                    sim = new Sim();
+                    sim.setUserId(getUserId());
+                }
+                Map<String, Object> merged = new HashMap<>();
+                if (exists) {
+                    merged.put("phone", sim.getPhone());
+                    merged.put("carrier", sim.getCarrier());
+                    merged.put("apn", sim.getApn());
+                    merged.put("planName", sim.getPlanName());
+                    merged.put("dataLimitMb", sim.getDataLimitMb());
+                    merged.put("monthlyCost", sim.getMonthlyCost());
+                    merged.put("deviceId", sim.getDeviceId());
+                    merged.put("status", sim.getStatus());
+                }
+                merged.putAll(row);
+                Object imei = row.get("imei");
+                if (imei != null) {
+                    Device device = byImei.get(String.valueOf(imei));
+                    if (device == null) {
+                        throw new IllegalArgumentException("Unknown IMEI " + imei);
+                    }
+                    merged.put("deviceId", device.getId());
+                    if (row.get("status") == null && (!exists || INVENTORY.equals(sim.getStatus()))) {
+                        merged.put("status", ACTIVE);
+                    }
+                }
+                read(sim, merged, devices);
+                if (row.containsKey("usageMb")) {
+                    sim.setUsageDate(new Date());
+                }
+                save(sim, devices);
+                if (exists) {
+                    updated += 1;
+                } else {
+                    created += 1;
+                }
+            } catch (RuntimeException | StorageException e) {
+                errors.add("Line " + (i + 1) + ": " + e.getMessage());
+            }
+        }
+        return Map.of("created", created, "updated", updated, "errors", errors);
+    }
+
+    /**
+     * Data usage reported by the carrier (portal export or a script calling its API): [{iccid, usageMb}].
+     */
+    @POST
+    @Path("usage")
+    public Map<String, Object> usage(List<Map<String, Object>> body) throws Exception {
+        FleetUtil.checkWritable(permissionsService, getUserId());
+        Set<Long> owners = visibleOwners();
+        int updated = 0;
+        List<String> unknown = new ArrayList<>();
+        for (Map<String, Object> item : body) {
+            String iccid = text(item.get("iccid"));
+            Sim sim = iccid != null ? byIccid(iccid.replaceAll("[^0-9A-Za-z]", "")) : null;
+            if (sim == null || owners != null && !owners.contains(sim.getUserId())) {
+                unknown.add(iccid);
+                continue;
+            }
+            sim.setUsageMb(Math.max(0, number(item.get("usageMb"))));
+            sim.setUsageDate(new Date());
+            storage.updateObject(sim, new Request(
+                    new Columns.Include("usageMb", "usageDate"), new Condition.Equals("id", sim.getId())));
+            updated += 1;
+        }
+        return Map.of("updated", updated, "unknown", unknown);
+    }
+
+    private Map<String, Object> summarize(Collection<Sim> sims, Map<Long, Device> devices) throws StorageException {
+        long now = System.currentTimeMillis();
+        double hours = silentHours();
+        Map<String, Integer> counts = new LinkedHashMap<>();
+        STATUSES.forEach(status -> counts.put(status, 0));
+        int silent = 0;
+        int overLimit = 0;
+        int assigned = 0;
+        int online = 0;
+        double cost = 0;
+        Set<Long> withSim = new HashSet<>();
+        for (Sim sim : sims) {
+            counts.merge(sim.getStatus() != null ? sim.getStatus() : INVENTORY, 1, Integer::sum);
+            if (sim.getDataLimitMb() > 0 && sim.getUsageMb() >= sim.getDataLimitMb()) {
+                overLimit += 1;
+            }
+            if (ACTIVE.equals(sim.getStatus())) {
+                cost += sim.getMonthlyCost();
+                if (sim.getDeviceId() > 0) {
+                    assigned += 1;
+                    withSim.add(sim.getDeviceId());
+                    if (reporting(devices.get(sim.getDeviceId()), now, 24)) {
+                        online += 1;
+                    }
+                    if (!reporting(devices.get(sim.getDeviceId()), now, hours)) {
+                        silent += 1;
+                    }
+                }
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>(counts);
+        result.put("total", sims.size());
+        result.put("silent", silent);
+        result.put("overLimit", overLimit);
+        result.put("availability", assigned > 0 ? Math.round(online * 1000.0 / assigned) / 10.0 : null);
+        result.put("monthlyCost", Math.round(cost * 100) / 100.0);
+        result.put("devicesWithoutSim", devices.keySet().stream().filter(id -> !withSim.contains(id)).count());
+        return result;
+    }
+
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary() throws StorageException {
+        return summarize(visibleSims(), visibleDevices());
+    }
+
+    /**
+     * Figures for the login page, only when the administrator enables them (server attribute loginLiveStats):
+     * active SIMs, availability of the last 24 hours and client accounts (accounts with a plan).
+     */
+    @GET
+    @PermitAll
+    @Path("public")
+    public Map<String, Object> publicStats() throws StorageException {
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        if (!server.getBoolean("loginLiveStats")) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        Map<Long, Device> devices = new HashMap<>();
+        for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+            devices.put(device.getId(), device);
+        }
+        Map<String, Object> summary = summarize(
+                storage.getObjects(Sim.class, new Request(new Columns.All())), devices);
+        long clients = storage.getObjects(User.class, new Request(new Columns.All())).stream()
+                .filter(user -> !user.getAdministrator() && !user.getDisabled() && user.getString("plan") != null)
+                .count();
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("activeSims", summary.get(ACTIVE));
+        result.put("availability", summary.get("availability"));
+        result.put("clients", clients);
+        result.put("devices", devices.size());
+        return result;
+    }
+
+}
