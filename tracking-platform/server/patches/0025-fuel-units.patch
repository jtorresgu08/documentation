+package org.traccar.sensor;
+
+import org.traccar.model.Device;
+import org.traccar.model.ExtendedModel;
+
+/**
+ * Fuel volume unit of a vehicle: liters (default) or US gallons ({@code fuelUnit} device attribute). Fuel sensors,
+ * tank capacity and fuel expenses of the vehicle are entered in its unit; fleet totals are normalized to liters.
+ */
+public final class FuelUnits {
+
+    public static final String ATTRIBUTE = "fuelUnit";
+    public static final String LITERS = "L";
+    public static final String GALLONS = "gal";
+    public static final double LITERS_PER_GALLON = 3.785411784;
+
+    private FuelUnits() {
+    }
+
+    public static String normalize(String unit) {
+        if (unit == null) {
+            return LITERS;
+        }
+        String value = unit.trim().toLowerCase();
+        return value.startsWith("gal") || value.equals("usgal") ? GALLONS : LITERS;
+    }
+
+    public static String of(Device device) {
+        return normalize(device != null ? device.getString(ATTRIBUTE) : null);
+    }
+
+    public static String of(ExtendedModel model, Device fallback) {
+        String unit = model.getString(ATTRIBUTE);
+        return unit != null ? normalize(unit) : of(fallback);
+    }
+
+    public static double toLiters(double value, String unit) {
+        return GALLONS.equals(normalize(unit)) ? value * LITERS_PER_GALLON : value;
+    }
+
+    public static double fromLiters(double value, String unit) {
+        return GALLONS.equals(normalize(unit)) ? value / LITERS_PER_GALLON : value;
+    }
+
+}
