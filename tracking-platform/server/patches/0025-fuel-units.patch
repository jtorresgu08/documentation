+package org.traccar.sensor;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Device;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class FuelUnitsTest {
+
+    @Test
+    public void testUnits() {
+        Device device = new Device();
+        assertEquals("L", FuelUnits.of(device));
+        device.set(FuelUnits.ATTRIBUTE, "Galones");
+        assertEquals("gal", FuelUnits.of(device));
+        assertEquals(37.854, FuelUnits.toLiters(10, "gal"), 0.001);
+        assertEquals(10, FuelUnits.fromLiters(37.85411784, "gal"), 0.0001);
+        assertEquals(12.5, FuelUnits.toLiters(12.5, "L"), 0.0001);
+    }
+
+}
