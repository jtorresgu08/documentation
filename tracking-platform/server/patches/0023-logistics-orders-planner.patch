+package org.traccar.dispatch;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Route planning for several vehicles: every order is inserted where it adds the least distance in a route that
+ * stays feasible (vehicle weight, volume and stop limits, customer time windows with waiting, service time, driver
+ * shift and return to the depot); higher priorities and earlier windows go first, then each route is improved with
+ * 2-opt. Orders that fit nowhere are reported with the reason.
+ */
+public final class DispatchPlanner {
+
+    public static final double ROAD_FACTOR = 1.3;
+
+    public static final String REASON_CAPACITY = "capacity";
+    public static final String REASON_STOPS = "maxStops";
+    public static final String REASON_WINDOW = "window";
+    public static final String REASON_SHIFT = "shift";
+    public static final String REASON_NO_VEHICLES = "noVehicles";
+
+    /** windows and times in epoch milliseconds, null when free; weight in kg and volume in m3 */
+    public record Job(
+            long id, double latitude, double longitude, Long windowStart, Long windowEnd, int serviceMinutes,
+            int priority, double weight, double volume) {
+    }
+
+    /** capacities and maximum stops of 0 mean unlimited */
+    public record Vehicle(
+            long id, double startLatitude, double startLongitude, double endLatitude, double endLongitude,
+            boolean returnToEnd, long shiftStart, long shiftEnd, double capacityWeight, double capacityVolume,
+            int maxStops) {
+    }
+
+    public record Visit(long jobId, long arrival, long start, long departure) {
+    }
+
+    public record Route(
+            long vehicleId, List<Visit> visits, double distance, long start, long end, double weight, double volume) {
+    }
+
+    public record Result(List<Route> routes, Map<Long, String> unassigned) {
+    }
+
+    private record Schedule(List<Visit> visits, double distance, long end) {
+    }
+
+    private final double speed;
+
+    /**
+     * @param speedKmh average speed between stops
+     */
+    public DispatchPlanner(double speedKmh) {
+        this.speed = Math.max(speedKmh, 5) / 3.6;
+    }
+
+    private static double meters(double lat1, double lon1, double lat2, double lon2) {
+        return DispatchService.distance(lat1, lon1, lat2, lon2) * ROAD_FACTOR;
+    }
+
+    private Schedule simulate(Vehicle vehicle, List<Job> jobs) {
+        long time = vehicle.shiftStart();
+        double latitude = vehicle.startLatitude();
+        double longitude = vehicle.startLongitude();
+        double distance = 0;
+        List<Visit> visits = new ArrayList<>();
+        for (Job job : jobs) {
+            double leg = meters(latitude, longitude, job.latitude(), job.longitude());
+            distance += leg;
+            time += (long) (leg / speed * 1000);
+            long arrival = time;
+            if (job.windowStart() != null && time < job.windowStart()) {
+                time = job.windowStart();
+            }
+            if (job.windowEnd() != null && time > job.windowEnd()) {
+                return null;
+            }
+            long start = time;
+            time += job.serviceMinutes() * 60_000L;
+            visits.add(new Visit(job.id(), arrival, start, time));
+            latitude = job.latitude();
+            longitude = job.longitude();
+        }
+        if (vehicle.returnToEnd()) {
+            double leg = meters(latitude, longitude, vehicle.endLatitude(), vehicle.endLongitude());
+            distance += leg;
+            time += (long) (leg / speed * 1000);
+        }
+        if (time > vehicle.shiftEnd()) {
+            return null;
+        }
+        return new Schedule(visits, distance, time);
+    }
+
+    private static double load(List<Job> jobs, boolean volume) {
+        return jobs.stream().mapToDouble(job -> volume ? job.volume() : job.weight()).sum();
+    }
+
+    private static String capacityProblem(Vehicle vehicle, List<Job> jobs, Job job) {
+        if (vehicle.capacityWeight() > 0 && load(jobs, false) + job.weight() > vehicle.capacityWeight()
+                || vehicle.capacityVolume() > 0 && load(jobs, true) + job.volume() > vehicle.capacityVolume()) {
+            return REASON_CAPACITY;
+        }
+        if (vehicle.maxStops() > 0 && jobs.size() >= vehicle.maxStops()) {
+            return REASON_STOPS;
+        }
+        return null;
+    }
+
+    public Result plan(List<Job> jobs, List<Vehicle> vehicles) {
+        Map<Long, List<Job>> sequences = new LinkedHashMap<>();
+        Map<Long, Schedule> schedules = new HashMap<>();
+        for (Vehicle vehicle : vehicles) {
+            sequences.put(vehicle.id(), new ArrayList<>());
+            schedules.put(vehicle.id(), simulate(vehicle, List.of()));
+        }
+        Map<Long, String> unassigned = new LinkedHashMap<>();
+        List<Job> ordered = new ArrayList<>(jobs);
+        ordered.sort(Comparator.comparing((Job job) -> -job.priority())
+                .thenComparing(job -> job.windowEnd() != null ? job.windowEnd() : Long.MAX_VALUE));
+        for (Job job : ordered) {
+            if (vehicles.isEmpty()) {
+                unassigned.put(job.id(), REASON_NO_VEHICLES);
+                continue;
+            }
+            Vehicle bestVehicle = null;
+            List<Job> bestSequence = null;
+            Schedule bestSchedule = null;
+            double bestCost = Double.MAX_VALUE;
+            String reason = null;
+            for (Vehicle vehicle : vehicles) {
+                List<Job> sequence = sequences.get(vehicle.id());
+                String problem = capacityProblem(vehicle, sequence, job);
+                if (problem != null) {
+                    reason = reason == null ? problem : reason;
+                    continue;
+                }
+                Schedule current = schedules.get(vehicle.id());
+                double base = current != null ? current.distance() : 0;
+                boolean fitted = false;
+                for (int position = 0; position <= sequence.size(); position++) {
+                    List<Job> candidate = new ArrayList<>(sequence);
+                    candidate.add(position, job);
+                    Schedule schedule = simulate(vehicle, candidate);
+                    if (schedule == null) {
+                        continue;
+                    }
+                    fitted = true;
+                    double cost = schedule.distance() - base;
+                    if (cost < bestCost) {
+                        bestCost = cost;
+                        bestVehicle = vehicle;
+                        bestSequence = candidate;
+                        bestSchedule = schedule;
+                    }
+                }
+                if (!fitted) {
+                    Schedule alone = simulate(vehicle, List.of(job));
+                    reason = alone == null && job.windowEnd() != null ? REASON_WINDOW : REASON_SHIFT;
+                }
+            }
+            if (bestVehicle == null) {
+                unassigned.put(job.id(), reason != null ? reason : REASON_SHIFT);
+            } else {
+                sequences.put(bestVehicle.id(), bestSequence);
+                schedules.put(bestVehicle.id(), bestSchedule);
+            }
+        }
+        List<Route> routes = new ArrayList<>();
+        for (Vehicle vehicle : vehicles) {
+            List<Job> sequence = improve(vehicle, sequences.get(vehicle.id()));
+            Schedule schedule = simulate(vehicle, sequence);
+            if (sequence.isEmpty() || schedule == null) {
+                continue;
+            }
+            routes.add(new Route(vehicle.id(), schedule.visits(), schedule.distance(), vehicle.shiftStart(),
+                    schedule.end(), load(sequence, false), load(sequence, true)));
+        }
+        return new Result(routes, unassigned);
+    }
+
+    private List<Job> improve(Vehicle vehicle, List<Job> sequence) {
+        List<Job> best = sequence;
+        Schedule bestSchedule = simulate(vehicle, best);
+        if (bestSchedule == null || best.size() < 3) {
+            return best;
+        }
+        boolean improved = true;
+        while (improved) {
+            improved = false;
+            for (int i = 0; i < best.size() - 1; i++) {
+                for (int j = i + 1; j < best.size(); j++) {
+                    List<Job> candidate = new ArrayList<>(best.subList(0, i));
+                    List<Job> middle = new ArrayList<>(best.subList(i, j + 1));
+                    java.util.Collections.reverse(middle);
+                    candidate.addAll(middle);
+                    candidate.addAll(best.subList(j + 1, best.size()));
+                    Schedule schedule = simulate(vehicle, candidate);
+                    if (schedule != null && schedule.distance() + 1 < bestSchedule.distance()) {
+                        best = candidate;
+                        bestSchedule = schedule;
+                        improved = true;
+                    }
+                }
+            }
+        }
+        return best;
+    }
+
+}
