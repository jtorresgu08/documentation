+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Geofence geofence : geofences) {
+            double[] center;
+            try {
+                center = center(geofence.getArea());
+            } catch (RuntimeException e) {
+                center = null;
+            }
+            if (center != null) {
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("id", geofence.getId());
+                item.put("name", geofence.getName());
+                item.put("latitude", center[0]);
+                item.put("longitude", center[1]);
+                item.put("depot", geofence.getBoolean("dispatchDepot"));
+                result.add(item);
+            }
+        }
+        result.sort(Comparator.comparing((Map<String, Object> item) -> !(Boolean) item.get("depot"))
+                .thenComparing(item -> String.valueOf(item.get("name"))));
