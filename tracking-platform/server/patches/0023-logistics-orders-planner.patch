+    private static double[] center(String area) {
+        if (area == null) {
+            return null;
+        }
+        String numbers = area.replaceAll("[A-Za-z()]", " ");
+        if (area.trim().toUpperCase().startsWith("CIRCLE")) {
+            String[] parts = numbers.trim().split("[\\s,]+");
+            return new double[] {Double.parseDouble(parts[0]), Double.parseDouble(parts[1])};
+        }
+        double latitude = 0;
+        double longitude = 0;
+        int count = 0;
+        for (String pair : numbers.split(",")) {
+            String[] parts = pair.trim().split("\\s+");
+            if (parts.length >= 2) {
+                latitude += Double.parseDouble(parts[0]);
+                longitude += Double.parseDouble(parts[1]);
+                count++;
+            }
+        }
+        return count > 0 ? new double[] {latitude / count, longitude / count} : null;
+    }
