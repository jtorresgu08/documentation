+    public DispatchOrder updateOrder(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkWritable();
+        DispatchOrder order = checkOrder(id);
+        if (!DispatchOrder.UNASSIGNED.equals(order.getStatus())) {
+            throw new IllegalArgumentException("Only orders in the pool can be edited");
+        }
+        DispatchOrder changes = readOrder(body);
+        changes.setId(order.getId());
+        changes.setUserId(order.getUserId());
+        changes.setStatus(order.getStatus());
+        changes.setCreated(order.getCreated());
+        storage.updateObject(changes, new Request(new Columns.Exclude("id"), new Condition.Equals("id", id)));
+        return changes;
+    }
