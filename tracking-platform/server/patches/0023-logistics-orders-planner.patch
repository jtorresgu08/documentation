+        checkWritable();
+        List<?> items = body instanceof List<?> list ? list : List.of(body);
+        List<DispatchOrder> orders = new ArrayList<>();
+        for (Object item : items) {
+            orders.add(readOrder(item));
+        }
+        for (DispatchOrder order : orders) {
+            order.setUserId(getUserId());
+            order.setStatus(DispatchOrder.UNASSIGNED);
+            order.setCreated(new Date());
+            if (order.getPlannedDate() == null) {
+                order.setPlannedDate(new Date());
+            }
+            order.setId(storage.addObject(order, new Request(new Columns.Exclude("id"))));
+        }
+        return orders;
+    }
