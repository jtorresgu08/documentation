+package org.traccar.dispatch;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class DispatchPlannerTest {
+
+    private static final long HOUR = 3_600_000L;
+
+    private static DispatchPlanner.Vehicle vehicle(long id, double capacity) {
+        return new DispatchPlanner.Vehicle(id, -12.05, -77.12, -12.05, -77.12, true, 8 * HOUR, 18 * HOUR,
+                capacity, 0, 0);
+    }
+
+    private static DispatchPlanner.Job job(long id, double lat, double lon, double weight, Long from, Long to) {
+        return new DispatchPlanner.Job(id, lat, lon, from, to, 10, 0, weight, 0);
+    }
+
+    @Test
+    public void testCapacitySplitsRoutes() {
+        List<DispatchPlanner.Job> jobs = new ArrayList<>();
+        for (int i = 0; i < 6; i++) {
+            jobs.add(job(i + 1, -12.06 - i * 0.01, -77.10 + i * 0.01, 100, null, null));
+        }
+        var result = new DispatchPlanner(30).plan(jobs, List.of(vehicle(1, 300), vehicle(2, 300)));
+        assertTrue(result.unassigned().isEmpty());
+        assertEquals(2, result.routes().size());
+        result.routes().forEach(route -> assertTrue(route.weight() <= 300));
+        assertEquals(6, result.routes().stream().mapToInt(route -> route.visits().size()).sum());
+    }
+
+    @Test
+    public void testUnassignedReasons() {
+        var jobs = List.of(
+                job(1, -12.06, -77.10, 500, null, null),
+                job(2, -12.07, -77.09, 10, 8 * HOUR, 8 * HOUR + 60_000L),
+                job(3, -12.08, -77.08, 10, null, null));
+        var result = new DispatchPlanner(30).plan(jobs, List.of(vehicle(1, 300)));
+        assertEquals(DispatchPlanner.REASON_CAPACITY, result.unassigned().get(1L));
+        assertEquals(DispatchPlanner.REASON_WINDOW, result.unassigned().get(2L));
+        assertEquals(1, result.routes().get(0).visits().size());
+    }
+
+    @Test
+    public void testTimeWindowsOrder() {
+        var jobs = List.of(
+                job(1, -12.06, -77.10, 0, 15 * HOUR, 17 * HOUR),
+                job(2, -12.20, -76.90, 0, 9 * HOUR, 11 * HOUR));
+        var route = new DispatchPlanner(30).plan(jobs, List.of(vehicle(1, 0))).routes().get(0);
+        assertEquals(2L, route.visits().get(0).jobId());
+        assertTrue(route.visits().get(1).start() >= 15 * HOUR);
+    }
+
+}
