+    // ---------- orders and planning ----------
+
+    private Set<Long> visibleOwners() throws StorageException {
+        if (!permissionsService.notAdmin(getUserId())) {
+            return null;
+        }
+        Set<Long> owners = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        owners.add(getUserId());
+        return owners;
+    }
+
+    private List<DispatchOrder> visibleOrders(Date from, Date to, String status) throws StorageException {
+        Set<Long> owners = visibleOwners();
+        List<DispatchOrder> result = new ArrayList<>();
+        for (DispatchOrder order : storage.getObjects(DispatchOrder.class, new Request(new Columns.All()))) {
+            if (owners != null && !owners.contains(order.getUserId())
+                    || status != null && !status.isEmpty() && !status.equals(order.getStatus())) {
+                continue;
+            }
+            Date date = order.getPlannedDate();
+            boolean open = DispatchOrder.UNASSIGNED.equals(order.getStatus());
+            if (date != null && (from != null && date.before(from) || to != null && date.after(to))
+                    && !(open && date.before(new Date()))) {
+                continue;
+            }
+            result.add(order);
+        }
+        result.sort(Comparator.comparing((DispatchOrder order) -> -order.getPriority())
+                .thenComparing(order -> order.getWindowEnd() != null
+                        ? order.getWindowEnd().getTime() : Long.MAX_VALUE));
+        return result;
+    }
+
+    private DispatchOrder checkOrder(long id) throws StorageException {
+        DispatchOrder order = storage.getObject(DispatchOrder.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        Set<Long> owners = visibleOwners();
+        if (order == null || owners != null && !owners.contains(order.getUserId())) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return order;
+    }
+
+    private DispatchOrder readOrder(Object value) {
+        Map<String, Object> copy = lenient().convertValue(value, new TypeReference<Map<String, Object>>() { });
+        for (String key : List.of("id", "userId", "status", "tripId", "stopId", "created")) {
+            copy.remove(key);
+        }
+        DispatchOrder order = lenient().convertValue(copy, DispatchOrder.class);
+        if (order.getName() == null || order.getName().isBlank() || Math.abs(order.getLatitude()) > 90
+                || Math.abs(order.getLongitude()) > 180 || order.getLatitude() == 0 && order.getLongitude() == 0) {
+            throw new IllegalArgumentException("Every order needs a name and valid coordinates");
+        }
+        if (order.getType() == null || !List.of(DispatchOrder.DELIVERY, DispatchOrder.PICKUP, DispatchOrder.SERVICE)
+                .contains(order.getType())) {
+            order.setType(DispatchOrder.DELIVERY);
+        }
+        if (order.getServiceMinutes() <= 0) {
+            order.setServiceMinutes(order.getType().equals(DispatchOrder.SERVICE) ? 30 : 10);
+        }
+        return order;
+    }
+
