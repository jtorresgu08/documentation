+package org.traccar.geofence;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Turns a road route into a line geofence that fits the geofence area column: Douglas-Peucker simplification in
+ * meters, raising the tolerance until the WKT (latitude longitude, 5 decimals, about 1 m) is short enough.
+ */
+public final class RouteSimplifier {
+
+    public static final int MAX_AREA = 4000;
+
+    private RouteSimplifier() {
+    }
+
+    private static double[] project(double[] point, double latitude) {
+        return new double[] {point[0] * 111320 * Math.cos(Math.toRadians(latitude)), point[1] * 110540};
+    }
+
+    private static double distance(double[] point, double[] start, double[] end) {
+        double dx = end[0] - start[0];
+        double dy = end[1] - start[1];
+        double length = dx * dx + dy * dy;
+        double k = length > 0
+                ? Math.max(0, Math.min(1, ((point[0] - start[0]) * dx + (point[1] - start[1]) * dy) / length)) : 0;
+        return Math.hypot(point[0] - (start[0] + k * dx), point[1] - (start[1] + k * dy));
+    }
+
+    private static void simplify(List<double[]> xy, int first, int last, double tolerance, boolean[] keep) {
+        double max = 0;
+        int index = -1;
+        for (int i = first + 1; i < last; i++) {
+            double value = distance(xy.get(i), xy.get(first), xy.get(last));
+            if (value > max) {
+                max = value;
+                index = i;
+            }
+        }
+        if (index >= 0 && max > tolerance) {
+            keep[index] = true;
+            simplify(xy, first, index, tolerance, keep);
+            simplify(xy, index, last, tolerance, keep);
+        }
+    }
+
+    /** Points [longitude, latitude] simplified with the tolerance in meters. */
+    public static List<double[]> simplify(List<double[]> points, double tolerance) {
+        if (points.size() < 3) {
+            return points;
+        }
+        double latitude = points.get(0)[1];
+        List<double[]> xy = points.stream().map(point -> project(point, latitude)).toList();
+        boolean[] keep = new boolean[points.size()];
+        keep[0] = true;
+        keep[points.size() - 1] = true;
+        simplify(xy, 0, points.size() - 1, tolerance, keep);
+        List<double[]> result = new ArrayList<>();
+        for (int i = 0; i < points.size(); i++) {
+            if (keep[i]) {
+                result.add(points.get(i));
+            }
+        }
+        return result;
+    }
+
+    public static String wkt(List<double[]> points) {
+        StringBuilder text = new StringBuilder("LINESTRING (");
+        for (int i = 0; i < points.size(); i++) {
+            if (i > 0) {
+                text.append(", ");
+            }
+            text.append(String.format(Locale.ROOT, "%.5f %.5f", points.get(i)[1], points.get(i)[0]));
+        }
+        return text.append(")").toString();
+    }
+
+    /** Simplest version of the route that fits the area column, starting at 2 m of tolerance. */
+    public static List<double[]> fit(List<double[]> points) {
+        double tolerance = 2;
+        List<double[]> result = simplify(points, tolerance);
+        while (wkt(result).length() > MAX_AREA && tolerance < 100000) {
+            tolerance *= 1.5;
+            result = simplify(points, tolerance);
+        }
+        return result;
+    }
+
+}
