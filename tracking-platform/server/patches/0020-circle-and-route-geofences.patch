+package org.traccar.geofence;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class RouteSimplifierTest {
+
+    @Test
+    public void testSimplifyKeepsCorners() {
+        List<double[]> points = new ArrayList<>();
+        for (int i = 0; i <= 10; i++) {
+            points.add(new double[] {-77.0 + i * 0.001, -12.0});
+        }
+        for (int i = 1; i <= 10; i++) {
+            points.add(new double[] {-76.99, -12.0 + i * 0.001});
+        }
+        List<double[]> simplified = RouteSimplifier.simplify(points, 2);
+        assertEquals(3, simplified.size());
+        assertEquals("LINESTRING (-12.00000 -77.00000, -12.00000 -76.99000, -11.99000 -76.99000)",
+                RouteSimplifier.wkt(simplified));
+    }
+
+    @Test
+    public void testFitLongRoute() {
+        List<double[]> points = new ArrayList<>();
+        for (int i = 0; i < 5000; i++) {
+            points.add(new double[] {-77.0 + i * 0.0002, -12.0 + Math.sin(i / 20.0) * 0.002});
+        }
+        List<double[]> fitted = RouteSimplifier.fit(points);
+        assertTrue(RouteSimplifier.wkt(fitted).length() <= RouteSimplifier.MAX_AREA);
+        assertTrue(fitted.size() > 50);
+        assertEquals(points.get(0), fitted.get(0));
+        assertEquals(points.get(points.size() - 1), fitted.get(fitted.size() - 1));
+    }
+
+}
