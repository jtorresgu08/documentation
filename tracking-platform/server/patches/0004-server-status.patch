+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.BaseProtocol;
+import org.traccar.ServerManager;
+import org.traccar.TrackerConnector;
+import org.traccar.TrackerServer;
+import org.traccar.api.BaseResource;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.model.Device;
+import org.traccar.model.Server;
+import org.traccar.session.ConnectionManager;
+import org.traccar.session.ProtocolStatistics;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Request;
+
+import java.io.File;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Server health for administrators: JVM, database, disk, connected devices and the state of every listening port.
+ */
+@Path("system")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SystemResource extends BaseResource {
+
+    @Inject
+    private ServerManager serverManager;
+
+    @Inject
+    private ConnectionManager connectionManager;
+
+    @Inject
+    private Config config;
+
+    private static Map<String, Object> messages(ProtocolStatistics.Counter counter, long now) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("total", counter != null ? counter.getTotal() : 0);
+        result.put("lastMinute", counter != null ? counter.getRecent(1, now) : 0);
+        result.put("last5Minutes", counter != null ? counter.getRecent(5, now) : 0);
+        result.put("lastHour", counter != null ? counter.getRecent(60, now) : 0);
+        result.put("lastTime", counter != null && counter.getLastTime() > 0 ? counter.getLastTime() : null);
+        return result;
+    }
+
+    @GET
+    @Path("status")
+    public Map<String, Object> status() throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        long now = System.currentTimeMillis();
+        Map<String, Object> result = new LinkedHashMap<>();
+
+        long started = System.nanoTime();
+        Server server = storage.getObject(Server.class, new Request(new Columns.All()));
+        Map<String, Object> database = new LinkedHashMap<>();
+        database.put("ok", server != null);
+        database.put("latencyMs", (System.nanoTime() - started) / 1_000_000.0);
+        database.put("driver", config.getString(Keys.DATABASE_DRIVER));
+        result.put("database", database);
+        result.put("version", server != null ? server.getVersion() : null);
+        result.put("time", now);
+
+        Runtime runtime = Runtime.getRuntime();
+        Map<String, Object> jvm = new LinkedHashMap<>();
+        jvm.put("uptime", ManagementFactory.getRuntimeMXBean().getUptime());
+        jvm.put("memoryUsed", runtime.totalMemory() - runtime.freeMemory());
+        jvm.put("memoryMax", runtime.maxMemory());
+        jvm.put("processors", runtime.availableProcessors());
+        jvm.put("loadAverage", ManagementFactory.getOperatingSystemMXBean().getSystemLoadAverage());
+        jvm.put("threads", ManagementFactory.getThreadMXBean().getThreadCount());
+        result.put("jvm", jvm);
+
+        String mediaPath = config.getString(Keys.MEDIA_PATH);
+        File disk = new File(mediaPath != null ? mediaPath : ".");
+        if (!disk.exists()) {
+            disk = new File(".");
+        }
+        Map<String, Object> storageInfo = new LinkedHashMap<>();
+        storageInfo.put("free", disk.getUsableSpace());
+        storageInfo.put("total", disk.getTotalSpace());
+        result.put("disk", storageInfo);
+
+        Collection<Device> devices = storage.getObjects(Device.class, new Request(new Columns.Include("uniqueId")));
+        Set<String> known = new HashSet<>();
+        devices.forEach(device -> known.add(device.getUniqueId()));
+        Map<String, Integer> online = connectionManager.getOnlineByProtocol();
+        Map<String, Object> deviceInfo = new LinkedHashMap<>();
+        deviceInfo.put("total", devices.size());
+        deviceInfo.put("connected", online.values().stream().mapToInt(Integer::intValue).sum());
+        result.put("devices", deviceInfo);
+
+        long messagesLastMinute = 0;
+        List<Map<String, Object>> ports = new ArrayList<>();
+        for (BaseProtocol protocol : serverManager.getProtocols()) {
+            ProtocolStatistics.Counter counter = ProtocolStatistics.getCounter(protocol.getName());
+            if (counter != null) {
+                messagesLastMinute += counter.getRecent(1, now);
+            }
+            for (TrackerConnector connector : protocol.getConnectorList()) {
+                if (connector instanceof TrackerServer trackerServer) {
+                    Map<String, Object> port = new LinkedHashMap<>();
+                    port.put("protocol", protocol.getName());
+                    port.put("port", trackerServer.getPort());
+                    port.put("transport", trackerServer.isDatagram() ? "udp" : "tcp");
+                    int channels = trackerServer.getChannelGroup().size();
+                    port.put("listening", channels > 0);
+                    port.put("connections", trackerServer.isDatagram() ? null : Math.max(0, channels - 1));
+                    port.put("devices", online.getOrDefault(protocol.getName(), 0));
+                    port.put("messages", messages(counter, now));
+                    ports.add(port);
+                }
+            }
+        }
+        result.put("messagesLastMinute", messagesLastMinute);
+        result.put("ports", ports);
+
+        List<Map<String, Object>> unknown = new ArrayList<>();
+        for (ProtocolStatistics.UnknownDevice item : ProtocolStatistics.getUnknownDevices()) {
+            if (known.contains(item.uniqueId())) {
+                ProtocolStatistics.removeUnknown(item.uniqueId());
+                continue;
+            }
+            Map<String, Object> entry = new LinkedHashMap<>();
+            entry.put("uniqueId", item.uniqueId());
+            entry.put("protocol", item.protocol());
+            entry.put("port", config.getInteger(Keys.PROTOCOL_PORT.withPrefix(item.protocol())));
+            entry.put("address", item.address());
+            entry.put("firstTime", item.firstTime());
+            entry.put("lastTime", item.lastTime());
+            entry.put("attempts", item.attempts());
+            unknown.add(entry);
+        }
+        result.put("unknownDevices", unknown);
+
+        return result;
+    }
+
+}
