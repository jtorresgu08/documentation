+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.session;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * In memory counters for the server status page: messages per protocol (total and per minute for the last hour)
+ * and identifiers of unknown devices trying to connect.
+ */
+public final class ProtocolStatistics {
+
+    private static final int MINUTES = 60;
+    private static final int MAX_UNKNOWN = 500;
+
+    private ProtocolStatistics() {
+    }
+
+    public static final class Counter {
+        private final AtomicLong total = new AtomicLong();
+        private final long[] minuteStamp = new long[MINUTES];
+        private final long[] minuteCount = new long[MINUTES];
+        private volatile long lastTime;
+
+        private synchronized void record(long now) {
+            total.incrementAndGet();
+            lastTime = now;
+            long minute = now / 60000;
+            int index = (int) (minute % MINUTES);
+            if (minuteStamp[index] != minute) {
+                minuteStamp[index] = minute;
+                minuteCount[index] = 0;
+            }
+            minuteCount[index]++;
+        }
+
+        public long getTotal() {
+            return total.get();
+        }
+
+        public long getLastTime() {
+            return lastTime;
+        }
+
+        /**
+         * Messages received during the last {@code minutes} full minutes, including the current one.
+         */
+        public synchronized long getRecent(int minutes, long now) {
+            long current = now / 60000;
+            long sum = 0;
+            for (int i = 0; i < MINUTES; i++) {
+                if (current - minuteStamp[i] < minutes) {
+                    sum += minuteCount[i];
+                }
+            }
+            return sum;
+        }
+    }
+
+    public record UnknownDevice(String uniqueId, String protocol, String address, long firstTime, long lastTime,
+                                long attempts) {
+    }
+
+    private static final Map<String, Counter> COUNTERS = new ConcurrentHashMap<>();
+    private static final Map<String, UnknownDevice> UNKNOWN = new ConcurrentHashMap<>();
+
+    public static void recordMessage(String protocol) {
+        COUNTERS.computeIfAbsent(protocol, key -> new Counter()).record(System.currentTimeMillis());
+    }
+
+    public static Counter getCounter(String protocol) {
+        return COUNTERS.get(protocol);
+    }
+
+    public static void recordUnknown(String protocol, String uniqueId, String address) {
+        long now = System.currentTimeMillis();
+        UNKNOWN.compute(uniqueId, (key, previous) -> previous == null
+                ? new UnknownDevice(uniqueId, protocol, address, now, now, 1)
+                : new UnknownDevice(uniqueId, protocol, address, previous.firstTime(), now, previous.attempts() + 1));
+        if (UNKNOWN.size() > MAX_UNKNOWN) {
+            UNKNOWN.values().stream()
+                    .min(Comparator.comparingLong(UnknownDevice::lastTime))
+                    .ifPresent(oldest -> UNKNOWN.remove(oldest.uniqueId()));
+        }
+    }
+
+    public static List<UnknownDevice> getUnknownDevices() {
+        List<UnknownDevice> result = new ArrayList<>(UNKNOWN.values());
+        result.sort(Comparator.comparingLong(UnknownDevice::lastTime).reversed());
+        return result;
+    }
+
+    public static void removeUnknown(String uniqueId) {
+        UNKNOWN.remove(uniqueId);
+    }
+
+}
