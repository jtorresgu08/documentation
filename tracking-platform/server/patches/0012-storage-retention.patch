--- /dev/null
+++ b/src/test/java/org/traccar/retention/HistoryCompactorTest.java
@@ -0,0 +1,72 @@
+package org.traccar.retention;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class HistoryCompactorTest {
+
+    private final List<Position> positions = new ArrayList<>();
+    private long time = 1_700_000_000_000L;
+    private double latitude = -12;
+
+    private Position add(double speed, double course, boolean ignition) {
+        Position position = new Position();
+        position.setId(positions.size() + 1);
+        position.setTime(new Date(time));
+        time += 1000;
+        latitude += speed / 3.6 / 111320;
+        position.setLatitude(latitude);
+        position.setLongitude(-77);
+        position.setSpeed(UnitsConverter.knotsFromKph(speed));
+        position.setCourse(course);
+        position.set(Position.KEY_IGNITION, ignition);
+        positions.add(position);
+        return position;
+    }
+
+    @Test
+    public void testThinning() {
+        for (int i = 0; i < 600; i++) {
+            add(50, 0, true); // 10 min straight at 1 s
+        }
+        Position turn = add(50, 90, true);
+        for (int i = 0; i < 3600; i++) {
+            add(0, 90, false); // 1 h parked
+        }
+        Position alarm = add(0, 90, false);
+        alarm.set(Position.KEY_ALARM, Position.ALARM_SOS);
+        for (int i = 0; i < 60; i++) {
+            add(0, 90, false);
+        }
+        Set<Long> protectedIds = new HashSet<>(Set.of(5L));
+
+        List<Long> removed = HistoryCompactor.redundant(positions, protectedIds, 30_000);
+        Set<Long> removedSet = new HashSet<>(removed);
+        int kept = positions.size() - removed.size();
+
+        assertTrue(kept < 50, "kept " + kept); // from 4262 points
+        assertFalse(removedSet.contains(1L)); // first
+        assertFalse(removedSet.contains(5L)); // protected (event)
+        assertFalse(removedSet.contains(35L)); // 30 s after the protected point
+        assertTrue(removedSet.contains(10L));
+        assertFalse(removedSet.contains(turn.getId())); // turn
+        assertFalse(removedSet.contains(turn.getId() + 1)); // ignition off, stop starts
+        assertFalse(removedSet.contains(alarm.getId()));
+        assertFalse(removedSet.contains((long) positions.size())); // last
+        // parked: one point every half hour
+        assertFalse(removedSet.contains(turn.getId() + 1 + 1800));
+        assertEquals(0, HistoryCompactor.redundant(List.of(positions.get(0)), Set.of(), 30_000).size());
+    }
+
+}
