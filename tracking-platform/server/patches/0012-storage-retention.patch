+ * limitations under the License.
+ */
+package org.traccar.retention;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import javax.imageio.IIOImage;
+import javax.imageio.ImageIO;
+import javax.imageio.ImageWriteParam;
+import javax.imageio.ImageWriter;
+import javax.imageio.stream.ImageOutputStream;
+import javax.sql.DataSource;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Timestamp;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.stream.Stream;
+
+/**
+ * Keeps the server storage bounded: deletes history older than retention.days, thins old positions, recompresses
+ * photos and videos and overwrites the oldest media when the media folder reaches its size limit. Runs every night
+ * (TaskStorageRetention) or on demand from the status page.
+ */
+@Singleton
+public class StorageRetention {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(StorageRetention.class);
+
+    private static final long DAY = 24L * 3600 * 1000;
+    private static final int MAX_COMPACT_DAYS_PER_RUN = 62;
+    private static final long MEDIA_BUDGET = 2 * 3600 * 1000L;
+    private static final long MIN_COMPRESS_SIZE = 50 * 1024;
+    private static final int MAX_IMAGE_WIDTH = 1280;
+    private static final String STATE_FILE = ".retention-state";
+    private static final String COMPRESSED_FILE = ".retention-compressed";
+
+    private final Config config;
+    private final Storage storage;
+    private final DataSource dataSource;
+
+    private volatile Map<String, Object> lastReport;
+    private volatile boolean running;
+
+    @Inject
+    public StorageRetention(Config config, Storage storage, DataSource dataSource) {
+        this.config = config;
+        this.storage = storage;
+        this.dataSource = dataSource;
+    }
+
+    public Map<String, Object> getLastReport() {
+        return lastReport;
+    }
+
+    public boolean isRunning() {
+        return running;
+    }
+
+    public Map<String, Object> getSettings() {
+        Map<String, Object> settings = new LinkedHashMap<>();
+        settings.put("days", config.getInteger(Keys.RETENTION_DAYS));
+        settings.put("compactDays", config.getInteger(Keys.RETENTION_COMPACT_DAYS));
+        settings.put("compactInterval", config.getInteger(Keys.RETENTION_COMPACT_INTERVAL));
+        settings.put("mediaCompressDays", config.getInteger(Keys.RETENTION_MEDIA_COMPRESS_DAYS));
+        settings.put("mediaMaxSize", config.getDouble(Keys.RETENTION_MEDIA_MAX_SIZE));
+        settings.put("hour", config.getInteger(Keys.RETENTION_HOUR));
+        settings.put("nextRun", nextRun(config.getInteger(Keys.RETENTION_HOUR)));
+        return settings;
+    }
+
+    /**
+     * Next occurrence of the configured hour in the server time zone (epoch ms), so clients show it in local time.
+     */
+    public static long nextRun(int hour) {
+        ZonedDateTime now = ZonedDateTime.now(ZoneId.systemDefault());
+        ZonedDateTime next = now.withHour(Math.max(0, Math.min(23, hour))).withMinute(0).withSecond(0).withNano(0);
+        if (!next.isAfter(now)) {
+            next = next.plusDays(1);
+        }
+        return next.toInstant().toEpochMilli();
+    }
+
+    private Path statePath(String name) {
+        String media = config.getString(Keys.MEDIA_PATH);
+        return Path.of(media != null ? media : "data").resolve(name);
+    }
+
+    private long readCompactedUntil() {
+        try {
+            Path path = statePath(STATE_FILE);
+            return Files.exists(path) ? Long.parseLong(Files.readString(path).trim()) : 0;
+        } catch (IOException | NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private void writeCompactedUntil(long time) throws IOException {
+        Path path = statePath(STATE_FILE);
+        Files.createDirectories(path.getParent());
+        Files.writeString(path, String.valueOf(time));
+    }
+
+    public synchronized Map<String, Object> run() {
+        running = true;
+        long started = System.currentTimeMillis();
+        Map<String, Object> report = new LinkedHashMap<>();
+        report.put("start", started);
+        try {
+            int days = config.getInteger(Keys.RETENTION_DAYS);
+            Collection<Device> devices = storage.getObjects(Device.class, new Request(new Columns.All()));
+            if (days > 0) {
+                deleteHistory(devices, started - days * DAY, report);
+            }
+            int compactDays = config.getInteger(Keys.RETENTION_COMPACT_DAYS);
+            if (compactDays > 0) {
+                compactHistory(devices, started - compactDays * DAY, days > 0 ? started - days * DAY : 0, report);
+            }
+            processMedia(started, report);
+        } catch (Exception e) {
+            LOGGER.warn("Storage retention failed", e);
+            report.put("error", e.getMessage());
+        } finally {
+            report.put("duration", System.currentTimeMillis() - started);
+            lastReport = report;
+            running = false;
+        }
+        LOGGER.info("Storage retention: {}", report);
+        return report;
+    }
+
+    private void deleteHistory(Collection<Device> devices, long cutoff, Map<String, Object> report)
+            throws SQLException {
+        long positions = 0;
+        long events = 0;
+        Timestamp time = new Timestamp(cutoff);
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement deleteEvents = connection.prepareStatement(
+                     "DELETE FROM tc_events WHERE deviceid = ? AND eventtime < ?");
+             PreparedStatement deletePositions = connection.prepareStatement(
+                     "DELETE FROM tc_positions WHERE deviceid = ? AND fixtime < ? AND id <> ?")) {
+            for (Device device : devices) {
+                deleteEvents.setLong(1, device.getId());
+                deleteEvents.setTimestamp(2, time);
+                events += deleteEvents.executeUpdate();
+                deletePositions.setLong(1, device.getId());
+                deletePositions.setTimestamp(2, time);
+                deletePositions.setLong(3, device.getPositionId());
+                positions += deletePositions.executeUpdate();
+            }
+        }
+        report.put("positionsExpired", positions);
+        report.put("eventsExpired", events);
+    }
+
+    private long oldestPosition() throws SQLException {
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement statement = connection.prepareStatement("SELECT MIN(fixtime) FROM tc_positions");
+             ResultSet result = statement.executeQuery()) {
+            Timestamp time = result.next() ? result.getTimestamp(1) : null;
+            return time != null ? time.getTime() : 0;
+        }
+    }
+
+    private void compactHistory(Collection<Device> devices, long until, long notBefore, Map<String, Object> report)
+            throws SQLException, StorageException, IOException {
+        long watermark = readCompactedUntil();
+        long from = Math.max(watermark > 0 ? watermark : oldestPosition(), notBefore);
+        long interval = config.getInteger(Keys.RETENTION_COMPACT_INTERVAL) * 1000L;
+        long removed = 0;
+        int processed = 0;
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement delete = connection.prepareStatement("DELETE FROM tc_positions WHERE id = ?")) {
+            while (from > 0 && from < until && processed < MAX_COMPACT_DAYS_PER_RUN) {
+                long to = Math.min(from + DAY, until);
+                for (Device device : devices) {
+                    List<Position> positions = PositionUtil.getPositions(
+                            storage, device.getId(), new Date(from), new Date(to));
+                    if (positions.size() < 3) {
+                        continue;
+                    }
+                    Set<Long> protectedIds = new HashSet<>();
+                    protectedIds.add(device.getPositionId());
+                    for (Event event : storage.getObjects(Event.class, new Request(
+                            new Columns.Include("positionId"),
+                            new Condition.And(
+                                    new Condition.Equals("deviceId", device.getId()),
+                                    new Condition.Between("eventTime", new Date(from), new Date(to)))))) {
+                        protectedIds.add(event.getPositionId());
+                    }
+                    List<Long> ids = HistoryCompactor.redundant(positions, protectedIds, interval);
+                    for (int i = 0; i < ids.size(); i++) {
+                        delete.setLong(1, ids.get(i));
+                        delete.addBatch();
+                        if (i % 1000 == 999 || i == ids.size() - 1) {
+                            delete.executeBatch();
+                        }
+                    }
+                    removed += ids.size();
+                }
+                from = to;
+                processed += 1;
+                writeCompactedUntil(from);
+            }
+        }
+        report.put("positionsCompacted", removed);
+        report.put("compactedUntil", from);
+    }
+
+    private void processMedia(long now, Map<String, Object> report) throws IOException {
+        String mediaPath = config.getString(Keys.MEDIA_PATH);
+        if (mediaPath == null || !Files.isDirectory(Path.of(mediaPath))) {
+            return;
+        }
+        Path root = Path.of(mediaPath);
+        List<Path> files = new ArrayList<>();
+        try (Stream<Path> stream = Files.walk(root)) {
+            stream.filter(Files::isRegularFile)
+                    .filter(path -> !path.getFileName().toString().startsWith("."))
+                    .forEach(files::add);
+        }
+
+        int days = config.getInteger(Keys.RETENTION_DAYS);
+        long deleted = 0;
+        if (days > 0) {
+            for (Path file : new ArrayList<>(files)) {
+                if (file.toFile().lastModified() < now - days * DAY) {
+                    Files.deleteIfExists(file);
+                    files.remove(file);
+                    deleted += 1;
+                }
+            }
+        }
+
+        Path indexPath = root.resolve(COMPRESSED_FILE);
+        Set<String> compressed = new HashSet<>(
+                Files.exists(indexPath) ? Files.readAllLines(indexPath, StandardCharsets.UTF_8) : List.of());
+        int compressDays = config.getInteger(Keys.RETENTION_MEDIA_COMPRESS_DAYS);
+        long saved = 0;
+        int compressedCount = 0;
+        if (compressDays > 0) {
+            boolean ffmpeg = ffmpegAvailable();
+            for (Path file : files) {
+                if (System.currentTimeMillis() - now > MEDIA_BUDGET) {
+                    break;
+                }
+                String key = root.relativize(file).toString();
+                File handle = file.toFile();
+                if (compressed.contains(key) || handle.lastModified() > now - compressDays * DAY
+                        || handle.length() < MIN_COMPRESS_SIZE) {
+                    continue;
+                }
+                long before = handle.length();
+                String name = key.toLowerCase();
+                boolean image = name.endsWith(".jpg") || name.endsWith(".jpeg");
+                if (!image && !(ffmpeg && name.endsWith(".mp4"))) {
+                    continue;
+                }
+                boolean done = image ? compressImage(file) : compressVideo(file);
+                compressed.add(key); // attempted once, also when the result would not be smaller
+                if (done) {
+                    compressedCount += 1;
+                    saved += before - file.toFile().length();
+                }
+            }
+        }
+
+        long maxSize = (long) (config.getDouble(Keys.RETENTION_MEDIA_MAX_SIZE) * 1024 * 1024 * 1024);
+        long total = files.stream().mapToLong(path -> path.toFile().length()).sum();
+        long overwritten = 0;
+        if (maxSize > 0 && total > maxSize) {
+            files.sort(Comparator.comparingLong(path -> path.toFile().lastModified()));
+            for (Path file : new ArrayList<>(files)) {
+                if (total <= maxSize * 9 / 10) {
+                    break;
+                }
+                total -= file.toFile().length();
+                Files.deleteIfExists(file);
+                files.remove(file);
+                overwritten += 1;
+            }
+        }
+
+        Set<String> existing = new HashSet<>();
+        files.forEach(path -> existing.add(root.relativize(path).toString()));
+        compressed.retainAll(existing);
+        Files.write(indexPath, compressed, StandardCharsets.UTF_8);
+
+        report.put("mediaExpired", deleted);
+        report.put("mediaCompressed", compressedCount);
+        report.put("mediaSaved", saved);
+        report.put("mediaOverwritten", overwritten);
+        report.put("mediaFiles", files.size());
+        report.put("mediaSize", total);
+    }
+
+    private static void replaceKeepingTime(Path file, Path replacement) throws IOException {
+        long modified = file.toFile().lastModified();
+        Files.move(replacement, file, StandardCopyOption.REPLACE_EXISTING);
+        file.toFile().setLastModified(modified);
+    }
+
+    private static boolean compressImage(Path file) {
+        try {
+            BufferedImage image = ImageIO.read(file.toFile());
+            if (image == null) {
+                return false;
+            }
+            if (image.getWidth() > MAX_IMAGE_WIDTH) {
+                int height = image.getHeight() * MAX_IMAGE_WIDTH / image.getWidth();
+                BufferedImage scaled = new BufferedImage(MAX_IMAGE_WIDTH, height, BufferedImage.TYPE_INT_RGB);
+                Graphics2D graphics = scaled.createGraphics();
+                graphics.setRenderingHint(
+                        RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
+                graphics.drawImage(image, 0, 0, MAX_IMAGE_WIDTH, height, null);
+                graphics.dispose();
+                image = scaled;
+            } else if (image.getType() != BufferedImage.TYPE_INT_RGB) {
+                BufferedImage rgb = new BufferedImage(
+                        image.getWidth(), image.getHeight(), BufferedImage.TYPE_INT_RGB);
+                Graphics2D graphics = rgb.createGraphics();
+                graphics.drawImage(image, 0, 0, null);
+                graphics.dispose();
+                image = rgb;
+            }
+            ImageWriter writer = ImageIO.getImageWritersByFormatName("jpeg").next();
+            ImageWriteParam param = writer.getDefaultWriteParam();
+            param.setCompressionMode(ImageWriteParam.MODE_EXPLICIT);
+            param.setCompressionQuality(0.7f);
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            try (ImageOutputStream stream = ImageIO.createImageOutputStream(output)) {
+                writer.setOutput(stream);
+                writer.write(null, new IIOImage(image, null, null), param);
+            } finally {
+                writer.dispose();
+            }
+            if (output.size() > file.toFile().length() * 85 / 100) {
+                return false;
+            }
+            Path temporary = file.resolveSibling(file.getFileName() + ".tmp");
+            Files.write(temporary, output.toByteArray());
+            replaceKeepingTime(file, temporary);
+            return true;
+        } catch (IOException e) {
+            LOGGER.warn("Image compression failed for {}", file, e);
+            return false;
+        }
+    }
+
+    private boolean ffmpegAvailable() {
+        try {
+            Process process = new ProcessBuilder(config.getString(Keys.RETENTION_FFMPEG), "-version")
+                    .redirectErrorStream(true).redirectOutput(ProcessBuilder.Redirect.DISCARD).start();
+            return process.waitFor(10, TimeUnit.SECONDS) && process.exitValue() == 0;
+        } catch (IOException e) {
+            return false;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return false;
+        }
+    }
+
+    private boolean compressVideo(Path file) {
+        Path temporary = file.resolveSibling(file.getFileName() + ".tmp.mp4");
+        try {
+            Process process = new ProcessBuilder(
+                    config.getString(Keys.RETENTION_FFMPEG), "-nostdin", "-y", "-loglevel", "error",
+                    "-i", file.toString(), "-map", "0:v:0", "-map", "0:a?",
+                    "-c:v", "libx264", "-preset", "veryfast", "-crf", "30", "-vf", "scale='min(1280,iw)':-2",
+                    "-c:a", "aac", "-b:a", "48k", "-movflags", "+faststart", "-threads", "2",
+                    temporary.toString())
+                    .redirectErrorStream(true).redirectOutput(ProcessBuilder.Redirect.DISCARD).start();
+            if (!process.waitFor(10, TimeUnit.MINUTES)) {
+                process.destroyForcibly();
+                return false;
+            }
+            if (process.exitValue() != 0 || !Files.exists(temporary)
+                    || Files.size(temporary) > file.toFile().length() * 9 / 10) {
+                return false;
+            }
+            replaceKeepingTime(file, temporary);
+            return true;
+        } catch (IOException e) {
+            LOGGER.warn("Video compression failed for {}", file, e);
+            return false;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return false;
+        } finally {
+            try {
+                Files.deleteIfExists(temporary);
+            } catch (IOException ignored) {
+                // nothing left to clean
+            }
+        }
+    }
+
+}
