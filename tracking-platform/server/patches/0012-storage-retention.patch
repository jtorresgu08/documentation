+package org.traccar.schedule;
+
+import jakarta.inject.Inject;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+import org.traccar.retention.StorageRetention;
+
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+public class TaskStorageRetention extends SingleScheduleTask {
+
+    private final Config config;
+    private final StorageRetention retention;
+
+    @Inject
+    public TaskStorageRetention(Config config, StorageRetention retention) {
+        this.config = config;
+        this.retention = retention;
+    }
+
+    @Override
+    public void schedule(ScheduledExecutorService executor) {
+        long delay = TimeUnit.MILLISECONDS.toMinutes(
+                StorageRetention.nextRun(config.getInteger(Keys.RETENTION_HOUR)) - System.currentTimeMillis());
+        executor.scheduleAtFixedRate(this, delay, TimeUnit.DAYS.toMinutes(1), TimeUnit.MINUTES);
+    }
+
+    @Override
+    public void run() {
+        if (config.getInteger(Keys.RETENTION_DAYS) > 0 || config.getInteger(Keys.RETENTION_COMPACT_DAYS) > 0
+                || config.getInteger(Keys.RETENTION_MEDIA_COMPRESS_DAYS) > 0
+                || config.getDouble(Keys.RETENTION_MEDIA_MAX_SIZE) > 0) {
+            retention.run();
+        }
+    }
+
+}
diff --git a/src/test/java/org/traccar/retention/HistoryCompactorTest.java b/src/test/java/org/traccar/retention/HistoryCompactorTest.java
new file mode 100644
