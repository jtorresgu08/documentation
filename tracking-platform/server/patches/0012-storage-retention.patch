+package org.traccar.retention;
+
+import org.traccar.helper.DistanceCalculator;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+
+/**
+ * Chooses the redundant positions of old history. Kept: the first and last point, positions referenced by events or
+ * the current position, alarms, media, ignition / motion / driver changes, one point per interval while moving (plus
+ * turns and long jumps, so the route keeps its shape) and one point every half hour while stopped.
+ */
+public final class HistoryCompactor {
+
+    static final double MOVING_SPEED = 3; // km/h
+    static final double TURN = 30; // degrees
+    static final double MAX_DISTANCE = 1000; // meters between kept points
+    static final long STOP_INTERVAL = 30 * 60 * 1000;
+
+    private static final List<String> KEEP_KEYS = List.of(
+            Position.KEY_ALARM, Position.KEY_IMAGE, Position.KEY_VIDEO, Position.KEY_AUDIO, Position.KEY_RESULT);
+
+    private HistoryCompactor() {
+    }
+
+    private static boolean moving(Position position) {
+        return position.getBoolean(Position.KEY_MOTION)
+                || UnitsConverter.kphFromKnots(position.getSpeed()) > MOVING_SPEED;
+    }
+
+    private static boolean changed(Position kept, Position position, String key) {
+        return !Objects.equals(kept.getAttributes().get(key), position.getAttributes().get(key));
+    }
+
+    /**
+     * Returns the ids to delete from positions of one device sorted by time.
+     */
+    public static List<Long> redundant(List<Position> positions, Set<Long> protectedIds, long interval) {
+        List<Long> result = new ArrayList<>();
+        Position kept = null;
+        for (int i = 0; i < positions.size(); i++) {
+            Position position = positions.get(i);
+            boolean keep = kept == null || i == positions.size() - 1
+                    || protectedIds.contains(position.getId())
+                    || KEEP_KEYS.stream().anyMatch(position::hasAttribute)
+                    || changed(kept, position, Position.KEY_IGNITION)
+                    || changed(kept, position, Position.KEY_DRIVER_UNIQUE_ID)
+                    || moving(kept) != moving(position);
+            if (!keep) {
+                long elapsed = position.getFixTime().getTime() - kept.getFixTime().getTime();
+                if (moving(position)) {
+                    double turn = Math.abs(((position.getCourse() - kept.getCourse() + 540) % 360) - 180);
+                    double distance = DistanceCalculator.distance(
+                            kept.getLatitude(), kept.getLongitude(), position.getLatitude(), position.getLongitude());
+                    keep = elapsed >= interval || turn >= TURN || distance >= MAX_DISTANCE;
+                } else {
+                    keep = elapsed >= STOP_INTERVAL;
+                }
+            }
+            if (keep) {
+                kept = position;
+            } else {
+                result.add(position.getId());
+            }
+        }
+        return result;
+    }
+
+}
diff --git a/src/main/java/org/traccar/retention/StorageRetention.java b/src/main/java/org/traccar/retention/StorageRetention.java
