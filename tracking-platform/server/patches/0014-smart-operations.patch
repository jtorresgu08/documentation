+package org.traccar.api.resource;
+
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.quality.ConnectionQuality;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Connection quality per unit: score, grade, detected issues and, with details, reports per hour and gaps.
+ */
+@Path("quality")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class QualityResource extends BaseResource {
+
+    private static final long MAX_PERIOD = 31L * 24 * 3600 * 1000;
+
+    @GET
+    public List<Map<String, Object>> get(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to,
+            @QueryParam("details") boolean details) throws StorageException {
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+        long now = System.currentTimeMillis();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            List<Position> positions = PositionUtil.getPositions(storage, device.getId(), from, to);
+            int reconnections = storage.getObjects(Event.class, new Request(
+                    new Columns.Include("id"),
+                    new Condition.And(
+                            new Condition.Equals("deviceId", device.getId()),
+                            new Condition.And(
+                                    new Condition.Equals("type", Event.TYPE_DEVICE_ONLINE),
+                                    new Condition.Between("eventTime", from, to))))).size();
+            Map<String, Object> item = ConnectionQuality.compute(
+                    positions, reconnections, from.getTime(), to.getTime(),
+                    device.getLastUpdate() != null ? device.getLastUpdate().getTime() : null, now, details);
+            item.put("deviceId", device.getId());
+            item.put("name", device.getName());
+            item.put("uniqueId", device.getUniqueId());
+            item.put("model", device.getModel());
+            item.put("phone", device.getPhone());
+            item.put("status", device.getStatus());
+            item.put("protocol", positions.isEmpty() ? null : positions.get(positions.size() - 1).getProtocol());
+            result.add(item);
+        }
+        result.sort((a, b) -> Long.compare(
+                ((Number) a.get("score")).longValue(), ((Number) b.get("score")).longValue()));
+        return result;
+    }
+
+}
