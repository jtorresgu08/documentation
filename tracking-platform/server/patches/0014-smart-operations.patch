+package org.traccar.alerts;
+
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Priority of an event in the alert center. Keys are the event type, or "alarm:" plus the alarm name; the server
+ * attribute alerts.severity overrides them, e.g. "alarm:door=critical, geofenceEnter=low".
+ */
+public final class AlertSeverity {
+
+    public static final String CRITICAL = "critical";
+    public static final String HIGH = "high";
+    public static final String MEDIUM = "medium";
+    public static final String LOW = "low";
+
+    public static final List<String> ORDER = List.of(CRITICAL, HIGH, MEDIUM, LOW);
+
+    private static final Map<String, String> DEFAULTS = new HashMap<>();
+
+    static {
+        for (String alarm : List.of(
+                Position.ALARM_SOS, Position.ALARM_ACCIDENT, Position.ALARM_TOW, Position.ALARM_POWER_CUT,
+                Position.ALARM_TAMPERING, Position.ALARM_REMOVING, Position.ALARM_JAMMING,
+                Position.ALARM_GPS_ANTENNA_CUT, Position.ALARM_FALL_DOWN, Position.ALARM_FUEL_LEAK,
+                "forwardCollision", "pedestrianCollision")) {
+            DEFAULTS.put("alarm:" + alarm, CRITICAL);
+        }
+        DEFAULTS.put(Event.TYPE_DEVICE_FUEL_DROP, CRITICAL);
+        for (String alarm : List.of(
+                Position.ALARM_OVERSPEED, Position.ALARM_BRAKING, Position.ALARM_ACCELERATION,
+                Position.ALARM_CORNERING, Position.ALARM_FATIGUE_DRIVING, Position.ALARM_LOW_POWER,
+                Position.ALARM_LOW_BATTERY, Position.ALARM_TEMPERATURE, Position.ALARM_MOVEMENT,
+                Position.ALARM_VIBRATION, Position.ALARM_DOOR, Position.ALARM_BONNET, Position.ALARM_POWER_OFF,
+                "phoneCall", "smoking", "distraction", "driverAbnormal", "laneDeparture", "vehicleDistance",
+                "obstacle", "frequentLaneChange", "roadSignOverLimit")) {
+            DEFAULTS.put("alarm:" + alarm, HIGH);
+        }
+        for (String type : List.of(
+                Event.TYPE_DEVICE_OVERSPEED, Event.TYPE_GEOFENCE_EXIT, Event.TYPE_MAINTENANCE,
+                Event.TYPE_DEVICE_INACTIVE)) {
+            DEFAULTS.put(type, HIGH);
+        }
+        for (String type : List.of(
+                Event.TYPE_DEVICE_ONLINE, Event.TYPE_DEVICE_OFFLINE, Event.TYPE_DEVICE_UNKNOWN,
+                Event.TYPE_DEVICE_MOVING, Event.TYPE_DEVICE_STOPPED, Event.TYPE_IGNITION_ON,
+                Event.TYPE_IGNITION_OFF, Event.TYPE_QUEUED_COMMAND_SENT)) {
+            DEFAULTS.put(type, LOW);
+        }
+    }
+
+    /** Event types that only describe normal operation; hidden in the alert center unless asked for. */
+    public static final Set<String> ROUTINE = Set.of(
+            Event.TYPE_DEVICE_ONLINE, Event.TYPE_DEVICE_OFFLINE, Event.TYPE_DEVICE_UNKNOWN,
+            Event.TYPE_DEVICE_MOVING, Event.TYPE_DEVICE_STOPPED, Event.TYPE_IGNITION_ON,
+            Event.TYPE_IGNITION_OFF, Event.TYPE_QUEUED_COMMAND_SENT, Event.TYPE_MEDIA);
+
+    private AlertSeverity() {
+    }
+
+    public static Map<String, String> parseOverrides(String value) {
+        Map<String, String> result = new HashMap<>();
+        if (value != null) {
+            for (String entry : value.split("[,;\\n]")) {
+                String[] pair = entry.split("=");
+                if (pair.length == 2 && ORDER.contains(pair[1].trim().toLowerCase())) {
+                    result.put(pair[0].trim(), pair[1].trim().toLowerCase());
+                }
+            }
+        }
+        return result;
+    }
+
+    public static String key(Event event) {
+        String alarm = event.getString(Position.KEY_ALARM);
+        return Event.TYPE_ALARM.equals(event.getType()) && alarm != null
+                ? "alarm:" + alarm.split(",")[0] : event.getType();
+    }
+
+    public static String of(Event event, Map<String, String> overrides) {
+        String key = key(event);
+        String severity = overrides.get(key);
+        if (severity == null && key.startsWith("alarm:")) {
+            severity = overrides.get(Event.TYPE_ALARM);
+        }
+        if (severity == null) {
+            severity = DEFAULTS.get(key);
+        }
+        if (severity == null) {
+            severity = key.startsWith("alarm:") ? HIGH : MEDIUM;
+        }
+        return severity;
+    }
+
+}
diff --git a/src/main/java/org/traccar/api/resource/AlertResource.java b/src/main/java/org/traccar/api/resource/AlertResource.java
