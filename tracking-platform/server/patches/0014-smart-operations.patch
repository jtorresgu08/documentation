+import org.traccar.api.BaseResource;
+import org.traccar.model.ReportTemplate;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.List;
+
+/**
+ * Configurable reports saved by each user (data source, columns, filters, grouping and sorting as JSON).
+ */
+@Path("report-templates")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class ReportTemplateResource extends BaseResource {
+
+    private static final int MAX_CONFIG = 100_000;
+
+    private ReportTemplate find(long id) throws StorageException {
+        ReportTemplate template = storage.getObject(ReportTemplate.class, new Request(
+                new Columns.All(),
+                new Condition.And(new Condition.Equals("id", id), new Condition.Equals("userId", getUserId()))));
+        if (template == null) {
+            throw new NotFoundException();
+        }
+        return template;
+    }
+
+    private static void validate(ReportTemplate template) {
+        if (template.getName() == null || template.getName().isBlank() || template.getName().length() > 128
+                || template.getConfig() == null || template.getConfig().length() > MAX_CONFIG) {
+            throw new BadRequestException("Invalid template");
+        }
+    }
+
+    @GET
+    public List<ReportTemplate> get() throws StorageException {
+        return storage.getObjects(ReportTemplate.class, new Request(
+                new Columns.All(), new Condition.Equals("userId", getUserId()), new Order("name")));
+    }
+
+    @POST
+    public ReportTemplate add(ReportTemplate template) throws StorageException {
+        validate(template);
+        template.setUserId(getUserId());
+        template.setId(storage.addObject(template, new Request(new Columns.Exclude("id"))));
+        return template;
+    }
+
+    @PUT
+    @Path("{id}")
+    public ReportTemplate update(@PathParam("id") long id, ReportTemplate template) throws StorageException {
+        find(id);
+        validate(template);
+        template.setId(id);
+        template.setUserId(getUserId());
+        storage.updateObject(template, new Request(new Columns.Exclude("id"), new Condition.Equals("id", id)));
+        return template;
+    }
+
+    @DELETE
+    @Path("{id}")
+    public Response remove(@PathParam("id") long id) throws StorageException {
+        find(id);
+        storage.removeObject(ReportTemplate.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+}
diff --git a/src/main/java/org/traccar/maintenance/FleetMaintenance.java b/src/main/java/org/traccar/maintenance/FleetMaintenance.java
new file mode 100644
index 0000000..31aad6a
--- /dev/null
+++ b/src/main/java/org/traccar/maintenance/FleetMaintenance.java
@@ -0,0 +1,217 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.maintenance;
+
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Group;
+import org.traccar.model.Maintenance;
+import org.traccar.model.Permission;
+import org.traccar.model.Position;
+import org.traccar.model.ServiceRecord;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Maintenance status of a unit: for every plan (own or inherited from its groups) the current value, last service,
+ * next due, what remains, whether it is ok / soon / overdue and, from the last 30 days of use, the estimated date.
+ * A service record restarts the plan from the odometer, engine hours or date it was done at.
+ */
+@Singleton
+public class FleetMaintenance {
+
+    public static final String OK = "ok";
+    public static final String SOON = "soon";
+    public static final String OVERDUE = "overdue";
+
+    static final double DEFAULT_NOTICE = 0.1;
+    static final long DAY = 24L * 3600 * 1000;
+
+    private final Storage storage;
+
+    @Inject
+    public FleetMaintenance(Storage storage) {
+        this.storage = storage;
+    }
+
+    public static boolean isTime(String type) {
+        return type.endsWith("Time");
+    }
+
+    public static double currentValue(String type, Position position) {
+        if (isTime(type)) {
+            return switch (type) {
+                case "serverTime" -> position.getServerTime().getTime();
+                case "deviceTime" -> position.getDeviceTime().getTime();
+                default -> position.getFixTime().getTime();
+            };
+        }
+        return position.getDouble(type);
+    }
+
+    /** Value of a service record in the plan's unit (date, engine hours or odometer). */
+    public static double recordValue(String type, ServiceRecord record) {
+        if (isTime(type)) {
+            return record.getServiceTime().getTime();
+        }
+        if (Position.KEY_HOURS.equals(type)) {
+            return record.getHours();
+        }
+        return record.getOdometer();
+    }
+
+    public static double nextDue(double start, double period, double current) {
+        if (current < start || period <= 0) {
+            return start;
+        }
+        return start + period * (Math.floor((current - start) / period) + 1);
+    }
+
+    /** Pure status computation, kept static for tests. */
+    public static Map<String, Object> status(
+            Maintenance maintenance, double current, ServiceRecord last, Double dailyUse, long now) {
+        String type = maintenance.getType();
+        double period = maintenance.getPeriod();
+        double base;
+        double next;
+        if (last != null) {
+            base = recordValue(type, last);
+            next = base + period;
+        } else {
+            next = nextDue(maintenance.getStart(), period, current);
+            base = period > 0 ? next - period : maintenance.getStart();
+        }
+        double remaining = next - current;
+        double notice = maintenance.hasAttribute("notice") ? maintenance.getDouble("notice") : DEFAULT_NOTICE;
+        double noticeValue = notice <= 1 ? period * notice : notice;
+        String state = remaining <= 0 ? OVERDUE : remaining <= noticeValue ? SOON : OK;
+        Map<String, Object> item = new LinkedHashMap<>();
+        item.put("maintenanceId", maintenance.getId());
+        item.put("name", maintenance.getName());
+        item.put("type", type);
+        item.put("period", period);
+        item.put("current", current);
+        item.put("base", base);
+        item.put("next", next);
+        item.put("remaining", remaining);
+        item.put("progress", period > 0 ? Math.max(0, Math.min(1.5, (current - base) / period)) : 0);
+        item.put("state", state);
+        item.put("notice", noticeValue);
+        if (isTime(type)) {
+            item.put("estimatedDate", (long) next);
+        } else if (dailyUse != null && dailyUse > 0) {
+            item.put("dailyUse", dailyUse);
+            item.put("estimatedDate", now + (long) (remaining / dailyUse * DAY));
+        }
+        if (last != null) {
+            item.put("lastServiceId", last.getId());
+            item.put("lastServiceTime", last.getServiceTime());
+            item.put("lastServiceCost", last.getCost());
+            item.put("lastWorkshop", last.getWorkshop());
+        }
+        return item;
+    }
+
+    public Collection<Maintenance> maintenances(Device device) throws StorageException {
+        Map<Long, Maintenance> result = new LinkedHashMap<>();
+        for (Maintenance maintenance : storage.getObjects(Maintenance.class, new Request(
+                new Columns.All(), new Condition.Permission(Device.class, device.getId(), Maintenance.class)))) {
+            result.put(maintenance.getId(), maintenance);
+        }
+        Set<Long> visited = new HashSet<>();
+        long groupId = device.getGroupId();
+        while (groupId > 0 && visited.add(groupId)) {
+            for (Permission permission : storage.getPermissions(Group.class, groupId, Maintenance.class, 0)) {
+                if (!result.containsKey(permission.getPropertyId())) {
+                    Maintenance maintenance = storage.getObject(Maintenance.class, new Request(
+                            new Columns.All(), new Condition.Equals("id", permission.getPropertyId())));
+                    if (maintenance != null) {
+                        result.put(maintenance.getId(), maintenance);
+                    }
+                }
+            }
+            Group group = storage.getObject(Group.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", groupId)));
+            groupId = group != null ? group.getGroupId() : 0;
+        }
+        return result.values();
+    }
+
+    public ServiceRecord lastService(long deviceId, long maintenanceId) throws StorageException {
+        List<ServiceRecord> records = storage.getObjects(ServiceRecord.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("deviceId", deviceId),
+                        new Condition.Equals("maintenanceId", maintenanceId)),
+                new Order("serviceTime", true, 1)));
+        return records.isEmpty() ? null : records.get(0);
+    }
+
+    public Position latest(Device device) throws StorageException {
+        return device.getPositionId() > 0 ? storage.getObject(Position.class, new Request(
+                new Columns.All(), new Condition.Equals("id", device.getPositionId()))) : null;
+    }
+
+    private Double dailyUse(Device device, String type, Position latest, long now) throws StorageException {
+        if (isTime(type)) {
+            return null;
+        }
+        Position first = PositionUtil.getEdgePosition(
+                storage, device.getId(), new Date(now - 30 * DAY), new Date(now), false);
+        if (first == null || latest == null || !first.hasAttribute(type)) {
+            return null;
+        }
+        double days = Math.max(1, (latest.getFixTime().getTime() - first.getFixTime().getTime()) / (double) DAY);
+        double used = latest.getDouble(type) - first.getDouble(type);
+        return used > 0 ? used / days : null;
+    }
+
+    public List<Map<String, Object>> status(Device device, long now) throws StorageException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        Position latest = latest(device);
+        if (latest == null) {
+            return result;
+        }
+        Map<String, Double> usage = new LinkedHashMap<>();
+        for (Maintenance maintenance : maintenances(device)) {
+            String type = maintenance.getType();
+            if (!usage.containsKey(type)) {
+                usage.put(type, dailyUse(device, type, latest, now));
+            }
+            Map<String, Object> item = status(
+                    maintenance, currentValue(type, latest), lastService(device.getId(), maintenance.getId()),
+                    usage.get(type), now);
+            item.put("deviceId", device.getId());
+            item.put("deviceName", device.getName());
+            result.add(item);
+        }
+        return result;
+    }
+
+}
