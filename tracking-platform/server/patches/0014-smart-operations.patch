+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.NotFoundException;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.maintenance.FleetMaintenance;
+import org.traccar.model.Device;
+import org.traccar.model.Expense;
+import org.traccar.model.Maintenance;
+import org.traccar.model.Position;
+import org.traccar.model.ServiceRecord;
+import org.traccar.model.UserRestrictions;
+import org.traccar.schedule.TaskMaintenanceReminder;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Fleet maintenance: status of every plan per unit and the service log (work done, odometer, cost and workshop).
+ * Registering a service restarts the plan and can add the cost to the unit's expenses.
+ */
+@Path("maintenance-plans")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class MaintenancePlanResource extends BaseResource {
+
+    private static final List<String> STATE_ORDER = List.of(
+            FleetMaintenance.OVERDUE, FleetMaintenance.SOON, FleetMaintenance.OK);
+
+    @Inject
+    private FleetMaintenance fleetMaintenance;
+
+    @Inject
+    private TaskMaintenanceReminder reminder;
+
+    @POST
+    @Path("check")
+    public Map<String, Object> check() throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        return Map.of("events", reminder.check());
+    }
+
+    @GET
+    @Path("status")
+    public Map<String, Object> status(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds)
+            throws StorageException {
+        long now = System.currentTimeMillis();
+        List<Map<String, Object>> items = new ArrayList<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            items.addAll(fleetMaintenance.status(device, now));
+        }
+        items.sort(Comparator.comparingInt((Map<String, Object> item) -> STATE_ORDER.indexOf(item.get("state")))
+                .thenComparing(item -> -((Number) item.get("progress")).doubleValue()));
+        Map<String, Integer> counts = new LinkedHashMap<>();
+        STATE_ORDER.forEach(state -> counts.put(state, 0));
+        items.forEach(item -> counts.merge((String) item.get("state"), 1, Integer::sum));
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("counts", counts);
+        result.put("items", items);
+        return result;
+    }
+
+    @GET
+    @Path("records")
+    public List<ServiceRecord> records(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        List<ServiceRecord> result = new ArrayList<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            Condition condition = new Condition.Equals("deviceId", device.getId());
+            if (from != null && to != null) {
+                condition = new Condition.And(condition, new Condition.Between("serviceTime", from, to));
+            }
+            result.addAll(storage.getObjects(ServiceRecord.class, new Request(
+                    new Columns.All(), condition, new Order("serviceTime", true, 0))));
+        }
+        result.sort(Comparator.comparing(ServiceRecord::getServiceTime).reversed());
+        return result;
+    }
+
+    @POST
+    @Path("records")
+    public ServiceRecord add(ServiceRecord record) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        permissionsService.checkPermission(Device.class, getUserId(), record.getDeviceId());
+        if (record.getServiceTime() == null || record.getCost() < 0) {
+            throw new BadRequestException("Invalid service");
+        }
+        Device device = storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("id", record.getDeviceId())));
+        Maintenance maintenance = null;
+        if (record.getMaintenanceId() > 0) {
+            maintenance = fleetMaintenance.maintenances(device).stream()
+                    .filter(item -> item.getId() == record.getMaintenanceId()).findFirst()
+                    .orElseThrow(() -> new BadRequestException("Maintenance not assigned to the unit"));
+        }
+        Position latest = fleetMaintenance.latest(device);
+        if (latest != null) {
+            if (record.getOdometer() <= 0) {
+                record.setOdometer(latest.getDouble(Position.KEY_TOTAL_DISTANCE));
+            }
+            if (record.getHours() <= 0) {
+                record.setHours(latest.getDouble(Position.KEY_HOURS));
+            }
+        }
+        record.setUserId(getUserId());
+        if (record.getCost() > 0 && record.getBoolean("createExpense")) {
+            Expense expense = new Expense();
+            expense.setDeviceId(record.getDeviceId());
+            expense.setType("maintenance");
+            expense.setAmount(record.getCost());
+            expense.setExpenseTime(record.getServiceTime());
+            expense.setOdometer(Math.round(record.getOdometer() / 1000));
+            expense.setVendor(record.getWorkshop());
+            expense.setDescription(maintenance != null ? maintenance.getName() : record.getNotes());
+            expense.setMaintenanceId(record.getMaintenanceId());
+            expense.setUserId(getUserId());
+            expense.setId(storage.addObject(expense, new Request(new Columns.Exclude("id"))));
+            record.setExpenseId(expense.getId());
+        }
+        record.getAttributes().remove("createExpense");
+        record.setId(storage.addObject(record, new Request(new Columns.Exclude("id"))));
+        return record;
+    }
+
+    @DELETE
+    @Path("records/{id}")
+    public Response remove(@PathParam("id") long id) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        ServiceRecord record = storage.getObject(ServiceRecord.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        if (record == null) {
+            throw new NotFoundException();
+        }
+        permissionsService.checkPermission(Device.class, getUserId(), record.getDeviceId());
+        if (record.getExpenseId() > 0) {
+            storage.removeObject(Expense.class, new Request(new Condition.Equals("id", record.getExpenseId())));
+        }
+        storage.removeObject(ServiceRecord.class, new Request(new Condition.Equals("id", id)));
+        return Response.noContent().build();
+    }
+
+}
