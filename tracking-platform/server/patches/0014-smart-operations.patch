+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.schedule;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.database.NotificationManager;
+import org.traccar.maintenance.FleetMaintenance;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.Date;
+import java.util.Map;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Hourly check of the maintenance plans: when a plan becomes due soon or overdue it raises one maintenance event
+ * per service cycle (attributes state = soon / overdue), which notifications and the alert center pick up.
+ */
+public class TaskMaintenanceReminder extends SingleScheduleTask {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TaskMaintenanceReminder.class);
+
+    private static final long CHECK_PERIOD_MINUTES = 60;
+    private static final long LOOKBACK = 400L * 24 * 3600 * 1000;
+
+    private final Storage storage;
+    private final FleetMaintenance fleetMaintenance;
+    private final NotificationManager notificationManager;
+
+    @Inject
+    public TaskMaintenanceReminder(
+            Storage storage, FleetMaintenance fleetMaintenance, NotificationManager notificationManager) {
+        this.storage = storage;
+        this.fleetMaintenance = fleetMaintenance;
+        this.notificationManager = notificationManager;
+    }
+
+    @Override
+    public void schedule(ScheduledExecutorService executor) {
+        executor.scheduleAtFixedRate(this, 5, CHECK_PERIOD_MINUTES, TimeUnit.MINUTES);
+    }
+
+    static String cycle(Map<String, Object> item) {
+        return item.get("maintenanceId") + ":" + item.get("state") + ":" + Math.round((Double) item.get("next"));
+    }
+
+    private boolean notified(long deviceId, String cycle, long now) throws StorageException {
+        return storage.getObjects(Event.class, new Request(
+                new Columns.All(),
+                new Condition.And(
+                        new Condition.Equals("deviceId", deviceId),
+                        new Condition.And(
+                                new Condition.Equals("type", Event.TYPE_MAINTENANCE),
+                                new Condition.Between("eventTime", new Date(now - LOOKBACK), new Date(now))))))
+                .stream().anyMatch(event -> cycle.equals(event.getString("cycle")));
+    }
+
+    public int check() throws StorageException {
+        long now = System.currentTimeMillis();
+        int created = 0;
+        for (Device device : storage.getObjects(Device.class, new Request(new Columns.All()))) {
+            for (Map<String, Object> item : fleetMaintenance.status(device, now)) {
+                if (FleetMaintenance.OK.equals(item.get("state"))) {
+                    continue;
+                }
+                String cycle = cycle(item);
+                if (notified(device.getId(), cycle, now)) {
+                    continue;
+                }
+                Position position = fleetMaintenance.latest(device);
+                Event event = new Event(Event.TYPE_MAINTENANCE, position);
+                event.setEventTime(new Date(now));
+                event.setMaintenanceId((Long) item.get("maintenanceId"));
+                event.set("state", (String) item.get("state"));
+                event.set("cycle", cycle);
+                event.set("name", (String) item.get("name"));
+                event.set("remaining", (Double) item.get("remaining"));
+                notificationManager.updateEvents(Map.of(event, position));
+                created += 1;
+            }
+        }
+        return created;
+    }
+
+    @Override
+    public void run() {
+        try {
+            check();
+        } catch (Exception e) {
+            LOGGER.warn("Maintenance reminder failed", e);
+        }
+    }
+
+}
diff --git a/src/test/java/org/traccar/alerts/AlertSeverityTest.java b/src/test/java/org/traccar/alerts/AlertSeverityTest.java
