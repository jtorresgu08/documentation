+package org.traccar.alerts;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class AlertSeverityTest {
+
+    private static Event alarm(String alarm) {
+        Event event = new Event(Event.TYPE_ALARM, 1);
+        event.set(Position.KEY_ALARM, alarm);
+        return event;
+    }
+
+    @Test
+    public void testDefaultsAndOverrides() {
+        var none = AlertSeverity.parseOverrides(null);
+        assertEquals(AlertSeverity.CRITICAL, AlertSeverity.of(alarm(Position.ALARM_SOS), none));
+        assertEquals(AlertSeverity.CRITICAL, AlertSeverity.of(new Event(Event.TYPE_DEVICE_FUEL_DROP, 1), none));
+        assertEquals(AlertSeverity.HIGH, AlertSeverity.of(alarm("phoneCall"), none));
+        assertEquals(AlertSeverity.HIGH, AlertSeverity.of(alarm("unknownAlarm"), none));
+        assertEquals(AlertSeverity.HIGH, AlertSeverity.of(new Event(Event.TYPE_DEVICE_OVERSPEED, 1), none));
+        assertEquals(AlertSeverity.MEDIUM, AlertSeverity.of(new Event(Event.TYPE_GEOFENCE_ENTER, 1), none));
+        assertEquals(AlertSeverity.LOW, AlertSeverity.of(new Event(Event.TYPE_DEVICE_ONLINE, 1), none));
+        assertEquals("alarm:sos", AlertSeverity.key(alarm("sos,overspeed")));
+        assertTrue(AlertSeverity.ROUTINE.contains(Event.TYPE_IGNITION_ON));
+
+        var custom = AlertSeverity.parseOverrides("alarm:door = critical; geofenceEnter=low, bad=urgent");
+        assertEquals(2, custom.size());
+        assertEquals(AlertSeverity.CRITICAL, AlertSeverity.of(alarm(Position.ALARM_DOOR), custom));
+        assertEquals(AlertSeverity.LOW, AlertSeverity.of(new Event(Event.TYPE_GEOFENCE_ENTER, 1), custom));
+    }
+
+}
diff --git a/src/test/java/org/traccar/maintenance/FleetMaintenanceTest.java b/src/test/java/org/traccar/maintenance/FleetMaintenanceTest.java
new file mode 100644
index 0000000..a7eb1e7
--- /dev/null
+++ b/src/test/java/org/traccar/maintenance/FleetMaintenanceTest.java
@@ -0,0 +1,64 @@
+package org.traccar.maintenance;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Maintenance;
+import org.traccar.model.ServiceRecord;
+
+import java.util.Date;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class FleetMaintenanceTest {
+
+    private static Maintenance plan(String type, double start, double period) {
+        Maintenance maintenance = new Maintenance();
+        maintenance.setId(7);
+        maintenance.setName("Aceite");
+        maintenance.setType(type);
+        maintenance.setStart(start);
+        maintenance.setPeriod(period);
+        return maintenance;
+    }
+
+    @Test
+    public void testDistancePlanWithoutService() {
+        long now = 1_700_000_000_000L;
+        var status = FleetMaintenance.status(plan("totalDistance", 0, 5_000_000), 12_300_000, null, 100_000.0, now);
+        assertEquals(15_000_000.0, status.get("next"));
+        assertEquals(2_700_000.0, status.get("remaining"));
+        assertEquals(FleetMaintenance.OK, status.get("state"));
+        assertEquals(now + 27L * 24 * 3600 * 1000, status.get("estimatedDate")); // 2,700 km at 100 km/day
+    }
+
+    @Test
+    public void testServiceRestartsThePlan() {
+        long now = 1_700_000_000_000L;
+        ServiceRecord record = new ServiceRecord();
+        record.setServiceTime(new Date(now));
+        record.setOdometer(11_000_000);
+        var status = FleetMaintenance.status(plan("totalDistance", 0, 5_000_000), 15_700_000, record, null, now);
+        assertEquals(16_000_000.0, status.get("next"));
+        assertEquals(FleetMaintenance.SOON, status.get("state")); // 300 km left, notice 10% = 500 km
+        assertFalse(status.containsKey("estimatedDate"));
+
+        var overdue = FleetMaintenance.status(plan("totalDistance", 0, 5_000_000), 16_200_000, record, null, now);
+        assertEquals(FleetMaintenance.OVERDUE, overdue.get("state"));
+        assertTrue((Double) overdue.get("progress") > 1);
+    }
+
+    @Test
+    public void testTimePlanAndNotice() {
+        long day = 24L * 3600 * 1000;
+        long now = 1_700_000_000_000L;
+        Maintenance maintenance = plan("fixTime", now - 300 * day, 365 * day);
+        maintenance.set("notice", 30.0 * day);
+        var status = FleetMaintenance.status(maintenance, now, null, null, now);
+        assertEquals(FleetMaintenance.OK, status.get("state"));
+        assertEquals((long) (now + 65.0 * day), status.get("estimatedDate"));
+        var soon = FleetMaintenance.status(maintenance, now + 40 * day, null, null, now);
+        assertEquals(FleetMaintenance.SOON, soon.get("state"));
+    }
+
+}
diff --git a/src/test/java/org/traccar/quality/ConnectionQualityTest.java b/src/test/java/org/traccar/quality/ConnectionQualityTest.java
new file mode 100644
index 0000000..1b49d3c
--- /dev/null
+++ b/src/test/java/org/traccar/quality/ConnectionQualityTest.java
@@ -0,0 +1,96 @@
+package org.traccar.quality;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ConnectionQualityTest {
+
+    private static final long START = 1_700_000_000_000L;
+    private static final long HOUR = 3600_000L;
+
+    private static Position position(long time, boolean valid, int satellites, int rssi, boolean ignition) {
+        Position position = new Position();
+        position.setTime(new Date(time));
+        position.setServerTime(new Date(time));
+        position.setValid(valid);
+        position.set(Position.KEY_SATELLITES, satellites);
+        position.set(Position.KEY_RSSI, rssi);
+        position.set(Position.KEY_IGNITION, ignition);
+        position.set(Position.KEY_MOTION, ignition);
+        return position;
+    }
+
+    @Test
+    public void testHealthyUnit() {
+        List<Position> positions = new ArrayList<>();
+        for (long time = START; time < START + 24 * HOUR; time += 30_000) {
+            positions.add(position(time, true, 11, 28, true));
+        }
+        var result = ConnectionQuality.compute(positions, 1, START, START + 24 * HOUR, START + 24 * HOUR,
+                START + 24 * HOUR, true);
+        assertTrue(((Number) result.get("score")).intValue() >= 90, result.toString());
+        assertEquals("excellent", result.get("grade"));
+        assertTrue(((List<?>) result.get("issues")).isEmpty(), result.get("issues").toString());
+        assertEquals(30L, result.get("interval"));
+        assertEquals(24, ((int[]) result.get("hourly")).length);
+    }
+
+    @Test
+    public void testProblems() {
+        List<Position> positions = new ArrayList<>();
+        int index = 0;
+        for (long time = START; time < START + 12 * HOUR; time += 30_000) {
+            positions.add(position(time, index++ % 3 != 0, 3, 1, true)); // 1-bar signal, few satellites
+        }
+        // 4 h lost while driving, then a parked night without reports (expected)
+        for (long time = START + 16 * HOUR; time < START + 18 * HOUR; time += 30_000) {
+            positions.add(position(time, true, 3, 1, time < START + 17 * HOUR));
+        }
+        positions.add(position(START + 23 * HOUR, true, 3, 1, false));
+        var result = ConnectionQuality.compute(positions, 20, START, START + 24 * HOUR, START + 23 * HOUR,
+                START + 24 * HOUR, false);
+        List<?> issues = (List<?>) result.get("issues");
+        assertTrue(issues.contains(ConnectionQuality.ISSUE_GAPS), issues.toString());
+        assertTrue(issues.contains(ConnectionQuality.ISSUE_WEAK_GPS), issues.toString());
+        assertTrue(issues.contains(ConnectionQuality.ISSUE_RECONNECTS), issues.toString());
+        assertTrue(issues.contains(ConnectionQuality.ISSUE_WEAK_SIGNAL), issues.toString());
+        assertTrue(issues.contains(ConnectionQuality.ISSUE_INVALID), issues.toString());
+        assertFalse(issues.contains(ConnectionQuality.ISSUE_OFFLINE));
+        assertEquals(1, result.get("gapCount")); // the parked hours are not a problem
+        assertTrue(((Number) result.get("score")).intValue() < 70, result.toString());
+    }
+
+    @Test
+    public void testFewReports() {
+        List<Position> positions = List.of(
+                position(START + HOUR, true, 10, 25, false), position(START + 20 * HOUR, true, 10, 25, false));
+        var result = ConnectionQuality.compute(positions, 0, START, START + 24 * HOUR, START + 20 * HOUR,
+                START + 24 * HOUR, false);
+        assertTrue(((List<?>) result.get("issues")).contains(ConnectionQuality.ISSUE_FEW_REPORTS));
+        assertTrue(((Number) result.get("score")).intValue() <= 60, result.toString());
+    }
+
+    @Test
+    public void testSignalScales() {
+        assertEquals(100.0, ConnectionQuality.signalPercent(-50.0));
+        assertEquals(60.0, ConnectionQuality.signalPercent(3.0));
+        assertEquals(100.0, ConnectionQuality.signalPercent(31.0));
+        assertEquals(0.0, ConnectionQuality.signalPercent(-120.0));
+    }
+
+    @Test
+    public void testNoData() {
+        var result = ConnectionQuality.compute(List.of(), 0, START, START + HOUR, null, START + HOUR, false);
+        assertEquals(0, result.get("score"));
+        assertTrue(((List<?>) result.get("issues")).contains(ConnectionQuality.ISSUE_NO_DATA));
+    }
+
+}
