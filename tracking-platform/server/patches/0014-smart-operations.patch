diff --git a/src/main/java/org/traccar/quality/ConnectionQuality.java b/src/main/java/org/traccar/quality/ConnectionQuality.java
new file mode 100644
index 0000000..3cc9a94
--- /dev/null
+++ b/src/main/java/org/traccar/quality/ConnectionQuality.java
@@ -0,0 +1,257 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.quality;
+
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Connection quality of a unit over a period, scored 0-100 from: time covered without reporting gaps while the unit
+ * works, valid GPS fixes, satellites / HDOP, GSM signal, power supply and reconnections. Gaps while the engine is off
+ * are expected (devices sleep), unless the unit stays silent for hours.
+ */
+public final class ConnectionQuality {
+
+    static final long MIN_GAP = 10 * 60 * 1000;
+    static final long SILENT_GAP = 6 * 3600 * 1000;
+    static final long CLOCK_TOLERANCE = 5 * 60 * 1000;
+    static final long DAY = 24 * 3600 * 1000;
+
+    public static final String ISSUE_NO_DATA = "noData";
+    public static final String ISSUE_OFFLINE = "offline";
+    public static final String ISSUE_GAPS = "gaps";
+    public static final String ISSUE_INVALID = "invalidFix";
+    public static final String ISSUE_WEAK_GPS = "weakGps";
+    public static final String ISSUE_WEAK_SIGNAL = "weakSignal";
+    public static final String ISSUE_LOW_POWER = "lowPower";
+    public static final String ISSUE_RECONNECTS = "reconnects";
+    public static final String ISSUE_CLOCK = "clock";
+    public static final String ISSUE_FEW_REPORTS = "fewReports";
+
+    static final double MIN_REPORTS_PER_DAY = 10;
+
+    private ConnectionQuality() {
+    }
+
+    /** Signal in percent from the usual scales: dBm, 0-5 bars, 0-31 CSQ or percent. */
+    static Double signalPercent(Double rssi) {
+        if (rssi == null) {
+            return null;
+        }
+        double value;
+        if (rssi < 0) {
+            value = (rssi + 110) / 60 * 100;
+        } else if (rssi <= 5) {
+            value = rssi * 20;
+        } else if (rssi <= 31) {
+            value = rssi / 31 * 100;
+        } else {
+            value = rssi;
+        }
+        return Math.max(0, Math.min(100, value));
+    }
+
+    private static Double average(List<Double> values) {
+        return values.isEmpty() ? null : values.stream().mapToDouble(Double::doubleValue).average().orElse(0);
+    }
+
+    private static boolean working(Position position) {
+        return position.getBoolean(Position.KEY_MOTION) || position.getBoolean(Position.KEY_IGNITION);
+    }
+
+    private static double clamp(double value) {
+        return Math.max(0, Math.min(1, value));
+    }
+
+    public static Map<String, Object> compute(
+            List<Position> positions, int reconnections, long from, long to, Long lastUpdate, long now,
+            boolean details) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        long period = Math.max(1, Math.min(to, now) - from);
+        double days = Math.max(1.0 / 24, period / (double) DAY);
+        List<String> issues = new ArrayList<>();
+        result.put("reports", positions.size());
+        result.put("reconnections", reconnections);
+        result.put("lastUpdate", lastUpdate);
+        boolean offline = lastUpdate == null || now - lastUpdate > DAY;
+        if (offline) {
+            issues.add(ISSUE_OFFLINE);
+        }
+        if (positions.isEmpty()) {
+            issues.add(ISSUE_NO_DATA);
+            result.put("score", 0);
+            result.put("grade", "poor");
+            result.put("issues", issues);
+            return result;
+        }
+
+        List<Long> intervals = new ArrayList<>();
+        for (int i = 1; i < positions.size(); i++) {
+            long gap = positions.get(i).getFixTime().getTime() - positions.get(i - 1).getFixTime().getTime();
+            if (gap > 0) {
+                intervals.add(gap);
+            }
+        }
+        List<Long> sorted = new ArrayList<>(intervals);
+        Collections.sort(sorted);
+        long median = sorted.isEmpty() ? 0 : sorted.get(sorted.size() / 2);
+        long threshold = Math.max(MIN_GAP, median * 5);
+
+        long lostTime = 0;
+        List<Map<String, Object>> gaps = new ArrayList<>();
+        int valid = 0;
+        int future = 0;
+        List<Double> satellites = new ArrayList<>();
+        List<Double> hdops = new ArrayList<>();
+        List<Double> signals = new ArrayList<>();
+        List<Double> power = new ArrayList<>();
+        int lowPowerAlarms = 0;
+        Position previous = null;
+        for (Position position : positions) {
+            if (position.getValid()) {
+                valid += 1;
+            }
+            if (position.getServerTime() != null
+                    && position.getFixTime().getTime() - position.getServerTime().getTime() > CLOCK_TOLERANCE) {
+                future += 1;
+            }
+            if (position.hasAttribute(Position.KEY_SATELLITES)) {
+                satellites.add(position.getDouble(Position.KEY_SATELLITES));
+            }
+            if (position.hasAttribute(Position.KEY_HDOP)) {
+                hdops.add(position.getDouble(Position.KEY_HDOP));
+            }
+            if (position.hasAttribute(Position.KEY_RSSI)) {
+                signals.add(signalPercent(position.getDouble(Position.KEY_RSSI)));
+            }
+            if (position.hasAttribute(Position.KEY_POWER)) {
+                power.add(position.getDouble(Position.KEY_POWER));
+            }
+            String alarm = position.getString(Position.KEY_ALARM);
+            if (alarm != null && (alarm.contains(Position.ALARM_LOW_POWER) || alarm.contains(Position.ALARM_POWER_CUT)
+                    || alarm.contains(Position.ALARM_LOW_BATTERY))) {
+                lowPowerAlarms += 1;
+            }
+            if (previous != null) {
+                long gap = position.getFixTime().getTime() - previous.getFixTime().getTime();
+                if (gap > threshold && (working(previous) || gap > SILENT_GAP)) {
+                    lostTime += gap - threshold;
+                    if (details || gaps.size() < 20) {
+                        Map<String, Object> item = new LinkedHashMap<>();
+                        item.put("start", previous.getFixTime().getTime());
+                        item.put("end", position.getFixTime().getTime());
+                        item.put("duration", gap);
+                        item.put("latitude", previous.getLatitude());
+                        item.put("longitude", previous.getLongitude());
+                        item.put("working", working(previous));
+                        gaps.add(item);
+                    }
+                }
+            }
+            previous = position;
+        }
+
+        double coverage = clamp(1 - lostTime / (double) period);
+        double validity = valid / (double) positions.size();
+        Double satelliteAverage = average(satellites);
+        Double hdopAverage = average(hdops);
+        Double signalAverage = average(signals);
+        Double powerAverage = average(power);
+
+        double gps = satelliteAverage != null ? clamp((satelliteAverage - 3) / 5) : validity;
+        if (hdopAverage != null && hdopAverage > 2) {
+            gps *= clamp(1 - (hdopAverage - 2) / 4);
+        }
+        double signal = signalAverage != null ? clamp(signalAverage / 70) : 0.8;
+        double supply = 1;
+        if (powerAverage != null && powerAverage > 0 && powerAverage < 9) {
+            supply = 0.3;
+        }
+        if (lowPowerAlarms > 0) {
+            supply = Math.min(supply, 0.5);
+        }
+        // per day over at least one day, so the first connection of a short period is not a problem
+        double reconnectsPerDay = reconnections / Math.max(1, days);
+        double stability = clamp(1 - reconnectsPerDay / 10);
+
+        double score = 35 * coverage + 25 * validity + 15 * gps + 10 * signal + 10 * supply + 5 * stability;
+        if (offline) {
+            score = Math.min(score, 40);
+        }
+        // too few positions to judge the unit well: a device sending a couple of reports a day is not excellent
+        boolean fewReports = days >= 0.25 && positions.size() / days < MIN_REPORTS_PER_DAY;
+        if (fewReports) {
+            score = Math.min(score, 60);
+        }
+
+        if (!gaps.isEmpty()) {
+            issues.add(ISSUE_GAPS);
+        }
+        if (validity < 0.8) {
+            issues.add(ISSUE_INVALID);
+        }
+        if ((satelliteAverage != null && satelliteAverage < 5) || (hdopAverage != null && hdopAverage > 3)) {
+            issues.add(ISSUE_WEAK_GPS);
+        }
+        if (signalAverage != null && signalAverage < 35) {
+            issues.add(ISSUE_WEAK_SIGNAL);
+        }
+        if (supply < 1) {
+            issues.add(ISSUE_LOW_POWER);
+        }
+        if (reconnectsPerDay > 4) {
+            issues.add(ISSUE_RECONNECTS);
+        }
+        if (future > 0) {
+            issues.add(ISSUE_CLOCK);
+        }
+        if (fewReports) {
+            issues.add(ISSUE_FEW_REPORTS);
+        }
+
+        result.put("score", Math.round(score));
+        result.put("grade", score >= 85 ? "excellent" : score >= 70 ? "good" : score >= 50 ? "fair" : "poor");
+        result.put("issues", issues);
+        result.put("interval", median / 1000);
+        result.put("coverage", Math.round(coverage * 1000) / 10.0);
+        result.put("validity", Math.round(validity * 1000) / 10.0);
+        result.put("satellites", satelliteAverage != null ? Math.round(satelliteAverage * 10) / 10.0 : null);
+        result.put("hdop", hdopAverage != null ? Math.round(hdopAverage * 10) / 10.0 : null);
+        result.put("signal", signalAverage != null ? Math.round(signalAverage) : null);
+        result.put("power", powerAverage != null ? Math.round(powerAverage * 10) / 10.0 : null);
+        result.put("lowPowerAlarms", lowPowerAlarms);
+        result.put("futureTimestamps", future);
+        result.put("gapCount", gaps.size());
+        result.put("lostTime", lostTime);
+        result.put("gaps", gaps);
+        if (details) {
+            int buckets = (int) Math.min(31 * 24, Math.ceil(period / 3600000.0));
+            int[] hourly = new int[Math.max(1, buckets)];
+            for (Position position : positions) {
+                int bucket = (int) ((position.getFixTime().getTime() - from) / 3600000);
+                if (bucket >= 0 && bucket < hourly.length) {
+                    hourly[bucket] += 1;
+                }
+            }
+            result.put("hourly", hourly);
+        }
+        return result;
+    }
+
+}
