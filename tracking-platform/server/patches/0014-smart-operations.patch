+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.NotFoundException;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.alerts.AlertSeverity;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.model.DeviceUtil;
+import org.traccar.model.AlertState;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.model.User;
+import org.traccar.model.UserRestrictions;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Alert center: the events that need attention, with priority and handling status (new, in progress, resolved or
+ * false alarm), who took them, notes and response times.
+ */
+@Path("alerts")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class AlertResource extends BaseResource {
+
+    public static final String STATUS_NEW = "new";
+    public static final String STATUS_ACK = "ack";
+    public static final String STATUS_RESOLVED = "resolved";
+    public static final String STATUS_DISMISSED = "dismissed";
+    private static final Set<String> STATUSES = Set.of(STATUS_NEW, STATUS_ACK, STATUS_RESOLVED, STATUS_DISMISSED);
+    private static final long MAX_PERIOD = 93L * 24 * 3600 * 1000;
+    private static final int LIMIT = 2000;
+
+    public static class StateUpdate {
+        private List<Long> eventIds;
+        private String status;
+        private String note;
+
+        public List<Long> getEventIds() {
+            return eventIds;
+        }
+
+        public void setEventIds(List<Long> eventIds) {
+            this.eventIds = eventIds;
+        }
+
+        public String getStatus() {
+            return status;
+        }
+
+        public void setStatus(String status) {
+            this.status = status;
+        }
+
+        public String getNote() {
+            return note;
+        }
+
+        public void setNote(String note) {
+            this.note = note;
+        }
+    }
+
+    private Map<String, String> overrides() throws StorageException {
+        return AlertSeverity.parseOverrides(permissionsService.getServer().getString("alerts.severity"));
+    }
+
+    private final Map<Long, String> userNames = new HashMap<>();
+
+    private String userName(long userId) throws StorageException {
+        if (userId == 0) {
+            return null;
+        }
+        if (!userNames.containsKey(userId)) {
+            User user = storage.getObject(User.class, new Request(
+                    new Columns.Include("name"), new Condition.Equals("id", userId)));
+            userNames.put(userId, user != null ? user.getName() : null);
+        }
+        return userNames.get(userId);
+    }
+
+    private List<Map<String, Object>> collect(
+            List<Long> deviceIds, List<Long> groupIds, Date from, Date to, List<String> statuses,
+            List<String> severities, List<String> types, boolean all) throws StorageException {
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+        Map<String, String> overrides = overrides();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Device device : DeviceUtil.getAccessibleDevices(storage, getUserId(), deviceIds, groupIds)) {
+            Map<Long, AlertState> states = new HashMap<>();
+            for (AlertState state : storage.getObjects(AlertState.class, new Request(
+                    new Columns.All(),
+                    new Condition.And(
+                            new Condition.Equals("deviceId", device.getId()),
+                            new Condition.Compare("updateTime", ">=", from))))) {
+                states.put(state.getEventId(), state);
+            }
+            for (Event event : storage.getObjects(Event.class, new Request(
+                    new Columns.All(),
+                    new Condition.And(
+                            new Condition.Equals("deviceId", device.getId()),
+                            new Condition.Between("eventTime", from, to)),
+                    new Order("eventTime", true, 0)))) {
+                if (!all && types.isEmpty() && AlertSeverity.ROUTINE.contains(event.getType())) {
+                    continue;
+                }
+                String key = AlertSeverity.key(event);
+                if (!types.isEmpty() && !types.contains(event.getType()) && !types.contains(key)) {
+                    continue;
+                }
+                String severity = AlertSeverity.of(event, overrides);
+                if (!severities.isEmpty() && !severities.contains(severity)) {
+                    continue;
+                }
+                AlertState state = states.get(event.getId());
+                String status = state != null ? state.getStatus() : STATUS_NEW;
+                if (!statuses.isEmpty() && !statuses.contains(status)) {
+                    continue;
+                }
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("id", event.getId());
+                item.put("type", event.getType());
+                item.put("key", key);
+                item.put("eventTime", event.getEventTime());
+                item.put("deviceId", device.getId());
+                item.put("deviceName", device.getName());
+                item.put("groupId", device.getGroupId());
+                item.put("positionId", event.getPositionId());
+                item.put("geofenceId", event.getGeofenceId());
+                item.put("maintenanceId", event.getMaintenanceId());
+                item.put("attributes", event.getAttributes());
+                item.put("severity", severity);
+                item.put("status", status);
+                if (state != null) {
+                    item.put("userId", state.getUserId());
+                    item.put("userName", userName(state.getUserId()));
+                    item.put("note", state.getNote());
+                    item.put("updateTime", state.getUpdateTime());
+                    item.put("history", state.getAttributes().get("history"));
+                    Object ackTime = state.getAttributes().get("ackTime");
+                    if (ackTime instanceof Number number) {
+                        item.put("responseMinutes", (number.longValue() - event.getEventTime().getTime()) / 60000.0);
+                    }
+                }
+                result.add(item);
+            }
+        }
+        result.sort(Comparator.comparing((Map<String, Object> item) -> (Date) item.get("eventTime")).reversed());
+        return result;
+    }
+
+    @GET
+    public List<Map<String, Object>> get(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to, @QueryParam("status") List<String> statuses,
+            @QueryParam("severity") List<String> severities, @QueryParam("type") List<String> types,
+            @QueryParam("all") boolean all) throws StorageException {
+        List<Map<String, Object>> items = collect(deviceIds, groupIds, from, to, statuses, severities, types, all);
+        return items.size() > LIMIT ? items.subList(0, LIMIT) : items;
+    }
+
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary(
+            @QueryParam("deviceId") List<Long> deviceIds, @QueryParam("groupId") List<Long> groupIds,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        List<Map<String, Object>> items = collect(
+                deviceIds, groupIds, from, to, List.of(), List.of(), List.of(), false);
+        Map<String, Integer> bySeverity = new LinkedHashMap<>();
+        AlertSeverity.ORDER.forEach(severity -> bySeverity.put(severity, 0));
+        Map<String, Integer> byStatus = new LinkedHashMap<>();
+        STATUSES.stream().sorted().forEach(status -> byStatus.put(status, 0));
+        Map<String, Integer> byType = new HashMap<>();
+        Map<String, Integer> byDevice = new HashMap<>();
+        Map<Integer, Integer> byHour = new LinkedHashMap<>();
+        for (int hour = 0; hour < 24; hour++) {
+            byHour.put(hour, 0);
+        }
+        double responseTotal = 0;
+        int responses = 0;
+        int openCritical = 0;
+        java.util.Calendar calendar = java.util.Calendar.getInstance();
+        for (Map<String, Object> item : items) {
+            String severity = (String) item.get("severity");
+            String status = (String) item.get("status");
+            bySeverity.merge(severity, 1, Integer::sum);
+            byStatus.merge(status, 1, Integer::sum);
+            byType.merge((String) item.get("key"), 1, Integer::sum);
+            byDevice.merge((String) item.get("deviceName"), 1, Integer::sum);
+            calendar.setTime((Date) item.get("eventTime"));
+            byHour.merge(calendar.get(java.util.Calendar.HOUR_OF_DAY), 1, Integer::sum);
+            if (item.get("responseMinutes") instanceof Double minutes) {
+                responseTotal += minutes;
+                responses += 1;
+            }
+            if (AlertSeverity.CRITICAL.equals(severity) && (STATUS_NEW.equals(status) || STATUS_ACK.equals(status))) {
+                openCritical += 1;
+            }
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("total", items.size());
+        result.put("open", byStatus.get(STATUS_NEW) + byStatus.get(STATUS_ACK));
+        result.put("openCritical", openCritical);
+        result.put("bySeverity", bySeverity);
+        result.put("byStatus", byStatus);
+        result.put("byType", top(byType, 8));
+        result.put("byDevice", top(byDevice, 5));
+        result.put("byHour", byHour);
+        result.put("avgResponseMinutes", responses > 0 ? responseTotal / responses : null);
+        result.put("handledPercent", items.isEmpty() ? null
+                : (items.size() - byStatus.get(STATUS_NEW)) * 100.0 / items.size());
+        return result;
+    }
+
+    private static List<Map<String, Object>> top(Map<String, Integer> counts, int limit) {
+        return counts.entrySet().stream()
+                .sorted(Map.Entry.<String, Integer>comparingByValue().reversed())
+                .limit(limit)
+                .map(entry -> {
+                    Map<String, Object> item = new LinkedHashMap<>();
+                    item.put("key", entry.getKey());
+                    item.put("count", entry.getValue());
+                    return item;
+                })
+                .toList();
+    }
+
+    private AlertState update(long eventId, String status, String note) throws StorageException {
+        if (!STATUSES.contains(status)) {
+            throw new BadRequestException("Invalid status");
+        }
+        Event event = storage.getObject(Event.class, new Request(
+                new Columns.All(), new Condition.Equals("id", eventId)));
+        if (event == null) {
+            throw new NotFoundException();
+        }
+        permissionsService.checkPermission(Device.class, getUserId(), event.getDeviceId());
+        AlertState state = storage.getObject(AlertState.class, new Request(
+                new Columns.All(), new Condition.Equals("eventId", eventId)));
+        boolean created = state == null;
+        if (created) {
+            state = new AlertState();
+            state.setEventId(eventId);
+            state.setDeviceId(event.getDeviceId());
+        }
+        Date now = new Date();
+        state.setStatus(status);
+        state.setUserId(getUserId());
+        if (note != null && !note.isBlank()) {
+            state.setNote(note.length() > 4000 ? note.substring(0, 4000) : note);
+        }
+        state.setUpdateTime(now);
+        if (!STATUS_NEW.equals(status) && !state.hasAttribute("ackTime")) {
+            state.set("ackTime", now.getTime());
+        }
+        @SuppressWarnings("unchecked")
+        List<Object> history = state.getAttributes().get("history") instanceof List<?> list
+                ? new ArrayList<>((List<Object>) list) : new ArrayList<>();
+        Map<String, Object> entry = new LinkedHashMap<>();
+        entry.put("time", now.getTime());
+        entry.put("userId", getUserId());
+        entry.put("userName", userName(getUserId()));
+        entry.put("status", status);
+        if (note != null && !note.isBlank()) {
+            entry.put("note", note.length() > 300 ? note.substring(0, 300) : note);
+        }
+        history.add(entry);
+        while (history.size() > 10) {
+            history.remove(0);
+        }
+        state.getAttributes().put("history", history);
+        if (created) {
+            state.setId(storage.addObject(state, new Request(new Columns.Exclude("id"))));
+        } else {
+            storage.updateObject(state, new Request(
+                    new Columns.Exclude("id"), new Condition.Equals("id", state.getId())));
+        }
+        return state;
+    }
+
+    @POST
+    @Path("{eventId}")
+    public AlertState updateOne(@PathParam("eventId") long eventId, StateUpdate update) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        return update(eventId, update.getStatus(), update.getNote());
+    }
+
+    @POST
+    @Path("batch")
+    public Collection<AlertState> updateMany(StateUpdate update) throws StorageException {
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getReadonly);
+        if (update.getEventIds() == null || update.getEventIds().isEmpty() || update.getEventIds().size() > 500) {
+            throw new BadRequestException("Invalid events");
+        }
+        List<AlertState> result = new ArrayList<>();
+        for (long eventId : update.getEventIds()) {
+            result.add(update(eventId, update.getStatus(), update.getNote()));
+        }
+        return result;
+    }
+
+    @GET
+    @Path("position/{eventId}")
+    public Position position(@PathParam("eventId") long eventId) throws StorageException {
+        Event event = storage.getObject(Event.class, new Request(
+                new Columns.All(), new Condition.Equals("id", eventId)));
+        if (event == null || event.getPositionId() == 0) {
+            throw new NotFoundException();
+        }
+        permissionsService.checkPermission(Device.class, getUserId(), event.getDeviceId());
+        return storage.getObject(Position.class, new Request(
+                new Columns.All(), new Condition.Equals("id", event.getPositionId())));
+    }
+
+}
