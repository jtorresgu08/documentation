+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.sensor;
+
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
+import org.traccar.model.Position;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * A unit sensor, GPS-Server / WOX style: reads a position attribute (io201, adc1, fuel...) and turns it into a value
+ * with a calibration table (piecewise linear) or a multiplier and offset. Fuel sensors also carry the fill and drain
+ * detection settings.
+ */
+@JsonIgnoreProperties(ignoreUnknown = true)
+public class Sensor {
+
+    public static final String TYPE_FUEL = "fuel";
+    public static final String TYPE_BINARY = "binary";
+
+    public static final String ATTRIBUTE_PREFIX = "sensor.";
+
+    private String id;
+    private String name;
+    private String type = "numeric";
+    private String source;
+    private List<double[]> calibration = new ArrayList<>();
+    private double multiplier = 1;
+    private double offset;
+    private String unit;
+    private boolean invert;
+    private double tankCapacity;
+    private double minFill = 10;
+    private double minDrain = 10;
+    private int waitTime = 120;
+    private int filter = 5;
+    private boolean stoppedOnly = true;
+    private double speedThreshold = 5;
+
+    public String getId() {
+        return id;
+    }
+
+    public void setId(String id) {
+        this.id = id;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public void setName(String name) {
+        this.name = name;
+    }
+
+    public String getType() {
+        return type;
+    }
+
+    public void setType(String type) {
+        this.type = type;
+    }
+
+    public String getSource() {
+        return source;
+    }
+
+    public void setSource(String source) {
+        this.source = source;
+    }
+
+    public List<double[]> getCalibration() {
+        return calibration;
+    }
+
+    public void setCalibration(List<double[]> calibration) {
+        this.calibration = calibration != null ? calibration : new ArrayList<>();
+    }
+
+    public double getMultiplier() {
+        return multiplier;
+    }
+
+    public void setMultiplier(double multiplier) {
+        this.multiplier = multiplier;
+    }
+
+    public double getOffset() {
+        return offset;
+    }
+
+    public void setOffset(double offset) {
+        this.offset = offset;
+    }
+
+    public String getUnit() {
+        return unit;
+    }
+
+    public void setUnit(String unit) {
+        this.unit = unit;
+    }
+
+    public boolean getInvert() {
+        return invert;
+    }
+
+    public void setInvert(boolean invert) {
+        this.invert = invert;
+    }
+
+    public double getTankCapacity() {
+        return tankCapacity;
+    }
+
+    public void setTankCapacity(double tankCapacity) {
+        this.tankCapacity = tankCapacity;
+    }
+
+    public double getMinFill() {
+        return minFill;
+    }
+
+    public void setMinFill(double minFill) {
+        this.minFill = minFill;
+    }
+
+    public double getMinDrain() {
+        return minDrain;
+    }
+
+    public void setMinDrain(double minDrain) {
+        this.minDrain = minDrain;
+    }
+
+    public int getWaitTime() {
+        return waitTime;
+    }
+
+    public void setWaitTime(int waitTime) {
+        this.waitTime = waitTime;
+    }
+
+    public int getFilter() {
+        return filter;
+    }
+
+    public void setFilter(int filter) {
+        this.filter = filter;
+    }
+
+    public boolean getStoppedOnly() {
+        return stoppedOnly;
+    }
+
+    public void setStoppedOnly(boolean stoppedOnly) {
+        this.stoppedOnly = stoppedOnly;
+    }
+
+    public double getSpeedThreshold() {
+        return speedThreshold;
+    }
+
+    public void setSpeedThreshold(double speedThreshold) {
+        this.speedThreshold = speedThreshold;
+    }
+
+    public String getKey() {
+        return ATTRIBUTE_PREFIX + id;
+    }
+
+    public static Double readRaw(Position position, String source) {
+        if (source == null || !position.hasAttribute(source)) {
+            return null;
+        }
+        Object value = position.getAttributes().get(source);
+        if (value instanceof Number number) {
+            return number.doubleValue();
+        } else if (value instanceof Boolean bool) {
+            return bool ? 1.0 : 0.0;
+        } else if (value instanceof String string) {
+            try {
+                return Double.parseDouble(string);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    public Double convert(double raw) {
+        if (TYPE_BINARY.equals(type)) {
+            return (raw != 0) != invert ? 1.0 : 0.0;
+        }
+        List<double[]> points = calibration.stream()
+                .filter(point -> point != null && point.length >= 2)
+                .sorted(Comparator.comparingDouble(point -> point[0]))
+                .toList();
+        if (points.size() >= 2) {
+            if (raw <= points.get(0)[0]) {
+                return points.get(0)[1];
+            }
+            for (int i = 1; i < points.size(); i++) {
+                double[] low = points.get(i - 1);
+                double[] high = points.get(i);
+                if (raw <= high[0]) {
+                    double span = high[0] - low[0];
+                    return span == 0 ? high[1] : low[1] + (raw - low[0]) * (high[1] - low[1]) / span;
+                }
+            }
+            return points.get(points.size() - 1)[1];
+        }
+        return raw * multiplier + offset;
+    }
+
+    public Double compute(Position position) {
+        Double raw = readRaw(position, source);
+        return raw != null ? convert(raw) : null;
+    }
+
+}
