@@ -0,0 +1,114 @@
+package org.traccar.sensor;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class FuelAnalyzerTest {
+
+    private final List<FuelAnalyzer.Sample> samples = new ArrayList<>();
+    private long time;
+
+    private void add(int count, double value, double speed) {
+        for (int i = 0; i < count; i++) {
+            time += 30_000;
+            samples.add(new FuelAnalyzer.Sample(time, value, speed, 0, 0, samples.size() + 1));
+        }
+    }
+
+    private Sensor sensor() {
+        Sensor sensor = new Sensor();
+        sensor.setId("t1");
+        sensor.setType(Sensor.TYPE_FUEL);
+        sensor.setMinFill(20);
+        sensor.setMinDrain(15);
+        sensor.setWaitTime(120);
+        return sensor;
+    }
+
+    @Test
+    public void testCalibration() {
+        Sensor sensor = sensor();
+        sensor.setCalibration(List.of(new double[] {0, 0}, new double[] {4095, 400}, new double[] {2000, 180}));
+        assertEquals(0, sensor.convert(-5));
+        assertEquals(90, sensor.convert(1000), 0.01);
+        assertEquals(400, sensor.convert(5000));
+        sensor.setCalibration(null);
+        sensor.setMultiplier(0.1);
+        assertEquals(12.3, sensor.convert(123), 0.0001);
+    }
+
+    @Test
+    public void testFillAndDrainWhileStopped() {
+        add(10, 100, 60);
+        add(5, 100, 0);
+        add(10, 160, 0);
+        add(10, 160, 50);
+        add(5, 160, 0);
+        add(10, 130, 0);
+        add(5, 130, 40);
+        var result = FuelAnalyzer.analyze(samples, sensor());
+        assertEquals(2, result.changes().size());
+        assertEquals(FuelAnalyzer.FILL, result.changes().get(0).type());
+        assertEquals(60, result.changes().get(0).amount(), 0.01);
+        assertEquals(FuelAnalyzer.DRAIN, result.changes().get(1).type());
+        assertEquals(-30, result.changes().get(1).amount(), 0.01);
+        assertEquals(60, result.filled(), 0.01);
+        assertEquals(30, result.drained(), 0.01);
+    }
+
+    @Test
+    public void testIgnoredChanges() {
+        add(10, 100, 0);
+        add(3, 70, 0);
+        add(10, 100, 0);
+        add(10, 100, 60);
+        add(2, 140, 60);
+        add(10, 100, 60);
+        add(5, 100, 0);
+        add(10, 92, 0);
+        var result = FuelAnalyzer.analyze(samples, sensor());
+        assertTrue(result.changes().isEmpty());
+    }
+
+    @Test
+    public void testPendingUntilWaitTime() {
+        add(10, 100, 0);
+        add(2, 150, 0);
+        var result = FuelAnalyzer.analyze(samples, sensor());
+        assertTrue(result.changes().isEmpty());
+        assertTrue(result.pending());
+        add(5, 150, 0);
+        assertEquals(1, FuelAnalyzer.analyze(samples, sensor()).changes().size());
+    }
+
+    @Test
+    public void testLiveWaitsForGradualFill() {
+        add(10, 100, 0);
+        for (int i = 1; i <= 6; i++) {
+            add(1, 100 + i * 30, 0);
+        }
+        assertTrue(FuelAnalyzer.analyze(samples, sensor(), false).changes().isEmpty());
+        add(6, 280, 0);
+        var changes = FuelAnalyzer.analyze(samples, sensor(), false).changes();
+        assertEquals(1, changes.size());
+        assertEquals(180, changes.get(0).amount(), 0.01);
+    }
+
+    @Test
+    public void testSlowDrainAfterLongStop() {
+        add(70, 100, 0);
+        for (int i = 1; i <= 8; i++) {
+            add(1, 100 - i * 5, 0);
+        }
+        add(10, 60, 0);
+        var changes = FuelAnalyzer.analyze(samples, sensor()).changes();
+        assertEquals(1, changes.size());
+        assertEquals(-40, changes.get(0).amount(), 0.01);
+    }
+
+}
