+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.handler.events;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.sensor.FuelAnalyzer;
+import org.traccar.sensor.Sensor;
+import org.traccar.sensor.SensorConfig;
+import org.traccar.session.cache.CacheManager;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Live fuel fill and drain alerts from the unit fuel sensors. Keeps the recent levels of each sensor in memory, runs
+ * the same analysis as the fuel report and raises deviceFuelIncrease / deviceFuelDrop once a change is confirmed.
+ */
+public class FuelSensorEventHandler extends BaseEventHandler {
+
+    static final int MAX_SAMPLES = 2000;
+    static final long MAX_AGE = 24 * 60 * 60 * 1000L;
+
+    private final CacheManager cacheManager;
+    private final ObjectMapper objectMapper;
+
+    private final Map<String, State> states = new ConcurrentHashMap<>();
+
+    private static final class State {
+        private final LinkedList<FuelAnalyzer.Sample> samples = new LinkedList<>();
+        private long lastReported;
+    }
+
+    @Inject
+    public FuelSensorEventHandler(CacheManager cacheManager, ObjectMapper objectMapper) {
+        this.cacheManager = cacheManager;
+        this.objectMapper = objectMapper;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        Device device = cacheManager.getObject(Device.class, position.getDeviceId());
+        if (device == null || !PositionUtil.isLatest(cacheManager, position)) {
+            return;
+        }
+        for (Sensor sensor : SensorConfig.fuelSensors(objectMapper, device)) {
+            Double value = sensor.compute(position);
+            if (value == null) {
+                continue;
+            }
+            for (Event event : update(device.getId(), sensor, position, value)) {
+                callback.eventDetected(event);
+            }
+        }
+    }
+
+    List<Event> update(long deviceId, Sensor sensor, Position position, double value) {
+        long time = position.getFixTime().getTime();
+        State state = states.computeIfAbsent(deviceId + "/" + sensor.getId(), key -> {
+            State created = new State();
+            created.lastReported = time;
+            return created;
+        });
+        List<Event> events = new ArrayList<>();
+        synchronized (state) {
+            if (!state.samples.isEmpty() && state.samples.getLast().time() >= time) {
+                return events;
+            }
+            state.samples.add(new FuelAnalyzer.Sample(
+                    time, value, UnitsConverter.kphFromKnots(position.getSpeed()),
+                    position.getLatitude(), position.getLongitude(), position.getId()));
+            while (state.samples.size() > MAX_SAMPLES || state.samples.getFirst().time() < time - MAX_AGE) {
+                state.samples.removeFirst();
+            }
+            for (FuelAnalyzer.Change change : FuelAnalyzer.analyze(state.samples, sensor, false).changes()) {
+                if (change.time() > state.lastReported) {
+                    state.lastReported = change.time();
+                    Event event = new Event(FuelAnalyzer.FILL.equals(change.type())
+                            ? Event.TYPE_DEVICE_FUEL_INCREASE : Event.TYPE_DEVICE_FUEL_DROP, position);
+                    event.setEventTime(new Date(change.time()));
+                    if (change.positionId() > 0) {
+                        event.setPositionId(change.positionId());
+                    }
+                    event.set("sensor", sensor.getName());
+                    event.set("before", Math.round(change.before() * 10) / 10.0);
+                    event.set("after", Math.round(change.after() * 10) / 10.0);
+                    event.set("amount", Math.round(Math.abs(change.amount()) * 10) / 10.0);
+                    events.add(event);
+                }
+            }
+        }
+        return events;
+    }
+
+}
diff --git a/src/main/java/org/traccar/sensor/FuelAnalyzer.java b/src/main/java/org/traccar/sensor/FuelAnalyzer.java
new file mode 100644
index 0000000..b36d38d
--- /dev/null
+++ b/src/main/java/org/traccar/sensor/FuelAnalyzer.java
@@ -0,0 +1,164 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.sensor;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Finds fuel fills and drains in a fuel level series. Levels are first smoothed with a median filter, changes are
+ * only searched while the unit is stopped (when the sensor asks for it) and a change counts only when it still holds
+ * after the wait time, so tank sloshing on curves, slopes or braking is not reported. The reference level follows the
+ * unit while it moves and ages out after a while when stopped, so idling consumption is not taken as a drain. A change
+ * is closed once the level stops rising or falling; with live data (incomplete) it stays pending until then.
+ */
+public final class FuelAnalyzer {
+
+    public static final String FILL = "fill";
+    public static final String DRAIN = "drain";
+
+    static final long REFERENCE_AGE = 30 * 60 * 1000L;
+
+    private FuelAnalyzer() {
+    }
+
+    public record Sample(long time, double value, double speed, double latitude, double longitude, long positionId) {
+    }
+
+    public record Change(
+            String type, long time, long endTime, double before, double after, double amount,
+            double latitude, double longitude, long positionId) {
+    }
+
+    public record Result(double[] smoothed, List<Change> changes, boolean pending) {
+
+        public double filled() {
+            return changes.stream().filter(change -> FILL.equals(change.type())).mapToDouble(Change::amount).sum();
+        }
+
+        public double drained() {
+            return -changes.stream().filter(change -> DRAIN.equals(change.type())).mapToDouble(Change::amount).sum();
+        }
+
+        public double start() {
+            return smoothed.length > 0 ? smoothed[0] : 0;
+        }
+
+        public double end() {
+            return smoothed.length > 0 ? smoothed[smoothed.length - 1] : 0;
+        }
+
+        public double consumed() {
+            return Math.max(0, start() - end() + filled() - drained());
+        }
+
+    }
+
+    static double[] smooth(List<Sample> samples, int window) {
+        int half = Math.max(0, window) / 2;
+        double[] result = new double[samples.size()];
+        for (int i = 0; i < samples.size(); i++) {
+            int from = Math.max(0, i - half);
+            int to = Math.min(samples.size() - 1, i + half);
+            double[] values = new double[to - from + 1];
+            for (int j = from; j <= to; j++) {
+                values[j - from] = samples.get(j).value();
+            }
+            Arrays.sort(values);
+            int middle = values.length / 2;
+            result[i] = values.length % 2 == 1 ? values[middle] : (values[middle - 1] + values[middle]) / 2;
+        }
+        return result;
+    }
+
+    public static Result analyze(List<Sample> samples, Sensor sensor) {
+        return analyze(samples, sensor, true);
+    }
+
+    public static Result analyze(List<Sample> samples, Sensor sensor, boolean complete) {
+        int count = samples.size();
+        double[] smoothed = smooth(samples, sensor.getFilter());
+        boolean[] moving = new boolean[count];
+        for (int i = 0; i < count; i++) {
+            moving[i] = sensor.getStoppedOnly() && samples.get(i).speed() > sensor.getSpeedThreshold();
+        }
+        List<Change> changes = new ArrayList<>();
+        if (count == 0) {
+            return new Result(smoothed, changes, false);
+        }
+
+        long wait = Math.max(0, sensor.getWaitTime()) * 1000L;
+        // the reference only ages out on a small drift, never in the middle of a change
+        double drift = Math.min(
+                sensor.getMinFill() > 0 ? sensor.getMinFill() : Double.MAX_VALUE,
+                sensor.getMinDrain() > 0 ? sensor.getMinDrain() : Double.MAX_VALUE) / 4;
+        double reference = smoothed[0];
+        long referenceTime = samples.get(0).time();
+        boolean pending = false;
+        int i = 1;
+        while (i < count) {
+            Sample sample = samples.get(i);
+            if (moving[i]) {
+                reference = smoothed[i];
+                referenceTime = sample.time();
+                i += 1;
+                continue;
+            }
+            double difference = smoothed[i] - reference;
+            boolean fill = sensor.getMinFill() > 0 && difference >= sensor.getMinFill();
+            boolean drain = sensor.getMinDrain() > 0 && -difference >= sensor.getMinDrain();
+            if (!fill && !drain) {
+                if (sample.time() - referenceTime > REFERENCE_AGE && Math.abs(difference) < drift) {
+                    reference = smoothed[i];
+                    referenceTime = sample.time();
+                }
+                i += 1;
+                continue;
+            }
+
+            int end = i;
+            while (end < count && samples.get(end).time() < sample.time() + wait) {
+                end += 1;
+            }
+            if (end >= count) {
+                pending = true;
+                break;
+            }
+            double threshold = fill ? sensor.getMinFill() : sensor.getMinDrain();
+            double step = threshold * 0.05;
+            while (end + 1 < count && !moving[end + 1]
+                    && (fill ? smoothed[end + 1] > smoothed[end] + step : smoothed[end + 1] < smoothed[end] - step)) {
+                end += 1;
+            }
+            if (!complete && end + 1 >= count) {
+                pending = true;
+                break;
+            }
+            double amount = smoothed[end] - reference;
+            if (fill ? amount >= threshold : -amount >= threshold) {
+                changes.add(new Change(
+                        fill ? FILL : DRAIN, sample.time(), samples.get(end).time(), reference, smoothed[end], amount,
+                        sample.latitude(), sample.longitude(), sample.positionId()));
+                reference = smoothed[end];
+                referenceTime = samples.get(end).time();
+                i = end + 1;
+            } else {
+                i += 1;
+            }
+        }
+        return new Result(smoothed, changes, pending);
+    }
+
+}
