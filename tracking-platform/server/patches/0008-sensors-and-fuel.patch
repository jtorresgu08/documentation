+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.BadRequestException;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Device;
+import org.traccar.model.Position;
+import org.traccar.model.UserRestrictions;
+import org.traccar.sensor.FuelAnalyzer;
+import org.traccar.sensor.Sensor;
+import org.traccar.sensor.SensorConfig;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Fuel report of a unit fuel sensor: level series for the chart, detected fills and drains and the period summary.
+ * Levels are recomputed from the raw parameter, so calibration changes also apply to past data.
+ */
+@Path("sensors")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class SensorResource extends BaseResource {
+
+    private static final long MAX_PERIOD = 62L * 24 * 60 * 60 * 1000;
+    private static final int MAX_POINTS = 4000;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    private static double round(double value) {
+        return Math.round(value * 100) / 100.0;
+    }
+
+    @GET
+    @Path("fuel")
+    public Map<String, Object> fuel(
+            @QueryParam("deviceId") long deviceId, @QueryParam("sensorId") String sensorId,
+            @QueryParam("from") Date from, @QueryParam("to") Date to) throws StorageException {
+        permissionsService.checkPermission(Device.class, getUserId(), deviceId);
+        permissionsService.checkRestriction(getUserId(), UserRestrictions::getDisableReports);
+        if (from == null || to == null || !to.after(from) || to.getTime() - from.getTime() > MAX_PERIOD) {
+            throw new BadRequestException("Invalid period");
+        }
+        Device device = storage.getObject(Device.class, new Request(
+                new Columns.All(), new Condition.Equals("id", deviceId)));
+        Sensor sensor = SensorConfig.fuelSensors(objectMapper, device).stream()
+                .filter(item -> sensorId == null || sensorId.equals(item.getId()))
+                .findFirst()
+                .orElseThrow(() -> new BadRequestException("No fuel sensor"));
+
+        List<FuelAnalyzer.Sample> samples = new ArrayList<>();
+        Position first = null;
+        Position last = null;
+        for (Position position : PositionUtil.getPositions(storage, deviceId, from, to)) {
+            if (first == null) {
+                first = position;
+            }
+            last = position;
+            Double value = sensor.compute(position);
+            if (value != null) {
+                samples.add(new FuelAnalyzer.Sample(
+                        position.getFixTime().getTime(), value, UnitsConverter.kphFromKnots(position.getSpeed()),
+                        position.getLatitude(), position.getLongitude(), position.getId()));
+            }
+        }
+        FuelAnalyzer.Result analysis = FuelAnalyzer.analyze(samples, sensor);
+
+        List<Map<String, Object>> points = new ArrayList<>();
+        int step = Math.max(1, (samples.size() + MAX_POINTS - 1) / MAX_POINTS);
+        for (int i = 0; i < samples.size(); i += step) {
+            var sample = samples.get(i);
+            Map<String, Object> point = new LinkedHashMap<>();
+            point.put("time", sample.time());
+            point.put("value", round(sample.value()));
+            point.put("level", round(analysis.smoothed()[i]));
+            point.put("speed", Math.round(sample.speed()));
+            point.put("latitude", sample.latitude());
+            point.put("longitude", sample.longitude());
+            points.add(point);
+        }
+
+        List<Map<String, Object>> changes = new ArrayList<>();
+        for (var change : analysis.changes()) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("type", change.type());
+            item.put("time", change.time());
+            item.put("endTime", change.endTime());
+            item.put("before", round(change.before()));
+            item.put("after", round(change.after()));
+            item.put("amount", round(Math.abs(change.amount())));
+            item.put("latitude", change.latitude());
+            item.put("longitude", change.longitude());
+            item.put("positionId", change.positionId());
+            changes.add(item);
+        }
+
+        Map<String, Object> summary = new LinkedHashMap<>();
+        summary.put("start", round(analysis.start()));
+        summary.put("end", round(analysis.end()));
+        summary.put("filled", round(analysis.filled()));
+        summary.put("drained", round(analysis.drained()));
+        summary.put("consumed", round(analysis.consumed()));
+        summary.put("startTime", samples.isEmpty() ? null : samples.get(0).time());
+        summary.put("endTime", samples.isEmpty() ? null : samples.get(samples.size() - 1).time());
+        double distance = first != null ? (last.getDouble(Position.KEY_TOTAL_DISTANCE)
+                - first.getDouble(Position.KEY_TOTAL_DISTANCE)) / 1000 : 0;
+        summary.put("distance", round(Math.max(0, distance)));
+        summary.put("fills", analysis.changes().stream().filter(c -> FuelAnalyzer.FILL.equals(c.type())).count());
+        summary.put("drains", analysis.changes().stream().filter(c -> FuelAnalyzer.DRAIN.equals(c.type())).count());
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("sensor", sensor);
+        result.put("points", points);
+        result.put("changes", changes);
+        result.put("summary", summary);
+        return result;
+    }
+
+}
