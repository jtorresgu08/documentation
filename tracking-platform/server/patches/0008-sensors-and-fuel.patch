+package org.traccar.sensor;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.model.Device;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Sensors of a unit, kept as a JSON array in the "sensors" device attribute.
+ */
+public final class SensorConfig {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(SensorConfig.class);
+
+    public static final String ATTRIBUTE = "sensors";
+
+    private static final Map<String, List<Sensor>> CACHE = new ConcurrentHashMap<>();
+
+    private SensorConfig() {
+    }
+
+    public static List<Sensor> parse(ObjectMapper objectMapper, Device device) {
+        String json = device != null ? device.getString(ATTRIBUTE) : null;
+        if (json == null || json.isBlank()) {
+            return List.of();
+        }
+        List<Sensor> cached = CACHE.get(json);
+        if (cached != null) {
+            return cached;
+        }
+        try {
+            List<Sensor> sensors = objectMapper.readValue(json, new TypeReference<List<Sensor>>() { }).stream()
+                    .filter(Objects::nonNull)
+                    .filter(sensor -> sensor.getId() != null && sensor.getSource() != null)
+                    .toList();
+            if (CACHE.size() > 10000) {
+                CACHE.clear();
+            }
+            CACHE.put(json, sensors);
+            return sensors;
+        } catch (Exception e) {
+            LOGGER.warn("Invalid sensors of device {}", device.getId(), e);
+            return List.of();
+        }
+    }
+
+    public static List<Sensor> fuelSensors(ObjectMapper objectMapper, Device device) {
+        return parse(objectMapper, device).stream()
+                .filter(sensor -> Sensor.TYPE_FUEL.equals(sensor.getType()))
+                .toList();
+    }
+
+}
diff --git a/src/test/java/org/traccar/sensor/FuelAnalyzerTest.java b/src/test/java/org/traccar/sensor/FuelAnalyzerTest.java
