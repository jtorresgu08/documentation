+    @Test
+    public void testRenewingServiceRollsAndReportsExpiry() {
+        long day = FleetMaintenance.DAY;
+        long now = 1_700_000_000_000L;
+        Maintenance maintenance = plan("fixTime", now - 370 * day, 365 * day);
+        maintenance.set(FleetMaintenance.RENEW, true);
+        maintenance.set("notice", 15.0 * day);
+        var status = FleetMaintenance.status(maintenance, now, null, null, now);
+        assertEquals((double) (now - 5 * day), status.get("expired"));
+        assertEquals((double) (now + 360 * day), status.get("next"));
+        assertEquals(FleetMaintenance.OK, status.get("state"));
+        var reminders = TaskMaintenanceReminder.reminders(status);
+        assertEquals(1, reminders.size());
+        assertEquals(FleetMaintenance.OVERDUE, reminders.get(0)[0]);
+        assertTrue(TaskMaintenanceReminder.mailBody(new Device(), status, FleetMaintenance.OVERDUE)
