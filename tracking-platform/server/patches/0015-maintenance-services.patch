+        assertEquals(FleetMaintenance.SOON, soon.get("state"));
+        var overdue = FleetMaintenance.status(maintenance, 1_900 * 3_600_000.0, null, null, now);
+        assertEquals(FleetMaintenance.OVERDUE, overdue.get("state")); // no auto roll: stays overdue at 1,250 h
+        assertEquals(1_250 * 3_600_000.0, overdue.get("next"));
+        assertFalse(overdue.containsKey("expired"));
