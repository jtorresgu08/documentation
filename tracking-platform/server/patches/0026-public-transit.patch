diff --git a/src/main/java/org/traccar/api/resource/TransitResource.java b/src/main/java/org/traccar/api/resource/TransitResource.java
new file mode 100644
index 0000000..e1b50ee
--- /dev/null
+++ b/src/main/java/org/traccar/api/resource/TransitResource.java
@@ -0,0 +1,423 @@
+/*
