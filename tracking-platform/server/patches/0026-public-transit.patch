diff --git a/src/main/java/org/traccar/transit/TransitGeometry.java b/src/main/java/org/traccar/transit/TransitGeometry.java
new file mode 100644
index 0000000..415893c
--- /dev/null
+++ b/src/main/java/org/traccar/transit/TransitGeometry.java
@@ -0,0 +1,179 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.transit;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Geometry of a line: points of its path in a local metric projection with the cumulative distance, projection of a
+ * position onto the path (distance travelled along the line and offset from it) preferring the stretch closest to
+ * where the unit was before (lines that go and come back on the same street), and distance along the line between
+ * two units, wrapping around on circular lines.
+ */
+public final class TransitGeometry {
+
+    private static final double EARTH = 6371008.8;
+    private static final double RAD = Math.PI / 180;
+
+    private final double lat0;
+    private final double[] x;
+    private final double[] y;
+    private final double[] cumulative;
+    private final boolean circular;
+
+    public record Projection(double along, double offset) {
+    }
+
+    /**
+     * @param points path as [latitude, longitude] pairs, at least two
+     */
+    public TransitGeometry(List<double[]> points, boolean circular) {
+        if (points.size() < 2) {
+            throw new IllegalArgumentException("A line needs at least two points");
+        }
+        this.circular = circular;
+        lat0 = points.stream().mapToDouble(point -> point[0]).average().orElse(0) * RAD;
+        int count = points.size();
+        x = new double[count];
+        y = new double[count];
+        cumulative = new double[count];
+        for (int i = 0; i < count; i++) {
+            x[i] = points.get(i)[1] * RAD * Math.cos(lat0) * EARTH;
+            y[i] = points.get(i)[0] * RAD * EARTH;
+            if (i > 0) {
+                cumulative[i] = cumulative[i - 1] + Math.hypot(x[i] - x[i - 1], y[i] - y[i - 1]);
+            }
+        }
+    }
+
+    public double length() {
+        return cumulative[cumulative.length - 1];
+    }
+
+    public boolean circular() {
+        return circular;
+    }
+
+    /**
+     * Projects a position; with a previous distance along the line, among the stretches within 40 m of the closest
+     * one it picks the one reached moving forward the least from there.
+     */
+    public Projection project(double latitude, double longitude, Double previous) {
+        double px = longitude * RAD * Math.cos(lat0) * EARTH;
+        double py = latitude * RAD * EARTH;
+        List<double[]> candidates = new ArrayList<>();
+        double best = Double.MAX_VALUE;
+        for (int i = 0; i < x.length - 1; i++) {
+            double dx = x[i + 1] - x[i];
+            double dy = y[i + 1] - y[i];
+            double squared = dx * dx + dy * dy;
+            double t = squared > 0 ? ((px - x[i]) * dx + (py - y[i]) * dy) / squared : 0;
+            t = Math.max(0, Math.min(1, t));
+            double distance = Math.hypot(px - (x[i] + t * dx), py - (y[i] + t * dy));
+            candidates.add(new double[] {cumulative[i] + t * Math.sqrt(squared), distance});
+            best = Math.min(best, distance);
+        }
+        double[] chosen = null;
+        for (double[] candidate : candidates) {
+            if (candidate[1] > best + 40) {
+                continue;
+            }
+            if (chosen == null) {
+                chosen = candidate;
+            } else if (previous != null) {
+                if (forward(previous, candidate[0]) < forward(previous, chosen[0])) {
+                    chosen = candidate;
+                }
+            } else if (candidate[1] < chosen[1]) {
+                chosen = candidate;
+            }
+        }
+        return new Projection(chosen[0], chosen[1]);
+    }
+
+    /**
+     * Distance moving forward along the line from one position to another (on linear lines, negative if behind).
+     */
+    public double forward(double from, double to) {
+        double difference = to - from;
+        if (circular) {
+            double length = length();
+            return ((difference % length) + length) % length;
+        }
+        return difference >= -30 ? Math.max(0, difference) : Double.MAX_VALUE / 4 - difference;
+    }
+
+    /**
+     * Distance along the line from a unit to the one ahead of it.
+     */
+    public double gap(double behind, double ahead) {
+        double difference = ahead - behind;
+        if (circular) {
+            double length = length();
+            return ((difference % length) + length) % length;
+        }
+        return difference;
+    }
+
+    /**
+     * Douglas-Peucker simplification of a [latitude, longitude] path with a tolerance in meters.
+     */
+    public static List<double[]> simplify(List<double[]> points, double tolerance) {
+        if (points.size() <= 2) {
+            return points;
+        }
+        double base = points.get(0)[0] * RAD;
+        boolean[] keep = new boolean[points.size()];
+        keep[0] = true;
+        keep[points.size() - 1] = true;
+        java.util.ArrayDeque<int[]> stack = new java.util.ArrayDeque<>();
+        stack.push(new int[] {0, points.size() - 1});
+        while (!stack.isEmpty()) {
+            int[] range = stack.pop();
+            double ax = points.get(range[0])[1] * RAD * Math.cos(base) * EARTH;
+            double ay = points.get(range[0])[0] * RAD * EARTH;
+            double bx = points.get(range[1])[1] * RAD * Math.cos(base) * EARTH;
+            double by = points.get(range[1])[0] * RAD * EARTH;
+            double dx = bx - ax;
+            double dy = by - ay;
+            double squared = dx * dx + dy * dy;
+            int index = -1;
+            double max = tolerance;
+            for (int i = range[0] + 1; i < range[1]; i++) {
+                double px = points.get(i)[1] * RAD * Math.cos(base) * EARTH;
+                double py = points.get(i)[0] * RAD * EARTH;
+                double t = squared > 0 ? Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / squared)) : 0;
+                double distance = Math.hypot(px - (ax + t * dx), py - (ay + t * dy));
+                if (distance > max) {
+                    max = distance;
+                    index = i;
+                }
+            }
+            if (index > 0) {
+                keep[index] = true;
+                stack.push(new int[] {range[0], index});
+                stack.push(new int[] {index, range[1]});
+            }
+        }
+        List<double[]> result = new ArrayList<>();
+        for (int i = 0; i < points.size(); i++) {
+            if (keep[i]) {
+                result.add(points.get(i));
+            }
+        }
+        return result;
+    }
+
+}
diff --git a/src/main/java/org/traccar/transit/TransitService.java b/src/main/java/org/traccar/transit/TransitService.java
