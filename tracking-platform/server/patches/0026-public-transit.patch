+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.api.resource;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.model.Device;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.TransitRoute;
+import org.traccar.model.TransitVisit;
+import org.traccar.model.User;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Order;
+import org.traccar.storage.query.Request;
+import org.traccar.transit.TransitGeometry;
+import org.traccar.transit.TransitService;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Public transport lines: stops, path, schedule and assigned units; live view with the distance between consecutive
+ * units on the line; and the report of laps, punctuality per stop and regularity of the intervals.
+ */
+@Path("transit")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class TransitResource extends BaseResource {
+
+    private static final int MAX_JSON = 7900;
+    private static final Set<String> SETTINGS = Set.of(
+            "speedKmh", "bunchingKm", "gapKm", "offRouteMeters", "delayMinutes", "timezone");
+
+    @Inject
+    private TransitService transitService;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    @Inject
+    private ObjectMapper objectMapper;
+
+    private ObjectMapper lenient() {
+        return objectMapper.copy().configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
+    }
+
+    private Set<Long> visibleOwners() throws StorageException {
+        if (!permissionsService.notAdmin(getUserId())) {
+            return null;
+        }
+        Set<Long> owners = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        owners.add(getUserId());
+        // lines of the managers above (the company), never the administrator's own
+        for (long ancestorId : hierarchyService.getAncestors(getUserId())) {
+            User ancestor = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", ancestorId)));
+            if (ancestor != null && !ancestor.getAdministrator()) {
+                owners.add(ancestorId);
+            }
+        }
+        return owners;
+    }
+
+    private Collection<Device> accessibleDevices() throws StorageException {
+        return permissionsService.notAdmin(getUserId())
+                ? storage.getObjects(Device.class, new Request(
+                        new Columns.All(), new Condition.Permission(User.class, getUserId(), Device.class)))
+                : storage.getObjects(Device.class, new Request(new Columns.All()));
+    }
+
+    private TransitRoute checkRoute(long id) throws StorageException {
+        TransitRoute route = storage.getObject(TransitRoute.class, new Request(
+                new Columns.All(), new Condition.Equals("id", id)));
+        Set<Long> owners = visibleOwners();
+        if (route == null || owners != null && !owners.contains(route.getUserId())) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+        return route;
+    }
+
+    private void checkWritable() throws StorageException {
+        if (permissionsService.getUser(getUserId()).getReadonly()) {
+            throw new SecurityException("Read-only user");
+        }
+    }
+
+    private List<Device> unitsOf(long routeId) throws StorageException {
+        List<Device> result = new ArrayList<>();
+        for (Device device : accessibleDevices()) {
+            if (TransitService.routeOf(device) == routeId) {
+                result.add(device);
+            }
+        }
+        return result;
+    }
+
+    private Map<String, Object> view(TransitRoute route) throws Exception {
+        Map<String, Object> result = lenient().convertValue(route, new TypeReference<>() { });
+        result.put("stops", objectMapper.readValue(route.getStops(), List.class));
+        result.put("path", route.getPath() != null && !route.getPath().isBlank()
+                ? objectMapper.readValue(route.getPath(), List.class) : List.of());
+        result.put("schedule", route.getSchedule() != null && !route.getSchedule().isBlank()
+                ? objectMapper.readValue(route.getSchedule(), Map.class) : Map.of());
+        result.put("deviceIds", unitsOf(route.getId()).stream().map(Device::getId).toList());
+        return result;
+    }
+
+    @SuppressWarnings("unchecked")
+    private void read(TransitRoute route, Map<String, Object> body) throws Exception {
+        String name = String.valueOf(body.getOrDefault("name", "")).trim();
+        if (name.isEmpty()) {
+            throw new IllegalArgumentException("The line needs a name");
+        }
+        route.setName(name);
+        route.setCode((String) body.get("code"));
+        route.setColor((String) body.get("color"));
+        route.setCircular(Boolean.TRUE.equals(body.get("circular")));
+        List<Map<String, Object>> stops = new ArrayList<>();
+        for (Map<String, Object> stop : (List<Map<String, Object>>) body.getOrDefault("stops", List.of())) {
+            if (!(stop.get("latitude") instanceof Number latitude)
+                    || !(stop.get("longitude") instanceof Number longitude)
+                    || Math.abs(latitude.doubleValue()) > 90 || Math.abs(longitude.doubleValue()) > 180) {
+                throw new IllegalArgumentException("Every stop needs valid coordinates");
+            }
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("name", String.valueOf(stop.getOrDefault("name", "Paradero " + (stops.size() + 1))));
+            item.put("latitude", latitude.doubleValue());
+            item.put("longitude", longitude.doubleValue());
+            if (stop.get("radius") instanceof Number radius) {
+                item.put("radius", radius.doubleValue());
+            }
+            if (stop.get("minutes") instanceof Number minutes) {
+                item.put("minutes", minutes.doubleValue());
+            }
+            stops.add(item);
+        }
+        if (stops.size() < 2) {
+            throw new IllegalArgumentException("A line needs at least two stops");
+        }
+        String stopsJson = objectMapper.writeValueAsString(stops);
+        if (stopsJson.length() > MAX_JSON) {
+            throw new IllegalArgumentException("Too many stops");
+        }
+        route.setStops(stopsJson);
+        List<double[]> path = new ArrayList<>();
+        for (Object point : (List<Object>) body.getOrDefault("path", List.of())) {
+            List<Number> pair = (List<Number>) point;
+            path.add(new double[] {pair.get(0).doubleValue(), pair.get(1).doubleValue()});
+        }
+        String pathJson = null;
+        double tolerance = 2;
+        while (path.size() >= 2) {
+            List<double[]> rounded = path.stream().map(point -> new double[] {
+                Math.round(point[0] * 1e5) / 1e5, Math.round(point[1] * 1e5) / 1e5}).toList();
+            pathJson = objectMapper.writeValueAsString(rounded);
+            if (pathJson.length() <= MAX_JSON) {
+                break;
+            }
+            path = TransitGeometry.simplify(path, tolerance);
+            tolerance *= 1.5;
+        }
+        route.setPath(pathJson);
+        Object schedule = body.get("schedule");
+        String scheduleJson = schedule != null ? objectMapper.writeValueAsString(schedule) : null;
+        if (scheduleJson != null && scheduleJson.length() > 2000) {
+            throw new IllegalArgumentException("Schedule too long");
+        }
+        route.setSchedule(scheduleJson);
+        Map<String, Object> attributes = new HashMap<>();
+        if (body.get("attributes") instanceof Map<?, ?> map) {
+            map.forEach((key, value) -> {
+                if (SETTINGS.contains(String.valueOf(key)) && value != null && !"".equals(value)) {
+                    attributes.put(String.valueOf(key), value);
+                }
+            });
+        }
+        route.setAttributes(attributes);
+    }
+
+    @SuppressWarnings("unchecked")
+    private void assign(long routeId, Object deviceIds) throws Exception {
+        Set<Long> wanted = new HashSet<>();
+        if (deviceIds instanceof List<?> list) {
+            for (Object id : list) {
+                wanted.add(((Number) id).longValue());
+            }
+        }
+        for (Device device : accessibleDevices()) {
+            boolean assigned = TransitService.routeOf(device) == routeId;
+            boolean want = wanted.contains(device.getId());
+            if (assigned == want) {
+                continue;
+            }
+            permissionsService.checkPermission(Device.class, getUserId(), device.getId());
+            if (want) {
+                device.set(TransitService.ATTRIBUTE, routeId);
+            } else {
+                device.getAttributes().remove(TransitService.ATTRIBUTE);
+            }
+            storage.updateObject(device, new Request(
+                    new Columns.Include("attributes"), new Condition.Equals("id", device.getId())));
+            cacheManager.invalidateObject(true, Device.class, device.getId(), ObjectOperation.UPDATE);
+        }
+    }
+
+    @GET
+    @Path("routes")
+    public List<Map<String, Object>> routes() throws Exception {
+        Set<Long> owners = visibleOwners();
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (TransitRoute route : storage.getObjects(TransitRoute.class, new Request(
+                new Columns.All(), new Order("name")))) {
+            if (owners == null || owners.contains(route.getUserId())) {
+                result.add(view(route));
+            }
+        }
+        return result;
+    }
+
+    @POST
+    @Path("routes")
+    public Map<String, Object> create(Map<String, Object> body) throws Exception {
+        checkWritable();
+        TransitRoute route = new TransitRoute();
+        read(route, body);
+        route.setUserId(getUserId());
+        route.setId(storage.addObject(route, new Request(new Columns.Exclude("id"))));
+        assign(route.getId(), body.get("deviceIds"));
+        return view(route);
+    }
+
+    @PUT
+    @Path("routes/{id}")
+    public Map<String, Object> update(@PathParam("id") long id, Map<String, Object> body) throws Exception {
+        checkWritable();
+        TransitRoute route = checkRoute(id);
+        read(route, body);
+        storage.updateObject(route, new Request(new Columns.Exclude("id", "userId"), new Condition.Equals("id", id)));
+        transitService.invalidate(id);
+        assign(id, body.get("deviceIds"));
+        return view(route);
+    }
+
+    @DELETE
+    @Path("routes/{id}")
+    public Response remove(@PathParam("id") long id) throws Exception {
+        checkWritable();
+        checkRoute(id);
+        assign(id, List.of());
+        storage.removeObject(TransitRoute.class, new Request(new Condition.Equals("id", id)));
+        transitService.invalidate(id);
+        return Response.noContent().build();
+    }
+
+    @GET
+    @Path("routes/{id}/live")
+    public Map<String, Object> live(@PathParam("id") long id) throws Exception {
+        checkRoute(id);
+        return transitService.live(id, unitsOf(id));
+    }
+
+    /**
+     * Laps and average delay per unit, punctuality per stop (on time between 1 minute early and 5 late) and the
+     * real interval between consecutive buses at each stop against the planned one.
+     */
+    @GET
+    @Path("report")
+    public Map<String, Object> report(
+            @QueryParam("routeId") long routeId, @QueryParam("from") Date from, @QueryParam("to") Date to)
+            throws Exception {
+        TransitRoute route = checkRoute(routeId);
+        TransitService.Line line = transitService.line(routeId);
+        Set<Long> allowed = new HashSet<>();
+        accessibleDevices().forEach(device -> allowed.add(device.getId()));
+        List<TransitVisit> visits = storage.getObjects(TransitVisit.class, new Request(
+                new Columns.All(), Condition.merge(List.of(
+                        new Condition.Equals("routeId", routeId),
+                        new Condition.Between("time", from, to))),
+                new Order("time"))).stream().filter(visit -> allowed.contains(visit.getDeviceId())).toList();
+        Map<Long, Device> names = new HashMap<>();
+        accessibleDevices().forEach(device -> names.put(device.getId(), device));
+        Map<Long, Map<String, Object>> byUnit = new TreeMap<>();
+        Map<Integer, List<TransitVisit>> byStop = new TreeMap<>();
+        for (TransitVisit visit : visits) {
+            Map<String, Object> unit = byUnit.computeIfAbsent(visit.getDeviceId(), key -> {
+                Device device = names.get(key);
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("deviceId", key);
+                item.put("name", device != null ? device.getName() : String.valueOf(key));
+                item.put("laps", new HashSet<Integer>());
+                item.put("visits", 0);
+                item.put("delaySum", 0L);
+                item.put("onTime", 0);
+                return item;
+            });
+            @SuppressWarnings("unchecked")
+            Set<Integer> laps = (Set<Integer>) unit.get("laps");
+            if (visit.getStopIndex() == 0) {
+                laps.add(visit.getLap());
+            }
+            unit.put("visits", (Integer) unit.get("visits") + 1);
+            unit.put("delaySum", (Long) unit.get("delaySum") + visit.getDelay());
+            if (visit.getDelay() >= -60 && visit.getDelay() <= 300) {
+                unit.put("onTime", (Integer) unit.get("onTime") + 1);
+            }
+            byStop.computeIfAbsent(visit.getStopIndex(), key -> new ArrayList<>()).add(visit);
+        }
+        List<Map<String, Object>> units = new ArrayList<>();
+        for (Map<String, Object> unit : byUnit.values()) {
+            int count = (Integer) unit.get("visits");
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("deviceId", unit.get("deviceId"));
+            item.put("name", unit.get("name"));
+            item.put("laps", ((Set<?>) unit.get("laps")).size());
+            item.put("visits", count);
+            item.put("averageDelayMinutes", Math.round((Long) unit.get("delaySum") / (double) count / 6) / 10.0);
+            item.put("onTimeRate", Math.round((Integer) unit.get("onTime") * 1000.0 / count) / 10.0);
+            units.add(item);
+        }
+        List<Map<String, Object>> stops = new ArrayList<>();
+        List<Double> allIntervals = new ArrayList<>();
+        double plannedSum = 0;
+        int plannedCount = 0;
+        for (Map.Entry<Integer, List<TransitVisit>> entry : byStop.entrySet()) {
+            List<TransitVisit> list = entry.getValue();
+            double delaySum = 0;
+            int onTime = 0;
+            List<Double> intervals = new ArrayList<>();
+            for (int i = 0; i < list.size(); i++) {
+                TransitVisit visit = list.get(i);
+                delaySum += visit.getDelay();
+                if (visit.getDelay() >= -60 && visit.getDelay() <= 300) {
+                    onTime++;
+                }
+                if (i > 0 && list.get(i - 1).getDeviceId() != visit.getDeviceId()) {
+                    intervals.add((visit.getTime().getTime() - list.get(i - 1).getTime().getTime()) / 60000.0);
+                    if (line != null) {
+                        Double planned = transitService.plannedHeadway(line, visit.getTime());
+                        if (planned != null) {
+                            plannedSum += planned;
+                            plannedCount++;
+                        }
+                    }
+                }
+            }
+            allIntervals.addAll(intervals);
+            Map<String, Object> item = new LinkedHashMap<>();
+            int index = entry.getKey();
+            item.put("index", index);
+            item.put("name", line != null && index < line.stops().size() ? line.stops().get(index).name()
+                    : "#" + (index + 1));
+            item.put("visits", list.size());
+            item.put("averageDelayMinutes", Math.round(delaySum / list.size() / 6) / 10.0);
+            item.put("onTimeRate", Math.round(onTime * 1000.0 / list.size()) / 10.0);
+            item.put("averageIntervalMinutes", intervals.isEmpty() ? null
+                    : Math.round(intervals.stream().mapToDouble(Double::doubleValue).average().orElse(0) * 10) / 10.0);
+            stops.add(item);
+        }
+        double average = allIntervals.stream().mapToDouble(Double::doubleValue).average().orElse(0);
+        double deviation = Math.sqrt(allIntervals.stream().mapToDouble(value -> (value - average) * (value - average))
+                .average().orElse(0));
+        Map<String, Object> summary = new LinkedHashMap<>();
+        summary.put("route", route.getName());
+        summary.put("laps", units.stream().mapToInt(unit -> (Integer) unit.get("laps")).sum());
+        summary.put("visits", visits.size());
+        summary.put("onTimeRate", visits.isEmpty() ? null : Math.round(visits.stream()
+                .filter(visit -> visit.getDelay() >= -60 && visit.getDelay() <= 300).count() * 1000.0
+                / visits.size()) / 10.0);
+        summary.put("averageIntervalMinutes", allIntervals.isEmpty() ? null : Math.round(average * 10) / 10.0);
+        summary.put("plannedIntervalMinutes",
+                plannedCount > 0 ? Math.round(plannedSum / plannedCount * 10) / 10.0 : null);
+        // regularity: 100% when every interval equals the average
+        summary.put("regularity", allIntervals.size() < 2 || average == 0 ? null
+                : Math.round(Math.max(0, 1 - deviation / average) * 1000) / 10.0);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("summary", summary);
+        result.put("units", units);
+        result.put("stops", stops);
+        return result;
+    }
+
+}
