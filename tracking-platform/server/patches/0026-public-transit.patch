+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.transit;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.helper.UnitsConverter;
+import org.traccar.model.Device;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.model.Server;
+import org.traccar.model.TransitRoute;
+import org.traccar.model.TransitVisit;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Public transport lines: progress of every unit along its line, stops served (visits with delay against the
+ * schedule), laps, distance and time to the unit ahead and behind, and alerts for bunching, gaps, leaving the line
+ * and delay.
+ */
+@Singleton
+public class TransitService {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TransitService.class);
+
+    public static final String ATTRIBUTE = "transitRouteId";
+    private static final long STALE = 10 * 60_000L;
+    private static final long ALERT_INTERVAL = 10 * 60_000L;
+
+    private final Storage storage;
+    private final CacheManager cacheManager;
+    private final ObjectMapper objectMapper;
+
+    public record Stop(String name, double latitude, double longitude, double radius, double minutes, double along) {
+    }
+
+    public record Band(LocalTime from, LocalTime to, double minutes) {
+    }
+
+    public record Line(
+            TransitRoute route, TransitGeometry geometry, List<Stop> stops, List<Band> bands,
+            List<LocalTime> departures,
+            double speedKmh, double bunchingMeters, double gapMeters, double offRouteMeters, double delayMinutes,
+            ZoneId zone) {
+    }
+
+    public static final class State {
+        private long routeId;
+        private String name;
+        private Double along;
+        private double offset;
+        private boolean offRoute;
+        private int offRouteCount;
+        private long time;
+        private double speed;
+        private int lap;
+        private Date tripStart;
+        private int lastStop = -1;
+        private Integer lastDelay;
+        private boolean delayAlerted;
+        private final Map<String, Long> alerts = new HashMap<>();
+    }
+
+    private final Map<Long, Line> lines = new ConcurrentHashMap<>();
+    private final Map<Long, State> states = new ConcurrentHashMap<>();
+
+    @Inject
+    public TransitService(Storage storage, CacheManager cacheManager, ObjectMapper objectMapper) {
+        this.storage = storage;
+        this.cacheManager = cacheManager;
+        this.objectMapper = objectMapper;
+    }
+
+    public void invalidate(long routeId) {
+        lines.remove(routeId);
+    }
+
+    public static long routeOf(Device device) {
+        if (device == null || !device.hasAttribute(ATTRIBUTE)) {
+            return 0;
+        }
+        try {
+            return Long.parseLong(String.valueOf(device.getAttributes().get(ATTRIBUTE)).replaceAll("\\.0$", ""));
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private static LocalTime time(Object value) {
+        try {
+            return value == null ? null : LocalTime.parse(String.valueOf(value).trim().length() == 4
+                    ? "0" + String.valueOf(value).trim() : String.valueOf(value).trim());
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    public Line line(long routeId) throws StorageException {
+        Line cached = lines.get(routeId);
+        if (cached != null) {
+            return cached;
+        }
+        TransitRoute route = storage.getObject(TransitRoute.class, new Request(
+                new Columns.All(), new Condition.Equals("id", routeId)));
+        if (route == null) {
+            return null;
+        }
+        try {
+            List<Map<String, Object>> rawStops = objectMapper.readValue(route.getStops(), new TypeReference<>() { });
+            List<double[]> path = route.getPath() != null && !route.getPath().isBlank()
+                    ? objectMapper.readValue(route.getPath(), new TypeReference<List<double[]>>() { })
+                    : new ArrayList<>();
+            if (path.size() < 2) {
+                path = new ArrayList<>();
+                for (Map<String, Object> stop : rawStops) {
+                    path.add(new double[] {((Number) stop.get("latitude")).doubleValue(),
+                            ((Number) stop.get("longitude")).doubleValue()});
+                }
+                if (route.getCircular() && !path.isEmpty()) {
+                    path.add(path.get(0));
+                }
+            }
+            TransitGeometry geometry = new TransitGeometry(path, route.getCircular());
+            double speed = route.getDouble("speedKmh") > 0 ? route.getDouble("speedKmh") : 20;
+            List<Stop> stops = new ArrayList<>();
+            Double previous = null;
+            for (Map<String, Object> stop : rawStops) {
+                double latitude = ((Number) stop.get("latitude")).doubleValue();
+                double longitude = ((Number) stop.get("longitude")).doubleValue();
+                double along = geometry.project(latitude, longitude, previous).along();
+                previous = along;
+                double radius = stop.get("radius") instanceof Number value && value.doubleValue() > 0
+                        ? value.doubleValue() : 60;
+                double minutes = stop.get("minutes") instanceof Number value && value.doubleValue() >= 0
+                        && !(stops.size() > 0 && value.doubleValue() == 0)
+                        ? value.doubleValue() : along / (speed / 3.6) / 60;
+                stops.add(new Stop(String.valueOf(stop.getOrDefault("name", "Paradero " + (stops.size() + 1))),
+                        latitude, longitude, radius, minutes, along));
+            }
+            Map<String, Object> schedule = route.getSchedule() != null && !route.getSchedule().isBlank()
+                    ? objectMapper.readValue(route.getSchedule(), new TypeReference<>() { }) : Map.of();
+            List<Band> bands = new ArrayList<>();
+            for (Map<String, Object> band : (List<Map<String, Object>>) schedule.getOrDefault("bands", List.of())) {
+                LocalTime from = time(band.get("from"));
+                LocalTime to = time(band.get("to"));
+                if (from != null && to != null && band.get("minutes") instanceof Number minutes) {
+                    bands.add(new Band(from, to, minutes.doubleValue()));
+                }
+            }
+            List<LocalTime> departures = new ArrayList<>();
+            for (Object departure : (List<Object>) schedule.getOrDefault("departures", List.of())) {
+                LocalTime value = time(departure);
+                if (value != null) {
+                    departures.add(value);
+                }
+            }
+            departures.sort(Comparator.naturalOrder());
+            String zone = route.getString("timezone");
+            if (zone == null) {
+                Server server = cacheManager.getServer();
+                zone = server != null ? server.getString("timezone") : null;
+            }
+            ZoneId zoneId;
+            try {
+                zoneId = zone != null ? ZoneId.of(zone) : ZoneId.systemDefault();
+            } catch (RuntimeException e) {
+                zoneId = ZoneId.systemDefault();
+            }
+            Line line = new Line(route, geometry, stops, bands, departures, speed,
+                    route.getDouble("bunchingKm") > 0 ? route.getDouble("bunchingKm") * 1000 : 300,
+                    route.getDouble("gapKm") > 0 ? route.getDouble("gapKm") * 1000 : 0,
+                    route.getDouble("offRouteMeters") > 0 ? route.getDouble("offRouteMeters") : 150,
+                    route.getDouble("delayMinutes") > 0 ? route.getDouble("delayMinutes") : 10, zoneId);
+            lines.put(routeId, line);
+            return line;
+        } catch (Exception e) {
+            LOGGER.warn("Invalid transit line {}", routeId, e);
+            return null;
+        }
+    }
+
+    /**
+     * Planned minutes between buses at a moment (frequency band), or from the departure times.
+     */
+    public Double plannedHeadway(Line line, Date moment) {
+        LocalTime now = ZonedDateTime.ofInstant(moment.toInstant(), line.zone()).toLocalTime();
+        for (Band band : line.bands()) {
+            if (!now.isBefore(band.from()) && now.isBefore(band.to())) {
+                return band.minutes();
+            }
+        }
+        List<LocalTime> departures = line.departures();
+        for (int i = 1; i < departures.size(); i++) {
+            if (now.isBefore(departures.get(i))) {
+                return (double) java.time.Duration.between(departures.get(i - 1), departures.get(i)).toMinutes();
+            }
+        }
+        return null;
+    }
+
+    private Date scheduledStart(Line line, Date start) {
+        if (line.departures().isEmpty()) {
+            return start;
+        }
+        ZonedDateTime moment = ZonedDateTime.ofInstant(start.toInstant(), line.zone());
+        ZonedDateTime best = null;
+        for (LocalTime departure : line.departures()) {
+            ZonedDateTime candidate = moment.with(departure);
+            if (best == null || Math.abs(candidate.toEpochSecond() - moment.toEpochSecond())
+                    < Math.abs(best.toEpochSecond() - moment.toEpochSecond())) {
+                best = candidate;
+            }
+        }
+        return Math.abs(best.toEpochSecond() - moment.toEpochSecond()) <= 1800 ? Date.from(best.toInstant()) : start;
+    }
+
+    private Event event(String type, Position position, Line line, String severity) {
+        Event event = new Event(type, position);
+        event.set("routeId", line.route().getId());
+        event.set("routeName", line.route().getName());
+        event.set("severity", severity);
+        return event;
+    }
+
+    private boolean throttled(State state, String type, long now) {
+        Long last = state.alerts.get(type);
+        if (last != null && now - last < ALERT_INTERVAL) {
+            return true;
+        }
+        state.alerts.put(type, now);
+        return false;
+    }
+
+    private void visit(Line line, State state, Position position, int index, List<Event> events) {
+        Stop stop = line.stops().get(index);
+        Date time = position.getFixTime();
+        if (index == 0) {
+            state.lap++;
+            state.tripStart = time;
+            state.delayAlerted = false;
+        }
+        Integer delay = null;
+        if (state.tripStart != null) {
+            Date start = scheduledStart(line, state.tripStart);
+            delay = (int) ((time.getTime() - start.getTime()) / 1000 - stop.minutes() * 60);
+        }
+        state.lastStop = index;
+        state.lastDelay = delay;
+        TransitVisit visit = new TransitVisit();
+        visit.setDeviceId(position.getDeviceId());
+        visit.setRouteId(line.route().getId());
+        visit.setStopIndex(index);
+        visit.setTime(time);
+        visit.setLap(state.lap);
+        visit.setDelay(delay != null ? delay : 0);
+        try {
+            storage.addObject(visit, new Request(new Columns.Exclude("id")));
+        } catch (StorageException e) {
+            LOGGER.warn("Transit visit not saved", e);
+        }
+        if (delay != null && delay > line.delayMinutes() * 60 && !state.delayAlerted) {
+            state.delayAlerted = true;
+            Event event = event(Event.TYPE_TRANSIT_DELAY, position, line, "medium");
+            event.set("stopName", stop.name());
+            event.set("delayMinutes", Math.round(delay / 60.0));
+            events.add(event);
+        }
+    }
+
+    public List<Event> onPosition(Position position) throws StorageException {
+        List<Event> events = new ArrayList<>();
+        Device device = cacheManager.getObject(Device.class, position.getDeviceId());
+        long routeId = routeOf(device);
+        if (routeId == 0) {
+            states.remove(position.getDeviceId());
+            return events;
+        }
+        Line line = line(routeId);
+        if (line == null) {
+            return events;
+        }
+        State state = states.computeIfAbsent(position.getDeviceId(), key -> new State());
+        if (state.routeId != routeId) {
+            state.along = null;
+            state.lap = 0;
+            state.tripStart = null;
+        }
+        state.routeId = routeId;
+        state.name = device.getName();
+        long now = position.getFixTime().getTime();
+        TransitGeometry geometry = line.geometry();
+        TransitGeometry.Projection projection = geometry.project(
+                position.getLatitude(), position.getLongitude(), state.along);
+        state.offset = projection.offset();
+        state.speed = UnitsConverter.kphFromKnots(position.getSpeed());
+        if (projection.offset() > line.offRouteMeters()) {
+            state.offRouteCount++;
+            if (state.offRouteCount >= 2 && !state.offRoute) {
+                state.offRoute = true;
+                Event event = event(Event.TYPE_TRANSIT_OFF_ROUTE, position, line, "high");
+                event.set("offsetMeters", Math.round(projection.offset()));
+                events.add(event);
+            }
+            state.time = now;
+            return events;
+        }
+        state.offRoute = false;
+        state.offRouteCount = 0;
+        double along = projection.along();
+        if (state.along == null || now - state.time > STALE * 3) {
+            state.lastStop = -1;
+            for (int i = 0; i < line.stops().size(); i++) {
+                Stop stop = line.stops().get(i);
+                if (geometry.forward(stop.along(), along) < 1e9 && stop.along() <= along) {
+                    state.lastStop = i;
+                }
+            }
+        } else {
+            double moved = geometry.forward(state.along, along);
+            if (moved <= geometry.length() / 2) {
+                // stops passed since the last position, in order
+                List<int[]> passed = new ArrayList<>();
+                for (int i = 0; i < line.stops().size(); i++) {
+                    double distance = geometry.forward(state.along, line.stops().get(i).along());
+                    if (distance > 0 && distance <= moved + line.stops().get(i).radius()) {
+                        passed.add(new int[] {i, (int) distance});
+                    }
+                }
+                passed.sort(Comparator.comparingInt(item -> item[1]));
+                for (int[] item : passed) {
+                    if (item[0] != state.lastStop) {
+                        visit(line, state, position, item[0], events);
+                    }
+                }
+            } else if (!geometry.circular() && along < line.stops().get(0).along() + 300) {
+                state.lastStop = -1;
+                state.tripStart = null;
+            }
+        }
+        state.along = along;
+        state.time = now;
+        headwayAlerts(line, position, state, events);
+        return events;
+    }
+
+    private void headwayAlerts(Line line, Position position, State state, List<Event> events) {
+        long now = state.time;
+        Double ahead = null;
+        long aheadId = 0;
+        for (Map.Entry<Long, State> entry : states.entrySet()) {
+            State other = entry.getValue();
+            if (entry.getKey() == position.getDeviceId() || other.along == null || other.offRoute
+                    || Math.abs(now - other.time) > STALE || other.routeId != line.route().getId()) {
+                continue;
+            }
+            double gap = line.geometry().gap(state.along, other.along);
+            if (gap >= 0 && (ahead == null || gap < ahead)) {
+                ahead = gap;
+                aheadId = entry.getKey();
+            }
+        }
+        if (ahead == null) {
+            return;
+        }
+        State aheadState = states.get(aheadId);
+        double gapLimit = line.gapMeters();
+        Double planned = plannedHeadway(line, position.getFixTime());
+        if (gapLimit <= 0 && planned != null) {
+            gapLimit = planned * 2 * line.speedKmh() / 60 * 1000;
+        }
+        String type = null;
+        if (ahead < line.bunchingMeters()) {
+            type = Event.TYPE_TRANSIT_BUNCHING;
+        } else if (gapLimit > 0 && ahead > gapLimit) {
+            type = Event.TYPE_TRANSIT_GAP;
+        }
+        if (type != null && !throttled(state, type, now)) {
+            Event event = event(type, position, line, "medium");
+            event.set("gapMeters", Math.round(ahead));
+            event.set("aheadName", aheadState != null ? aheadState.name : null);
+            events.add(event);
+        }
+    }
+
+    /**
+     * Live picture of a line for the given units: progress, stops, distance and minutes to the unit ahead and behind.
+     */
+    public Map<String, Object> live(long routeId, List<Device> devices) throws StorageException {
+        Line line = line(routeId);
+        Map<String, Object> result = new LinkedHashMap<>();
+        if (line == null) {
+            return result;
+        }
+        TransitGeometry geometry = line.geometry();
+        long now = System.currentTimeMillis();
+        List<Map<String, Object>> units = new ArrayList<>();
+        for (Device device : devices) {
+            State state = states.get(device.getId());
+            Position position = cacheManager.getPosition(device.getId());
+            if (position == null && device.getPositionId() > 0) {
+                position = storage.getObject(Position.class, new Request(
+                        new Columns.All(), new Condition.Equals("id", device.getPositionId())));
+            }
+            Map<String, Object> unit = new LinkedHashMap<>();
+            unit.put("deviceId", device.getId());
+            unit.put("name", device.getName());
+            if (position != null) {
+                unit.put("latitude", position.getLatitude());
+                unit.put("longitude", position.getLongitude());
+                unit.put("course", position.getCourse());
+                unit.put("fixTime", position.getFixTime());
+                unit.put("speed", Math.round(UnitsConverter.kphFromKnots(position.getSpeed())));
+            }
+            Double along = state != null ? state.along : null;
+            boolean offRoute = state != null && state.offRoute;
+            if (along == null && position != null) {
+                TransitGeometry.Projection projection = geometry.project(
+                        position.getLatitude(), position.getLongitude(), null);
+                offRoute = projection.offset() > line.offRouteMeters();
+                along = offRoute ? null : projection.along();
+            }
+            boolean active = position != null && now - position.getFixTime().getTime() < STALE;
+            unit.put("active", active);
+            unit.put("offRoute", offRoute);
+            if (state != null) {
+                unit.put("offset", Math.round(state.offset));
+                unit.put("lap", state.lap);
+                unit.put("delayMinutes", state.lastDelay != null ? Math.round(state.lastDelay / 60.0) : null);
+                unit.put("lastStop", state.lastStop);
+            }
+            if (along != null) {
+                unit.put("along", Math.round(along));
+                unit.put("progress", Math.round(along / geometry.length() * 1000) / 10.0);
+                int next = -1;
+                double toNext = Double.MAX_VALUE;
+                for (int i = 0; i < line.stops().size(); i++) {
+                    double distance = geometry.forward(along, line.stops().get(i).along());
+                    if (distance > 15 && distance < toNext) {
+                        toNext = distance;
+                        next = i;
+                    }
+                }
+                if (next >= 0) {
+                    double speed = Math.max(line.speedKmh(), 5);
+                    unit.put("nextStop", next);
+                    unit.put("nextStopName", line.stops().get(next).name());
+                    unit.put("nextStopMeters", Math.round(toNext));
+                    unit.put("nextStopMinutes", Math.round(toNext / (speed / 3.6) / 60));
+                }
+            }
+            units.add(unit);
+        }
+        // distance along the line to the closest unit ahead and behind (active units on the line only)
+        List<Map<String, Object>> running = units.stream()
+                .filter(unit -> unit.get("along") != null && Boolean.TRUE.equals(unit.get("active"))
+                        && !Boolean.TRUE.equals(unit.get("offRoute")))
+                .sorted(Comparator.comparingLong(unit -> (Long) unit.get("along"))).toList();
+        List<Double> gaps = new ArrayList<>();
+        for (int i = 0; i < running.size(); i++) {
+            Map<String, Object> unit = running.get(i);
+            Map<String, Object> ahead = i + 1 < running.size() ? running.get(i + 1)
+                    : geometry.circular() && running.size() > 1 ? running.get(0) : null;
+            Map<String, Object> behind = i > 0 ? running.get(i - 1)
+                    : geometry.circular() && running.size() > 1 ? running.get(running.size() - 1) : null;
+            if (ahead != null) {
+                double gap = geometry.gap((Long) unit.get("along"), (Long) ahead.get("along"));
+                unit.put("aheadId", ahead.get("deviceId"));
+                unit.put("aheadName", ahead.get("name"));
+                unit.put("aheadMeters", Math.round(gap));
+                unit.put("aheadMinutes", Math.round(gap / (line.speedKmh() / 3.6) / 60));
+                gaps.add(gap);
+            }
+            if (behind != null) {
+                double gap = geometry.gap((Long) behind.get("along"), (Long) unit.get("along"));
+                unit.put("behindId", behind.get("deviceId"));
+                unit.put("behindName", behind.get("name"));
+                unit.put("behindMeters", Math.round(gap));
+                unit.put("behindMinutes", Math.round(gap / (line.speedKmh() / 3.6) / 60));
+            }
+        }
+        Double planned = plannedHeadway(line, new Date());
+        double plannedMeters = planned != null ? planned * line.speedKmh() / 60 * 1000 : 0;
+        double gapLimit = line.gapMeters() > 0 ? line.gapMeters() : plannedMeters * 2;
+        Map<String, Object> summary = new LinkedHashMap<>();
+        summary.put("units", devices.size());
+        summary.put("running", running.size());
+        summary.put("offRoute", units.stream().filter(unit -> Boolean.TRUE.equals(unit.get("offRoute"))).count());
+        summary.put("lengthKm", Math.round(geometry.length() / 100) / 10.0);
+        summary.put("plannedHeadwayMinutes", planned);
+        summary.put("plannedGapKm", plannedMeters > 0 ? Math.round(plannedMeters / 100) / 10.0 : null);
+        summary.put("averageGapKm", gaps.isEmpty() ? null
+                : Math.round(gaps.stream().mapToDouble(Double::doubleValue).average().orElse(0) / 100) / 10.0);
+        summary.put("minGapKm", gaps.isEmpty() ? null : Math.round(java.util.Collections.min(gaps) / 100) / 10.0);
+        summary.put("maxGapKm", gaps.isEmpty() ? null : Math.round(java.util.Collections.max(gaps) / 100) / 10.0);
+        summary.put("bunching", gaps.stream().filter(gap -> gap < line.bunchingMeters()).count());
+        summary.put("gaps", gapLimit > 0 ? gaps.stream().filter(gap -> gap > gapLimit).count() : 0);
+        summary.put("bunchingKm", line.bunchingMeters() / 1000);
+        summary.put("gapKm", gapLimit > 0 ? Math.round(gapLimit / 100) / 10.0 : null);
+        List<Map<String, Object>> stops = new ArrayList<>();
+        for (Stop stop : line.stops()) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("name", stop.name());
+            item.put("latitude", stop.latitude());
+            item.put("longitude", stop.longitude());
+            item.put("along", Math.round(stop.along()));
+            item.put("minutes", Math.round(stop.minutes() * 10) / 10.0);
+            stops.add(item);
+        }
+        result.put("summary", summary);
+        result.put("stops", stops);
+        result.put("units", units);
+        return result;
+    }
+
+}
