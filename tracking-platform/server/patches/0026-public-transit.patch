+package org.traccar.handler.events;
+
+import jakarta.inject.Inject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.helper.model.PositionUtil;
+import org.traccar.model.Event;
+import org.traccar.model.Position;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.StorageException;
+import org.traccar.transit.TransitService;
+
+/**
+ * Public transport events from positions: bunching, gaps, leaving the line and delay at stops.
+ */
+public class TransitEventHandler extends BaseEventHandler {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TransitEventHandler.class);
+
+    private final CacheManager cacheManager;
+    private final TransitService transitService;
+
+    @Inject
+    public TransitEventHandler(CacheManager cacheManager, TransitService transitService) {
+        this.cacheManager = cacheManager;
+        this.transitService = transitService;
+    }
+
+    @Override
+    public void onPosition(Position position, Callback callback) {
+        if (!PositionUtil.isLatest(cacheManager, position) || !position.getValid()) {
+            return;
+        }
+        try {
+            for (Event event : transitService.onPosition(position)) {
+                callback.eventDetected(event);
+            }
+        } catch (StorageException e) {
+            LOGGER.warn("Transit processing failed", e);
+        }
+    }
+
+}
