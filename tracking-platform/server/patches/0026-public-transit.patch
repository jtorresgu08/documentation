+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.transit;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class TransitGeometryTest {
+
+    @Test
+    public void testProjectionAndGap() {
+        // 0.01 degrees of latitude is about 1112 m
+        var line = new TransitGeometry(List.of(new double[] {-12.00, -77.0}, new double[] {-12.02, -77.0}), false);
+        assertEquals(2224, line.length(), 5);
+        var projection = line.project(-12.01, -77.0005, null);
+        assertEquals(1112, projection.along(), 5);
+        assertEquals(54, projection.offset(), 3);
+        assertEquals(556, line.gap(556, 1112), 1);
+    }
+
+    @Test
+    public void testCircularWrapAndDirection() {
+        // out on one street and back on the same street: the previous position decides the direction
+        var loop = new TransitGeometry(List.of(
+                new double[] {-12.00, -77.0}, new double[] {-12.02, -77.0}, new double[] {-12.00, -77.0}), true);
+        assertEquals(4448, loop.length(), 10);
+        assertEquals(1112, loop.project(-12.01, -77.0, 900.0).along(), 5);
+        assertEquals(3336, loop.project(-12.01, -77.0, 3000.0).along(), 5);
+        assertEquals(448, loop.gap(4200, 200), 10);
+        assertTrue(loop.forward(4400, 50) < 100);
+    }
+
+}
