+package org.traccar.protocol;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class TeltonikaProtocolTest {
+
+    @Test
+    public void testSmsPrefix() {
+
+        assertEquals("  ", TeltonikaProtocol.smsPrefix("FMB920", null, null));
+        assertEquals("admin 1234 ", TeltonikaProtocol.smsPrefix("FMB920", "admin", "1234"));
+        assertEquals("  ", TeltonikaProtocol.smsPrefix(null, null, null));
+        assertEquals(" ", TeltonikaProtocol.smsPrefix("FTC920", null, null));
+        assertEquals("1234 ", TeltonikaProtocol.smsPrefix("FTC961", "admin", "1234"));
+
+    }
+
+}
