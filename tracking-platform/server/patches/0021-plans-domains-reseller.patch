+package org.traccar.plans;
+
+import jakarta.annotation.Priority;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Priorities;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.container.ContainerRequestContext;
+import jakarta.ws.rs.container.ContainerRequestFilter;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.security.UserPrincipal;
+import org.traccar.storage.StorageException;
+
+import java.util.Map;
+
+/**
+ * Rejects API calls of modules not included in the caller's plan (403), after authentication.
+ */
+@Priority(Priorities.USER + 100)
+public class ModuleRequestFilter implements ContainerRequestFilter {
+
+    public static final Map<String, String> PATHS = Map.ofEntries(
+            Map.entry("video", "video"),
+            Map.entry("sensors/fuel", "fuel"),
+            Map.entry("sensors", "sensors"),
+            Map.entry("alert-rules", "alerts"),
+            Map.entry("geofence-speed", "geofenceSpeed"),
+            Map.entry("routing", "routes"),
+            Map.entry("chat", "chat"),
+            Map.entry("driving", "driving"),
+            Map.entry("expenses", "expenses"),
+            Map.entry("maintenance-plans", "maintenance"),
+            Map.entry("report-templates", "reports"),
+            Map.entry("hierarchy/domains", "whitelabel"));
+
+    @Inject
+    private PlanService planService;
+
+    public static String moduleOf(String path) {
+        String clean = path.startsWith("/") ? path.substring(1) : path;
+        String best = null;
+        String module = null;
+        for (var entry : PATHS.entrySet()) {
+            String prefix = entry.getKey();
+            if ((clean.equals(prefix) || clean.startsWith(prefix + "/"))
+                    && (best == null || prefix.length() > best.length())) {
+                best = prefix;
+                module = entry.getValue();
+            }
+        }
+        return module;
+    }
+
+    @Override
+    public void filter(ContainerRequestContext requestContext) {
+        String module = moduleOf(requestContext.getUriInfo().getPath());
+        if (module == null || !(requestContext.getSecurityContext().getUserPrincipal() instanceof UserPrincipal user)) {
+            return;
+        }
+        try {
+            if (!planService.hasModule(user.getUserId(), module)) {
+                throw new WebApplicationException(Response.status(Response.Status.FORBIDDEN)
+                        .type(MediaType.TEXT_PLAIN).entity("Module not included in plan: " + module).build());
+            }
+        } catch (StorageException e) {
+            throw new WebApplicationException(e);
+        }
+    }
+
+}
