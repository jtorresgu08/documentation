+import org.traccar.api.BaseResource;
+import org.traccar.model.ObjectOperation;
+import org.traccar.model.Server;
+import org.traccar.model.User;
+import org.traccar.plans.Plan;
+import org.traccar.plans.PlanService;
+import org.traccar.session.cache.CacheManager;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+@Path("plans")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class PlanResource extends BaseResource {
+
+    @Inject
+    private PlanService planService;
+
+    @Inject
+    private CacheManager cacheManager;
+
+    /**
+     * Plan catalog, module list and which plans the caller may assign (those within its own modules).
+     */
+    @GET
+    public Map<String, Object> get() throws Exception {
+        Set<String> own = planService.getModules(getUserId());
+        List<Plan> plans = planService.getPlans();
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("modules", PlanService.MODULES);
+        result.put("plans", plans);
+        result.put("assignable", plans.stream().filter(plan -> own.containsAll(plan.getModules()))
+                .map(Plan::getId).toList());
+        result.put("own", own);
+        return result;
+    }
+
+    @GET
+    @Path("modules")
+    public Set<String> modules(@QueryParam("userId") long userId) throws Exception {
+        if (userId > 0 && userId != getUserId()) {
+            permissionsService.checkUser(getUserId(), userId);
+            return planService.getModules(userId);
+        }
+        return planService.getModules(getUserId());
+    }
+
+    @PUT
+    public List<Plan> update(List<Plan> plans) throws Exception {
+        permissionsService.checkAdmin(getUserId());
+        Set<String> ids = new HashSet<>();
+        for (Plan plan : plans) {
+            if (plan.getId() == null || !plan.getId().matches("[a-z0-9_-]{1,32}")
+                    || PlanService.CUSTOM.equals(plan.getId()) || !ids.add(plan.getId())) {
+                throw new IllegalArgumentException("Invalid or duplicated plan id: " + plan.getId());
+            }
+            if (plan.getName() == null || plan.getName().isBlank()) {
+                throw new IllegalArgumentException("Plan without name: " + plan.getId());
+            }
+            plan.setModules(plan.getModules().stream().filter(PlanService.MODULES::contains).distinct().toList());
+        }
+        for (User user : storage.getObjects(User.class, new Request(new Columns.All()))) {
+            String plan = user.getString(PlanService.ATTRIBUTE_PLAN);
+            if (plan != null && !plan.isBlank() && !PlanService.CUSTOM.equals(plan) && !ids.contains(plan)) {
+                throw new IllegalArgumentException("Plan in use, reassign its accounts first: " + plan);
+            }
+        }
+        Server server = planService.getServer();
+        server.set(PlanService.SERVER_PLANS, planService.toJson(plans));
+        storage.updateObject(server, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", server.getId())));
+        cacheManager.invalidateObject(true, Server.class, server.getId(), ObjectOperation.UPDATE);
+        planService.invalidate();
+        return plans;
+    }
+
+}
