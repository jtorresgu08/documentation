+package org.traccar.plans;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.model.User;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public class PlanServiceTest {
+
+    @Test
+    public void testModulePaths() {
+        assertEquals("video", ModuleRequestFilter.moduleOf("video/recordings"));
+        assertEquals("fuel", ModuleRequestFilter.moduleOf("/sensors/fuel"));
+        assertEquals("sensors", ModuleRequestFilter.moduleOf("sensors/report"));
+        assertEquals("alerts", ModuleRequestFilter.moduleOf("alert-rules/12"));
+        assertEquals("whitelabel", ModuleRequestFilter.moduleOf("hierarchy/domains"));
+        assertNull(ModuleRequestFilter.moduleOf("hierarchy/brand"));
+        assertNull(ModuleRequestFilter.moduleOf("alerts/summary"));
+        assertNull(ModuleRequestFilter.moduleOf("videos"));
+    }
+
+    @Test
+    public void testOwnModules() {
+        PlanService service = new PlanService(null, null, null);
+        User user = new User();
+        assertNull(service.getOwnModules(user, PlanService.DEFAULT_PLANS));
+        user.set(PlanService.ATTRIBUTE_PLAN, "basic");
+        assertEquals(Set.of("geofenceSpeed"), service.getOwnModules(user, PlanService.DEFAULT_PLANS));
+        user.set(PlanService.ATTRIBUTE_PLAN, "custom");
+        user.set(PlanService.ATTRIBUTE_MODULES, "video, fuel,unknown");
+        assertEquals(Set.of("video", "fuel"), service.getOwnModules(user, PlanService.DEFAULT_PLANS));
+        user.setAdministrator(true);
+        assertNull(service.getOwnModules(user, PlanService.DEFAULT_PLANS));
+    }
+
+}
