+    private Map<String, Long> readDomains(Server server) {
+        Map<String, Long> result = new LinkedHashMap<>();
+        String domains = server.getString(BRAND_DOMAINS);
+        if (domains != null) {
+            for (String item : domains.split("[,;\\s]+")) {
+                String[] pair = item.split("=");
+                if (pair.length == 2) {
+                    try {
+                        result.put(pair[0].trim().toLowerCase(Locale.ROOT), Long.parseLong(pair[1].trim()));
+                    } catch (NumberFormatException ignored) {
+                        // skip malformed entries
+                    }
+                }
+            }
+        }
+        return result;
+    }
+
+    private void writeDomains(Server server, Map<String, Long> domains) throws Exception {
+        server.set(BRAND_DOMAINS, String.join("\n", domains.entrySet().stream()
+                .map(entry -> entry.getKey() + "=" + entry.getValue()).toList()));
+        storage.updateObject(server, new Request(
+                new Columns.Include("attributes"), new Condition.Equals("id", server.getId())));
+        cacheManager.invalidateObject(true, Server.class, server.getId(), ObjectOperation.UPDATE);
+    }
+
+    private Set<String> resolve(String host) {
+        Set<String> result = new TreeSet<>();
+        if (host != null && !host.isBlank()) {
+            try {
+                for (InetAddress address : InetAddress.getAllByName(host.trim())) {
+                    result.add(address.getHostAddress());
+                }
+            } catch (UnknownHostException ignored) {
+                // not resolvable (yet)
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Addresses white label domains must point to: the {@code deviceHost} server attribute or the web URL host.
+     */
+    private Set<String> expectedAddresses(Server server) {
+        Set<String> result = new TreeSet<>();
+        String deviceHost = server.getString("deviceHost");
+        if (deviceHost != null) {
+            result.addAll(resolve(deviceHost));
+        }
+        String url = config.getString(Keys.WEB_URL);
+        if (url != null) {
+            try {
+                result.addAll(resolve(URI.create(url).getHost()));
+            } catch (IllegalArgumentException ignored) {
+                // invalid url
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Used by Caddy (on demand TLS) before issuing a certificate: only registered white label domains get one.
+     */
+    @GET
