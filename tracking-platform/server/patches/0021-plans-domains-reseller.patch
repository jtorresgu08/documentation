+        if (domain != null && readDomains(permissionsService.getServer())
+                .containsKey(domain.trim().toLowerCase(Locale.ROOT))) {
+            return Response.ok(Map.of("domain", domain.trim().toLowerCase(Locale.ROOT))).build();
+        }
+        return Response.status(Response.Status.NOT_FOUND).build();
+    }
+
+    /**
+     * White label domains of the caller's branch with their DNS status.
+     */
+    @GET
+    @Path("domains")
