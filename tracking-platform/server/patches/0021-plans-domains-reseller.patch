+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.traccar.plans;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.model.Server;
+import org.traccar.model.User;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.stream.Collectors;
+
+/**
+ * Plans and modules. Each account may have a plan ({@code plan} attribute) or a custom module list ({@code plan} =
+ * {@code custom} plus {@code modules}); an account without plan inherits. The modules an account can use are the
+ * intersection of its own and those of every manager above it, so a distributor can never give more than it has.
+ * The plan catalog lives in the {@code plans} server attribute (JSON) and defaults to four plans.
+ */
+@Singleton
+public class PlanService {
+
+    public static final String ATTRIBUTE_PLAN = "plan";
+    public static final String ATTRIBUTE_MODULES = "modules";
+    public static final String SERVER_PLANS = "plans";
+    public static final String CUSTOM = "custom";
+
+    public static final List<String> MODULES = List.of(
+            "video", "fuel", "sensors", "alerts", "geofenceSpeed", "routes", "whatsapp", "chat",
+            "driving", "expenses", "maintenance", "reports", "whitelabel");
+
+    public static final List<Plan> DEFAULT_PLANS = List.of(
+            new Plan("basic", "Básico", "Rastreo, historial, geocercas y alertas estándar", "#78909c", 0,
+                    List.of("geofenceSpeed")),
+            new Plan("pro", "Profesional", "Flotas: sensores, combustible, alertas personalizadas y reportes",
+                    "#2563c9", 0, List.of("fuel", "sensors", "alerts", "geofenceSpeed", "routes",
+                    "whatsapp", "driving", "expenses", "maintenance", "reports")),
+            new Plan("video", "Video", "Profesional más dashcams, video y chat con conductores", "#8e44ad", 0,
+                    List.of("video", "fuel", "sensors", "alerts", "geofenceSpeed", "routes",
+                    "whatsapp", "chat", "driving", "expenses", "maintenance", "reports")),
+            new Plan("reseller", "Distribuidor", "Todos los módulos y marca blanca para revender", "#1a9aa3", 0,
+                    MODULES));
+
+    private static final long CACHE_MILLIS = 15_000;
+
+    private final Storage storage;
+    private final HierarchyService hierarchyService;
+    private final ObjectMapper objectMapper;
+
+    private record Cached(Set<String> modules, long time) {
+    }
+
+    private final Map<Long, Cached> cache = new ConcurrentHashMap<>();
+
+    @Inject
+    public PlanService(Storage storage, HierarchyService hierarchyService, ObjectMapper objectMapper) {
+        this.storage = storage;
+        this.hierarchyService = hierarchyService;
+        this.objectMapper = objectMapper;
+    }
+
+    public Server getServer() throws StorageException {
+        return storage.getObject(Server.class, new Request(new Columns.All()));
+    }
+
+    public List<Plan> getPlans() throws StorageException {
+        String json = getServer().getString(SERVER_PLANS);
+        if (json != null && !json.isBlank()) {
+            try {
+                List<Plan> plans = objectMapper.readValue(json, new TypeReference<>() { });
+                // modules no longer offered are dropped so they never block assigning a plan
+                plans.forEach(plan -> plan.setModules(plan.getModules().stream().filter(MODULES::contains).toList()));
+                return plans;
+            } catch (JsonProcessingException e) {
+                return DEFAULT_PLANS;
+            }
+        }
+        return DEFAULT_PLANS;
+    }
+
+    public String toJson(List<Plan> plans) throws JsonProcessingException {
+        return objectMapper.writeValueAsString(plans);
+    }
+
+    public void invalidate() {
+        cache.clear();
+    }
+
+    /**
+     * Modules granted by the account itself, or {@code null} when it inherits from its manager.
+     */
+    public Set<String> getOwnModules(User user, List<Plan> plans) {
+        if (user == null) {
+            return Set.of();
+        }
+        if (user.getAdministrator()) {
+            return null;
+        }
+        String plan = user.getString(ATTRIBUTE_PLAN);
+        if (plan == null || plan.isBlank()) {
+            return null;
+        }
+        if (CUSTOM.equals(plan)) {
+            String modules = user.getString(ATTRIBUTE_MODULES);
+            return modules == null ? Set.of() : Arrays.stream(modules.split("[,;\\s]+"))
+                    .filter(MODULES::contains).collect(Collectors.toCollection(LinkedHashSet::new));
+        }
+        return plans.stream().filter(item -> plan.equals(item.getId())).findFirst()
+                .map(item -> (Set<String>) new LinkedHashSet<>(item.getModules())).orElse(null);
+    }
+
+    private User getUser(long userId) throws StorageException {
+        return storage.getObject(User.class, new Request(new Columns.All(), new Condition.Equals("id", userId)));
+    }
+
+    /**
+     * Modules the account can use: its own intersected with every manager above it.
+     */
+    public Set<String> getModules(long userId) throws StorageException {
+        Cached cached = cache.get(userId);
+        if (cached != null && System.currentTimeMillis() - cached.time() < CACHE_MILLIS) {
+            return cached.modules();
+        }
+        List<Plan> plans = getPlans();
+        User user = getUser(userId);
+        Set<String> result = new LinkedHashSet<>(MODULES);
+        if (user == null) {
+            result.clear();
+        } else if (!user.getAdministrator()) {
+            Set<String> own = getOwnModules(user, plans);
+            if (own != null) {
+                result.retainAll(own);
+            }
+            for (long ancestorId : hierarchyService.getAncestors(userId)) {
+                Set<String> ancestor = getOwnModules(getUser(ancestorId), plans);
+                if (ancestor != null) {
+                    result.retainAll(ancestor);
+                }
+            }
+        }
+        Set<String> modules = Set.copyOf(result);
+        cache.put(userId, new Cached(modules, System.currentTimeMillis()));
+        return modules;
+    }
+
+    public boolean hasModule(long userId, String module) throws StorageException {
+        return getModules(userId).contains(module);
+    }
+
+    public void checkModule(long userId, String module) throws StorageException {
+        if (!hasModule(userId, module)) {
+            throw new SecurityException("Module not included in plan: " + module);
+        }
+    }
+
+    /**
+     * Only a manager above the account (or the administrator) may change its plan, and never beyond its own modules.
+     */
+    public void checkPlanUpdate(long editorId, User before, User after) throws StorageException {
+        String beforePlan = before != null ? before.getString(ATTRIBUTE_PLAN) : null;
+        String beforeModules = before != null ? before.getString(ATTRIBUTE_MODULES) : null;
+        if (Objects.equals(beforePlan, after.getString(ATTRIBUTE_PLAN))
+                && Objects.equals(beforeModules, after.getString(ATTRIBUTE_MODULES))) {
+            return;
+        }
+        String plan = after.getString(ATTRIBUTE_PLAN);
+        if (plan != null && !plan.isBlank() && !CUSTOM.equals(plan)
+                && getPlans().stream().noneMatch(item -> plan.equals(item.getId()))) {
+            throw new IllegalArgumentException("Unknown plan");
+        }
+        User editor = editorId > 0 ? getUser(editorId) : null;
+        if (editor != null && editor.getAdministrator()) {
+            invalidate();
+            return;
+        }
+        if (editor == null || editor.getUserLimit() == 0 || editorId == after.getId()) {
+            throw new SecurityException("Only a manager above the account can change its plan");
+        }
+        if (after.getId() > 0 && !hierarchyService.getDescendants(editorId).contains(after.getId())) {
+            throw new SecurityException("Account outside the manager branch");
+        }
+        Set<String> granted = getOwnModules(after, getPlans());
+        if (granted != null && !getModules(editorId).containsAll(granted)) {
+            throw new SecurityException("The plan includes modules the manager does not have");
+        }
+        invalidate();
+    }
+
+}
