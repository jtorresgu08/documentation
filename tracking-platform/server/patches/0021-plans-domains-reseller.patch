+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.MediaType;
+import org.traccar.api.BaseResource;
+import org.traccar.api.security.HierarchyService;
+import org.traccar.model.Device;
+import org.traccar.model.ManagedUser;
+import org.traccar.model.Permission;
+import org.traccar.model.User;
+import org.traccar.plans.Plan;
+import org.traccar.plans.PlanService;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.stream.Collectors;
+
+/**
+ * Distributor dashboard: accounts, units and quotas of the caller's branch, its direct accounts with their plans
+ * and units, and what expires soon.
+ */
+@Path("reseller")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class ResellerResource extends BaseResource {
+
+    private static final long DAY = TimeUnit.DAYS.toMillis(1);
+    private static final long EXPIRING = 30 * DAY;
+
+    @Inject
+    private HierarchyService hierarchyService;
+
+    @Inject
+    private PlanService planService;
+
+    private static boolean isManager(User user) {
+        return user.getAdministrator() || user.getUserLimit() != 0;
+    }
+
+    private static Map<String, Object> deviceStats(Collection<Device> devices, long now) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("total", devices.size());
+        result.put("online", devices.stream().filter(device -> "online".equals(device.getStatus())).count());
+        result.put("offline24h", devices.stream().filter(device -> !device.getDisabled()
+                && (device.getLastUpdate() == null || now - device.getLastUpdate().getTime() > DAY)).count());
+        result.put("disabled", devices.stream().filter(Device::getDisabled).count());
+        result.put("expired", devices.stream().filter(device -> device.getExpirationTime() != null
+                && device.getExpirationTime().getTime() < now).count());
+        return result;
+    }
+
+    private Collection<Device> devicesOf(long userId) throws StorageException {
+        return storage.getObjects(Device.class, new Request(
+                new Columns.All(), new Condition.Permission(User.class, userId, Device.class)));
+    }
+
+    @GET
+    @Path("summary")
+    public Map<String, Object> summary() throws Exception {
+        permissionsService.checkManager(getUserId());
+        long now = System.currentTimeMillis();
+        User me = permissionsService.getUser(getUserId());
+        boolean admin = me.getAdministrator();
+
+        List<User> allUsers = storage.getObjects(User.class, new Request(new Columns.All()));
+        Map<Long, User> usersById = allUsers.stream().collect(Collectors.toMap(User::getId, user -> user));
+        Set<Long> branch = admin
+                ? allUsers.stream().map(User::getId).filter(id -> id != me.getId()).collect(Collectors.toSet())
+                : hierarchyService.getDescendants(me.getId());
+        List<User> branchUsers = branch.stream().map(usersById::get).filter(user -> user != null
+                && !user.getTemporary()).toList();
+
+        // closest manager of every account: the owner holding most ancestors itself
+        Map<Long, Set<Long>> owners = new HashMap<>();
+        for (Permission permission : storage.getPermissions(User.class, ManagedUser.class)) {
+            owners.computeIfAbsent(permission.getPropertyId(), key -> new HashSet<>()).add(permission.getOwnerId());
+        }
+        Map<Long, Long> parents = new HashMap<>();
+        for (var entry : owners.entrySet()) {
+            long parent = 0;
+            int depth = -1;
+            for (long owner : entry.getValue()) {
+                int ownerDepth = owners.getOrDefault(owner, Set.of()).size();
+                if (ownerDepth > depth) {
+                    parent = owner;
+                    depth = ownerDepth;
+                }
+            }
+            parents.put(entry.getKey(), parent);
+        }
+
+        // units of an account, assigned directly or through groups
+        Collection<Device> branchDevices = admin
+                ? storage.getObjects(Device.class, new Request(new Columns.All()))
+                : devicesOf(me.getId());
+
+        List<Plan> plans = planService.getPlans();
+        Map<String, Plan> plansById = plans.stream().collect(Collectors.toMap(Plan::getId, plan -> plan));
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("devices", deviceStats(branchDevices, now));
+
+        Map<String, Object> accounts = new LinkedHashMap<>();
+        accounts.put("total", branchUsers.size());
+        accounts.put("managers", branchUsers.stream().filter(ResellerResource::isManager).count());
+        accounts.put("clients", branchUsers.stream().filter(user -> !isManager(user)).count());
+        accounts.put("disabled", branchUsers.stream().filter(User::getDisabled).count());
+        accounts.put("expired", branchUsers.stream().filter(user -> user.getExpirationTime() != null
+                && user.getExpirationTime().getTime() < now).count());
+        result.put("accounts", accounts);
+
+        Map<String, Object> quota = new LinkedHashMap<>();
+        quota.put("deviceLimit", me.getDeviceLimit());
+        quota.put("devices", branchDevices.size());
+        quota.put("userLimit", me.getUserLimit());
+        quota.put("users", branchUsers.size());
+        result.put("quota", quota);
+
+        Map<String, Long> planCounts = new LinkedHashMap<>();
+        for (User user : branchUsers) {
+            String plan = user.getString(PlanService.ATTRIBUTE_PLAN);
+            String key = plan == null || plan.isBlank() ? "inherit" : plan;
+            planCounts.merge(key, 1L, Long::sum);
+        }
+        result.put("plans", planCounts);
+        result.put("modules", planService.getModules(me.getId()));
+
+        List<Map<String, Object>> children = new ArrayList<>();
+        for (User user : branchUsers) {
+            long parent = parents.getOrDefault(user.getId(), 0L);
+            boolean direct = parent == me.getId() || (admin && (parent == 0 || !branch.contains(parent)));
+            if (!direct) {
+                continue;
+            }
+            Set<Long> subtree = hierarchyService.getDescendants(user.getId());
+            Collection<Device> devices = devicesOf(user.getId());
+            String plan = user.getString(PlanService.ATTRIBUTE_PLAN);
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("id", user.getId());
+            item.put("name", user.getName());
+            item.put("email", user.getEmail());
+            item.put("manager", isManager(user));
+            item.put("disabled", user.getDisabled());
+            item.put("expirationTime", user.getExpirationTime());
+            item.put("plan", plan);
+            item.put("planName", plan == null || plan.isBlank() ? null
+                    : PlanService.CUSTOM.equals(plan) ? "custom"
+                    : plansById.containsKey(plan) ? plansById.get(plan).getName() : plan);
+            item.put("modules", planService.getModules(user.getId()));
+            item.put("users", subtree.size());
+            item.put("deviceLimit", user.getDeviceLimit());
+            item.put("userLimit", user.getUserLimit());
+            item.putAll(Map.of("deviceStats", deviceStats(devices, now)));
+            children.add(item);
+        }
+        children.sort(Comparator.comparing(item -> -((Number) ((Map<?, ?>) item.get("deviceStats"))
+                .get("total")).longValue()));
+        result.put("children", children);
+
+        List<Map<String, Object>> expiring = new ArrayList<>();
+        for (User user : branchUsers) {
+            Date time = user.getExpirationTime();
+            if (time != null && time.getTime() < now + EXPIRING) {
+                expiring.add(Map.of("type", "user", "id", user.getId(), "name",
+                        user.getName() != null ? user.getName() : user.getEmail(), "time", time));
+            }
+        }
+        for (Device device : branchDevices) {
+            Date time = device.getExpirationTime();
+            if (time != null && time.getTime() < now + EXPIRING) {
+                expiring.add(Map.of("type", "device", "id", device.getId(), "name", device.getName(), "time", time));
+            }
+        }
+        expiring.sort(Comparator.comparing(item -> (Date) item.get("time")));
+        result.put("expiring", expiring);
+        return result;
+    }
+
+}
