+        permissionsService.checkManager(getUserId());
+        Server server = permissionsService.getServer();
+        boolean admin = !permissionsService.notAdmin(getUserId());
+        Set<Long> branch = new HashSet<>(hierarchyService.getDescendants(getUserId()));
+        branch.add(getUserId());
+        Set<String> expected = expectedAddresses(server);
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (var entry : readDomains(server).entrySet()) {
+            if (!admin && !branch.contains(entry.getValue())) {
+                continue;
+            }
+            User owner = storage.getObject(User.class, new Request(
+                    new Columns.All(), new Condition.Equals("id", entry.getValue())));
+            Set<String> addresses = resolve(entry.getKey());
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("domain", entry.getKey());
+            item.put("userId", entry.getValue());
+            item.put("userName", owner != null ? owner.getName() : null);
+            item.put("addresses", addresses);
+            item.put("expected", expected);
+            String status;
+            if (addresses.isEmpty()) {
+                status = "unresolved";
+            } else if (expected.isEmpty()) {
+                status = "unknown";
+            } else if (expected.containsAll(addresses) || addresses.stream().anyMatch(expected::contains)) {
+                status = "ok";
+            } else {
+                status = "wrong";
+            }
+            item.put("status", status);
+            result.add(item);
+        }
+        return result;
+    }
+
+    /**
+     * Registers a white label domain for the caller or an account of its branch; the HTTPS certificate is then
+     * issued automatically on the first visit (see the Caddyfile).
+     */
+    @POST
+    @Path("domains")
+    public Response addDomain(Map<String, Object> body) throws Exception {
+        permissionsService.checkManager(getUserId());
+        String domain = String.valueOf(body.getOrDefault("domain", "")).trim().toLowerCase(Locale.ROOT)
+                .replaceFirst("^https?://", "").replaceFirst("/.*$", "");
+        long userId = body.get("userId") instanceof Number number ? number.longValue() : getUserId();
+        if (!domain.matches(HOST_PATTERN)) {
+            throw new IllegalArgumentException("Invalid domain: " + domain);
+        }
+        if (userId != getUserId()) {
+            permissionsService.checkUser(getUserId(), userId);
+        }
+        String url = config.getString(Keys.WEB_URL);
+        if (url != null && domain.equalsIgnoreCase(URI.create(url).getHost())) {
+            throw new IllegalArgumentException("The main domain of the platform cannot be assigned");
+        }
+        Server server = permissionsService.getServer();
+        Map<String, Long> domains = readDomains(server);
+        Long current = domains.get(domain);
+        if (current != null && current != userId) {
+            throw new IllegalArgumentException("Domain already assigned to another account");
+        }
+        domains.put(domain, userId);
+        writeDomains(server, domains);
+        return Response.ok(Map.of("domain", domain, "userId", userId)).build();
+    }
+
+    @DELETE
+    @Path("domains")
+    public Response removeDomain(@QueryParam("domain") String domain) throws Exception {
+        permissionsService.checkManager(getUserId());
+        Server server = permissionsService.getServer();
+        Map<String, Long> domains = readDomains(server);
+        String key = domain != null ? domain.trim().toLowerCase(Locale.ROOT) : "";
+        Long owner = domains.get(key);
+        if (owner == null) {
+            return Response.status(Response.Status.NOT_FOUND).build();
+        }
+        if (owner != getUserId()) {
+            permissionsService.checkUser(getUserId(), owner);
+        }
+        domains.remove(key);
+        writeDomains(server, domains);
+        return Response.noContent().build();
+    }
+
 }
