{
	email {$ACME_EMAIL}

	# Dominios propios de distribuidores: el certificado HTTPS se pide en la primera visita, solo si la plataforma
	# confirma que el dominio está registrado (Panel del distribuidor > Dominios propios)
	on_demand_tls {
		ask http://traccar:8082/api/hierarchy/domain-check
	}
}

(plataforma) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	# Mapas propios de Safe Connection: un archivo PMTiles de Latinoamérica más tipografías e íconos, servidos
	# desde el disco por partes (Range); el navegador dibuja el mapa. Ver scripts/mapas-latam.sh
	handle_path /maps/* {
		root * /srv/maps
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# La consola de base de datos y el endpoint de salud no se exponen
	@blocked path /console* /api/health
	respond @blocked 404

	# Video en vivo de dashcams: si instalas un servidor JT/T 1078 (ver DEPLOY.md) publica su HTTP-FLV en /live/
	# handle /live/* {
	# 	reverse_proxy video:8080
	# }

	# (directiva suelta a propósito: Caddy aplica antes handle_path /maps y el bloqueo de arriba)
	reverse_proxy traccar:8082
}

# Dominio principal
{$DOMAIN} {
	import plataforma
}

# Cualquier otro dominio que apunte al servidor: HTTPS automático si está registrado como dominio propio
https:// {
	tls {
		on_demand
	}
	import plataforma
}
