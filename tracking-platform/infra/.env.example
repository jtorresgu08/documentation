# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Dominio que apunta (registro A) a la IP del servidor, p. ej. rastreo.tuempresa.com
DOMAIN=rastreo.example.com
# Correo para los certificados de Let's Encrypt
ACME_EMAIL=admin@example.com

# Contraseña de PostgreSQL: genera una con  openssl rand -base64 32
DB_PASSWORD=

# Rango de puertos de protocolos GPS expuestos (debe coincidir con el firewall)
GPS_PORTS=5001-5100

# Memoria de Java (para un VPS de 8 GB, -Xmx3g es razonable)
JAVA_OPTS=-Xms512m -Xmx2g

# Copias de seguridad
BACKUP_RETENTION_DAYS=14
# Opcional: destino rclone para copia externa (p. ej. "ovh-s3:rastreo-backups"). Vacío = solo local.
RCLONE_REMOTE=
