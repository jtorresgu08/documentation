# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Dominio que apunta (registro A) a la IP del servidor, p. ej. rastreo.tuempresa.com
DOMAIN=rastreo.example.com
# Correo para los certificados de Let's Encrypt
ACME_EMAIL=admin@example.com

# Contraseña de PostgreSQL: genera una con  openssl rand -base64 32
DB_PASSWORD=

# Rango de puertos de protocolos GPS expuestos (debe coincidir con el firewall)
GPS_PORTS=5001-5100

# Dashcams: dirección que las cámaras usan para subir adjuntos y video. Muchas cámaras solo aceptan IP,
# así que conviene poner la IP pública del VPS. Vacío = se usa DOMAIN.
PUBLIC_HOST=
# Puerto del servidor de video JT/T 1078 (ver DEPLOY.md, sección Dashcams)
VIDEO_PORT=7611

# Memoria de Java (para un VPS de 8 GB, -Xmx3g es razonable)
JAVA_OPTS=-Xms512m -Xmx2g

# Copias de seguridad
BACKUP_RETENTION_DAYS=14
# Opcional: destino rclone para copia externa (p. ej. "ovh-s3:rastreo-backups"). Vacío = solo local.
RCLONE_REMOTE=

# Notificaciones: agrega "whatsapp" cuando configures WhatsApp (p. ej. web,mail,whatsapp)
NOTIFICATOR_TYPES=web,mail
# WhatsApp Cloud API de Meta (DEPLOY.md, sección 10). Deja vacío para desactivar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada con un parámetro en el cuerpo, para alertas fuera de la ventana de 24 h
WHATSAPP_TEMPLATE=
# Token que tú eliges para registrar el webhook, y el "App secret" de tu app de Meta (firma de mensajes)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
